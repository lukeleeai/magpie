LineLLMMutation(('source.cpp', 12), '#include <iostream>\n#include <vector>\n#include <cmath>\n#include <cstdio>\n#include <cstring>\nusing namespace std;\n\nint main() {\n    int n, k;\n    scanf("%d%d", &n, &k);\n    vector<int> f(n + 1, 0x3f3f3f3f);\n    vector<int> w(n + 1);\n\n    for (int i = 1; i <= n; i++) {\n        scanf("%d", &w[i]);\n    }\n\n    f[1] = 0;\n\n    for (int i = 2; i <= n; i++) {\n        for (int j = 1; j <= k; j++) {\n            if (i - j <= 0) break;\n            f[i] = min(f[i], f[i - j] + abs(w[i - j] - w[i]));\n        }\n    }\n\n    printf("%d\\n", f[n]);\n}') + LineLLMMutation(('source.cpp', 15), '#include <iostream>\n#include <vector>\n#include <cmath>\n#include <cstdio>\n#include <cstring>\nusing namespace std;\n\nint main() {\n    int n, k;\n    scanf("%d%d", &n, &k);\n    vector<int> f(n + 1, 0x3f3f3f3f);\n    vector<int> w(n + 1);\n\n    for (int i = 1; i <= n; i++) {\n        scanf("%d", &w[i]);\n    }\n\n    f[1] = 0;\n\n    for (int i = 2; i <= n; i++) {\n        int start = max(1, i - k); // Optimize the starting index\n        for (int j = start; j < i; j++) { // Change the inner loop to iterate from start to i-1\n            f[i] = min(f[i], f[j] + abs(w[j] - w[i]));\n        }\n    }\n\n    printf("%d\\n", f[n]);\n}')
