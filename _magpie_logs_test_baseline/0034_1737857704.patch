LineLLMMutation(('source.cpp', 9), '#include <cstdio>\nusing namespace std;\n\nint main() {\n    int n, m, i, totalSum = 0, from, to; // Change long long to int\n    scanf("%d", &n); // Change to int\n    int elements[n + 10];\n    int elementCount[100001] = {0};\n\n    for (i = 0; i < n; i++) {\n        scanf("%d", &elements[i]); // Change to int\n        totalSum += elements[i];\n        elementCount[elements[i]]++;\n    }\n\n    scanf("%d", &m); // Change to int\n    for (i = 0; i < m; i++) {\n        scanf("%d%d", &from, &to); // Change to int\n        totalSum += (to - from) * elementCount[from];\n        elementCount[to] += elementCount[from];\n        elementCount[from] = 0;\n        printf("%d\\n", totalSum); // Change to int\n    }\n}')
