LineLLMCrossover(('source.cpp', 12), '#include <cstdio>\nusing namespace std;\n\nint main() {\n    int k, x;\n    scanf("%d %d", &k, &x);\n    \n    int start = x - (k - 1);\n    int end = x + (k - 1);\n    \n    char buffer[200];\n    int pos = 0;\n    pos += sprintf(buffer + pos, "%d", start);\n    for (int i = start + 1; i <= end; i++) {\n        pos += sprintf(buffer + pos, " %d", i);\n    }\n    printf("%s\\n", buffer);\n    \n    return 0;\n}')
