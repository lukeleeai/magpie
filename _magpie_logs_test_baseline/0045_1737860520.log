2025-01-26 03:02:48,925	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include <iostream>\n#include <cstdio>\n#include <cstring>\nusing namespace std;\n\n#define rep(i,a,n) for(int i=a;i<=n;i++)\n#define per(i,a,n) for(int i=n;i>=a;i--)\n#define pb push_back\n#define SZ(x) ((int)(x).size())\n\ntypedef long long ll;\ntypedef pair<int,int> pii;\ntypedef double db;\n\nll n, ans, r, g, b;\nchar s[4010];\n\nint main() {\n    cin >> n;\n    scanf("%s", s + 1);\n    rep(i, 1, n) {\n        if (s[i] == \'R\') r++;\n        else if (s[i] == \'G\') g++;\n        else if (s[i] == \'B\') b++;\n    }\n    ans = r * g * b;\n\n    rep(len, 1, n) {\n        rep(j, 1, n - 2 * len) {\n            if (s[j] != s[j + len] && s[j] != s[j + 2 * len] && s[j + len] != s[j + 2 * len])\n                ans--;\n        }\n    }\n    printf("%lld\\n", ans);\n    return 0;\n}')"

