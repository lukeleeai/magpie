LineLLMMutation(('source.cpp', 8), '#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cmath>\nusing namespace std;\n\ntypedef long long ll;\nconst int OO = 1e9;\n\nint n, k;\nvector<int> arr;\nvector<int> mem;\n\nint solve(int x) {\n    if (x == n - 1) return 0;\n    if (mem[x] != OO) return mem[x];\n\n    for (int i = 1; i <= k && (x + i) <= n - 1; i++) {\n        mem[x] = min(mem[x], solve(x + i) + std::abs(arr[x] - arr[x + i]));\n    }\n\n    return mem[x];\n}\n\nint main() {\n    cin >> n >> k;\n    arr.resize(n);\n    mem.resize(n, OO);\n    for (int i = 0; i < n; i++) {\n        cin >> arr[i];\n    }\n    cout << solve(0) << endl;\n    return 0;\n}') + LineLLMMutation(('source.cpp', 13), '#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cmath>\nusing namespace std;\n\ntypedef long long ll;\nconst int OO = 1e9;\n\nint n, k;\nvector<int> arr;\nvector<ll> dp;  // Change mem type to long long for more precise calculations\n\nll solve(int x) {\n    if (x == n - 1) return 0;\n    if (dp[x] != OO) return dp[x];\n\n    ll min_cost = OO;  // Initialize the minimum cost\n    for (int i = 1; i <= k && (x + i) <= n - 1; i++) {\n        min_cost = min(min_cost, solve(x + i) + std::abs(arr[x] - arr[x + i]));\n    }\n\n    return dp[x] = min_cost;  // Store the result in dp\n}\n\nint main() {\n    cin >> n >> k;\n    arr.resize(n);\n    dp.resize(n, OO);  // Use dp instead of mem for clarity\n    for (int i = 0; i < n; i++) {\n        cin >> arr[i];\n    }\n    cout << solve(0) << endl;\n    return 0;\n}')
