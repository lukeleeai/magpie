LineLLMCrossover(('source.cpp', 3), '#include <bits/stdc++.h>\nusing namespace std;\n\n#define ll long long\n#define mx 100005\n#define inf 100000000000000000LL\n\nll arr[mx], dp[mx];\n\ninline ll my_abs(ll x) {\n    return x < 0 ? -x : x;\n}\n\nll solve(int pos, int n, int k) {\n    if (pos == n) return 0;\n    ll &ret = dp[pos];\n    if (dp[pos] != -1) return ret;\n    ret = inf;\n    for (int i = 1; i <= k; i++) {\n        int nxt = pos + i;\n        if (nxt > n) break;\n        ret = min(ret, my_abs(arr[pos] - arr[nxt]) + solve(nxt, n, k));\n    }\n    return ret;\n}\n\nint main() {\n    int n, k;\n    while (scanf("%d%d", &n, &k) == 2) {\n        for (int i = 1; i <= n; i++)\n            scanf("%lld", &arr[i]);\n        memset(dp, -1, sizeof dp);\n        printf("%lld\\n", solve(1, n, k));\n        return 0;\n    }\n}') + LineLLMMutation(('source.cpp', 17), '#include <bits/stdc++.h>\nusing namespace std;\n\n#define ll long long\n#define mx 100005\n#define inf 100000000000000000LL\n\nll arr[mx], dp[mx];\n\ninline ll my_abs(ll x) {\n    return x < 0 ? -x : x;\n}\n\nll solve(int n, int k) {\n    dp[n] = 0; // Base case: no cost to reach the end\n    for (int pos = n - 1; pos >= 1; pos--) {\n        dp[pos] = inf; // Initialize the current position\n        for (int i = 1; i <= k; i++) {\n            int nxt = pos + i;\n            if (nxt > n) break;\n            dp[pos] = min(dp[pos], my_abs(arr[pos] - arr[nxt]) + dp[nxt]);\n        }\n    }\n    return dp[1]; // Return the result starting from position 1\n}\n\nint main() {\n    int n, k;\n    while (scanf("%d%d", &n, &k) == 2) {\n        for (int i = 1; i <= n; i++)\n            scanf("%lld", &arr[i]);\n        memset(dp, -1, sizeof dp);\n        printf("%lld\\n", solve(n, k));\n        return 0;\n    }\n}') + LineLLMMutation(('source.cpp', 19), '#include <bits/stdc++.h>\nusing namespace std;\n\n#define ll long long\n#define mx 100005\n#define inf 100000000000000000LL\n\nll arr[mx], dp[mx];\n\ninline ll my_abs(ll x) {\n    return x < 0 ? -x : x;\n}\n\nll solve(int n, int k) {\n    dp[n] = 0; // Base case: no cost to reach the end\n    for (int pos = n - 1; pos >= 1; pos--) {\n        dp[pos] = inf; // Initialize the current position\n        for (int i = 1; i <= k; i++) {\n            int nxt = pos + i;\n            if (nxt > n) break;\n            dp[pos] = min(dp[pos], my_abs(arr[pos] - arr[nxt]) + dp[nxt]);\n        }\n    }\n    return dp[1]; // Return the result starting from position 1\n}\n\nint main() {\n    int n, k;\n    while (scanf("%d%d", &n, &k) == 2) {\n        for (int i = 1; i <= n; i++)\n            scanf("%lld", &arr[i]);\n        // Initialize dp array to inf\n        for (int i = 1; i <= n; i++) {\n            dp[i] = inf; // Set all values to inf\n        }\n        dp[n] = 0; // Base case: no cost to reach the end\n        printf("%lld\\n", solve(n, k));\n    }\n    return 0;\n}')
