LineLLMMutation(('source.cpp', 2), '#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cmath>\nusing namespace std;\n\n#define ll long long\n\nconst ll INF = 1LL << 60;\n\n// Input\nll N;\nll K;\nvector<ll> h;\n\nvector<ll> dp;\n\nvoid chmin(ll& a, ll b) {\n    if (a > b) {\n        a = b;\n    }\n}\n\nint main() {\n    cin >> N >> K;\n    h.resize(N);\n    for (ll i = 0; i < N; i++) cin >> h[i];\n\n    dp.resize(N, INF);\n    dp[0] = 0;\n\n    for (ll i = 0; i < N; i++) {\n        for (ll j = i + 1; j <= min(i + K, N - 1); j++) {\n            chmin(dp[j], dp[i] + abs(h[i] - h[j]));\n        }\n    }\n\n    cout << dp[N - 1] << endl;\n}') + LineLLMMutation(('source.cpp', 23), '#include <iostream>\n#include <vector>\n#include <algorithm>\nusing namespace std;\n\n#define ll long long\n\nconst ll INF = 1LL << 60;\n\n// Input\nll N;\nll K;\nvector<ll> h;\n\nvector<ll> dp;\n\nint main() {\n    cin >> N >> K;\n    h.resize(N);\n    for (ll i = 0; i < N; i++) cin >> h[i];\n\n    dp.resize(N, INF);\n    dp[0] = 0;\n\n    for (ll i = 0; i < N; i++) {\n        ll currentHeight = h[i];\n        for (ll j = i + 1; j <= min(i + K, N - 1); j++) {\n            dp[j] = min(dp[j], dp[i] + (currentHeight >= h[j] ? currentHeight - h[j] : h[j] - currentHeight));\n        }\n    }\n\n    cout << dp[N - 1] << endl;\n}')
