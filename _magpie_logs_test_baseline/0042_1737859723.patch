LineLLMCrossover(('source.cpp', 13), '#include <cstdio>\n#include <cstring>\n#include <cmath>\n#include <algorithm>\n\nusing namespace std;\n\ntypedef long long ll;\n\nconst double eps = 1e-6, pi = acos(-1);\nconst int N = 1e5 + 5, M = 1e9 + 7;\n\nint n, m, a[N], mem[N];\n\nint solve(int i) {\n    if (i >= n) return 1e9;\n    if (i == n - 1) return 0;\n\n    int &ret = mem[i];\n    if (~ret) return ret;\n\n    ret = 1e9;\n    for (int j = 1; j <= m; ++j) {\n        if (i + j < n) {\n            ret = min(ret, solve(i + j) + abs(a[i] - a[i + j]));\n        }\n    }\n    return ret;\n}\n\nint main() {\n    scanf("%d%d", &n, &m);\n    for (int i = 0; i < n; ++i)\n        scanf("%d", a + i);\n    memset(mem, -1, sizeof mem);\n    printf("%d", solve(0));\n    return 0;\n}')
