LineLLMCrossover(('source.cpp', 9), '#include <iostream>\nusing namespace std;\n\nconst int MOD = 1e9 + 7;\n\nlong long int factorial(long long int n) {\n    if (n < 0) return 0; // handle invalid input\n    long long int ans = 1;\n    for (long long int i = 1; i <= n; i++) { // start from 1 to include all numbers\n        ans = (ans * i) % MOD;\n    }\n    return ans;\n}\n\nint main() {\n    long long int n;\n    cin >> n;\n    if (n < 0) {\n        cout << "Invalid input" << endl; // handle negative inputs\n    } else {\n        cout << factorial(n) << endl;\n    }\n    return 0;\n}')
