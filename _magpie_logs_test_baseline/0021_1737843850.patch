LineLLMMutation(('source.cpp', 2), '#define _CRT_SECURE_NO_WARNINGS\n\n#include<cstdio>\n#include<algorithm>\n#include<vector>\n#include<cstring>\n\nusing namespace std;\n\n#define  ll long long\n\n#define ex(n) return printf("%lld\\n", n), 0;\n\nint n, c;\nvector<ll> v;\nll mem[(int)1e5 + 10];\n\nll solve(int i) {\n    if (i == n - 1) return 0;\n    ll& ret = mem[i];\n    if (~ret) return ret;\n    ret = solve(i + 1) + abs(v[i + 1] - v[i]);\n    for (int k = 2; k <= c; k++) {\n        if (k + i < n) ret = min(ret, solve(i + k) + abs(v[i + k] - v[i]));\n    }\n    return ret;\n}\n\nint main() {\n    memset(mem, -1, sizeof mem);\n    scanf("%d %d", &n, &c);\n    v.resize(n);\n    for (int i = 0; i < n; ++i) scanf("%lld", &v[i]);\n    ex(solve(0));\n}') + LineLLMMutation(('source.cpp', 16), '#define _CRT_SECURE_NO_WARNINGS\n\n#include<cstdio>\n#include<algorithm>\n#include<vector>\n#include<cstring>\n\nusing namespace std;\n\n#define ll long long\n\nint n, c;\nvector<ll> v;\nll dp[(int)1e5 + 10];\n\nll solve() {\n    dp[n - 1] = 0;  // Base case\n    for (int i = n - 2; i >= 0; --i) {\n        dp[i] = dp[i + 1] + abs(v[i + 1] - v[i]);  // Default step to the next position\n        for (int k = 2; k <= c; k++) {\n            if (i + k < n) {\n                dp[i] = min(dp[i], dp[i + k] + abs(v[i + k] - v[i]));\n            }\n        }\n    }\n    return dp[0];\n}\n\nint main() {\n    scanf("%d %d", &n, &c);\n    v.resize(n);\n    for (int i = 0; i < n; ++i) scanf("%lld", &v[i]);\n    printf("%lld\\n", solve());\n}')
