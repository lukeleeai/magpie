LineLLMCrossover(('source.cpp', 8), '#include <iostream>\n#include <vector>\n#include <algorithm>\n\nusing namespace std;\n\nconst int MAX_NODES = 100;\nvector<vector<int>> G(MAX_NODES);\n\nint rec(int pos, int visited) {\n    visited |= (1 << pos); // Mark as used using bitmask\n    int ret = 1;\n\n    for (int r : G[pos]) {\n        if (!(visited & (1 << r))) { // Check if not visited using bitmask\n            ret = max(ret, rec(r, visited) + 1);\n        }\n    }\n\n    return ret;\n}\n\nint main() {\n    int N, A, B;\n\n    while (cin >> N, N) {\n        G.assign(MAX_NODES, vector<int>());\n\n        for (int i = 0; i < N; i++) {\n            cin >> A; A--;\n            cin >> B; B--;\n            G[A].push_back(B);\n            G[B].push_back(A);\n        }\n\n        int ret = 0;\n        for (int i = 0; i < MAX_NODES; i++) {\n            if (!G[i].empty()) {\n                ret = max(ret, rec(i, 0)); // Start with an empty visited bitmask\n            }\n        }\n\n        cout << ret << endl;\n    }\n\n    return 0;\n}')
