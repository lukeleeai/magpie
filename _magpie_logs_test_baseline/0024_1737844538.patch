LineLLMMutation(('source.cpp', 3), '#include <cstdio>\n#include <iostream>\nusing namespace std;\n\ntypedef long long ll;\n\nint n, k;\n\nint main() {\n    scanf("%d%d", &n, &k);\n    if (k == 0) {\n        printf("%lld\\n", (ll)n * n);\n        return 0;\n    }\n    ll sum = 0;\n    int x = 1;\n    for (int i = k + 1; i <= n; i++) {\n        ll n_div_i = n / i; // Store n/i in a variable\n        sum += n_div_i * x;\n        if (n % i >= k)\n            sum += n % i - k + 1;\n        x++;\n    }\n    printf("%lld\\n", sum);\n}') + LineLLMMutation(('source.cpp', 15), '#include <cstdio>\n#include <iostream>\nusing namespace std;\n\ntypedef long long ll;\n\nint n, k;\n\nint main() {\n    scanf("%d%d", &n, &k);\n    if (k == 0) {\n        printf("%lld\\n", (ll)n * n);\n        return 0;\n    }\n    ll sum = 0;\n    int x = 1;\n    for (int i = k + 1; i <= n; i++) {\n        sum += (n / i) * x; // Store n/i in a variable\n        if (n % i >= k)\n            sum += n % i - k + 1;\n        x++;\n    }\n    printf("%lld\\n", sum);\n}') + LineLLMMutation(('source.cpp', 23), '#include <cstdio>\n#include <iostream>\nusing namespace std;\n\ntypedef long long ll;\n\nint n, k;\n\nint main() {\n    scanf("%d%d", &n, &k);\n    if (k == 0) {\n        printf("%lld\\n", (ll)n * n);\n        return 0;\n    }\n    ll sum = 0;\n    int x = 1;\n    for (int i = k + 1; i <= n; i++) {\n        ll division_result = n / i; // Store n/i in a variable\n        sum += division_result * x; \n        if (n % i >= k)\n            sum += n % i - k + 1;\n        x++;\n    }\n    printf("%lld\\n", sum);\n}')
