LineLLMMutation(('source.cpp', 5), '#include <iostream>\n#include <vector>\n#include <cstdlib>\nusing namespace std;\n\nint n;\nint k;\nvector<int> arr;\nvector<int> memo;\n\nint cost(int i) {\n    if(i >= n - 1) return 0;\n    if(i == n - 2) return abs(arr[n - 2] - arr[n - 1]);\n\n    if(memo[i] == -1) {\n        for(int j = 1; j <= k; ++j) {\n            if(i + j > n - 1) break;\n            int temp = abs(arr[i + j] - arr[i]) + cost(i + j);\n            memo[i] = (memo[i] == -1) ? temp : min(memo[i], temp);\n        }\n    }\n    return memo[i];\n}\n\nint main() {\n    cin >> n >> k;\n    arr.resize(n);\n    memo.resize(n, -1);\n    for(int i = 0; i < n; ++i) cin >> arr[i];\n    cout << cost(0) << endl;\n    return 0;\n}')
