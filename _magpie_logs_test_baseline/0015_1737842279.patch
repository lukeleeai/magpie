LineLLMMutation(('source.cpp', 5), '#include <iostream>\n#include <algorithm>\nusing namespace std;\n\ntypedef long long ll;\n\nconst int N = 2e5 + 5;\nll dp[N];\nint h[N];\n\nint main() {\n    int n, k;\n    cin >> n >> k;\n    for (int i = 1; i <= n; i++) {\n        cin >> h[i];\n        dp[i] = 0x3f3f3f3f; // Initialize dp here\n    }\n    dp[1] = 0;\n\n    for (int i = 2; i <= n; i++) {\n        for (int j = 1; j <= k && i - j >= 1; j++) {\n            ll diff = h[i] - h[i - j];\n            dp[i] = min(dp[i], dp[i - j] + (diff < 0 ? -diff : diff));\n        }\n    }\n    cout << dp[n] << endl;\n    return 0;\n}')
