LineLLMCrossover(('source.cpp', 12), '#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cstring>\nusing namespace std;\n\n#define ll long long int\n#define inf 1000000000000000001\n#define mem(a,val) memset(a,val,sizeof(a))\n\nll k2;\nll arr[1000000];\nll arr2[1000000];\n\nll func(ll n) {\n    vector<ll> dp(n + 1, inf);\n    dp[0] = 0; // Base case\n    for (ll cur = 0; cur < n; ++cur) {\n        for (ll i = 1; i <= k2 && cur + i <= n; ++i) {\n            dp[cur + i] = min(dp[cur + i], dp[cur] + abs(arr[cur] - arr[cur + i]));\n        }\n    }\n    return dp[n];\n}\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    ll n = 0;\n    cin >> n >> k2;\n    for (ll i = 0; i < n; ++i) {\n        cin >> arr[i];\n    }\n    cout << func(n - 1);\n    return 0;\n}')
