ack(n - 1); // Start with the last position\n\n    for (int i = n - 2; i >= 0; i--) {\n        // Remove elements not in the sliding window\n        while (!dq.empty() && dq.front() > i + k) {\n            dq.pop_front();\n        }\n        \n        // Calculate the minimum cost using the front of the deque\n        if (!dq.empty()) {\n            dp[i] = dp[dq.front()] + abs(a[i] - a[dq.front()]);\n        }\n\n        // Maintain the deque: remove all elements that are not better than the current\n        while (!dq.empty() && dp[dq.back()] >= dp[i]) {\n            dq.pop_back();\n        }\n        \n        dq.push_back(i); // Add the current index\n    }\n    \n    printf("%d\\n", dp[0]);\n    return 0;\n}')"
