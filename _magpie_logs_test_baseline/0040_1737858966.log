icient recursive function with memoization\nll solve(int x) {\n    if (x >= n - 1) return 0;\n    if (mem[x] != OO) return mem[x];\n\n    // Only initialize to OO if it's the first time visiting this index\n    // This ensures we don't reset it unnecessarily\n    mem[x] = OO; \n    for (int i = 1; i <= k && (x + i) < n; i++) {\n        mem[x] = min(mem[x], solve(x + i) + std::abs(arr[x] - arr[x + i]));\n    }\n\n    return mem[x];\n}\n\nint main() {\n    cin >> n >> k;\n    arr.resize(n);\n    fill(mem, mem + MAXN, OO); // Initialize the static array\n    for (int i = 0; i < n; i++) {\n        cin >> arr[i];\n    }\n    cout << solve(0) << endl;\n    return 0;\n}")"
