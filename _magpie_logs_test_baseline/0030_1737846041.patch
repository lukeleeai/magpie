LineLLMCrossover(('source.cpp', 8), '#include <cstdio>\n#include <cstring>\nusing namespace std;\n\nchar a[10000001];\n\nint main() {\n    fgets(a, sizeof(a), stdin); // Use fgets to read the entire line at once\n    int len = 0;\n    while (a[len] != \'\\0\') len++; // Calculate length manually\n    if (len > 0 && a[len - 1] == \'\\n\') {\n        len--; // Remove the newline character\n    }\n    printf("%c%d%c\\n", a[0], len - 2, a[len - 1]);\n    return 0;\n}')
