LineLLMCrossover(('source.cpp', 10), '#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cmath>\nusing namespace std;\n\nlong long n, k;\n\nint main() {\n    cin >> n >> k;\n    vector<long long> l(n), l1(n); // Initialize l1 without zeroes\n\n    for (int i = 0; i < n; i++) {\n        cin >> l[i];\n    }\n\n    l1[0] = 0; // Initialize the first element\n    for (int i = 1; i < n; i++) {\n        l1[i] = l1[i - 1] + abs(l[i - 1] - l[i]);\n        for (int j = 1; j <= min(i * 1ll, k); j++) {\n            l1[i] = min(l1[i], l1[i - j] + abs(l[i - j] - l[i]));\n        }\n    }\n    cout << max(0ll, l1[n - 1]) << endl;\n}')
