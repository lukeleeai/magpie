LineLLMCrossover(('source.cpp', 5), '#include <cstdio>\n#include <algorithm>\n\nusing namespace std;\n\nlong long a[10000];\n\nint main() {\n    int n;\n    scanf("%d", &n);\n\n    for (int i = 0; i < n; i++) {\n        scanf("%lld", &a[i]);\n    }\n\n    long long ans = 0;\n    bool continueLoop = true;\n\n    while (continueLoop) {\n        long long maxn = a[0];\n        int id = 0;\n\n        for (int i = 1; i < n; i++) {\n            if (maxn < a[i]) {\n                maxn = a[i];\n                id = i;\n            }\n        }\n\n        if (maxn <= n - 1) {\n            continueLoop = false;\n            break;\n        }\n\n        long long divisor = maxn / n;\n        a[id] = maxn % n; \n\n        for (int i = 0; i < n; i++) {\n            if (i != id) {\n                a[i] += divisor; \n            }\n        }\n\n        ans += divisor;\n    }\n\n    printf("%lld\\n", ans);\n}') + LineLLMMutation(('source.cpp', 25), '#include <cstdio>\n#include <algorithm>\n\nusing namespace std;\n\nlong long a[10000];\n\nint main() {\n    int n;\n    scanf("%d", &n);\n\n    for (int i = 0; i < n; i++) {\n        scanf("%lld", &a[i]);\n    }\n\n    long long ans = 0;\n\n    while (true) {\n        long long maxn = a[0];\n        int id = 0;\n\n        // Using a single loop to find max value\n        for (int i = 1; i < n; i++) {\n            if (a[i] > maxn) {\n                maxn = a[i];\n                id = i;\n            }\n        }\n\n        // Instead of checking maxn <= n - 1, we can simply break if maxn < n\n        if (maxn < n) {\n            break;\n        }\n\n        long long divisor = maxn / n;\n        a[id] = maxn % n; \n\n        // Instead of two loops, we can add divisor to all but the max element directly\n        for (int i = 0; i < n; i++) {\n            if (i != id) {\n                a[i] += divisor; \n            }\n        }\n\n        ans += divisor;\n    }\n\n    printf("%lld\\n", ans);\n}')
