LineLLMMutation(('source.cpp', 12), '#pragma GCC optimize ("O3")\n\n#include <iostream>\n#include <vector>\n#include <cstring>\n#include <stack>\n\nusing namespace std;\n\ntypedef long long ll;\n\nll n, k, arr[100005], memo[100005];\n\nll solve() {\n    stack<pair<ll, ll>> s;\n    s.push({0, 0});\n    ll ans = 1e9;\n    \n    while (!s.empty()) {\n        auto [i, current_ans] = s.top();\n        s.pop();\n        \n        if (i == n - 1) {\n            ans = min(ans, current_ans);\n            continue;\n        }\n\n        if (~memo[i]) {\n            ans = min(ans, current_ans + memo[i]);\n            continue;\n        }\n\n        for (int j = 1; j <= k && j + i < n; j++) {\n            s.push({i + j, current_ans + abs(arr[i] - arr[i + j])});\n        }\n    }\n    \n    return ans;\n}\n\nint main() {\n    cin >> n >> k;\n    memset(memo, -1, sizeof memo);\n    for (int i = 0; i < n; i++)\n        cin >> arr[i];\n\n    cout << solve();\n    return 0;\n}') + LineLLMMutation(('source.cpp', 18), '#pragma GCC optimize ("O3")\n\n#include <iostream>\n#include <vector>\n#include <cstring>\n#include <algorithm>\n\nusing namespace std;\n\ntypedef long long ll;\n\nll n, k, arr[100005], memo[100005];\n\nll solve() {\n    memo[0] = 0; // Base case\n    for (ll i = 1; i < n; ++i) {\n        memo[i] = 1e9; // Initialize with a large number\n        for (int j = 1; j <= k && j <= i; j++) {\n            memo[i] = min(memo[i], memo[i - j] + abs(arr[i] - arr[i - j]));\n        }\n    }\n    return memo[n - 1];\n}\n\nint main() {\n    cin >> n >> k;\n    for (int i = 0; i < n; i++)\n        cin >> arr[i];\n\n    cout << solve();\n    return 0;\n}')
