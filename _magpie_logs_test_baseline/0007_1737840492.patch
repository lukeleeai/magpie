LineLLMCrossover(('source.cpp', 12), '#include <iostream>\n#include <vector>\n#include <cmath>\n#include <limits>\nusing namespace std;\n\ntypedef long long int int64;\n\nint main() {\n    int64 n, k;\n    cin >> n >> k;\n    vector<int64> h(n);\n    for (int64 i = 0; i < n; i++)\n        cin >> h[i];\n\n    vector<int64> ans(n, numeric_limits<int64>::max());\n    ans[0] = 0;\n    ans[1] = abs(h[1] - h[0]);\n\n    for (int64 i = 2; i < n; i++) {\n        ans[i] = abs(h[i] - h[i - 1]) + ans[i - 1];\n        for (int64 j = 2; j <= k && j <= i; j++) {\n            ans[i] = min(ans[i], abs(h[i] - h[i - j]) + ans[i - j]);\n        }\n    }\n    cout << ans[n - 1];\n}')
