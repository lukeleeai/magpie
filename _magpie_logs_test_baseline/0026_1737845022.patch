LineLLMCrossover(('source.cpp', 17), '#include <cstdio>\n#include <algorithm>\n#include <cstring>\nusing namespace std;\n\nconst int N = 100005;\nint f[N], a[N];\n\nint main() {\n    int n, k;\n    scanf("%d %d", &n, &k);\n    fill(f, f + N, 0x3f); // Using fill function for initialization\n    for (int i = 1; i <= n; i++) {\n        scanf("%d", &a[i]);\n    }\n    f[1] = 0;\n    for (int i = 2; i <= n; i++) {\n        for (int j = 1; j <= k; j++) { // Consistent loop structure\n            if (i - j >= 1) {\n                f[i] = min(f[i], f[i - j] + abs(a[i] - a[i - j]));\n            }\n        }\n    }\n    printf("%d\\n", f[n]);\n}')
