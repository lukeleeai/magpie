LineLLMCrossover(('source.cpp', 13), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\n\n#define ll long long\nconst ll INF = 1 << 30;\nconst int MAX_SIZE = 200005;\n\nll n, k;\nll ara[MAX_SIZE], dp[MAX_SIZE];\n\nvoid cal() {\n    dp[n] = 0; // Base case\n    for (ll pos = n - 1; pos >= 1; pos--) {\n        dp[pos] = INF; // Initialize with INF\n        dp[pos] = min(dp[pos], abs(ara[pos + 1] - ara[pos]) + dp[pos + 1]);\n        for (int i = 2; i <= k && pos + i <= n; i++) {\n            dp[pos] = min(dp[pos], abs(ara[pos] - ara[pos + i]) + dp[pos + i]);\n        }\n    }\n}\n\nint main() {\n    scanf("%lld %lld", &n, &k);\n    for (ll i = 0; i <= n; i++) {\n        dp[i] = INF; // Initializing dp array\n    }\n    for (ll i = 1; i <= n; i++) {\n        scanf("%lld", &ara[i]);\n    }\n    cal(); // Call the iterative cal function\n    printf("%lld\\n", dp[1]); // Output result from dp[1]\n    return 0;\n}')
