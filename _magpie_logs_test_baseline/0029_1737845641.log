2025-01-25 23:00:36,276	[DEBUG]	patch(5-6)="LineLLMCrossover(('source.cpp', 12), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\n\ntypedef long long ll;\nconst int N = 16;\nconst ll MN = -1e9 * N;\n\nint n;\nint a[N][N];\nll dp[(1 << N)];\nll value[(1 << N)];\nint arr[N];\n\nll get_cost(int sz) {\n    if (sz < 2) return 0; // Return 0 cost if less than 2 elements\n    ll ret = 0;\n    ll prefix_sum[N] = {0}; // Prefix sum array\n    for (int i = 0; i < sz; i++) {\n        prefix_sum[i + 1] = prefix_sum[i] + a[arr[i]][arr[i]];\n    }\n    for (int i = 0; i < sz; i++) {\n        for (int j = i + 1; j < sz; j++) {\n            ret += a[arr[i]][arr[j]];\n        }\n    }\n    return ret;\n}\n\nll solve(int msk) {\n    if (!msk) return 0;\n\n    ll &ret = dp[msk];\n    if (~ret) return ret;\n\n    ret = MN;\n    for (int cur_msk = msk; cur_msk; cur_msk = (cur_msk - 1) & msk) {\n        ret = max(ret, value[cur_msk] + solve(msk ^ cur_msk));\n    }\n    return ret;\n}\n\nint main() {\n    scanf("%d", &n);\n    for (int i = 0; i < n; i++)\n        for (int j = 0; j < n; j++)\n            scanf("%d", &a[i][j]);\n\n    memset(dp, -1, sizeof dp);\n    for (int i = 0; i < (1 << n); i++) {\n        int idx = 0;\n        for (int j = 0; j < n; j++) {\n            if (i & (1 << j)) arr[idx++] = j;\n        }\n        value[i] = get_cost(idx);\n    }\n\n    printf("%lld\\n", solve((1 << n) - 1));\n}')"

