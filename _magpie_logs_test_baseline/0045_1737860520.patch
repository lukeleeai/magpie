LineLLMCrossover(('source.cpp', 10), '#include <iostream>\n#include <cstdio>\nusing namespace std;\n\n#define rep(i,a,n) for(int i=a;i<=n;i++)\n#define pb push_back\n#define SZ(x) ((int)(x).size())\n\ntypedef long long ll;\nchar s[4010];\n\ninline bool different(int j, int len) {\n    return s[j] != s[j + len] && s[j] != s[j + 2 * len] && s[j + len] != s[j + 2 * len];\n}\n\nint main() {\n    ll n, ans = 0, r = 0, g = 0, b = 0;\n\n    scanf("%lld", &n);\n    scanf("%s", s + 1);\n    for (int i = 1; i <= n; i++) {\n        r += (s[i] == \'R\');\n        g += (s[i] == \'G\');\n        b += (s[i] == \'B\');\n    }\n    ans = r * g * b;\n\n    for (int len = 1; len <= n; len++) {\n        for (int j = 1; j <= n - 2 * len; j++) {\n            if (different(j, len)) ans--;\n        }\n    }\n    printf("%lld\\n", ans);\n    return 0;\n}')
