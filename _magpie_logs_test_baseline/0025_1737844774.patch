LineLLMCrossover(('source.cpp', 9), '#include <cstdio>\n#include <algorithm>\n\nusing namespace std;\n\n#define ll long long\n\nconst ll inf = 0x3f3f3f3f;\nconst int maxn = 1e5 + 5;\nconst ll mod = 1e9 + 7;\n\ninline int my_min(int a, int b) { return a < b ? a : b; }\n\nint main() {\n    int k, x;\n    scanf("%d%d", &k, &x);\n    int t = my_min(x + k - 1, 1000000);\n    for (int i = max(x - k + 1, -1000000); i <= t; i++)\n        printf("%d%c", i, " \\n"[i == t]);\n    return 0;\n}')
