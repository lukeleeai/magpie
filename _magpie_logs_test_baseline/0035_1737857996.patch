LineLLMCrossover(('source.cpp', 9), '#include <cstdio>\nusing namespace std;\n\nint main() {\n    long long n, z = 0, r = 0, g = 0, b = 0;\n    scanf("%lld", &n);\n    char s[200005];\n    scanf("%s", s);\n\n    for (long long i = 0; i < n; i++) {\n        switch (s[i]) {\n            case \'R\':\n                z += g * b;\n                r++;\n                break;\n            case \'G\':\n                z += r * b;\n                g++;\n                break;\n            case \'B\':\n                z += r * g;\n                b++;\n                break;\n        }\n    }\n\n    for (long long o = 3; o - 1 < n; o += 2) {\n        for (long long i = o - 1; i < n; i++) {\n            if (s[i] != s[i - o + 1] && s[i - o + 1] != s[i - o / 2] && s[i - o / 2] != s[i])\n                z--;\n        }\n    }\n    printf("%lld\\n", z);\n    return 0;\n}')
