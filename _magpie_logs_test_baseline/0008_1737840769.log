ush_back(0); // Start with the first index\n\n    for (int i = 1; i < n; i++) {\n        l1[i] = l1[i - 1] + abs(l[i - 1] - l[i]);\n\n        // Remove indices from the deque that are out of the sliding window\n        while (!dq.empty() && dq.front() < i - k) {\n            dq.pop_front();\n        }\n\n        // The front of the deque holds the index of the minimum value for l1 in the current window\n        if (!dq.empty()) {\n            l1[i] = min(l1[i], l1[dq.front()] + abs(l[dq.front()] - l[i]));\n        }\n\n        // Maintain the deque to keep it sorted for minimum values\n        while (!dq.empty() && l1[dq.back()] >= l1[i]) {\n            dq.pop_back();\n        }\n\n        dq.push_back(i); // Add current index to the deque\n    }\n    cout << max(0ll, l1[n - 1]) << endl;\n}')"
