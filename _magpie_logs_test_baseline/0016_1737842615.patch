LineLLMMutation(('source.cpp', 9), '#include <iostream>\n#include <vector>\n#include <cstring>\nusing namespace std;\n\nconst int INF = 1e9 + 10;\n\nint n, k;\nvector<int> a, dp;\n\nint calc(int i) {\n    if (i >= n) return INF;\n    if (i == n - 1) return 0;\n\n    int &ret = dp[i];\n    if (ret != -1) return ret;\n\n    ret = INF;\n    for (int j = 1; j <= k; j++)\n        ret = min(calc(i + j) + abs(a[i] - a[i + j]), ret);\n\n    return ret;\n}\n\nint main() {\n    scanf("%d%d", &n, &k);\n    a.resize(n);\n    for (int i = 0; i < n; i++) {\n        scanf("%d", &a[i]);\n    }\n    dp.resize(n, -1);\n    printf("%d\\n", calc(0));\n    return 0;\n}') + LineLLMMutation(('source.cpp', 15), '#include <iostream>\n#include <vector>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\n\nconst int INF = 1e9 + 10;\n\nint n, k;\nvector<int> a, dp;\n\nint main() {\n    scanf("%d%d", &n, &k);\n    a.resize(n);\n    for (int i = 0; i < n; i++) {\n        scanf("%d", &a[i]);\n    }\n    \n    dp.resize(n, INF);\n    dp[n - 1] = 0; // Base case\n\n    for (int i = n - 2; i >= 0; i--) {\n        for (int j = 1; j <= k && i + j < n; j++) {\n            dp[i] = min(dp[i], dp[i + j] + abs(a[i] - a[i + j]));\n        }\n    }\n    \n    printf("%d\\n", dp[0]);\n    return 0;\n}') + LineLLMMutation(('source.cpp', 19), '#include <iostream>\n#include <vector>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\n\nconst int INF = 1e9 + 10;\n\nint n, k;\nvector<int> a, dp;\n\nint main() {\n    scanf("%d%d", &n, &k);\n    a.resize(n);\n    for (int i = 0; i < n; i++) {\n        scanf("%d", &a[i]);\n    }\n    \n    dp.resize(n);\n    dp[n - 1] = 0; // Base case\n\n    for (int i = n - 2; i >= 0; i--) {\n        int currentMin = INF;\n        for (int j = 1; j <= k && i + j < n; j++) {\n            currentMin = min(currentMin, dp[i + j] + abs(a[i] - a[i + j]));\n        }\n        dp[i] = currentMin;\n    }\n    \n    printf("%d\\n", dp[0]);\n    return 0;\n}')
