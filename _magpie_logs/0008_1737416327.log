.h"\n\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, k;\n    cin >> n >> k;\n\n    vector<int> l(n), l1(n);\n    for (int i = 0; i < n; i++) {\n        cin >> l[i];\n    }\n\n    for (int i = 1; i < n; i++) {\n        int lastAbsDiff = abs(l[i - 1] - l[i]);\n        l1[i] = l1[i - 1] + lastAbsDiff; // Directly using the last calculated absolute difference\n        \n        // Maintain a sliding window minimum for the previous k elements\n        int minValue = l1[i]; // Start with the current value\n        for (int j = 1; j <= min(i, k); j++) {\n            minValue = min(minValue, l1[i - j] + abs(l[i - j] - l[i]));\n        }\n        l1[i] = minValue; // Update l1[i] with the minimum value found\n    }\n\n    cout << max(0, l1[n - 1]) << endl;\n}')"
