LineLLMCrossover(('source.cpp', 12), '#include<cstdio>\n#include<algorithm>\nusing namespace std;\n\nfloat g[110][110], dp[110][110];\n\nint main(){\n\n    int n,m;\n\n    while(scanf("%d%d",&n,&m)&&(n||m)){\n\n        for(int i=0;i<n;i++)\n\n            for(int j=0;j<n;j++)\n\n                scanf("%f",&g[i][j]);\n\n        for(int i=0;i<=m;i++) // Changed this line to use a nested loop for clarity and speed.\n            for(int j=0;j<n;j++)\n\n                dp[i][j] = -1; // Initialize with -1.\n\n        for(int i=0;i<n;i++)\n\n            dp[1][i]=1.0;\n\n\n\n        for(int i=2;i<=m;i++)\n\n            for(int j=0;j<n;j++)\n\n                for(int k=0;k<n;k++)\n\n                    dp[i][j] = max(dp[i][j],dp[i-1][k]*g[k][j]);\n\n        float ans = -1;\n\n        for(int i=0;i<n;i++)\n\n            ans = max(ans,dp[m][i]);\n\n        printf("%.2f\\n",ans);\n\n    }\n\n}')
