LineLLMMutation(('source.cpp', 19), '#include <cstdio>\n\nusing namespace std;\n\nint main() {\n    long long int num1, num2, gcd, res, lcm;\n    while(scanf("%lld%lld", &num1, &num2) != EOF) {\n        res = num1 * num2;\n        \n        // Use the Euclidean algorithm with modulo for GCD\n        while(num2 != 0) {\n            long long int temp = num2;\n            num2 = num1 % num2;\n            num1 = temp;\n        }\n        \n        gcd = num1;\n        lcm = res / gcd;\n        printf("%lld %lld\\n", gcd, lcm);\n    }\n    return 0;\n}')
