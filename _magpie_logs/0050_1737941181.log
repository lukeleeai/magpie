2025-01-27 01:29:07,283	[DEBUG]	patch(3-2)="LineLLMMutation(('source.cpp', 25), '#include <cstdio>\n\n#include <algorithm>\n\nusing namespace std;\n\n#define rep(i,n) for(int i=0;i<(n);i++)\n\n\n\nint main(){\n\n    double g[110][110];\n\n    rep(i,110)rep(j,110)g[i][j]=-1;\n\n    int n,m;\n\n    while(scanf("%d%d",&n,&m)==2){\n\n        if(n==0&&m==0)break;\n\n        rep(i,n){\n\n            rep(j,n){\n\n                scanf("%lf",&g[i][j]);\n\n            }\n\n        }\n\n\n\n\n\n        double dp[110][110];\n\n        rep(i,110)rep(j,110)dp[i][j] = -1;\n\n        rep(i,n)dp[1][i]=1.0;\n\n\n\n        for(int i=2;i<=m;i++){\n\n            for(int j=0;j<n;j++){\n\n                for(int k=0;k<n;k++){\n\n                    dp[i][j] = max(dp[i][j],dp[i-1][k]*g[k][j]);\n\n                }\n\n            }\n\n        }\n\n        double ans = -1;\n\n        rep(i,n){\n\n            ans = max(ans,dp[m][i]);\n\n        }\n\n        printf("%.2lf\\n",ans);\n\n    }\n\n}')"
