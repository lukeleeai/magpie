2025-02-24 21:58:33,039	[DEBUG]	patch(3-6)="LineLLMCrossover(('source.cpp', 10), '#include <iostream>\n#include <algorithm>\nusing namespace std;\n\n#define rep(i,n) for(int i = 0 ; i < n ; i++)\nstruct P{int x,y;P(){}P(int a,int b){x = a , y = b;}};\n\nint operator -(P a, P b){\n    return abs(a.x - b.x) + abs(a.y - b.y);\n}\n\n#define INF (1<<21)\n\nint dp[1<<5][5][1000];\n\nint main(){\n    int width, height;\n    while(cin >> width >> height, width){\n        P start, goal;\n        P vertices[6][1000]; // Static array for fixed size\n        int count[6] = {0}; // To keep track of sizes of each vector\n\n        rep(i,height)rep(j,width){\n            char cell; cin >> cell;\n            if(cell == \'S\') start = P(j,i);\n            else if(cell == \'G\') goal = P(j,i);\n            else if(cell != \'.\') {\n                vertices[cell-\'1\'][count[cell-\'1\']++] = P(j,i); // Fill the static array\n            }\n        }\n\n        rep(i,1<<5)rep(k,5)rep(j,1000)dp[i][k][j] = INF;\n\n        // Optimized DP filling\n        rep(i,5)rep(j,count[(i+1)%5]){\n            dp[(1<<i) | (1<<((i+1)%5))][(i+1)%5][j] = start - vertices[(i+1)%5][j];\n        }\n\n        rep(bit,(1<<5)-1)rep(x,5){\n            int y = (x+1)%5;\n            rep(i,count[x]){\n                if( dp[bit][x][i] == INF ) break;\n                rep(j,count[y]){\n                    dp[bit|(1<<y)][y][j] = min( dp[bit|(1<<y)][y][j] , dp[bit][x][i] + (vertices[x][i]-vertices[y][j]) );\n                }\n            }\n        }\n\n        int answer = INF , choice = -1;\n        rep(i,5) rep(j,count[i]){\n            int cost = dp[(1<<5)-1][i][j] + (goal - vertices[i][j]);\n            int w = (i+1)%5;\n            if(answer >= cost){\n                if(answer == cost){\n                    choice = min(choice, w);\n                }else{\n                    choice = w;\n                    answer = cost;\n                }\n            }\n        }\n\n        if(answer == INF) cout << "NA" << endl;\n        else cout << choice+1 << " " << answer << endl;\n    }\n}')"
