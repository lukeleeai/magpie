\n#include <vector>\n#include <cstdio> // Using C-style input for performance\nusing namespace std;\n\n#define rep(i,n) for(int i = 0 ; i < n ; i++)\nstruct P{int x,y;P(){}P(int a,int b){x = a , y = b;}};\n\nint operator -(P a, P b){\n    return abs(a.x - b.x) + abs(a.y - b.y);\n}\n\nint dp[1<<5][5][1000];\n#define INF (1<<21)\n\nint main(){\n    int W,H;\n    while(scanf("%d %d", &W, &H), W){ // Using scanf for faster input\n        P s , g ;\n        P v[6][1000]; // Static array instead of vector\n        int count[6] = {0}; // To keep track of sizes of each vector\n\n        rep(i,H)rep(j,W){\n            char c; scanf(" %c", &c); // Using scanf for character input\n            if(c == \'S\') s = P(j,i);\n            else if(c == \'G\') g = P(j,i);\n            else if(c != \'.\') {\n                v[c-\'1\'][count[c-\'1\']++] = P(j,i); // Fill the static array\n            }\n        }\n\n        rep(i,1<<5)rep(k,5)rep(j,1000)dp[i][k][j] = INF;\n\n        rep(i,5)rep(j,count[(i+1)%5]){\n            dp[(1<<i) | (1<<((i+1)%5))][(i+1)%5][j] = s - v[(i+1)%5][j];\n        }\n\n        rep(bit,(1<<5)-1)rep(x,5){\n            int y = (x+1)%5;\n            rep(i,count[x]){\n                if( dp[bit][x][i] == INF ) break;\n                rep(j,count[y]){\n                    dp[bit|(1<<y)][y][j] = min( dp[bit|(1<<y)][y][j] , dp[bit][x][i] + (v[x][i]-v[y][j]) );\n                }\n            }\n        }\n\n        int ans = INF , cho = -1;\n        rep(i,5) rep( j , count[i] ){\n            int cst = dp[(1<<5)-1][i][j] + (g - v[i][j]);\n            int w = (i+1)%5;\n            if(ans >= cst){\n                if(ans == cst){\n                    cho = min(cho, w);\n                }else{\n                    cho = w;\n                    ans = cst;\n                }\n            }\n        }\n\n        if(ans == INF) cout << "NA" << endl;\n        else cout << cho+1 << " " << ans << endl;\n    }\n}') | LineLLMMutation(('source.cpp', 27), '#include <iostream>\n#include <algorithm>\n#include <cstdio> // Using C-style input for performance\nusing namespace std;\n\nstruct P { int x, y; P() {} P(int a, int b) : x(a), y(b) {} };\n\nint operator -(P a, P b) {\n    return abs(a.x - b.x) + abs(a.y - b.y);\n}\n\nconst int MAXN = 1000;\nP v[6][MAXN]; // Static array instead of vector\nint count[6] = { 0 }; // To keep track of sizes of each static array\n\nint main() {\n    int W, H;\n    while (scanf("%d %d", &W, &H), W) {\n        P s, g;\n        // Using a single loop to gather points\n        for (int i = 0; i < H; ++i) {\n            for (int j = 0; j < W; ++j) {\n                char c; \n                scanf(" %c", &c);\n                if (c == \'S\') s = P(j, i);\n                else if (c == \'G\') g = P(j, i);\n                else if (c != \'.\') {\n                    // Fill the static array\n                    v[c - \'1\'][count[c - \'1\']++] = P(j, i);\n                }\n            }\n        }\n\n        // Use a single array for dynamic programming to reduce space complexity\n        int dp[1 << 5][5] = { INF }; // Store minimum distances\n        for (int i = 0; i < (1 << 5); ++i) \n            fill(dp[i], dp[i] + 5, INF);\n\n        // Initialize starting positions\n        for (int i = 0; i < 5; ++i) {\n            for (int j = 0; j < count[(i + 1) % 5]; ++j) {\n                dp[(1 << i) | (1 << ((i + 1) % 5))][(i + 1) % 5] = s - v[(i + 1) % 5][j];\n            }\n        }\n\n        int ans = INF, cho = -1;\n        for (int i = 0; i < 5; ++i) {\n            for (int j = 0; j < count[i]; ++j) {\n                int cst = dp[(1 << 5) - 1][i] + (g - v[i][j]);\n                int w = (i + 1) % 5;\n                if (ans >= cst) {\n                    if (ans == cst) {\n                        cho = min(cho, w);\n                    } else {\n                        cho = w;\n                        ans = cst;\n                    }\n                }\n            }\n        }\n\n        if (ans == INF) co