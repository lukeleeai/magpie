2025-02-24 22:00:44,319	[DEBUG]	patch(4-8)="LineLLMCrossover(('source.cpp', 15), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\n#define rep(i,n) for(int i = 0; i < n; i++)\nstruct P { int x, y; P() {} P(int a, int b) { x = a, y = b; } };\n\nint operator-(P a, P b) {\n    return abs(a.x - b.x) + abs(a.y - b.y);\n}\n\n#define INF (1 << 21)\nint dp[1 << 5][5][1000];\n\nint main() {\n    int W, H;\n    while (scanf("%d %d", &W, &H), W) {\n        P s, g;\n        P v[6][1000]; // Static array instead of vector\n        int count[6] = {0}; // To keep track of sizes of each vector\n\n        rep(i, H) rep(j, W) {\n            char c; scanf(" %c", &c); // Using scanf for character input\n            if (c == \'S\') s = P(j, i);\n            else if (c == \'G\') g = P(j, i);\n            else if (c != \'.\') {\n                v[c - \'1\'][count[c - \'1\']++] = P(j, i); // Fill the static array\n            }\n        }\n\n        rep(i, 1 << 5) rep(k, 5) rep(j, 1000) dp[i][k][j] = INF;\n\n        rep(i, 5) rep(j, count[(i + 1) % 5]) {\n            dp[(1 << i) | (1 << ((i + 1) % 5))][(i + 1) % 5][j] = s - v[(i + 1) % 5][j];\n        }\n\n        rep(bit, (1 << 5) - 1) rep(x, 5) {\n            int y = (x + 1) % 5;\n            rep(i, count[x]) {\n                if (dp[bit][x][i] == INF) break;\n                rep(j, count[y]) {\n                    dp[bit | (1 << y)][y][j] = min(dp[bit | (1 << y)][y][j], dp[bit][x][i] + (v[x][i] - v[y][j]));\n                }\n            }\n        }\n\n        int ans = INF, cho = -1;\n        rep(i, 5) rep(j, count[i]) {\n            int cst = dp[(1 << 5) - 1][i][j] + (g - v[i][j]);\n            int w = (i + 1) % 5;\n            if (ans >= cst) {\n                if (ans == cst) {\n                    cho = min(cho, w);\n                } else {\n                    cho = w;\n                    ans = cst;\n                }\n            }\n        }\n\n        if (ans == INF) printf("NA\\n");\n        else printf("%d %d\\n", cho + 1, ans);\n    }\n}')"
