2025-02-24 21:58:37,541	[DEBUG]	patch(3-2)="LineLLMMutation(('source.cpp', 25), '#include <iostream>\n#include <vector>\n#include <algorithm>\n\nusing namespace std;\n\nstruct P {\n    int x, y;\n    P() : x(0), y(0) {}\n    P(int a, int b) : x(a), y(b) {}\n};\n\nint operator -(P a, P b) {\n    return abs(a.x - b.x) + abs(a.y - b.y);\n}\n\nint dp[1 << 5][5][1000];\n#define INF (1 << 21)\n\nint main() {\n    int W, H;\n\n    while (cin >> W >> H, W) {\n        P s, g;\n        vector<P> v[6];\n\n        for (int i = 0; i < H; i++) {\n            for (int j = 0; j < W; j++) {\n                char c;\n                cin >> c;\n                if (c == \'S\') s = P(j, i);\n                else if (c == \'G\') g = P(j, i);\n                else if (c != \'.\') v[c - \'1\'].emplace_back(P(j, i));\n            }\n        }\n\n        fill(&dp[0][0][0], &dp[0][0][0] + (1 << 5) * 5 * 1000, INF);\n\n        for (int i = 0; i < 5; i++) {\n            for (size_t j = 0; j < v[(i + 1) % 5].size(); j++) {\n                dp[(1 << i) | (1 << ((i + 1) % 5))][(i + 1) % 5][j] = s - v[(i + 1) % 5][j];\n            }\n        }\n\n        for (int bit = 0; bit < (1 << 5); bit++) {\n            for (int x = 0; x < 5; x++) {\n                int y = (x + 1) % 5;\n\n                for (size_t i = 0; i < v[x].size(); i++) {\n                    if (dp[bit][x][i] == INF) break;\n\n                    for (size_t j = 0; j < v[y].size(); j++) {\n                        dp[bit | (1 << y)][y][j] = min(dp[bit | (1 << y)][y][j], dp[bit][x][i] + (v[x][i] - v[y][j]));\n                    }\n                }\n            }\n        }\n\n        int ans = INF, cho = -1;\n\n        for (int i = 0; i < 5; i++) {\n            for (size_t j = 0; j < v[i].size(); j++) {\n                int cst = dp[(1 << 5) - 1][i][j] + (g - v[i][j]);\n                int w = (i + 1) % 5;\n\n                if (ans >= cst) {\n                    if (ans == cst) {\n                        cho = min(cho, w);\n                    } else {\n                        cho = w;\n                        ans = cst;\n                    }\n                }\n            }\n        }\n\n        if (ans == INF) cout << "NA" << endl;\n        else cout << cho + 1 << " " << ans << endl;\n    }\n}')"
