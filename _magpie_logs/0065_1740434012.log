2025-02-24 21:55:26,810	[DEBUG]	patch(1-7)="LineLLMMutation(('source.cpp', 12), '#include <iostream>\n#include <algorithm>\n#include <vector>\nusing namespace std;\n\n#define rep(i,n) for(int i = 0 ; i < n ; i++)\nstruct P{int x,y;P(){}P(int a,int b){x = a , y = b;}};\n\nint manhattanDistance(P a, P b) {\n    return (a.x > b.x ? a.x - b.x : b.x - a.x) + (a.y > b.y ? a.y - b.y : b.y - a.y);\n}\n\nint dp[1<<5][5][1000];\n#define INF (1<<21)\n\nint main(){\n    int W,H;\n    while(cin >> W >> H , W){\n        P s , g ;\n        vector<P> v[6];\n\n        rep(i,H)rep(j,W){\n            char c; cin >> c;\n            if(c == \'S\') s = P(j,i);\n            else if(c == \'G\') g = P(j,i);\n            else if(c != \'.\') v[c-\'1\'].push_back(P(j,i));\n        }\n\n        rep(i,1<<5)rep(k,5)rep(j,1000)dp[i][k][j] = INF;\n\n        rep(i,5)rep(j,v[(i+1)%5].size()){\n            dp[(1<<i) | (1<<((i+1)%5))][(i+1)%5][j] = manhattanDistance(s, v[(i+1)%5][j]);\n        }\n\n        rep(bit,(1<<5)-1)rep(x,5){\n            int y = (x+1)%5;\n            rep(i,v[x].size()){\n                if( dp[bit][x][i] == INF ) break;\n                rep(j,v[y].size()){\n                    dp[bit|(1<<y)][y][j] = min( dp[bit|(1<<y)][y][j] , dp[bit][x][i] + (manhattanDistance(v[x][i], v[y][j])) );\n                }\n            }\n        }\n\n        int ans = INF , cho = -1;\n        rep(i,5) rep( j , v[i].size() ){\n            int cst = dp[(1<<5)-1][i][j] + manhattanDistance(g, v[i][j]);\n            int w = (i+1)%5;\n            if(ans >= cst){\n                if(ans == cst){\n                    cho = min(cho, w);\n                }else{\n                    cho = w;\n                    ans = cst;\n                }\n            }\n        }\n\n        if(ans == INF) cout << "NA" << endl;\n        else cout << cho+1 << " " << ans << endl;\n    }\n}')"
