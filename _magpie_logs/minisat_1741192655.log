test_timeout = 
test_lengthout = 
run_cmd = bash run_fixed.sh
run_timeout = 
run_lengthout = 
batch_timeout = 
batch_lengthout = 
batch_bin_fitness_strategy = aggregate
batch_fitness_strategy = sum
fitness = time
retries = 1

[srcml]
