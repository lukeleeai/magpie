LineLLMCrossover(('source.cpp', 34), '#include <iostream>\n#include <vector>\n#include <limits>\n\nusing namespace std;\n\nint n;\nvector<pair<int, int>> items; // Pair of weight and strength\nvector<int> bestIndex;\nint bestG;\n\nvoid solve(int k, int usedMask, vector<int>& index, int g, int sumW) {\n    if (k == n) {\n        if (g < bestG) {\n            bestG = g;\n            bestIndex = index;\n        }\n        return;\n    }\n    for (int i = 0; i < n; ++i) {\n        if (usedMask & (1 << i)) continue; // Check if the item is already used\n        if (items[i].second >= sumW) {\n            index[k] = i;\n            solve(k + 1, usedMask | (1 << i), index, g + (n - k) * items[i].first, sumW + items[i].first);\n        }\n    }\n}\n\nint main() {\n    for (;;) {\n        cin >> n;\n        if (n == 0) return 0;\n\n        items.resize(n);\n        vector<string> name(n);\n        for (int i = 0; i < n; ++i)\n            cin >> name[i] >> items[i].first >> items[i].second;\n\n        bestG = numeric_limits<int>::max(); // Using numeric_limits for clarity\n        vector<int> index(n);\n        solve(0, 0, index, 0, 0);\n        for (int i = n - 1; i >= 0; --i)\n            cout << name[bestIndex[i]] << endl;\n    }\n}')
