LineLLMCrossover(('source.cpp', 25), '#include <cstdio>\n#include <cfloat>\n#include <cstring>\n#include <array>\nusing namespace std;\n\narray<char[21], 10> f;\narray<int, 10> w, s, a, b;\nint n;\ndouble maxg;\n\nvoid dfs(int x, int tw, int m, double g, bool u[10]) {\n    if (m == n) {\n        if (maxg < g) {\n            maxg = g;\n            memcpy(b.data(), a.data(), sizeof(int) * n);\n        }\n        return;\n    }\n    if (x >= n) return;\n\n    if (!u[x] && tw <= s[x]) {\n        u[x] = true;\n        tw += w[x];\n        a[m] = x;\n        dfs(0, tw, m + 1, g + w[x] * (m + 1), u);\n        tw -= w[x];\n        u[x] = false;\n    }\n    dfs(x + 1, tw, m, g, u);\n}\n\nint main() {\n    while (scanf("%d", &n) && n != 0) {\n        for (int i = 0; i < n; i++) {\n            scanf("%s %d %d", f[i], &w[i], &s[i]);\n        }\n        bool u[10] = {false};\n        maxg = -DBL_MAX;\n        dfs(0, 0, 0, 0., u);\n        for (int i = n - 1; i >= 0; i--) {\n            printf("%s\\n", f[b[i]]);\n        }\n    }\n    return 0;\n}') + LineLLMMutation(('source.cpp', 41), '#include <cstdio>\n#include <cfloat>\n#include <cstring>\n#include <array>\n#include <bitset> // Using bitset instead of bool array for space efficiency\nusing namespace std;\n\narray<char[21], 10> f;\narray<int, 10> w, s, a, b;\nint n;\ndouble maxg;\n\nvoid dfs(int x, int tw, int m, double g, bitset<10>& u) { // Change to bitset\n    if (m == n) {\n        if (maxg < g) {\n            maxg = g;\n            memcpy(b.data(), a.data(), sizeof(int) * n);\n        }\n        return;\n    }\n    if (x >= n) return;\n\n    if (!u[x] && tw <= s[x]) {\n        u[x] = true;\n        tw += w[x];\n        a[m] = x;\n        dfs(0, tw, m + 1, g + w[x] * (m + 1), u);\n        tw -= w[x];\n        u[x] = false;\n    }\n    dfs(x + 1, tw, m, g, u);\n}\n\nint main() {\n    while (scanf("%d", &n) && n != 0) {\n        for (int i = 0; i < n; i++) {\n            scanf("%s %d %d", f[i], &w[i], &s[i]);\n        }\n        bitset<10> u; // Initialize bitset\n        maxg = -DBL_MAX;\n        dfs(0, 0, 0, 0., u);\n        for (int i = n - 1; i >= 0; i--) {\n            printf("%s\\n", f[b[i]]);\n        }\n    }\n    return 0;\n}')
