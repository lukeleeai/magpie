#define ll long long\n#define mx 100005\n#define inf 100000000000000000LL\n\nll arr[mx], dp[mx];\nint n, k;\n\nvoid solve() {\n    dp[n] = 0; \n    deque<ll> window; // Deque to maintain the sliding window minimum\n    for (int pos = n - 1; pos >= 0; pos--) {\n        // Remove elements that are out of the current sliding window\n        if (!window.empty() && window.front() > pos + k) {\n            window.pop_front();\n        }\n        \n        // Calculate the minimum value from the sliding window\n        if (!window.empty()) {\n            dp[pos] = llabs(arr[pos] - arr[window.front()]) + dp[window.front()];\n        } else {\n            dp[pos] = inf; // If the window is empty, set dp[pos] to inf\n        }\n\n        // Maintain the deque: remove elements from the back that are not useful\n        while (!window.empty() && dp[window.back()] >= dp[pos]) {\n            window.pop_back();\n        }\n        window.push_back(pos); // Add the current position to the deque\n    }\n}\n\nint main() {\n    while (scanf("%d%d", &n, &k)) {\n        for (int i = 1; i <= n; i++)\n            scanf("%lld", &arr[i]);\n        std::fill(dp, dp + n + 1, inf); // Use std::fill for initialization\n        solve();\n        printf("%lld\\n", dp[1]);\n        return 0;\n    }\n}')"
