2025-01-20 22:35:24,989	[DEBUG]	patch(5-18)="LineLLMCrossover(('source.cpp', 35), '#include <vector>\n#include <iostream>\n#include <cstring>\n#include <algorithm>\n\nusing namespace std;\n\n#define ll long long\n#define mx 100005\n#define inf 100000000000000000LL\n\nll arr[mx], dp[mx];\nint n, k;\n\nll solve(int pos) {\n    if (pos >= n) return 0;\n    ll& ret = dp[pos] == -1 ? (dp[pos] = inf) : dp[pos]; // Conditional initialization\n    for (int i = 1; i <= k; i++) {\n        int nxt = pos + i;\n        if (nxt > n) break;\n        ret = min(ret, llabs(arr[pos] - arr[nxt]) + solve(nxt));\n    }\n    return ret;\n}\n\nint main() {\n    while (scanf("%d%d", &n, &k)) {\n        for (int i = 1; i <= n; i++)\n            scanf("%lld", &arr[i]);\n        fill(dp, dp + mx, inf); // Initialization of dp array\n        printf("%lld\\n", solve(1));\n        return 0;\n    }\n}')"
