2025-01-20 22:27:40,464	[DEBUG]	patch(0-20)="LineLLMMutation(('source.cpp', 19), '#include <array>\n#include <iostream>\n#include <cstring>\n#include <algorithm>\n#include <queue>\n\nusing namespace std;\n\n#define ll long long\n#define mx 100005\n#define inf 100000000000000000LL\n\narray<ll, mx> arr;\narray<ll, mx> dp = {};\nint n, k;\n\nvoid resetDP() {\n    fill(dp.begin(), dp.end(), -1);\n}\n\nll solve(int pos) {\n    if (pos == n) return 0;\n    ll& ret = dp[pos];\n    if (dp[pos] != -1) return ret;\n    ret = inf;\n\n    priority_queue<pair<ll, int>, vector<pair<ll, int>>, greater<pair<ll, int>>> pq; // Min-heap\n    pq.push({0, pos});\n\n    while (!pq.empty()) {\n        auto [currCost, currPos] = pq.top();\n        pq.pop();\n\n        if (currPos == n) return currCost;\n\n        for (int i = 1; i <= k; i++) {\n            int nxt = currPos + i;\n            if (nxt > n) break;\n            ll newCost = currCost + (arr[currPos] - arr[nxt]);\n            pq.push({newCost, nxt});\n        }\n    }\n\n    return ret;\n}\n\nint main() {\n    //fast;\n    do {\n        if (!(cin >> n >> k) || n < 0 || k < 0) break;\n        for (int i = 1; i <= n; i++)\n            cin >> arr[i];\n        resetDP();\n        cout << solve(1) << endl;\n    } while (true);\n}')"
