LineLLMMutation(('source.cpp', 4), '#include <iostream>\n#include <cstdio>\n#include <algorithm>\n\nusing namespace std;\n\nint main()\n{\n    long long int num1, num2, gcd, res, lcm;\n    while(scanf("%lld%lld", &num1, &num2) != EOF)\n    {\n        res = num1 * num2;\n        do\n        {\n            if(num1 > num2)\n                num1 -= num2;\n            else\n                num2 -= num1;\n        } while(num1 != num2);\n        gcd = num1;\n        lcm = res / gcd;\n        printf("%lld %lld\\n", gcd, lcm);\n    }\n    return 0;\n}')
