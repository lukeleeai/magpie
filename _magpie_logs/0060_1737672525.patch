LineLLMCrossover(('source.cpp', 34), '#include <iostream>\nusing namespace std;\n\nconst long long int t[8] = { 0, 1, 2, 3, 5, 7, 8, 9 };\n\nlong long int solve(int n) {\n    long long int s = 0;\n    long long int base = 1; \n    while (n > 0) {\n        s += (long long int)t[n & 7] * base; \n        base *= 10; // Improved base calculation\n        n >>= 3; \n    }\n    return s;\n}\n\nint main() {\n    int n;\n    while (cin >> n && n) {\n        cout << solve(n) << endl;\n    }\n}')
