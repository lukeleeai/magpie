LineLLMCrossover(('source.cpp', 31), '#include <cstdio>\n#include <array>\nusing namespace std;\n\n#define reep(i,f,t) for(int i=f ; i<int(t) ; ++i)\n#define rep(i,n) reep(i, 0, n)\n\nconst int MAXN = 1000; // Assuming a maximum possible size\nint main() {\n    int n;\n    while(scanf("%d", &n), n) {\n        array<bool, MAXN> nums; // Declare the array without default initialization\n        nums.fill(false); // Explicitly set all elements to false\n\n        reep(i, 1, n)\n            nums[(i*i) % n] = true; // Efficiently mark indices\n\n        for (int i = 1; i < (n + 1) / 2; ++i) {\n            int sum = 0;\n            rep(j, n) {\n                sum += nums[j] && nums[(j + i) % n]; // Count matches directly\n            }\n            printf("%d\\n", sum * 2); // Output the result\n        }\n    }\n    return 0;\n}')
