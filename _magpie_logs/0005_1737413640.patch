LineLLMCrossover(('source.cpp', 62), '#include "stdc++.h"\n\nusing namespace std;\n\nconst int MAXN = 1000000;\narray<int, MAXN + 1> A = {}; // Using std::array for improved performance\n\nint f(int n) {\n    return (n % 2 == 0) ? (n / 2) : (3 * n + 1); // Using modulo for clarity\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(0);\n    int s, count = 1;\n    cin >> s;\n\n    A[s] += 1; // Start counting directly\n    while (s <= MAXN) { // Reduce checks by moving the condition to the while loop\n        s = f(s);\n        count++;\n        if (A[s] != 0) {\n            cout << count << \'\\n\';\n            break;\n        }\n        ++A[s]; // Using pre-increment for potential optimization\n    }\n    return 0;\n}')
