LineLLMCrossover(('source.cpp', 9), '#include <iostream>\n#include <cmath>\nusing namespace std;\n\nvoid problemOne() {\n    int a, b;\n    int lengthArray[200] = {}; // Pre-calculate lengths of sums from 0 to 199\n    for (int i = 0; i < 200; i++) lengthArray[i] = (i == 0) ? 1 : (i < 10) ? 1 : (i < 100) ? 2 : 3;\n\n    while (cin >> a >> b) {\n        int sum = a + b;\n        if (sum < 200) {\n            cout << lengthArray[sum] << endl; // Fast lookup for small sums\n        } else {\n            int intLength = 0;\n            int temp = sum;\n            while (temp != 0) {\n                temp /= 10;\n                intLength += 1;\n            }\n            cout << intLength << endl; // Directly calculate length for larger sums\n        }\n    }\n}\n\nint main() {\n    problemOne();\n}')
