LineLLMCrossover(('source.cpp', 8), '#include <stdio.h>\n\nint masu[102][102], ice[102][102], n, m, mx; // Increased size for safety\n\nvoid initializeMasu() {\n    for (int i = 1; i <= n; i++) {\n        for (int j = 1; j <= m; j++) {\n            masu[i][j] = ice[i][j]; // Populate masu from ice\n        }\n    }\n}\n\nvoid func(int x, int y, int now) {\n    if (masu[x][y] != 1) return; // Early return if not traversable\n    masu[x][y] = 0; // Mark as visited\n    mx = mx > now ? mx : now; // Update max path length\n\n    func(x + 1, y, now + 1);\n    func(x - 1, y, now + 1);\n    func(x, y + 1, now + 1);\n    func(x, y - 1, now + 1);\n\n    masu[x][y] = 1; // Unmark when backtracking\n}\n\nint main(void) {\n    while (scanf("%d%d", &m, &n), n, m) {\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j <= m; j++) {\n                scanf("%d", &ice[i][j]);\n            }\n        }\n\n        initializeMasu(); // Initialize masu from ice\n\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j <= m; j++) {\n                if (masu[i][j] == 1) {\n                    func(i, j, 1);\n                }\n            }\n        }\n\n        printf("%d\\n", mx);\n        mx = 0; // Reset for the next case\n    }\n\n    return 0;\n}') + LineLLMMutation(('source.cpp', 34), '#include <stdio.h>\n\nint masu[102][102], ice[102][102], n, m, mx; // Increased size for safety\n\nvoid initializeMasu() {\n    for (int i = 1; i <= n; i++) {\n        for (int j = 1; j <= m; j++) {\n            masu[i][j] = ice[i][j]; // Populate masu from ice\n        }\n    }\n}\n\nvoid func(int x, int y, int now) {\n    if (masu[x][y] != 1) return; // Early return if not traversable\n    masu[x][y] = 0; // Mark as visited\n    mx = mx > now ? mx : now; // Update max path length\n\n    func(x + 1, y, now + 1);\n    func(x - 1, y, now + 1);\n    func(x, y + 1, now + 1);\n    func(x, y - 1, now + 1);\n\n    masu[x][y] = 1; // Unmark when backtracking\n}\n\nint main(vo