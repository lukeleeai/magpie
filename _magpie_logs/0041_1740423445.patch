LineLLMCrossover(('source.cpp', 13), '#include <cstdio>\n#include <vector>\n#include <limits>\nusing namespace std;\n\nint main() {\n    int n;\n    while (scanf("%d", &n), n) {\n        vector<int> h(n), r(n);\n        for (int i = 0; i < n; ++i) {\n            scanf("%d%d", &h[i], &r[i]);\n        }\n        int M; scanf("%d", &M);\n        h.reserve(n + M);\n        r.reserve(n + M);\n        for (int i = 0; i < M; ++i) {\n            scanf("%d%d", &h[n + i], &r[n + i]);\n        }\n        n += M;\n\n        int m[200][200] = {0};\n        for (int i = 0; i < n; ++i) {\n            for (int j = 0; j < n; ++j) {\n                if (h[i] < h[j] && r[i] < r[j]) {\n                    m[i][j] = -1;\n                }\n            }\n        }\n\n        int ans = numeric_limits<int>::max();\n        for (int k = 0; k < n; ++k) \n            for (int i = 0; i < n; ++i) \n                for (int j = 0; j < n; ++j) {\n                    if (m[i][k] != 0 && m[k][j] != 0) {\n                        m[i][j] = min(m[i][j], m[i][k] + m[k][j]);\n                    }\n                    ans = min(ans, m[i][j]);\n                }\n\n        printf("%d\\n", -ans + 1);\n    }\n}')
