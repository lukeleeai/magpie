2025-01-25 02:08:15,835	[DEBUG]	patch(7-4)="LineLLMCrossover(('source.cpp', 25), '#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <numeric>\nusing namespace std;\n\nint main() {\n    int n, m, h, k;\n    while (cin >> n >> m >> h >> k && n + m + h + k) {\n        vector<int> a(n);\n        for (int &x : a) cin >> x;\n\n        vector<pair<int, int>> b(m);\n        for (int i = 0; i < m; i++) {\n            cin >> b[i].second >> b[i].first;  // Efficient input\n        }\n\n        sort(b.begin(), b.end());\n        vector<int> c(n);\n        iota(c.begin(), c.end(), 0);\n\n        // Improved swapping logic for safety and clarity\n        for (auto &pair : b) {\n            if(pair.second - 1 >= 0 && pair.second < n) {\n                int idx1 = pair.second - 1;\n                int idx2 = pair.second;\n                swap(c[idx1], c[idx2]);\n                pair = {c[idx2], c[idx1]};\n            }\n        }\n\n        vector<pair<int, int>> d(n);\n        for (int i = 0; i < n; i++) d[i] = {c[i], a[i]};\n\n        sort(d.begin(), d.end());\n        int sm = accumulate(d.begin(), d.begin() + k, 0, [](int sum, pair<int, int> p) { return sum + p.second; });\n\n        int mn = sm;\n        for (auto &pair : b) {\n            if (pair.first < k && pair.second >= k) {\n                if (d[pair.first].second > d[pair.second].second)\n                    mn = min(mn, sm - d[pair.first].second + d[pair.second].second);\n            }\n            if (pair.first >= k && pair.second < k) {\n                if (d[pair.first].second < d[pair.second].second)\n                    mn = min(mn, sm + d[pair.first].second - d[pair.second].second);\n            }\n        }\n        cout << mn << endl;\n    }\n    return 0;\n}')"
