2025-01-25 02:12:07,702	[DEBUG]	patch(9-5)="LineLLMCrossover(('source.cpp', 34), '#include <cstdio>\n#include <vector>\n#include <algorithm>\n#include <numeric>\nusing namespace std;\n\nint main() {\n    int n, m, h, k;\n    while (scanf("%d %d %d %d", &n, &m, &h, &k) == 4 && n + m + h + k) {\n        vector<int> a(n);\n        for (int &x : a) scanf("%d", &x);\n\n        vector<tuple<int, int>> b(m);\n        for (int i = 0; i < m; i++) {\n            scanf("%d %d", &get<1>(b[i]), &get<0>(b[i]));  // Streamlined input\n        }\n\n        sort(b.begin(), b.end());\n        vector<int> c(n);\n        iota(c.begin(), c.end(), 0);\n\n        for (auto &pair : b) {\n            if(get<1>(pair) - 1 >= 0 && get<1>(pair) < n) {\n                int idx1 = get<1>(pair) - 1;\n                int idx2 = get<1>(pair);\n                swap(c[idx1], c[idx2]);\n                pair = {c[idx2], c[idx1]};\n            }\n        }\n\n        vector<pair<int, int>> d(n);\n        for (int i = 0; i < n; i++) d[i] = {c[i], a[i]};\n\n        sort(d.begin(), d.end());\n        int sm = accumulate(d.begin(), d.begin() + k, 0, [](int sum, pair<int, int> p) { return sum + p.second; });\n\n        int mn = sm;\n        for (auto &pair : b) {\n            if (get<0>(pair) < k && get<1>(pair) >= k) {\n                if (d[get<0>(pair)].second > d[get<1>(pair)].second)\n                    mn = min(mn, sm - d[get<0>(pair)].second + d[get<1>(pair)].second);\n            }\n            if (get<0>(pair) >= k && get<1>(pair) < k) {\n                if (d[get<0>(pair)].second < d[get<1>(pair)].second)\n                    mn = min(mn, sm + d[get<0>(pair)].second - d[get<1>(pair)].second);\n            }\n        }\n        printf("%d\\n", mn);\n    }\n    return 0;\n}')"
