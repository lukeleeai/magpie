2025-01-25 01:58:11,837	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include <cstdio>\n#include <algorithm>\n#include <cstring>\nusing namespace std;\n\nint main() {\n    int i, n, m, h, k;\n    while (scanf("%d%d%d%d", &n, &m, &h, &k) && n + m + h + k) {\n        int a[1000];\n        for (i = 0; i < n; i++)\n            scanf("%d", &a[i]);\n\n        pair<int, int> b[100000];\n        for (i = 0; i < m; i++) {\n            int p, q;\n            scanf("%d%d", &p, &q);\n            b[i] = make_pair(q, p);\n        }\n\n        sort(b, b + m);\n        int c[1000];\n        for (i = 0; i < n; i++)\n            c[i] = i;\n\n        for (i = 0; i < m; i++) {\n            int p;\n            p = c[b[i].second - 1];\n            c[b[i].second - 1] = c[b[i].second];\n            c[b[i].second] = p;\n            b[i] = make_pair(c[b[i].second], c[b[i].second - 1]);\n        }\n\n        pair<int, int> d[1000];\n        for (i = 0; i < n; i++)\n            d[i] = make_pair(c[i], a[i]);\n\n        sort(d, d + n);\n        int sm = 0;\n        for (i = 0; i < k; i++)\n            sm += d[i].second;\n\n        int mn = sm;\n        for (i = 0; i < m; i++) {\n            if (b[i].first < k && b[i].second >= k) {\n                if (d[b[i].first].second > d[b[i].second].second)\n                    mn = min(mn, sm - d[b[i].first].second + d[b[i].second].second);\n            }\n            if (b[i].first >= k && b[i].second < k) {\n                if (d[b[i].first].second < d[b[i].second].second)\n                    mn = min(mn, sm + d[b[i].first].second - d[b[i].second].second);\n            }\n        }\n        printf("%d\\n", mn);\n    }\n    return 0;\n}')"

