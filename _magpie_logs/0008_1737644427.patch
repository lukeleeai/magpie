LineLLMCrossover(('source.cpp', 19), '#include <iostream>\n#include <vector>\n#include <algorithm>\nusing namespace std;\n\nint main() {\n    int b;\n    while (cin >> b) {\n        if (b == 0) break;\n\n        vector<int> v(b);\n        for (int &val : v) {\n            cin >> val;\n        }\n\n        int max_sum = 0;\n        int current_sum = 0;\n        for (int i : v) {\n            current_sum = max(0, current_sum + i);\n            max_sum = max(max_sum, current_sum);\n        }\n        cout << max_sum << endl;\n    }\n}') + LineLLMMutation(('source.cpp', 32), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\nint main() {\n    int b;\n    while (scanf("%d", &b) && b != 0) {\n        int max_sum = 0, current_sum = 0;\n        for (int i = 0; i < b; ++i) {\n            int val;\n            scanf("%d", &val);\n            current_sum = max(0, current_sum + val);\n            max_sum = max(max_sum, current_sum);\n        }\n        printf("%d\\n", max_sum);\n    }\n}') + LineLLMMutation(('source.cpp', 39), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\nint main() {\n    int b;\n    while (scanf("%d", &b) && b != 0) {\n        int max_sum = 0, current_sum = 0;\n        for (int i = 0; i < b; ++i) {\n            int val;\n            // Using scanf directly for input, but we can optimize by reading all at once if b is known.\n            scanf("%d", &val);\n            current_sum = max(0, current_sum + val);\n            max_sum = max(max_sum, current_sum);\n        }\n        printf("%d\\n", max_sum);\n    }\n}')
