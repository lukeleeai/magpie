LineLLMMutation(('source.cpp', 2), '#include <iostream>\n#include <cstdio>\nusing namespace std;\n\n#define rep(i,n) for(int i=0;i<(n);i++)\n\nint main() {\n    int weight;\n    int n, v, w, c = 0;\n    int dp[1001][1001];\n\n    while(scanf("%d\\n", &weight) && weight) {\n        c++;\n        rep(i, 1001) rep(j, 1001) dp[i][j] = 0;\n\n        scanf("%d\\n", &n);\n\n        for(int k = 1; k <= n; k++) {\n            scanf("%d,%d\\n", &v, &w);\n            for(int i = 0; i < w; i++) {\n                dp[k][i] = dp[k-1][i];  // No change for i < w\n            }\n            for(int i = w; i <= weight; i++) {\n                dp[k][i] = max(dp[k-1][i], dp[k-1][i-w] + v);\n            }\n        }\n\n        printf("Case %d:\\n", c);\n        printf("%d\\n", dp[n][weight]);\n        for(int i = 0; i <= weight; i++) {\n            if(dp[n][i] == dp[n][weight]) {\n                printf("%d\\n", i);\n                break;\n            }\n        }\n    }\n}') + LineLLMMutation(('source.cpp', 10), '#include <iostream>\n#include <cstdio>\nusing namespace std;\n\n#define rep(i,n) for(int i=0;i<(n);i++)\n\nint main() {\n    int weight;\n    int n, v, w, c = 0;\n    int dp[1001];\n\n    while(scanf("%d\\n", &weight) && weight) {\n        c++;\n        fill(dp, dp + 1001, 0);  // Efficiently initialize dp array to 0\n\n        scanf("%d\\n", &n);\n\n        for(int k = 1; k <= n; k++) {\n            scanf("%d,%d\\n", &v, &w);\n            for(int i = weight; i >= w; i--) {\n                dp[i] = max(dp[i], dp[i - w] + v);  // Update in reverse to avoid overwriting\n            }\n        }\n\n        printf("Case %d:\\n", c);\n        printf("%d\\n", dp[weight]);\n        for(int i = 0; i <= weight; i++) {\n            if(dp[i] == dp[weight]) {\n                printf("%d\\n", i);\n                break;\n            }\n        }\n    }\n}') + LineLLMMutation(('source.cpp', 20), '#include <iostream>\n#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\n#define rep(i,n) for(int i=0;i<(n);i++)\n\nint main() {\n    int weight;\n    int n, v, w, c = 0;\n    int dp[1001];\n\n    while(scanf("%d", &weight) && weight) {\n        c++;\n        fill(dp, dp + 1001, 0);  // Efficiently initialize dp array to 0\n\n        scanf("%d", &n);\n\n        for(int k = 1; k <= n; k++) {\n            // Combined input reading for v and w\n            scanf("%d,%d", &v, &w);  \n            for(int i = weight; i >= w; i--) {\n                dp[i] = max(dp[i], dp[i - w] + v);  // Update in reverse to avoid overwriting\n            }\n        }\n\n        printf("Case %d:\\n", c);\n        printf("%d\\n", dp[weight]);\n        for(int i = 0; i <= weight; i++) {\n            if(dp[i] == dp[weight]) {\n                printf("%d\\n", i);\n                break;\n            }\n        }\n    }\n}')
