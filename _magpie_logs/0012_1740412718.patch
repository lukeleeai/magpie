LineLLMCrossover(('source.cpp', 7), '#include <cstdio>\n#include <string>\n#include <algorithm>\n#define loop(i,a,b) for(int i=a;i<b;i++)\n#define rep(i,a) loop(i,0,a)\nusing namespace std;\n\nint main() {\n    int n;\n    scanf("%d", &n);\n    getchar(); // Consume newline\n    rep(i, n) {\n        char s[1000];\n        scanf("%[^\\n]", s); // Read until newline\n        \n        string ans;\n        bool found = false;\n        rep(a, 27) {\n            rep(b, 27) {\n                string tmp(s); // Copy the input string\n                for (char &c : tmp) {\n                    if (isalpha(c)) {\n                        c = (a * (c - \'a\') + b) % 26 + \'a\';\n                    }\n                }\n                \n                // Check for keywords\n                if (tmp.find("this") != string::npos || tmp.find("that") != string::npos) {\n                    ans = tmp;\n                    found = true;\n                    break;\n                }\n            }\n            if (found) break;\n        }\n        printf("%s\\n", ans.c_str());\n    }\n}')
