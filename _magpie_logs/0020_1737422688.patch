LineLLMCrossover(('source.cpp', 21), '#include <iostream>\n#include <vector>\n#include <cmath>\n\nusing namespace std;\n\nint n;\nint k;\nvector<int> arr(100004, 0);\nvector<int> memo(100004, -1);\n\nint cost() {\n    fill(memo.begin(), memo.begin() + n, -1); // Clear memoization array\n    for (int i = n - 1; i >= 0; --i) {\n        if (i >= n - 1) {\n            memo[i] = 0;\n        } else if (i == n - 2) {\n            memo[i] = abs(arr[n - 2] - arr[n - 1]);\n        } else {\n            for (int j = 1; j <= k; ++j) {\n                if (i + j > n - 1) break;\n                int temp = abs(arr[i + j] - arr[i]) + memo[i + j];\n                memo[i] = (memo[i] == -1) ? temp : min(memo[i], temp);\n            }\n        }\n    }\n    return memo[0];\n}\n\nint main() {\n    cin >> n >> k;\n    if(n <= 0 || k <= 0) {\n        cout << "Invalid input." << endl;\n        return 1;\n    }\n    for (int i = 0; i < n; ++i) cin >> arr[i];\n    cout << cost() << endl;\n    return 0;\n}') + LineLLMMutation(('source.cpp', 35), '#include <iostream>\n#include <vector>\n#include <cmath>\n#include <limits>\n\nusing namespace std;\n\nint n;\nint k;\nvector<int> arr(100004, 0);\nvector<int> memo(100004, numeric_limits<int>::max()); // Use max for initial values\n\nint cost() {\n    fill(memo.begin(), memo.begin() + n, numeric_limits<int>::max()); // Clear memoization array\n    memo[n - 1] = 0; // Base case for the last element\n    for (int i = n - 2; i >= 0; --i) {\n        for (int j = 1; j <= k; ++j) {\n            if (i + j >= n) break;\n            int temp = abs(arr[i + j] - arr[i]) + memo[i + j];\n            memo[i] = min(memo[i], temp);\n        }\n    }\n    return memo[0];\n}\n\nint main() {\n    cin >> n >> k;\n    if(n <= 0 || k <= 0) {\n        cout << "Invalid input." << endl;\n        return 1;\n    }\n    for (int i = 0; i < n; ++i) cin >> arr[i];\n    cout << cost() << endl;\n    return 0;\n}') + LineLLMMutation(('source.cpp', 43), '#include <iostream>\n#include <vector>\n#include <cmath>\n#include <limits>\n\nusing namespace std;\n\nint n;\nint k;\nvector<int> arr(100004, 0);\nvector<int> memo(100004, numeric_limits<int>::max()); // Use max for initial values\n\nint cost() {\n    fill(memo.begin(), memo.begin() + n, numeric_limits<int>::max()); // Clear memoization array\n    memo[n - 1] = 0; // Base case for the last element\n    for (int i = n - 2; i >= 0; --i) {\n        for (int j = 1; j <= k && i + j < n; ++j) { // Combine condition to reduce iterations\n            int temp = abs(arr[i + j] - arr[i]) + memo[i + j];\n            memo[i] = min(memo[i], temp);\n        }\n    }\n    return memo[0];\n}\n\nint main() {\n    cin >> n >> k;\n    if(n <= 0 || k <= 0) {\n        cout << "Invalid input." << endl;\n        return 1;\n    }\n    for (int i = 0; i < n; ++i) cin >> arr[i];\n    cout << cost() << endl;\n    return 0;\n}') + LineLLMMutation(('source.cpp', 74), '#include <iostream>\n#include <vector>\n#include <cmath>\n#include <limits>\n\nusing namespace std;\n\nint n;\nint k;\nvector<int> arr(100004, 0);\nvector<int> memo(100004, numeric_limits<int>::max()); // Use max for initial values\n\nint cost() {\n    fill(memo.begin(), memo.begin() + n, numeric_limits<int>::max()); // Clear memoization array\n    memo[n - 1] = 0; // Base case for the last element\n    for (int i = n - 2; i >= 0; --i) {\n        for (int j = 1; j <= k && i + j < n; ++j) {\n            // Cache absolute difference to avoid recalculating\n            int absDiff = abs(arr[i + j] - arr[i]);\n            int temp = absDiff + memo[i + j];\n            memo[i] = min(memo[i], temp);\n        }\n    }\n    return memo[0];\n}\n\nint main() {\n    cin >> n >> k;\n    if(n <= 0 || k <= 0) {\n        cout << "Invalid input." << endl;\n        return 1;\n    }\n    for (int i = 0; i < n; ++i) cin >> arr[i];\n    cout << cost() << endl;\n    return 0;\n}')
