\n\n\tint pos[6][6]={\n\n\t\t{0,1,2,3,4,5},\n\n\t\t{1,5,2,3,0,4},\n\n\t\t{2,1,5,0,4,3},\n\n\t\t{3,1,0,5,4,2},\n\n\t\t{4,0,2,3,5,1},\n\n\t\t{5,4,2,3,1,0},\n\n\t};\n\n\tvstring res;\n\n\trep(i,6)res.PB(s[pos[n][i]]);\n\n\treturn res;\n\n}\n\n\n\nint main() {\n\n\tIL{\n\n\t\tint n;\n\n\t\tcin>>n;\n\n\t\tif(n==0)break;\n\n\t\tvector<vstring> dice;\n\n\t\tvstring rotdice[40][24];\n\n\t\trep(i,n){\n\n\t\t\tstring s;\n\n\t\t\tvstring v;\n\n\t\t\trep(i,6){\n\n\t\t\t\tcin>>s;\n\n\t\t\t\tv.PB(s);\n\n\t\t\t}\n\n\t\t\tdice.PB(v);\n\n\t\t}\n\n\t\trep(k,n){\n\n\t\t\trep(i,6){\n\n\t\t\t\tvstring v=g(dice[k],i);\n\n\t\t\t\trep(j,4){\n\n\t\t\t\t\trotdice[k][i*4+j]=h(v,j);\n\n\t\t\t\t}\n\n\t\t\t}\n\n\t\t}\n\n\t\tint ng[40]={};\n\n\t\trep(i,n)repn(j,i+1,n-1){\n\n\t\t\trep(k,24){\n\n\t\t\t\tif(rotdice[j][k]==dice[i])ng[j]=1;\n\n\t\t\t}\n\n\t\t}\n\n\t\tint res=0;\n\n\t\trep(i,n)res+=ng[i];\n\n\t\tcout<<res<<endl;\n\n\t}\n\n\treturn 0;\n\n}')"
