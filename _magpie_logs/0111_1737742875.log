LineLLMCrossover(('source.cpp', 31), '#include <iostream>\n#include <vector>\n#include <cstring>\nusing namespace std;\n\nint h, n;\nvector<int> b;\nvector<int> dp; // Vector for dynamic sizing\n\nint dfs(int i = 1, int bit = 0) {\n    if (i == h) return 0;\n    bit |= b[i];\n    int state = (i << 3) | bit; \n    if (state >= dp.size()) return 0; // Prevent out of bounds access\n    if (dp[state] != -1) return dp[state]; // Improved clarity in checking state\n    dp[state] = 0;\n\n    // Streamlined recursion conditions for clarity\n    if (bit == 0) dp[state] = max(dp[state], dfs(i + 1, 0b111) + 2);\n    else if ((bit & 0b110) == 0) dp[state] = max(dp[state], dfs(i + 1, 0b110) + 1);\n    else if ((bit & 0b011) == 0) dp[state] = max(dp[state], dfs(i + 1, 0b011) + 1);\n\n    dp[state] = max(dp[state], dfs(i + 1, 0)); // Check for no bits set\n    return dp[state];\n}\n\nint main() {\n    cin >> h >> n; \n    dp.resize((h << 3) + 8, -1); // Preallocate size for dp vector\n    b.assign(h + 1, 0);\n    for (int i = 0; i < n; ++i) {\n        int x, y;\n        cin >> x >> y;\n        b[y + 1] |= (1 << x);\n        b[y] |= (1 << x);\n    }\n    cout << dfs() << endl;\n}')
