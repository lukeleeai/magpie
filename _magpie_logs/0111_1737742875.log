\n    // Optimize dp resizing by using a fixed size based on maximum possible states\n    static const int MAX_STATE = (1 << 3) * 100; // Assuming h can go up to 100\n    if (state >= dp.size()) dp.resize(MAX_STATE, -1); // Preallocate a fixed size\n\n    dp[state] = 0;\n\n    if (bit == 0) dp[state] = max(dp[state], dfs(i + 1, 0b111) + 2);\n    else if ((bit & 0b110) == 0) dp[state] = max(dp[state], dfs(i + 1, 0b110) + 1);\n    else if ((bit & 0b011) == 0) dp[state] = max(dp[state], dfs(i + 1, 0b011) + 1);\n    \n    dp[state] = max(dp[state], dfs(i + 1, 0)); \n    return dp[state];\n}\n\nint main() {\n    cin >> h >> n; \n    b.assign(h + 1, 0);\n    dp.resize((1 << 3) * (h + 1), -1); // Preallocate size based on maximum state possible\n    int ei[4] = {0b100, 0b110, 0b011, 0b001};\n    for (int i = 0; i < n; ++i) {\n        int x, y;\n        cin >> x >> y;\n        b[y + 1] |= ei[x];\n        b[y] |= ei[x];\n    }\n    cout << dfs() << endl;\n}')"
