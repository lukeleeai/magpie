LineLLMCrossover(('source.cpp', 36), '#include <algorithm>\n#include <cstdio>\n\nconst int INF = 1 << 29;\n\nint n, m;\nint d[3000][3000][2]; // Combined 2D arrays into one 3D array\n\nvoid floydWarshall() {\n    for (int k = 0; k != n; ++k) {\n        for (int i = 0; i != n; ++i) {\n            for (int j = 0; j != n; ++j) {\n                // Directly update the 3D array\n                d[i][j][0] = std::min(d[i][j][0], d[i][k][0] + d[k][j][0]);\n                d[i][j][1] = std::min(d[i][j][1], d[i][k][1] + d[k][j][1]);\n            }\n        }\n    }\n}\n\nint main() {\n    while (scanf("%d %d", &n, &m), n | m) {\n        for (int i = 0; i != n * n * 2; ++i)\n            d[i / (n * 2)][(i / 2) % n][i % 2] = INF; // Single loop initialization\n\n        for (int i = 0; i != n; ++i) {\n            int a, b, c, t;\n            scanf("%d %d %d %d", &a, &b, &c, &t);\n            d[a - 1][b - 1][0] = d[b - 1][a - 1][0] = c;\n            d[a - 1][b - 1][1] = d[b - 1][a - 1][1] = t;\n        }\n\n        floydWarshall();\n\n        int k;\n        scanf("%d", &k);\n        while (k--) {\n            int p, q, r;\n            scanf("%d %d %d", &p, &q, &r);\n            printf("%d\\n", d[p - 1][q - 1][r]); // Access the combined array directly\n        }\n    }\n    return 0;\n}')
