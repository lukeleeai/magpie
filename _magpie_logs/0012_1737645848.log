in() {\n    int n;\n    scanf("%d", &n);\n    getchar();\n    vector<string> lines(n);\n\n    for (int i = 0; i < n; ++i) {\n        getline(cin, lines[i]);\n    }\n\n    initializeMemo(); // Initialize memoization only once\n\n    for (const auto& s : lines) {\n        string ans;\n        bool found = false;\n\n        for (int a = 0; a < MAX_A && !found; ++a) {\n            for (int b = 0; b < MAX_B && !found; ++b) {\n                string tmp = s;\n                for (char& ch : tmp) {\n                    if (isalpha(ch)) {\n                        ch = memo[a][b][ch - \'a\'];\n                    }\n                }\n                if (tmp.find("this") != string::npos || tmp.find("that") != string::npos) {\n                    ans = tmp;\n                    found = true;\n                }\n            }\n        }\n        cout << ans << endl;\n    }\n}')"
