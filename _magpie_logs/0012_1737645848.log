ng ans;\n        bool found = false;\n\n        // Instead of nested loops, we can combine the transformations in one pass\n        for(int a = 0; a < 27 && !found; a++){\n            for(int b = 0; b < 27 && !found; b++){\n                string tmp;\n                for(char c : s) {\n                    if(isalpha(c)) {\n                        tmp += (a * (c - \'a\') + b) % 26 + \'a\'; // Transform and build the new string directly\n                    } else {\n                        tmp += c; // Keep non-alpha characters unchanged\n                    }\n                }\n                // Check for \'this\' or \'that\' in one go\n                if (tmp.find("this") != string::npos || tmp.find("that") != string::npos) {\n                    ans = tmp; \n                    found = true; \n                }\n            }\n        }\n        \n        cout << ans << endl;\n    }\n}')"
