2025-01-23 15:25:40,143	[DEBUG]	patch(0-8)="LineLLMMutation(('source.cpp', 7), '#include <iostream>\n#include <string>\n#include <algorithm>\n#include <map>\n#include <set>\n#include <utility>\n#include <vector>\n#include <cmath>\n#include <cstdio>\n\n#define loop(i,a,b) for(int i=a;i<b;i++)\n#define rep(i,a) loop(i,0,a)\n\nconst double PI=acos(-1);\nconst double ESP=1e-10;\n\nusing namespace std;\n\nvoid KMP(const string& pattern, const string& text, bool &found){\n    int m = pattern.size(), n = text.size();\n    vector<int> lps(m, 0);\n    for (int i = 1, len = 0; i < m;) {\n        if (pattern[i] == pattern[len]) {\n            lps[i++] = ++len;\n        } else {\n            if (len) len = lps[len - 1];\n            else lps[i++] = 0;\n        }\n    }\n\n    for (int i = 0, j = 0; i < n;) {\n        if (pattern[j] == text[i]) {\n            i++; j++;\n        }\n        if (j == m) {\n            found = true; return;\n        } else if (i < n && pattern[j] != text[i]) {\n            if (j) j = lps[j - 1];\n            else i++;\n        }\n    }\n}\n\nint main(){\n    int n;\n    scanf("%d", &n);\n    getchar();\n    vector<string> lines(n);\n\n    for(int i = 0; i < n; ++i) {\n        getline(cin, lines[i]);\n    }\n\n    rep(i,n){\n        const string& s = lines[i];\n        string ans;\n        bool han=false;\n        rep(a,27){\n            rep(b,27){\n                string tmp=s;\n                rep(j,tmp.size()) if(isalpha(tmp[j])) tmp[j]=(a*(tmp[j]-\'a\')+b)%26+\'a\';\n\n                bool found_this = false, found_that = false;\n                KMP("this", tmp, found_this);\n                KMP("that", tmp, found_that);\n                \n                if(found_this || found_that) {\n                    ans = tmp; han = true; break;\n                }\n                if(han) break;\n            }\n            if(han) break;\n        }\n        cout << ans << endl;\n    }\n}')"
