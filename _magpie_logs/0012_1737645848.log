(const string& pat, const string& txt) {\n    int M = pat.length();\n    int N = txt.length();\n    vector<int> lps(M);\n    computeLPSArray(pat, lps);\n\n    int i = 0; // index for txt\n    int j = 0; // index for pat\n    while (N - i >= M - j) {\n        if (pat[j] == txt[i]) {\n            i++;\n            j++;\n        }\n        if (j == M) {\n            return true; // pattern found\n        } else if (i < N && pat[j] != txt[i]) {\n            if (j != 0) {\n                j = lps[j - 1];\n            } else {\n                i++;\n            }\n        }\n    }\n    return false; // pattern not found\n}\n\nint main() {\n    int n;\n    scanf("%d", &n);\n    getchar();  // Clear the newline left by scanf\n    vector<string> lines(n);\n\n    for (int i = 0; i < n; ++i) {\n        getline(cin, lines[i]);\n    }\n\n    for (const auto& s : lines) {\n        string ans;\n        bool found = false;\n\n        for (int a = 0; a < 27 && !found; a++) {\n            for (int b = 0; b < 27 && !found; b++) {\n                string tmp = s;\n                for (char& c : tmp) {\n                    if (isalpha(c)) {\n                        c = (a * (c - \'a\') + b) % 26 + \'a\';\n                    }\n                }\n                // Use KMP for substring search\n                if (KMPSearch("this", tmp) || KMPSearch("that", tmp)) {\n                    ans = tmp; found = true; break;\n                }\n            }\n        }\n        cout << ans << endl;\n    }\n}')"
