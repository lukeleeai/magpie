2025-01-23 23:07:56,696	[DEBUG]	patch(0-10)="LineLLMMutation(('source.cpp', 9), '#include <iostream>\n#include <vector>\n#include <thread>\n#include <future>\n\nusing namespace std;\n\ntypedef long long ll;\n\nll gcd(ll a, ll b) {\n    return (!b) ? a : gcd(b, a % b);\n}\n\nvoid computeGcdAndUpdate(int n, vector<ll>& d, vector<ll>& v, vector<ll>& t) {\n    t[0] = 1;\n\n    for (int i = 1; i < n; i++) {\n        t[i] = t[i - 1] * d[i - 1] * v[i];\n        for (int j = 0; j < i; j++) t[j] *= d[i] * v[i - 1];\n\n        ll T = t[0];\n        for (int j = 1; j <= i; j++) T = gcd(T, t[j]);\n        for (int j = 0; j <= i; j++) t[j] /= T;\n    }\n}\n\nint main() {\n    int n;\n    vector<ll> d, v, t;\n\n    for (;;) {\n        cin >> n;\n        if (!n) break;\n\n        d.resize(n);\n        v.resize(n);\n        t.resize(n);\n        for (int i = 0; i < n; i++) cin >> d[i] >> v[i];\n\n        // Launching a thread to perform computations\n        thread computeThread(computeGcdAndUpdate, n, ref(d), ref(v), ref(t));\n        computeThread.join(); // Wait for the thread to finish\n\n        for (int i = 0; i < n; i++) cout << t[i] << endl;\n    }\n}')"
