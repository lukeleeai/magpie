2025-01-27 01:47:49,719	[DEBUG]	patch(1-3)="LineLLMCrossover(('source.cpp', 2), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\n\nconst int N = 100005;\n\nint n, a[N], b[N];\n\nlong long read(){\n\n\tlong long x = 0, f = 1;\n\n\tchar c = getchar();\n\n\twhile (c < \'0\' || c > \'9\'){\n\n\t\tif (c == \'-\') f = -1;\n\n\t\tc = getchar();\n\n\t}\n\n\twhile (c >= \'0\' && c <= \'9\'){\n\n\t\tx = x * 10 + c - \'0\';\n\n\t\tc = getchar();\n\n\t}\n\n\treturn x * f;\n\n}\n\nlong long calc(long long x, long long y){\n\n\tlong long z = (x + y - 1) / y * y;\n\n\treturn z - x;\n\n}\n\nint main(){\n\n\tn = read();\n\n\tfor (int i = 1; i <= n; i++) a[i] = read(), b[i] = read();\n\n\tlong long ans = 0;\n\n\tfor (int i = n; i; i--){\n\n\t\tans += calc(a[i] + ans, b[i]);\n\n\t}\n\n\tprintf("%lld\n", ans);\n\n\treturn 0;\n\n}')"
