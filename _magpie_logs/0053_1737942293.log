test_cmd = bash test.sh
test_timeout = 
test_lengthout = 
run_cmd = bash run.sh
run_timeout = 3
run_lengthout = 
batch_timeout = 
batch_lengthout = 
batch_bin_fitness_strategy = aggregate
batch_fitness_strategy = sum
fitness = time

[srcml]
