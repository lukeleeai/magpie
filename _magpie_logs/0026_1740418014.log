2025-02-24 17:32:02,767	[DEBUG]	patch(2-1)="LineLLMMutation(('source.cpp', 18), '#include <iostream>\n#include <string>\n#include <unordered_map>\n\nusing namespace std;\n\nint main(void) {\n    long long n;\n\n    while (cin >> n) {\n        if (!n) break;\n\n        unordered_map<string, long long> salesMap; // Use a hashmap for efficient access\n\n        for (int i = 0; i < n; i++) {\n            string id;\n            long long price;\n            int bnum;\n\n            cin >> id >> price >> bnum;\n            salesMap[id] += price * bnum; // Directly update the sales in the hashmap\n        }\n\n        int count = 0;\n        for (const auto& entry : salesMap) {\n            if (entry.second >= 1000000) {\n                count++;\n                cout << entry.first << endl; // Output the IDs with sales >= 1,000,000\n            }\n        }\n\n        if (!count) cout << "NA" << endl;\n    }\n\n    return 0;\n}')"
