2025-02-24 17:32:56,024	[DEBUG]	patch(3-2)="LineLLMMutation(('source.cpp', 0), '#include <cstdio>\n#include <cstring>\nusing namespace std;\n\ntypedef struct {\n    char id[21]; // Assume ID length is limited to 20 characters\n    long long sales;\n} staff;\n\nint main(void) {\n    long long n;\n    while(scanf("%lld", &n) == 1) {\n        if(!n) break;\n        staff staff1[4001];\n        int pt = 0;\n        for(int i = 0; i < n; i++) {\n            char id[21];\n            long long price;\n            int bnum;\n            scanf("%s %lld %d", id, &price, &bnum);\n            int m = -1;\n            for(int j = 0; j < i; j++) {\n                if(strcmp(id, staff1[j].id) == 0) {\n                    pt++;\n                    m = j;\n                    break;\n                }\n            }\n            if(m == -1) {\n                strcpy(staff1[i - pt].id, id);\n                staff1[i - pt].sales = price * bnum;\n            } else {\n                staff1[m].sales += price * bnum;\n            }\n        }\n        int count = 0;\n        for(int i = 0; i < n - pt; i++) {\n            if(staff1[i].sales >= 1000000) {\n                count++;\n                printf("%s\\n", staff1[i].id);\n            }\n        }\n        if(!count) printf("NA\\n");\n    }\n    return 0;\n}')"
