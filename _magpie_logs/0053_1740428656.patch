LineLLMCrossover(('source.cpp', 4), '#include <iostream>\n#include <vector>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\n\nconst int INF = 10000;\n\nstruct E {\n    int a, b, c;\n    E(int a, int b, int c) : a(a), b(b), c(c) {}\n};\n\n#define MONEY 0\n#define EKI 1\n\nint main() {\n    int n, m;\n    while (cin >> n >> m) {\n        if (n == 0 && m == 0) break;\n        vector<vector<pair<int, int>>> costs(n + 1), times(n + 1);\n        int a, b, c, t;\n        for (int i = 0; i < n; ++i) {\n            cin >> a >> b >> c >> t;\n            costs[a].emplace_back(b, c);\n            costs[b].emplace_back(a, c);\n            times[a].emplace_back(b, t);\n            times[b].emplace_back(a, t);\n        }\n        int k, p, q, r;\n        cin >> k;\n        for (int i = 0; i < k; ++i) {\n            vector<int> d(n + 1, INF);\n            cin >> p >> q >> r;\n            d[p] = 0;\n            while (true) {\n                bool update = false;\n                auto& edges = (r == MONEY ? costs : times);\n                for (int j = 0; j <= n; ++j) {\n                    for (const auto& edge : edges[j]) {\n                        if (d[j] != INF && d[edge.first] > d[j] + edge.second) {\n                            d[edge.first] = d[j] + edge.second;\n                            update = true;\n                        }\n                    }\n                }\n                if (!update) break;\n            }\n            cout << d[q] << endl;\n        }\n    }\n    return 0;\n}')
