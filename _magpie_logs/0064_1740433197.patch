LineLLMCrossover(('source.cpp', 12), '#include <cstdio>\n#include <vector>\n#include <utility>\n#include <cstring>\n#include <algorithm>\n#include <limits>\n\nusing namespace std;\n\ntypedef pair<int, int> P;\n\nvector<P> point[7];\nint x, y;\nint dp[1001][6]; // reduced dimensionality\nchar mas[1001][1001];\nint cx[6], ans;\nint sp, ans1;\n\nint solve(int i, int j, int z);\n\nint main() {\n    while (true) {\n        for (int i = 0; i < 7; i++) {\n            point[i].clear();\n        }\n\n        fill(cx, cx + 6, 0); // Use fill for initialization\n        ans1 = numeric_limits<int>::max(); // Use numeric_limits for INF\n        sp = numeric_limits<int>::max();\n\n        scanf("%d %d", &x, &y); // Faster input using scanf\n        if (x == 0 && y == 0) break;\n\n        for (int i = 0; i < y; i++) {\n            scanf("%s", mas[i]); // Using scanf for input\n        }\n\n        for (int i = 0; i < y; i++) {\n            for (int j = 0; j < x; j++) {\n                if (mas[i][j] == \'S\') {\n                    point[0].emplace_back(j, i);\n                }\n                if (mas[i][j] == \'G\') {\n                    point[6].emplace_back(j, i);\n                }\n                if (mas[i][j] >= \'1\' && mas[i][j] <= \'5\') {\n                    point[mas[i][j] - \'0\'].emplace_back(j, i);\n                    cx[mas[i][j] - \'0\']++;\n                }\n            }\n        }\n\n        for (int i = 1; i <= 5; i++) {\n            rotate(point + 1, point + 2, point + 6);\n            rotate(cx + 1, cx + 2, cx + 6);\n            memset(dp, -1, sizeof(dp)); // Initialize dp with -1\n            ans = solve(0, 0, 0);\n            if (ans < ans1) {\n                ans1 = ans;\n                sp = i;\n            }\n        }\n\n        if (ans1 == numeric_limits<int>::max()) printf("NA\\n");\n        else printf("%d %d\\n", sp, ans1);\n    }\n}\n\nint solve(int i, int j, int z) {\n    if (dp[j][z] >= 0) return dp[j][z];\n\n    if (i == 4) {\n        return abs(point[6][0].first - point[z][j].first) + abs(point[6][0].second - point[z][j].second);\n    }\n\n    int res = numeric_limits<int>::max();\n    for (int k = 0; k < cx[z + 1]; k++) {\n        res = min(abs(point[z + 1][k].first - point[z][j].first) + abs(point[z + 1][k].second - point[z][j].second) + solve(i + 1, k, z + 1), res);\n    }\n\n    return dp[j][z] = res; // Use reduced dimension for dp storage\n}')
