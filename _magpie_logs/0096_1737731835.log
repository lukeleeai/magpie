e\n        int exp = exp_end.first;\n        int end = exp_end.second;\n\n        for (int i = 0; i < n; i++) {\n            if (exp < r[i]) continue;\n            int new_exp = min(exp + e[i], 100);\n            int new_end = max(end - a[i], 0);\n            if (memo[new_exp * 101 + new_end] > c + 1) {\n                memo[new_exp * 101 + new_end] = c + 1;\n                q.push_back({c + 1, {new_exp, new_end}}); // Use push_back for deque\n            }\n        }\n    }\n}\n\nint main() {\n    while (cin >> d >> n, d) {\n        for (int i = 0; i < n; i++) cin >> a[i] >> e[i] >> r[i];\n        bfs_rec();\n        int ans = INF;\n        for (int i = 0; i < 101; i++) ans = min(ans, memo[i * 101]); // Adjusted index for memo\n        cout << (ans == INF ? "NA" : to_string(ans)) << endl;\n    }\n    return 0;\n}') | LineLLMMutation(('source.cpp', 35), '#include <iostream>\n#include <array>\n#include <algorithm>\n#include <deque>\n\nusing namespace std;\n\nint d, n;\narray<int, 105> a, e, r;\nint memo[105 * 101]; // Changed memo from array to a simple int array for less overhead\n\nconst int INF = 1000000000;\n\nvoid bfs_rec() {\n    deque<int> q; // Use a simple deque of integers instead of pairs\n    q.push_back(0); // Store only the current cost in the queue\n    fill(memo, memo + 105 * 101, INF); // Initialize memo with INF\n    memo[0 * 101 + d] = 0; // Adjusted index for memo\n\n    while (!q.empty()) {\n        int c = q.front();\n        q.pop_front();\n        int exp = c / 101; // Extract experience from cost\n        int end = d - (c % 101); // Calculate remaining end based on cost\n\n        for (int i = 0; i < n; i++) {\n            if (exp < r[i]) continue;\n            int new_exp = min(exp + e[i], 100);\n            int new_end = max(end - a[i], 0);\n            int new_cost = new_exp * 101 + new_end;\n\n            if (memo[new_cost] > c + 1) {\n                memo[new_cost] = c + 1;\n                q.push_back(new_cost); // Push the new cost into the queue\n            }\n        }\n    }\n}\n\nint main() {\n    while (cin >> d >> n, d) {\n        for (int i = 0; i < n; i++) cin >> a[i] >> e[i] >> r[i];\n        bfs_rec();\n        int ans = INF;\n        for (int i = 0; i < 101; i++) ans = min(ans, memo[i * 101]); // Adjusted index for memo\n        cout << (ans == INF ? "NA" : to_string(ans)) << endl;\n    }\n    return 0;\n}')"
