2025-01-24 15:23:43,256	[DEBUG]	patch(4-3)="LineLLMCrossover(('source.cpp', 12), '#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <queue>\n\nusing namespace std;\n\nint d, n;\nvector<int> a, e, r;\nvector<vector<int>> memo;\n\nconst int INF = 1000000000;\n\nvoid iterative_rec() {\n    queue<pair<int, pair<int, int>>> q; // holds (c, (exp, end))\n    q.push({0, {0, d}});\n    memo.assign(105, vector<int>(105, INF)); // Initialize memo directly\n    memo[0][d] = 0;\n\n    while (!q.empty()) {\n        auto [c, exp_end] = q.front();\n        q.pop();\n        int exp = exp_end.first;\n        int end = exp_end.second;\n\n        for (int i = 0; i < n; i++) {\n            if (exp < r[i]) continue;\n            int new_exp = min(exp + e[i], 100);\n            int new_end = max(end - a[i], 0);\n            if (memo[new_exp][new_end] > c + 1) {\n                memo[new_exp][new_end] = c + 1;\n                q.push({c + 1, {new_exp, new_end}});\n            }\n        }\n    }\n}\n\nint main() {\n    while (cin >> d >> n, d) {\n        a.resize(n); e.resize(n); r.resize(n);\n        for (int i = 0; i < n; i++) cin >> a[i] >> e[i] >> r[i];\n        iterative_rec();\n        int ans = INF;\n        for (int i = 0; i < 101; i++) ans = min(ans, memo[i][0]);\n        cout << (ans == INF ? "NA" : to_string(ans)) << endl;\n    }\n    return 0;\n}')"

