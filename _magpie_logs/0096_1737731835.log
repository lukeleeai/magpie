t min_moves = INF; // Changed from ans to min_moves\n        for (int i = 0; i < 101; i++) min_moves = min(min_moves, memo[i][0]);\n        cout << (min_moves == INF ? "NA" : to_string(min_moves)) << endl;\n    }\n    return 0;\n}')"
