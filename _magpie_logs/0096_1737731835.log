00000 ? "NA" : to_string(ans)) << endl;\n    }\n    return 0;\n}') | LineLLMMutation(('source.cpp', 18), '#include <iostream>\n#include <array>\n#include <algorithm>\n\nusing namespace std;\n\nint d, n;\narray<int, 105> a, e, r;\narray<int, 105 * 105> memo; // Use std::array for fixed size and better performance\n\nvoid rec(int c = 0, int exp = 0, int end = d) {\n    int idx = exp * 105 + end; // Calculate the index for the flattened array\n    if (memo[idx] <= c) return;\n    memo[idx] = c;\n\n    for (int i = 0; i < n; i++) {\n        if (exp < r[i]) continue;\n        rec(c + 1, min(exp + e[i], 100), max(end - a[i], 0));\n    }\n}\n\nint main() {\n    while (cin >> d >> n, d) {\n        for (int i = 0; i < n; i++) cin >> a[i] >> e[i] >> r[i];\n        memo.fill(1000000000); // Initialize memoization array using fill\n        rec();\n        int ans = 1000000000;\n        for (int i = 0; i < 101; i++) ans = min(ans, memo[i * 105]);\n        cout << (ans == 1000000000 ? "NA" : to_string(ans)) << endl;\n    }\n    return 0;\n}')"

