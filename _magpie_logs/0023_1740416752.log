2025-02-24 17:07:20,511	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), "#include<iostream>\n#include<vector>\n#include<algorithm>\n#include<string>\n\nusing namespace std;\n\nint dp[1001][1001];\n\nint latte(int i, int j, int k) {\n    return dp[i+k][j+k] - dp[i+k][j-1] - dp[i-1][j+k] + dp[i-1][j-1];\n}\n\nint main() {\n    int n;\n    while(cin >> n, n) {\n        for(int i = 0; i <= n; i++)\n            for(int j = 0; j <= n; j++)\n                dp[i][j] = 0; // Direct initialization\n\n        for(int i = 0; i < n; i++) {\n            string str;\n            cin >> str;\n            for(int j = 0; j < n; j++) {\n                dp[i + 1][j + 1] = dp[i][j + 1] + dp[i + 1][j] - dp[i][j];\n                if(str[j] == '*') dp[i + 1][j + 1]++;\n            }\n        }\n\n        int Max = 0;\n        for(int i = 1; i <= n; i++) {\n            for(int j = 1; j <= n; j++) {\n                if(latte(i, j, 0)) continue;\n\n                int lb = 0, ub = min(n - i, n - j) + 1;\n                while(ub - lb > 1) {\n                    int k = (ub + lb) / 2;\n                    if(latte(i, j, k)) ub = k;\n                    else lb = k;\n                }\n                Max = max(Max, lb + 1);\n            }\n        }\n        cout << Max << endl;\n    }\n}")"

