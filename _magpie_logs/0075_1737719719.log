2025-01-24 12:05:50,683	[DEBUG]	patch(5-5)="LineLLMCrossover(('source.cpp', 18), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\n#define fr first\n#define sc second\n\ntypedef pair<int, int> P;\n\nint main() {\n    int X, Y, Z, N, E, A;\n    while (scanf("%d %d %d", &X, &Y, &Z), X) {\n        int jump[X];\n        P ivent[Y + 1];\n        for (int i = 0; i <= Y; i++) ivent[i] = P(0, 0);\n        double dp[51][2500] = {}; // Maintain higher precision\n        dp[0][0] = 1.0;\n\n        for (int i = 0; i < X; i++) {\n            scanf("%d", &jump[i]);\n        }\n\n        for (int i = 0; i < Z; i++) {\n            scanf("%d %d %d", &N, &E, &A);\n            if (E == 1) ivent[N].fr = A;\n            else if (E == 2) ivent[N].sc = A;\n            else ivent[N].sc = -A;\n        }\n\n        for (int i = 0, limit = 0; i < Y; i++, limit += 100) {\n            for (int j = 0; j <= limit; j++) {\n                if (dp[i][j]) {\n                    for (int k = 0; k < X; k++) {\n                        int p_mas = min(i + jump[k], Y);\n                        int p_money = max(0, ivent[p_mas].sc + j);\n                        p_mas = min(p_mas + ivent[p_mas].fr, Y);\n                        dp[p_mas][p_money] += dp[i][j] / X;\n                    }\n                }\n            }\n        }\n\n        double ans = 0.0;\n        for (int i = 0; i < 2500; i++) {\n            ans += dp[Y][i] * i;\n        }\n\n        printf("%d\\n", (int)ans);\n    }\n}')"
