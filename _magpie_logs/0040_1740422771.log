nly necessary dimensions\n        vector<vector<int>> dp(1000, vector<int>(m + n + 1, 1000));\n\n        int ans = 0;\n\n        for (const auto& [h, r] : mt) {\n            dp[h][1] = min(dp[h][1], r);\n            for (int j = 0; j < h; j++) {\n                for (int k = 0; k <= m + n; k++) {\n                    if (r > dp[j][k]) {\n                        dp[h][k + 1] = min(dp[h][k + 1], r);\n                    }\n                }\n            }\n        }\n\n        for (int j = 0; j <= m + n; j++) {\n            if (dp[j][j] != 1000) {\n                ans = max(ans, j);\n            }\n        }\n\n        printf("%d\\n", ans);\n    }\n}')"
