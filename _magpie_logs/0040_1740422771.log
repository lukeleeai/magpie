          scanf("%d %d", &a, &b);\n            mt[i] = P(a, b);\n        }\n\n        scanf("%d", &m);\n        for (int i = 0; i < m; i++) {\n            int a, b;\n            scanf("%d %d", &a, &b);\n            mt[n + i] = P(a, b);\n        }\n\n        sort(mt, mt + m + n, customCompare);\n        fill(&dp[0][0], &dp[0][0] + sizeof(dp) / sizeof(int), 1000);\n\n        for (int i = 0; i < m + n; i++) {\n            int h = mt[i].first;\n            int r = mt[i].second;\n            dp[h][1] = min(dp[h][1], r);\n\n            for (int j = 0; j < h; j++) {\n                if (r <= dp[j][1]) continue; // Skip unnecessary iterations\n                for (int k = 0; k < m + n; k++) {\n                    if (r > dp[j][k])\n                        dp[h][k + 1] = min(dp[h][k + 1], r);\n                }\n            }\n        }\n\n        int ans = 0;\n        for (int i = 0; i < 1000; i++)\n            for (int j = 0; j <= m + n; j++) {\n                if (dp[i][j] != 1000) ans = max(ans, j);\n            }\n\n        printf("%d\\n", ans);\n    }\n}') | LineLLMMutation(('source.cpp', 18), '#include <cstdio>\n#include <algorithm>\n#include <vector>\nusing namespace std;\n\ntypedef pair<int,int> P;\n\nvector<P> mt; // Use dynamic vector instead of static array\nvector<vector<int>> dp(1000, vector<int>(201, 1000)); // Initialize with 1000 directly\n\nbool customCompare(const P &a, const P &b) {\n    return a.first < b.first || (a.first == b.first && a.second < b.second);\n}\n\nint main() {\n    int n, m;\n\n    while (true) {\n        scanf("%d", &n);\n        if (n == 0) return 0;\n\n        mt.resize(n + m); // Resize vector to hold all pairs\n        for (int i = 0; i < n; i++) {\n            int a, b;\n            scanf("%d %d", &a, &b);\n            mt[i] = P(a, b);\n        }\n\n        scanf("%d", &m);\n        for (int i = 0; i < m; i++) {\n            int a, b;\n            scanf("%d %d", &a, &b);\n            mt[n + i] = P(a, b);\n        }\n\n        sort(mt.begin(), mt.begin() + n + m, customCompare); // Use vector sort\n\n        for (const auto& p : mt) {\n            int h = p.first;\n            int r = p.second;\n            dp[h][1] = min(dp[h][1], r);\n\n            for (int j = 0; j < h; j++) {\n                if (r <= dp[j][1]) continue;\n                for (int k = 0; k < m + n; k++) {\n                    if (r > dp[j][k])\n                        dp[h][k + 1] = min(dp[h][k + 1], r);\n                }\n            }\n        }\n\n        int ans = 0;\n        for (int i = 0; i < 1000; i++)\n            for (int j = 0; j <= m + n; j++) {\n                if (dp[i][j] != 1000) ans = max(ans, j);\n            }\n\n        printf("%d\\n", ans);\n    }\n}')"
