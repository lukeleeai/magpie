2025-01-23 22:23:34,965	[DEBUG]	patch(3-5)="LineLLMCrossover(('source.cpp', 10), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\nint main() {\n    int n, m, a, b, cost, time, k, p, q, r;\n    const int INF = 1000000; // Constant for infinity\n    int t[100][100], c[100][100];\n\n    for (;;) {\n        scanf("%d %d", &n, &m);\n        if (!n && !m) break;\n\n        // Initialize t and c arrays\n        for (int i = 0; i < m; i++) {\n            fill(t[i], t[i] + m, INF); // Fill with INF\n            fill(c[i], c[i] + m, INF); // Fill with INF\n            t[i][i] = 0; // Set diagonal to 0\n            c[i][i] = 0; // Set diagonal to 0\n        }\n\n        for (int i = 0; i < n; i++) {\n            scanf("%d %d %d %d", &a, &b, &cost, &time);\n            t[a - 1][b - 1] = t[b - 1][a - 1] = time;\n            c[a - 1][b - 1] = c[b - 1][a - 1] = cost;\n        }\n\n        for (int x = 0; x < m; x++) {\n            for (int i = 0; i < m; i++) {\n                int t_ix = t[i][x], c_ix = c[i][x]; // Store intermediate results\n                for (int j = 0; j < m; j++) {\n                    t[i][j] = min(t[i][j], t_ix + t[x][j]);\n                    c[i][j] = min(c[i][j], c_ix + c[x][j]);\n                }\n            }\n        }\n\n        scanf("%d", &k);\n        for (int i = 0; i < k; i++) {\n            scanf("%d %d %d", &p, &q, &r);\n            if (r) printf("%d\\n", t[p - 1][q - 1]);\n            else printf("%d\\n", c[p - 1][q - 1]);\n        }\n    }\n}')"
