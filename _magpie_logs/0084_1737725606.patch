LineLLMCrossover(('source.cpp', 25), '#include <iostream>\n#include <bitset>\n#include <cstdio>\n#include <vector>\n#include <algorithm>\n\n#define C 300000\n\nusing namespace std;\n\nint main() {\n    int n, q;\n    int c[300000];\n    bitset<C + 1> has_c;\n\n    scanf("%d %d", &n, &q);\n    for (int i = 0; i < n; i++) {\n        scanf("%d", &c[i]);\n        has_c[c[i]] = true;\n    }\n\n    vector<int> results(q);\n    for (int i = 0; i < q; i++) {\n        int query;\n        scanf("%d", &query);\n        int max_r = -1;\n\n        // Efficient search using bitset with results storage\n        for (int r = min(query - 1, C); r >= 0; r--) {\n            int x = r; \n            while (x <= C) {\n                if (has_c[x]) {\n                    max_r = max(r, max_r);\n                    break;\n                }\n                x += query; \n            }\n            if (max_r >= 0) {\n                break;\n            }\n        }\n        results[i] = max_r;\n    }\n\n    for (int result : results) {\n        printf("%d\\n", result);\n    }\n\n    return 0;\n}')
