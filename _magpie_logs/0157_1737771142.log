(!s.empty()) {\n        auto [index, count] = s.top();\n        s.pop();\n\n        if (count == k) {\n            ostringstream oss;\n            for (const auto& str : num) {\n                oss << str;\n            }\n            answer = oss.str();\n            if (complete_integer.find(answer) == complete_integer.end()) {\n                complete_integer.insert(answer);\n                integer_count++;\n            }\n            continue;\n        }\n\n        for (int i = index + 1; i <= n; i++) {\n            if (chousen[i] == 0) {\n                chousen[i] = 1;\n                num.push_back(integer[i]);\n                s.push({i, count + 1}); // push the next state\n                num.pop_back();\n                chousen[i] = 0;\n            }\n        }\n    }\n}\n\nint main() {\n    while (true) {\n        cin >> n >> k;\n        if (n == 0 && k == 0) {\n            break;\n        }\n        for (int i = 1; i <= n; i++) {\n            cin >> integer[i];\n        }\n        operation();\n        cout << integer_count << endl;\n\n        num.clear();\n        complete_integer.clear();\n        answer.clear();\n        integer_count = 0;\n    }\n    return 0;\n}')"
