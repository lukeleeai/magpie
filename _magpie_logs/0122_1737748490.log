LineLLMCrossover(('source.cpp', 26), '#include <cstdio>\nusing namespace std;\n\nconst int MAXN = 100000;  // Increased size limit for the input\nint input[MAXN];\n\nint main() {\n    while (true) {\n        int n, m;\n        if (scanf("%d %d", &n, &m) != 2 || (n == 0 && m == 0)) {\n            break;\n        }\n        for (int i = 0; i < n; i++) {\n            scanf("%d", &input[i]);\n        }\n        int current_sum = 0;\n        for (int i = 0; i < m; i++) {\n            current_sum += input[i];\n        }\n        int max_sum = current_sum;  // Renamed variable for clarity\n        for (int i = m; i < n; i++) {\n            current_sum += input[i] - input[i - m];\n            if (current_sum > max_sum) {\n                max_sum = current_sum;\n            }\n        }\n        printf("%d\\n", max_sum);\n    }\n    return 0;\n}') + LineLLMMutation(('source.cpp', 40), '#include <cstdio>\nusing namespace std;\n\nconst int MAXN = 100000;  // Increased size limit for the input\nint input[MAXN];\n\nint main() {\n    while (true) {\n        int n, m;\n        if (scanf("%d %d", &n, &m) != 2 || (n == 0 && m == 0)) {\n            break;\n        }\n        for (int i = 0; i < n; i++) {\n            scanf("%d", &input[i]);\n        }\n        \n        // Calculate the initial sum of the first m elements\n        int current_sum = 0;\n        for (int i = 0; i < m; i++) {\n            current_sum += input[i];\n        }\n        \n        int max_sum = current_sum;  // Renamed variable for clarity\n\n        // Use sliding window technique to calculate maximum sum of m elements\n        for (int i = m; i < n; i++) {\n            current_sum += input[i] - input[i - m];  // Update sum in O(1) time\n            max_sum = (current_sum > max_sum) ? current_sum : max_sum;  // Avoid unnecessary comparisons\n        }\n        \n        printf("%d\\n", max_sum);\n    }\n    return 0;\n}') + LineLLMMutation(('source.cpp', 42), '#include <cstdio>\nusing namespace std;\n\nconst int MAXN = 100000;  // Increased size limit for the input\nint input[MAXN];\n\nint main() {\n    while (true) {\n        int n, m;\n        if (scanf("%d %d", &n, &m) != 2 || (n == 0 && m == 0)) {\n            break;\n        }\n        \n        // Initialize current_sum and max_sum in a single loop\n        int current_sum = 0, max_sum = 0;\n        for (int i = 0; i < n; i++) {\n            scanf("%d", &input[i]);\n            // Only calculate current_sum for the first m elements\n            if (i < m) {\n                current_sum += input[i];\n                max_sum = current_sum;  // Set max_sum initially\n            } else {\n                current_sum += input[i] - input[i - m];  // Update sum in O(1) time\n                max_sum = (current_sum > max_sum) ? current_sum : max_sum;  // Avoid unnecessary comparisons\n            }\n        }\n        \n        printf("%d\\n", max_sum);\n    }\n    return 0;\n}')
