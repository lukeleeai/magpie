LineLLMCrossover(('source.cpp', 40), '#include <iostream>\n#include <array>\n#include <vector>\n#include <cstring>\n#include <limits>\n#include <algorithm>\n#include <unordered_map>\n\nusing namespace std;\n\nconst int N = 1e5 + 1;\n\nint n, k;\nunordered_map<int, int> dp;\n\nint calc(int i, const vector<int>& a) {\n    if (i >= n - 1) return 0;\n    if (dp.find(i) != dp.end()) return dp[i];\n\n    int ret = numeric_limits<int>::max();\n    for (int j = 1; j <= k && (i + j) < n; j++) {\n        ret = min(calc(i + j, a) + abs(a[i] - a[i + j]), ret);\n    }\n    dp[i] = ret;\n    return ret;\n}\n\nint main() {\n    scanf("%d%d", &n, &k);\n    vector<int> a(n);\n    for (int i = 0; i < n; i++) {\n        scanf("%d", &a[i]);\n    }\n    cout << calc(0, a);\n    return 0;\n}') + LineLLMMutation(('source.cpp', 77), '#include <iostream>\n#include <array>\n#include <vector>\n#include <cstring>\n#include <limits>\n#include <algorithm>\n#include <unordered_map>\n\nusing namespace std;\n\nconst int N = 1e5 + 1;\n\nint n, k;\nunordered_map<int, int> dp;\n\nint calc(int i, const vector<int>& a) {\n    if (i >= n - 1) return 0;\n    if (dp.count(i)) return dp[i];  // Use count for checking existence\n\n    int ret = numeric_limits<int>::max();\n    for (int j = 1; j <= k && (i + j) < n; j++) {\n        // Combine the calculation and update in one line to minimize function calls\n        ret = min(ret, calc(i + j, a) + abs(a[i] - a[i + j]));\n    }\n    dp[i] = ret;  // Store the result in the map\n    return ret;\n}\n\nint main() {\n    scanf("%d%d", &n, &k);\n    vector<int> a(n);\n    for (int i = 0; i < n; i++) {\n        scanf("%d", &a[i]);\n    }\n    cout << calc(0, a);\n    return 0;\n}') + LineLLMMutation(('source.cpp', 89), '#include <iostream>\n#include <array>\n#include <vector>\n#include <cstring>\n#include <limits>\n#include <algorithm>\n#include <unordered_map>\n\nusing namespace std;\n\nconst int N = 1e5 + 1;\n\nint n, k;\nunordered_map<int, int> dp;\n\nint calc(int i, const vector<int>& a) {\n    if (i >= n - 1) return 0;\n    if (dp.find(i) != dp.end()) return dp[i];  // Use find instead of count for checking existence\n\n    int ret = numeric_limits<int>::max();\n    for (int j = 1; j <= k && (i + j) < n; j++) {\n        // Combine the calculation and update in one line to minimize function calls\n        ret = min(ret, calc(i + j, a) + abs(a[i] - a[i + j]));\n    }\n    dp[i] = ret;  // Store the result in the map\n    return ret;\n}\n\nint main() {\n    scanf("%d%d", &n, &k);\n    vector<int> a(n);\n    for (int i = 0; i < n; i++) {\n        scanf("%d", &a[i]);\n    }\n    cout << calc(0, a);\n    return 0;\n}')
