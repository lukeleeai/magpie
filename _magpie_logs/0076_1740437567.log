X, Y));\n    }\n}') | LineLLMMutation(('source.cpp', 13), '#include <cstdio>\n#include <array>\n#include <algorithm>\n\nconst int kMaxSquare = 64;\n\nint roulette[4];\n\nstruct BoardState {\n    int type;\n    int value;\n};\n\nBoardState board[kMaxSquare];\n\nint bp(int X, int Y) {\n    std::array<std::array<double, 1000>, kMaxSquare> bp = {}; // Using a fixed-size array\n    double prob = 1.0 / static_cast<double>(X);\n    bp[0][0] = 1.0;\n\n    for (int n = 0; n < Y; n++) {\n        for (int k = 0; k < X; k++) {\n            int pos = (n + roulette[k] < Y) ? n + roulette[k] : Y;\n            double current_prob = bp[n][n]; // Cache current probability to avoid repeated access\n\n            switch (board[pos].type) {\n                case 1:\n                    bp[(pos + board[pos].value < Y) ? pos + board[pos].value : Y][n] += current_prob * prob;\n                    break;\n                case 2:\n                    bp[pos][n + board[pos].value] += current_prob * prob;\n                    break;\n                case 3:\n                    if(n - board[pos].value >= 0)\n                        bp[pos][n - board[pos].value] += current_prob * prob;\n                    break;\n                default:\n                    bp[pos][n] += current_prob * prob;\n                    break;\n            }\n        }\n    }\n\n    double res = 0.0;\n    for (int i = 0; i < 1000; i++)\n        res += static_cast<double>(i) * bp[Y][i];\n    \n    return static_cast<int>(res);\n}\n\nint main() {\n    while (1) {\n        int X, Y, Z;\n        scanf("%d %d %d", &X, &Y, &Z);\n        if (X == 0) return 0;\n\n        for (int i = 0; i < X; i++)\n            scanf("%d", &roulette[i]);\n\n        for (int i = 0; i < kMaxSquare; i++)\n            board[i] = {0, 0};\n\n        for (; Z > 0; Z--) {\n            int N, E, A;\n            scanf("%d %d %d", &N, &E, &A);\n            board[N] = {E, A};\n        }\n\n        printf("%d\\n", bp(X, Y));\n    }\n}')"
