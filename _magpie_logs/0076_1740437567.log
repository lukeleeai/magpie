ource.cpp', 18), '#include <cstdio>\n#include <map>\n\nconst int kMaxSquare = 64;\n\nint roulette[4];\n\nstruct BoardState {\n    int type;\n    int value;\n};\n\nBoardState board[kMaxSquare];\n\nint bp(int X, int Y) {\n    std::map<int, double> bp; // Change here: use a single map instead of an array of maps\n    double prob = 1.0f / static_cast<double>(X);\n    bp[0] = 1.0f;\n\n    for (int n = 0; n < Y; n++) {\n        std::map<int, double> temp; // Temporary map to store results for the current step\n        for (auto& it : bp) {\n            for (int k = 0; k < X; k++) {\n                int pos = (n + roulette[k] < Y) ? n + roulette[k] : Y;\n\n                switch (board[pos].type) {\n                    case 1:\n                        temp[(pos + board[pos].value < Y) ? pos + board[pos].value : Y] += it.second * prob;\n                        break;\n                    case 2:\n                        temp[pos][it.first + board[pos].value] += it.second * prob;\n                        break;\n                    case 3:\n                        temp[pos][(it.first - board[pos].value > 0) ? it.first - board[pos].value : 0] += it.second * prob;\n                        break;\n                    default:\n                        temp[pos][it.first] += it.second * prob;\n                        break;\n                }\n            }\n        }\n        bp = std::move(temp); // Move to the new map\n    }\n\n    double res = 0.0f;\n    for (auto it = bp.begin(); it != bp.end(); it++)\n        res += static_cast<double>(it->first) * it->second;\n    return static_cast<int>(res);\n}\n\nint main() {\n    while (1) {\n        int X, Y, Z;\n        scanf("%d %d %d", &X, &Y, &Z);\n        if (X == 0) return 0;\n\n        for (int i = 0; i < X; i++)\n            scanf("%d", &roulette[i]);\n\n        for (int i = 0; i < kMaxSquare; i++)\n            board[i] = {0, 0};\n\n        for (; Z > 0; Z--) {\n            int N, E, A;\n            scanf("%d %d %d", &N, &E, &