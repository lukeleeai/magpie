2025-02-24 22:53:51,678	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include <cstdio>\n#include <vector>\n#include <algorithm>\n\nconst int kMaxSquare = 64;\n\nint roulette[4];\n\nstruct BoardState {\n    int type;\n    int value;\n};\n\nBoardState board[kMaxSquare];\n\nint bp(int X, int Y) {\n    std::vector<std::vector<double>> bp(Y + 1, std::vector<double>(X + 1, 0));\n    double prob = 1.0f / static_cast<double>(X);\n    bp[0][0] = 1.0f;\n\n    for (int n = 0; n < Y; n++) {\n        for (int k = 0; k < X; k++) {\n            int pos = (n + roulette[k] < Y) ? n + roulette[k] : Y;\n            if (board[pos].type == 1) {\n                bp[pos + board[pos].value < Y ? pos + board[pos].value : Y][0] += bp[n][0] * prob;\n            } else if (board[pos].type == 2) {\n                bp[pos][0 + board[pos].value] += bp[n][0] * prob;\n            } else if (board[pos].type == 3) {\n                bp[pos][(0 - board[pos].value > 0) ? 0 - board[pos].value : 0] += bp[n][0] * prob;\n            } else {\n                bp[pos][0] += bp[n][0] * prob;\n            }\n        }\n    }\n\n    double res = 0.0f;\n    for (int i = 0; i <= X; i++) {\n        res += static_cast<double>(i) * bp[Y][i];\n    }\n    return static_cast<int>(res);\n}\n\nint main() {\n    while (1) {\n        int X, Y, Z;\n        scanf("%d %d %d", &X, &Y, &Z);\n        if (X == 0) return 0;\n\n        for (int i = 0; i < X; i++)\n            scanf("%d", &roulette[i]);\n\n        for (int i = 0; i < kMaxSquare; i++)\n            board[i] = {0, 0};\n\n        for (; Z > 0; Z--) {\n            int N, E, A;\n            scanf("%d %d %d", &N, &E, &A);\n            board[N] = {E, A};\n        }\n\n        printf("%d\\n", bp(X, Y));\n    }\n}')"
