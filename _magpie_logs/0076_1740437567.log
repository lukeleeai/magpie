ossible value of \'it.first\'\n\nint roulette[4];\n\nstruct BoardState {\n    int type;\n    int value;\n};\n\nBoardState board[kMaxSquare];\n\ndouble bp[kMaxSquare][kMaxValue]; // Change from std::map to fixed-size array\n\nint bpFunc(int X, int Y) {\n    double prob = 1.0f / X;\n    bp[0][0] = 1.0f;\n\n    for (int n = 0; n < Y; n++) {\n        for (int v = 0; v < kMaxValue; v++) {\n            if (bp[n][v] > 0) {\n                for (int k = 0; k < X; k++) {\n                    int pos = std::min(n + roulette[k], Y);\n                    switch (board[pos].type) {\n                        case 1:\n                            bp[std::min(pos + board[pos].value, Y)][v] += bp[n][v] * prob;\n                            break;\n                        case 2:\n                            bp[pos][v + board[pos].value] += bp[n][v] * prob;\n                            break;\n                        case 3:\n                            bp[pos][std::max(v - board[pos].value, 0)] += bp[n][v] * prob;\n                            break;\n                        default:\n                            bp[pos][v] += bp[n][v] * prob;\n                            break;\n                    }\n                }\n            }\n        }\n    }\n\n    double res = 0.0f;\n    for (int v = 0; v < kMaxValue; v++)\n        res += static_cast<double>(v) * bp[Y][v];\n    return static_cast<int>(res);\n}\n\nint main() {\n    while (true) {\n        int X, Y, Z;\n        scanf("%d %d %d", &X, &Y, &Z);\n        if (X == 0) break;\n\n        for (int i = 0; i < X; i++)\n            scanf("%d", &roulette[i]);\n\n        for (int i = 0; i < kMaxSquare; i++)\n            board[i] = {0, 0};\n\n        for (; Z > 0; Z--) {\n            int N, E, A;\n            scanf("%d %d %d", &N, &E, &A);\n            board[N] = {E, A};\n        }\n\n        printf("%d\\n", bpFunc(X, Y));\n    }\n}')"
