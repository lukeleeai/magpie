Square = 64;\n\nint roulette[4];\n\nstruct BoardState {\n    int type;\n    int value;\n};\n\nBoardState board[kMaxSquare];\n\nint bp(int X, int Y) {\n    std::vector<double> bp[kMaxSquare];\n    for (int i = 0; i < kMaxSquare; i++) {\n        bp[i].resize(Y + 1, 0.0);\n    }\n    \n    double prob = 1.0f / X;\n    bp[0][0] = 1.0f;\n\n    for (int n = 0; n < Y; n++) {\n        for (int k = 0; k < X; k++) {\n            int pos = std::min(n + roulette[k], Y);\n            for (int newValue = 0; newValue <= Y; newValue++) {\n                double currentProb = bp[n][newValue];\n                if (currentProb == 0.0) continue;\n\n                switch (board[pos].type) {\n                    case 1:\n                        bp[std::min(pos + board[pos].value, Y)][newValue] += currentProb * prob;\n                        break;\n                    case 2:\n                        bp[pos][std::min(newValue + board[pos].value, Y)] += currentProb * prob;\n                        break;\n                    case 3:\n                        bp[pos][std::max(newValue - board[pos].value, 0)] += currentProb * prob;\n                        break;\n                    default:\n                        bp[pos][newValue] += currentProb * prob;\n                        break;\n                }\n            }\n        }\n    }\n\n    double res = 0.0f;\n    for (int i = 0; i <= Y; i++)\n        res += static_cast<double>(i) * bp[Y][i];\n    return static_cast<int>(res);\n}\n\nint main() {\n    while (1) {\n        int X, Y, Z;\n        scanf("%d %d %d", &X, &Y, &Z);\n        if (X == 0) return 0;\n\n        for (int i = 0; i < X; i++)\n            scanf("%d", &roulette[i]);\n\n        for (int i = 0; i < kMaxSquare; i++)\n            board[i] = {0, 0};\n\n        for (; Z > 0; Z--) {\n            int N, E, A;\n            scanf("%d %d %d", &N, &E, &A);\n            board[N] = {E, A};\n        }\n\n        printf("%d\\n", bp(X, Y));\n    }\n}')"
