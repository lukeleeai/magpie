 Assuming a reasonable maximum value for it.first\n\nint roulette[4];\ndouble bp[kMaxSquare][kMaxValue]; // Change std::map to a fixed array\nstruct BoardState {\n    int type;\n    int value;\n};\n\nBoardState board[kMaxSquare];\n\nint bp_func(int X, int Y) {\n    double prob = 1.0f / X;\n    memset(bp, 0, sizeof(bp)); // Initialize the bp array\n    bp[0][0] = 1.0f;\n\n    for (int n = 0; n < Y; n++) {\n        for (int k = 0; k < X; k++) {\n            int pos = std::min(n + roulette[k], Y);\n            switch (board[pos].type) {\n                case 1:\n                    bp[std::min(pos + board[pos].value, Y)][0] += bp[n][0] * prob; // Only one state tracked\n                    break;\n                case 2:\n                    bp[pos][board[pos].value] += bp[n][0] * prob; // Adjust for value addition\n                    break;\n                case 3:\n                    bp[pos][0] += bp[n][0] * prob; // Adjust for value subtraction\n                    break;\n                default:\n                    bp[pos][0] += bp[n][0] * prob; // Default case remains unchanged\n                    break;\n            }\n        }\n    }\n\n    double res = 0.0f;\n    for (int i = 0; i < kMaxValue; i++) // Calculate the final result\n        res += static_cast<double>(i) * bp[Y][i];\n    return static_cast<int>(res);\n}\n\nint main() {\n    while (true) {\n        int X, Y, Z;\n        scanf("%d %d %d", &X, &Y, &Z);\n        if (X == 0) break;\n\n        for (int i = 0; i < X; i++)\n            scanf("%d", &roulette[i]);\n\n        for (int i = 0; i < kMaxSquare; i++)\n            board[i] = {0, 0};\n\n        for (; Z > 0; Z--) {\n            int N, E, A;\n            scanf("%d %d %d", &N, &E, &A);\n            board[N] = {E, A};\n        }\n\n        printf("%d\\n", bp_func(X, Y));\n    }\n}')"
