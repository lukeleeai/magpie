LineLLMMutation(('source.cpp', 19), '#include <cstdio>\n\nusing namespace std;\n\nint main() {\n\n    long NUM = 1000000;\n\n    long n;\n\n    long counter = 0;\n\n    bool primeNum[NUM + 10];\n\n    long i, ii, j, len = NUM + 10;\n\n    primeNum[0] = primeNum[1] = false;\n    for (i = 2; i < len; i++) primeNum[i] = true;\n\n    ii = 4;\n\n    for(i = 2; ii < NUM;) {\n        if (primeNum[i]) {\n            for (j = ii; j < NUM; j += i) {\n                primeNum[j] = false;\n            }\n        }\n\n        i++;\n        ii = i * i;\n    }\n\n    while (scanf("%ld", &n) != EOF) {\n        counter = 0;\n\n        for (i = 0; i <= n; i++) {\n            if (primeNum[i]) counter++;\n        }\n\n        printf("%ld\\n", counter);\n    }\n\n    return 0;\n}')
