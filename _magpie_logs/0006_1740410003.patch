LineLLMCrossover(('source.cpp', 2), '#include<iostream>\nusing namespace std;\n\nint main() {\n    int n, cnt;\n\n    while (cin >> n) {\n        bool prime[n + 1] = {false}; // Dynamic array size based on input\n        prime[1] = true; // 1 is not prime\n\n        for (int j = 2; j * j <= n; j++) {\n            if (!prime[j]) {\n                for (int k = j * j; k <= n; k += j) {\n                    prime[k] = true;\n                }\n            }\n        }\n\n        cnt = 0;\n        for (int i = 1; i <= n; i++) {\n            if (!prime[i]) cnt++;\n        }\n\n        cout << cnt << endl;\n    }\n}')
