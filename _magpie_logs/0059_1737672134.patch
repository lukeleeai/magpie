LineLLMCrossover(('source.cpp', 28), '#include <cstdio>\n#include <algorithm>\n\nvoid ToOctalNumber(int n) {\n    if (n == 0) {\n        printf("0");\n        return;\n    }\n\n    int octalDigit;\n    int digits[11]; // For storing the results temporarily\n    int index = 0;\n\n    while (n > 0) {\n        octalDigit = n & 7; // Get the last 3 bits (octal digit)\n        digits[index++] = (octalDigit < 4 ? octalDigit : (octalDigit == 4 ? 5 : octalDigit + 2)); // Optimize octal digit\n        n >>= 3; // Right shift to process the next octal digit\n    }\n\n    // Print the octal number in reverse order\n    for (int i = index - 1; i >= 0; --i) {\n        printf("%d", digits[i]);\n    }\n}\n\nint main() {\n    int n;\n    while (scanf("%d", &n), n) {\n        ToOctalNumber(n);\n        printf("\\n");\n    }\n}') + LineLLMMutation(('source.cpp', 43), '#include <cstdio>\n#include <algorithm>\n\nvoid ToOctalNumber(int n) {\n    if (n == 0) {\n        printf("0");\n        return;\n    }\n\n    int octalDigit;\n    int output[11]; // For storing the results temporarily\n    int index = 0;\n\n    while (n > 0) {\n        octalDigit = n & 7; // Get the last 3 bits (octal digit)\n        output[index++] = (octalDigit < 4 ? octalDigit : (octalDigit == 4 ? 5 : octalDigit + 2)); // Optimize octal digit\n        n >>= 3; // Right shift to process the next octal digit\n    }\n\n    // Print the octal number in reverse order directly without storing\n    for (int i = index - 1; i >= 0; --i) {\n        printf("%d", output[i]);\n    }\n}\n\nint main() {\n    int n;\n    while (scanf("%d", &n), n) {\n        ToOctalNumber(n);\n        printf("\\n");\n    }\n}')
