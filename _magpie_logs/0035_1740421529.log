2025-02-24 18:28:04,164	[DEBUG]	patch(1-1)="LineLLMMutation(('source.cpp', 14), '#include <stdio.h>\n\nconst int MAX_X = 10000;\nint prime[MAX_X + 1]; // Ensure prime array covers all numbers up to MAX_X\n\nvoid sieve() {\n    for (int i = 2; i <= MAX_X; i++) {\n        prime[i] = 1; // Initialize all numbers as prime\n    }\n    for (int i = 2; i * i <= MAX_X; i++) {\n        if (prime[i]) {\n            for (int k = i * i; k <= MAX_X; k += i) { // Start from i*i for optimization\n                prime[k] = 0; // Mark multiples of i as non-prime\n            }\n        }\n    }\n}\n\nint main() {\n    sieve(); // Generate prime numbers once at the start\n\n    int n;\n    while (scanf("%d", &n), n != 0) { // Combine input and condition check\n        int max = -1; // Initialize max to -1 to handle edge cases\n        for (int i = n; i >= 2; i--) {\n            if (prime[i] && i >= 2 && prime[i - 2]) {\n                max = i; // Find the largest prime number that has a twin prime\n                break;\n            }\n        }\n        if (max != -1) { // Check if a prime was found\n            printf("%d %d\\n", max - 2, max);\n        } else {\n            printf("No twin prime found.\\n"); // Handle case where no twin primes are found\n        }\n    }\n    return 0;\n}')"
