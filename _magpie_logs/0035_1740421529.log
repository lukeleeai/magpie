 a smaller data type for the prime array\n    bool prime[MAX_X + 1];\n    memset(prime, 1, sizeof(prime)); // Initialize all entries as true\n    int n;\n\n    // Sieve of Eratosthenes\n    prime[0] = prime[1] = 0; // 0 and 1 are not prime\n    for (int i = 2; i * i <= MAX_X; i++) {\n        if (prime[i]) {\n            for (int k = i * i; k <= MAX_X; k += i) {\n                prime[k] = 0; // mark as non-prime\n            }\n        }\n    }\n\n    // Read input and find prime twins\n    while (true) {\n        scanf("%d", &n);\n        if (n == 0) break;\n\n        int max = -1;\n        for (int i = (n % 2 == 0 ? n - 1 : n); i >= 2; i -= 2) { // Check only odd numbers\n            if (prime[i] && prime[i - 2]) {\n                max = i;\n                break;\n            }\n        }\n\n        if (max != -1)\n            printf("%d %d\\n", max - 2, max);\n    }\n\n    return 0;\n}')"

