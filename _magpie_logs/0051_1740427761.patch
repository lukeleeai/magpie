LineLLMCrossover(('source.cpp', 6), '#include <cstdio>\n#include <queue>\n#include <vector>\n\nusing namespace std;\n\ntypedef pair<pair<int,int>,int> NODE;\n\n#define X first.second\n#define Y first.first\n#define depth second\n\nint ox[] = {-1, 1, 0, 0, 1, 1};\nint oy[] = { 0, 0,-1, 1,-1, 1};\nint ex[] = {-1, 1, 0, 0,-1,-1};\nint ey[] = { 0, 0,-1, 1,-1, 1};\n\nint main() {\n    int h, w, a, b, t, x, y, s;\n\n    while (scanf("%d", &w) && w) {\n        scanf("%d", &h);\n        vector<vector<int>> point(h, vector<int>(w, 0));\n        scanf("%d", &t);\n\n        for (int i = 0; i < t; i++) {\n            scanf("%d%d", &a, &b);\n            point[--b][--a] = i + 1;\n        }\n\n        scanf("%d", &s);\n        int ret = 0;\n        for (int P = 0; P < s; P++) {\n            scanf("%d%d", &a, &b);\n            point[--b][--a] = 50;\n\n            int pt[100] = {0};\n            for (int i = 0; i < h; i++) {\n                for (int j = 0; j < w; j++) {\n                    x = j, y = i;\n                    queue<NODE> Q;\n                    pair<int,int> dp[100] = {};\n                    bool done[100][100] = {false};\n\n                    Q.push(make_pair(make_pair(y, x), 0));\n                    while (!Q.empty()) {\n                        NODE q = Q.front(); Q.pop();\n                        if (point[q.Y][q.X]) {\n                            dp[q.depth].first++;\n                            dp[q.depth].second = point[q.Y][q.X];\n                        }\n\n                        if (q.Y % 2 == 1) {\n                            for (int L = 0; L < 6; L++) {\n                                int newX = q.X + ox[L], newY = q.Y + oy[L];\n                                if (newX >= 0 && newX < w && newY < h && newY >= 0 && !done[newY][newX]) {\n                                    Q.push(make_pair(make_pair(newY, newX), q.depth + 1));\n                                    done[newY][newX] = true;\n                                }\n                            }\n                        } else {\n                            for (int L = 0; L < 6; L++) {\n                                int newX = q.X + ex[L], newY = q.Y + ey[L];\n                                if (newX >= 0 && newX < w && newY < h && newY >= 0 && !done[newY][newX]) {\n                                    Q.push(make_pair(make_pair(newY, newX), q.depth + 1));\n                                    done[newY][newX] = true;\n                                }\n                            }\n                        }\n                    }\n\n                    for (int I = 0; I < 100; I++) {\n                        if (dp[I].first) {\n                            if (dp[I].first == 1)\n                                pt[dp[I].second - 1]++;\n                            break;\n                        }\n                    }\n                }\n            }\n            ret = max(pt[49], ret);\n            point[b][a] = 0;\n        }\n        printf("%d\\n", ret);\n    }\n}')
