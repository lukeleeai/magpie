LineLLMCrossover(('source.cpp', 11), '#include <cstdio>\n#include <cfloat>\n#include <algorithm>\nusing namespace std;\n\nchar f[10][21];\nint n, w[10], s[10], a[10], b[10];\nbool u[10];\ndouble maxg;\n\nvoid dfs(int x, int tw, int m, double g) {\n    if (m == n) {\n        if (maxg < g) {\n            maxg = g;\n            for (int i = 0; i < n; i++) {\n                b[i] = a[i];\n            }\n        }\n        return;\n    }\n    \n    if (x >= n) {\n        return;\n    }\n    \n    if (!u[x] && tw <= s[x]) {\n        u[x] = true;\n        tw += w[x];\n        a[m] = x;\n        dfs(0, tw, m + 1, g + w[x] * (m + 1));\n        tw -= w[x];\n        u[x] = false;\n    }\n    \n    dfs(x + 1, tw, m, g);\n}\n\nint main() {\n    while (1) {\n        scanf("%d", &n);\n        if (!n) break;\n        for (int i = 0; i < n; i++) {\n            scanf("%s %d %d", f[i], &w[i], &s[i]);\n        }\n        fill(u, u + n, false);\n        double maxg = -1e9;\n        dfs(0, 0, 0, 0.);\n        for (int i = n - 1; i >= 0; i--) {\n            printf("%s\\n", f[b[i]]);\n        }\n    }\n    return 0;\n}')
