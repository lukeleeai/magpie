LineLLMCrossover(('source.cpp', 10), '#include <cstdio>\n#include <cstring>\n\nusing namespace std;\n\n#define reep(i,f,t) for(int i=f ; i<int(t) ; ++i)\n#define rep(i,n) reep(i, 0, n)\n\ninline int computeSum(int* nums, int n, int i) {\n    int sum = 0;\n    rep(j, n) {\n        int idx = (j + i) % n; // Precompute index\n        sum += nums[j] & nums[idx];\n    }\n    return sum;\n}\n\nint main() {\n    int n;\n    while(scanf("%d", &n), n) {\n        int nums[n];\n        memset(nums, 0, sizeof(nums));\n\n        reep(i, 1, n)\n            nums[(i*i)%n] |= 1;\n\n        reep(i, 1, (n+1)/2) {\n            printf("%d\\n", computeSum(nums, n, i) * 2); // Using computeSum for efficiency\n        }\n    }\n    return 0;\n}')
