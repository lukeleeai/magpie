2025-02-25 00:29:09,533	[DEBUG]	patch(1-5)="LineLLMMutation(('source.cpp', 10), '#define _CRT_SECURE_NO_WARNINGS\n\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <limits>\n\nusing namespace std;\n\ntypedef long long ll;\ntypedef vector<int> vi;\ntypedef pair<int,int> pii;\n\nvoid fastios() {\n    ios_base::sync_with_stdio(0);\n    cin.tie(0);\n}\n\nint popcount(unsigned long long x) {\n    static int dp[66000];\n    if (dp[65536] != 16) {\n        for (int i = 0; i < 65536; i++) dp[i] = (i & 1) + dp[i >> 1];\n    }\n    int res = 0;\n    while (x) res += dp[x & 65535], x >>= 16;\n    return res;\n}\n\nint solve(ll s, ll d) {\n    if (s <= 0 && d >= 0) return popcount(-s) + popcount(d);\n    else if (s >= 0 && d >= 0) {\n        int j = 0;\n        int ans = 0;\n        while (s < d) {\n            if ((s >> j & 1) && (d >> j & 1)) {\n                s += 1LL << j;\n                d -= 1LL << j;\n                ans += 2;\n            } else if ((s >> j & 1) ^ (d >> j & 1)) {\n                s += 1LL << j;\n                ans++;\n            }\n            j++;\n        }\n        return ans;\n    } else return solve(-d, -s);\n}\n\nsigned main() {\n    fastios();\n    int N;\n    cin >> N;\n    for (int i = 0; i < N; i++) {\n        ll s, d;\n        cin >> s >> d;\n        cout << solve(s, d) << endl;\n    }\n}')"

