 l;\n\n}\n\n#define mems(arr,val) memset(arr,val,sizeof(arr));\n\nint const mod = 1000000007;\n\nint const inf = numeric_limits<int>::max()/10;\n\n\n\nint popcount(unsigned long long x){\n\n    static int dp[66000];\n\n    if(dp[65536] != 16) for(int i = 0; i < 65536; i++) dp[i] = (i&1) + dp[i>>1];\n\n    int res = 0;\n\n    while(x) res += dp[x&65535], x >>= 16;\n\n    return res;\n\n}\n\n\n\nint solve(ll s, ll d){\n\n    //if(s <= 0 && d >= 0) return __builtin_popcount(-s) + __builtin_popcount(d);\n\n    if(s <= 0 && d >= 0) return popcount(-s) + popcount(d);\n\n    else if(s >= 0 && d >= 0){\n\n        int j = 0;\n\n        int ans = 0;\n\n        while(s < d){\n\n            if((s>>j&1) && (d>>j&1)){\n\n                s += 1LL<<j;\n\n                d -= 1LL<<j;\n\n                ans += 2;\n\n            } else if((s>>j&1) ^ (d>>j&1)){\n\n                s += 1LL<<j;\n\n                ans ++;\n\n            }\n\n            j++;\n\n        }\n\n        return ans;\n\n    } else return solve(-d,-s);\n\n}\n\n\n\nsigned main(){\n\n    fastios();\n\n    int N;\n\n    cin >> N;\n\n    rep(i,N){\n\n        ll s,d;\n\n        cin >> s >> d;\n\n        cout << solve(s,d) << endl;\n\n    }\n\n}')"
