LineLLMCrossover(('source.cpp', 8), '#include <cstdio>\n#include <cmath>\n\ninline int getNumDigits(int sum) {\n    return (sum == 0) ? 1 : static_cast<int>(log10(abs(sum))) + 1;\n}\n\nvoid problemOne() {\n    int a, b;\n    while (scanf("%d %d", &a, &b) == 2) {\n        printf("%d\\n", getNumDigits(a + b));\n    }\n}\n\nint main() {\n    problemOne();\n}')
