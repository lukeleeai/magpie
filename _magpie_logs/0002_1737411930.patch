LineLLMCrossover(('source.cpp', 37), '#include <vector>\n#include <iostream>\n#include <cstring>\n#include <algorithm>\n\nusing namespace std;\n\n#define ll long long\n#define mx 100005\n#define inf 100000000000000000LL\n\nll arr[mx], dp[mx];\nint n, k;\n\nvoid solve() {\n    dp[n] = 0; // Base case\n    for (int pos = n - 1; pos >= 0; pos--) {\n        ll ret = inf;\n        for (int i = 1; i <= k; i++) {\n            int nxt = pos + i;\n            if (nxt > n) break;\n            ret = min(ret, llabs(arr[pos] - arr[nxt]) + dp[nxt]);\n        }\n        dp[pos] = ret;\n    }\n}\n\nint main() {\n    while (scanf("%d%d", &n, &k)) {\n        for (int i = 1; i <= n; i++)\n            scanf("%lld", &arr[i]);\n        for (int i = 0; i <= n; i++)\n            dp[i] = inf; // Initialization of dp array\n        solve();\n        printf("%lld\\n", dp[1]);\n        return 0;\n    }\n}') + LineLLMMutation(('source.cpp', 56), '#include <vector>\n#include <iostream>\n#include <cstring>\n#include <algorithm>\n\nusing namespace std;\n\n#define ll long long\n#define mx 100005\n#define inf 100000000000000000LL\n\nll arr[mx], dp[mx];\nint n, k;\n\nvoid solve() {\n    dp[n] = 0; // Base case\n    for (int pos = n - 1; pos >= 0; pos--) {\n        ll ret = inf;\n        for (int i = 1; i <= k; i++) {\n            int nxt = pos + i;\n            if (nxt > n) break;\n            // Combine the calculation of absolute difference and dp[nxt]\n            ll current_diff = arr[pos] - arr[nxt];\n            ret = min(ret, (current_diff < 0 ? -current_diff : current_diff) + dp[nxt]);\n        }\n        dp[pos] = ret;\n    }\n}\n\nint main() {\n    while (scanf("%d%d", &n, &k)) {\n        for (int i = 1; i <= n; i++)\n            scanf("%lld", &arr[i]);\n        for (int i = 0; i <= n; i++)\n            dp[i] = inf; // Initialization of dp array\n        solve();\n        printf("%lld\\n", dp[1]);\n        return 0;\n    }\n}') + LineLLMMutation(('source.cpp', 66), '#include <vector>\n#include <iostream>\n#include <cstring>\n#include <algorithm>\n\nusing namespace std;\n\n#define ll long long\n#define mx 100005\n#define inf 100000000000000000LL\n\nll arr[mx], dp[mx];\nint n, k;\n\nvoid solve() {\n    dp[n] = 0; // Base case\n    for (int pos = n - 1; pos >= 0; pos--) {\n        ll ret = inf;\n        for (int i = 1; i <= k; i++) {\n            int nxt = pos + i;\n            if (nxt > n) break;\n            // Use std::abs for calculating absolute difference\n            ll current_diff = abs(arr[pos] - arr[nxt]);\n            ret = min(ret, current_diff + dp[nxt]);\n        }\n        dp[pos] = ret;\n    }\n}\n\nint main() {\n    while (scanf("%d%d", &n, &k)) {\n        for (int i = 1; i <= n; i++)\n            scanf("%lld", &arr[i]);\n        for (int i = 0; i <= n; i++)\n            dp[i] = inf; // Initialization of dp array\n        solve();\n        printf("%lld\\n", dp[1]);\n        return 0;\n    }\n}') + LineLLMMutation(('source.cpp', 84), '#include <vector>\n#include <iostream>\n#include <cstring>\n#include <algorithm>\n\nusing namespace std;\n\n#define ll long long\n#define mx 100005\n#define inf 100000000000000000LL\n\nll arr[mx], dp[mx];\nint n, k;\n\nvoid solve() {\n    dp[n] = 0; // Base case\n    for (int pos = n - 1; pos >= 0; pos--) {\n        ll ret = inf;\n        for (int i = 1; i <= k; i++) {\n            int nxt = pos + i;\n            if (nxt > n) break;\n            // Use std::abs for calculating absolute difference\n            ll current_diff = abs(arr[pos] - arr[nxt]);\n            ret = min(ret, current_diff + dp[nxt]);\n        }\n        dp[pos] = ret;\n    }\n}\n\nint main() {\n    while (scanf("%d%d", &n, &k)) {\n        for (int i = 1; i <= n; i++)\n            scanf("%lld", &arr[i]);\n        // Use std::fill instead of a loop for initialization of dp array\n        std::fill(dp, dp + n + 1, inf);\n        solve();\n        printf("%lld\\n", dp[1]);\n        return 0;\n    }\n}')
