LineLLMCrossover(('source.cpp', 32), '#include <iostream>\n#include <unordered_map>\n#include <vector>\n#include <tuple>\n#include <algorithm>\n\nusing namespace std;\n\nint main() {\n    int n, a, b;\n    string number;\n    unordered_map<string, long long> info; // Using long long for large values\n    vector<string> seq; // Using vector for efficient storage\n\n    while (cin >> n && n) {\n        info.clear();\n        seq.clear();\n        while (n--) {\n            cin >> number >> a >> b;\n            long long value = a * b; // Calculate value directly\n            // Use operator[] for direct access and insertion\n            long long& current_value = info[number]; \n            if (current_value == 0) {\n                seq.push_back(number); // Insert a new entry\n            }\n            current_value += value;\n            if (current_value > 1000000) {\n                current_value = 1000000; // Cap the value\n            }\n        }\n        bool flag = true;\n        for (const auto& num : seq) {\n            if (info[num] >= 1000000) {\n                flag = false;\n                cout << num << endl;\n            }\n        }\n        if (flag) cout << "NA" << endl;\n    }\n}')
