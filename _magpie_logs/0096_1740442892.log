LineLLMCrossover(('source.cpp', 6), '#include <iostream>\n#include <vector>\n#include <queue>\n#include <cstdio>\nusing namespace std;\n\nconst int MAX_EXP = 105;\nconst int MAX_END = 105;\nint d, n;\nvector<int> a, e, r;\nint memo[MAX_EXP][MAX_END];\nconst int INF = 1000000000;\n\nvoid iterative() {\n    queue<pair<int, pair<int, int>>> q;\n    q.push({0, {0, d}});\n\n    while (!q.empty()) {\n        auto [c, exp_end] = q.front();\n        int exp = exp_end.first;\n        int end = exp_end.second;\n        q.pop();\n\n        if (memo[exp][end] <= c) continue;\n        memo[exp][end] = c;\n\n        for (int i = 0; i < n; i++) {\n            if (exp < r[i]) continue;\n            q.push({c + 1, {min(exp + e[i], 100), max(end - a[i], 0)}});\n        }\n    }\n}\n\nint main() {\n    while (scanf("%d %d", &d, &n), d) {\n        a.resize(n);\n        e.resize(n);\n        r.resize(n);\n        for (int i = 0; i < n; i++) scanf("%d %d %d", &a[i], &e[i], &r[i]);\n        fill(&memo[0][0], &memo[0][0] + sizeof(memo) / sizeof(int), INF);\n        iterative();\n        int ans = INF;\n        for (int i = 0; i < 101; i++) ans = min(ans, memo[i][0]);\n        printf("%s\\n", ans == INF ? "NA" : to_string(ans).c_str());\n    }\n    return 0;\n}') + LineLLMMutation(('source.cpp', 25), '#include <iostream>\n#include <vector>\n#include <queue>\n#include <cstdio>\nusing namespace std;\n\nconst int MAX_EXP = 105;\nconst int MAX_END = 105;\nint d, n;\nvector<int> a, e, r;\nint memo[MAX_EXP][MAX_END];\nconst int INF = 1000000000;\n\nstruct State {\n    int cost;\n    int exp;\n    int end;\n};\n\nvoid iterative() {\n    queue<State> q;\n    q.push({0, 0, d});\n\n    while (!q.empty()) {\n        State current = q.front();\n        q.pop();\n\n        if (memo[current.exp][current.end] <= current.cost) continue;\n        memo[current.exp][current.end] = current.cost;\n\n        for (int i = 0; i < n; i++) {\n            if (current.exp < r[i]) continue;\n            q.push({current