_EXP; exp++) {\n                int new_exp = min(exp + e[i], 100);\n                int new_end = max(d - a[i], 0);\n                if (memo[new_exp][new_end] > c + 1) {\n                    memo[new_exp][new_end] = c + 1;\n                }\n            }\n        }\n    }\n}\n\nint main() {\n    while (scanf("%d %d", &d, &n), d) {\n        a.resize(n);\n        e.resize(n);\n        r.resize(n);\n        for (int i = 0; i < n; i++) scanf("%d %d %d", &a[i], &e[i], &r[i]);\n        iterative();\n        int ans = INF;\n        for (int i = 0; i < 101; i++) ans = min(ans, memo[i][0]);\n        printf("%s\\n", ans == INF ? "NA" : to_string(ans).c_str());\n    }\n    return 0;\n}')"
