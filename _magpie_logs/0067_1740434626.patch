LineLLMMutation(('source.cpp', 0), '#include <cstdio>  \n#define MAX 10000  \n\nint main(void){  \n    int n, data[MAX + 1], des[2], num, max, mnum;  \n\n    for(;;){  \n        max = mnum = 0;  \n\n        for(int i = 0; i <= MAX; i++)  \n            data[i] = 0;  \n\n        scanf("%d", &n);  \n        if(n == 0) break;  \n\n        for(int i = 0; i < n; i++){  \n            scanf("%d %d %d", &num, &des[1], &des[0]);  \n            data[num] = des[0] + des[1];  \n\n            if(data[num] > max){  \n                max = data[num];  \n                mnum = num;  \n            }  \n        }  \n\n        printf("%d %d\\n", mnum, max);  \n    }  \n    return 0;  \n}')
