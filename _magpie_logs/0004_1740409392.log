2025-02-24 15:04:19,333	[DEBUG]	patch(0-10)="LineLLMMutation(('source.cpp', 9), '#include <cstdio>\n#include <vector>\n#include <cmath>\n\nusing namespace std;\n\nvoid simpleSieve(long limit, vector<long>& primes) {\n    vector<bool> mark(limit + 1, true);\n    for (long p = 2; p * p <= limit; p++) {\n        if (mark[p]) {\n            for (long i = p * p; i <= limit; i += p) {\n                mark[i] = false;\n            }\n        }\n    }\n    for (long p = 2; p <= limit; p++) {\n        if (mark[p]) primes.push_back(p);\n    }\n}\n\nvoid segmentedSieve(long n) {\n    long limit = floor(sqrt(n)) + 1;\n    vector<long> primes;\n    simpleSieve(limit, primes);\n\n    long low = limit;\n    long high = limit * 2;\n\n    while (low < n) {\n        if (high > n) high = n;\n\n        vector<bool> mark(high - low + 1, true);\n        for (long i : primes) {\n            long minMult = max(i * i, (low + i - 1) / i * i);\n            for (long j = minMult; j < high; j += i) {\n                mark[j - low] = false;\n            }\n        }\n\n        for (long i = low; i < high; i++) {\n            if (mark[i - low]) printf("%ld\\n", i);\n        }\n\n        low += limit;\n        high += limit;\n    }\n}\n\nint main() {\n    long n;\n    while (scanf("%ld", &n) != EOF) {\n        segmentedSieve(n);\n    }\n    return 0;\n}')"
