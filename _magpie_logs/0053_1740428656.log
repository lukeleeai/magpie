2025-02-24 20:25:43,596	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include <iostream>\n#include <vector>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\n\nint costs[1010][1010];\nint times[1010][1010];\nint d[1010];\n\n#define INF 10000\n\nstruct E {\n    int a, b, c;\n    E(int a, int b, int c) : a(a), b(b), c(c) {}\n};\n\n#define MONEY 0\n#define EKI 1\n\nint main() {\n    int n, m;\n    while (cin >> n >> m) {\n        if (n == 0 && m == 0) break;\n        memset(costs, INF, sizeof(costs));\n        memset(times, INF, sizeof(times));\n        vector<E> cs, ts;\n        int a, b, c, t;\n        for (int i = 0; i < n; ++i) {\n            cin >> a >> b >> c >> t;\n            costs[a][b] = c; costs[b][a] = c;\n            times[a][b] = t; times[b][a] = t;\n            cs.emplace_back(a, b, c);\n            cs.emplace_back(b, a, c);\n            ts.emplace_back(a, b, t);\n            ts.emplace_back(b, a, t);\n        }\n        for (int i = 0; i < m; ++i) {\n            costs[i][i] = 0;\n            times[i][i] = 0;\n        }\n        int k, p, q, r;\n        cin >> k;\n        for (int i = 0; i < k; ++i) {\n            memset(d, INF, sizeof(d));\n            cin >> p >> q >> r;\n            d[p] = 0;\n            while (true) {\n                bool update = false;\n                for (const auto& edge : (r == MONEY ? cs : ts)) {\n                    if (d[edge.a] != INF && d[edge.b] > d[edge.a] + (r == MONEY ? edge.c : edge.c)) {\n                        d[edge.b] = d[edge.a] + (r == MONEY ? edge.c : edge.c);\n                        update = true;\n                    }\n                }\n                if (!update) break;\n            }\n            cout << d[q] << endl;\n        }\n    }\n    return 0;\n}')"
