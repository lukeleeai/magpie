LineLLMCrossover(('source.cpp', 13), '#include <cstdio>\n\n#include <cfloat>\n\nusing namespace std;\n\n\n\nchar f[10][21];\n\nint n, w[10], s[10], a[10], b[10];\n\nbool u[10];\n\nfloat maxg;\n\n\n\nvoid dfs(int x, int tw, int m, float g) {\n\n  if (m == n) {\n\n    if (maxg < g) {\n\n      maxg = g;\n\n      for (int i=0; i<n; i++) {\n\n        b[i] = a[i];\n\n      }\n\n    }\n\n    return;\n\n  }\n\n  if (x>=n) {\n\n    return;\n\n  }\n\n  if (!u[x] && tw <= s[x]) {\n\n    u[x] = true;\n\n    tw += w[x];\n\n    a[m] = x;\n\n    dfs(0, tw, m+1, g + w[x]*(m+1));\n\n    tw -= w[x];\n\n    u[x] = false;\n\n  }\n\n  dfs(x+1, tw, m, g);\n\n}\n\n\n\nint main() {\n\n  while (1) {\n\n    scanf("%d", &n);\n\n    if (!n) break;\n\n    for (int i=0; i<n; i++) {\n\n      scanf("%s %d %d", f[i], &w[i], &s[i]);\n\n    }\n\n    for (int i=0; i<n; i++) {\n\n      u[i] = false;\n\n    }\n\n    maxg = -DBL_MAX;\n\n    dfs(0, 0, 0, 0.);\n\n    for (int i=n-1; i>=0; i--) {\n\n      printf("%s\\n", f[b[i]]);\n\n    }\n\n  }\n\n  return 0;\n\n}')
