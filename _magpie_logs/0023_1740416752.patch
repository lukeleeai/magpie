LineLLMCrossover(('source.cpp', 6), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\nint dp[1001][1001];\n\nint latte(int i, int j, int k) {\n    return dp[i + k][j + k] - dp[i + k][j - 1] - dp[i - 1][j + k] + dp[i - 1][j - 1];\n}\n\nint main() {\n    int n;\n    while (scanf("%d", &n), n) {\n        for (int i = 0; i <= n; i++)\n            for (int j = 0; j <= n; j++)\n                dp[i][j] = 0;\n\n        for (int i = 0; i < n; i++) {\n            char str[1001];\n            scanf("%s", str);\n            for (int j = 0; j < n; j++) {\n                dp[i + 1][j + 1] = dp[i][j + 1] + dp[i + 1][j] - dp[i][j];\n                if (str[j] == \'*\') dp[i + 1][j + 1]++;\n            }\n        }\n\n        int Max = 0;\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j <= n; j++) {\n                if (latte(i, j, 0)) continue;\n\n                int lb = 0, ub = min(n - i, n - j) + 1;\n                while (ub - lb > 1) {\n                    int k = (ub + lb) / 2;\n                    if (latte(i, j, k)) ub = k;\n                    else lb = k;\n                }\n                Max = max(Max, lb + 1);\n            }\n        }\n        printf("%d\\n", Max);\n    }\n}') + LineLLMMutation(('source.cpp', 23), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\nint dp[1002][1002];\n\nint latte(int i, int j, int k) {\n    return dp[i + k][j + k] - dp[i + k][j - 1] - dp[i - 1][j + k] + dp[i - 1][j - 1];\n}\n\nint main() {\n    int n;\n    while (scanf("%d", &n), n) {\n        // Use a single loop to fill dp table and count \'*\' simultaneously\n        for (int i = 0; i < n; i++) {\n            char str[1001];\n            scanf("%s", str);\n            for (int j = 0; j < n; j++) {\n                // Calculate dp[i + 1][j + 1] directly based on previous values\n                dp[i + 1][j + 1] = dp[i][j + 1] + dp[i + 1][j] - dp[i][j] + (str[j] == \'*\' ? 1 : 0);\n            }\n        }\n\n        int Max = 0;\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j <= n; j++) {\n                if (latte(i, j, 0)) continue;\n\n                int lb = 0, ub = min(n - i, n - j) + 1;\n                while (ub - lb > 1) {\n                    int k = (ub + lb) / 2;\n                    if (latte(i, j, k)) ub = k;\n                    else lb = k;\n                }\n                Max = max(Max, lb + 1);\n            }\n        }\n        printf("%d\\n", Max);\n    }\n}') + LineLLMMutation(('source.cpp', 25), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\nint dp[1002][1002];\n\nint latte(int i, int j, int k) {\n    return dp[i + k][j + k] - dp[i + k][j - 1] - dp[i - 1][j + k] + dp[i - 1][j - 1];\n}\n\nint main() {\n    int n;\n    while (scanf("%d", &n), n) {\n        // Use a single loop to fill dp table and count \'*\' simultaneously\n        for (int i = 0; i < n; i++) {\n            char str[1001];\n            scanf("%s", str);\n            for (int j = 0; j < n; j++) {\n                // Combine dp calculations and optimize to prevent out of bounds\n                dp[i + 1][j + 1] = (str[j] == \'*\' ? 1 : 0) + dp[i][j + 1] + dp[i + 1][j] - dp[i][j];\n            }\n        }\n\n        int Max = 0;\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j <= n; j++) {\n                if (latte(i, j, 0)) continue;\n\n                int lb = 0, ub = min(n - i, n - j) + 1;\n                // Optimize binary search loop to reduce unnecessary iterations\n                while (lb + 1 < ub) {\n                    int k = (ub + lb) / 2;\n                    if (latte(i, j, k)) ub = k;\n                    else lb = k;\n                }\n                Max = max(Max, lb + 1);\n            }\n        }\n        printf("%d\\n", Max);\n    }\n}')
