LineLLMCrossover(('source.cpp', 67), '#include <iostream>\n#include <omp.h>\n#include <cstdint>\n\nusing namespace std;\n\nuint64_t factorial_mod(uint64_t n, uint64_t mod) {\n    if (n == 0 || n == 1) return 1;\n    uint64_t ans = 1;\n\n    #pragma omp parallel \n    {\n        uint64_t local_ans = 1; // Local accumulation for each thread\n        #pragma omp for\n        for (uint64_t i = 2; i <= n; i++) {\n            local_ans = (local_ans * (i % mod)) % mod; // Use local variable with modulus\n        }\n        #pragma omp critical // Combine results safely\n        {\n            ans = (ans * local_ans) % mod;\n        }\n    }\n    return ans;\n}\n\nint main() {\n    uint64_t n;\n    cin >> n;\n    cout << factorial_mod(n, 1000000007) << endl;\n    return 0;\n}')
