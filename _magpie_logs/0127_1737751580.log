ar(); // Clear the unordered_set\n        sections.clear();\n        if (scanf("%d %d", &N, &K) != 2 || N == 0) break;\n        for (int i = 0; i < K; i++) {\n            int a;\n            scanf("%d", &a);\n            card.insert(a); // Insert elements into unordered_set\n        }\n        bool keep = false;\n        int st, ans = 0;\n        for (int i = 1; i <= N + 1; i++) {\n            if (keep && card.find(i) == card.end()) {\n                sections.push_back(Section(st, i));\n                keep = false;\n            }\n            if (!keep && card.find(i) != card.end()) {\n                st = i;\n                keep = true;\n            }\n        }\n        for (auto it = sections.begin(); it != sections.end(); ++it) {\n            if (card.find(0) != card.end() && (it + 1) != sections.end() && it->end() + 1 == (it + 1)->begin())\n                ans = max(ans, it->length() + (it + 1)->length() + 1);\n            if (card.find(0) != card.end())\n                ans = max(ans, it->length() + 1);\n            ans = max(ans, it->length());\n        }\n        printf("%d\\n", ans);\n    }\n}')"

