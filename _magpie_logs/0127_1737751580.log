2025-01-24 20:54:08,137	[DEBUG]	patch(5-10)="LineLLMCrossover(('source.cpp', 15), '#include <cstdio>\n#include <vector>\n#include <unordered_set>\nusing namespace std;\n\nclass Section {\nprivate:\n    int _begin, _end;\npublic:\n    Section(int b, int e) : _begin(b), _end(e) {}\n    int begin() const { return _begin; }\n    int end() const { return _end; }\n    int length() const { return end() - begin(); }\n};\n\nunordered_set<int> card;\nvector<Section> sections;\nint K, N;\n\nint main() {\n    while (true) {\n        card.clear();\n        sections.clear();\n        if (scanf("%d %d", &N, &K) != 2 || N == 0) break;\n        for (int i = 0; i < K; i++) {\n            int a;\n            scanf("%d", &a);\n            card.insert(a);\n        }\n        bool keep = false;\n        int st, ans = 0;\n        for (int i = 1; i <= N + 1; i++) {\n            if (keep && card.find(i) == card.end()) {\n                sections.push_back(Section(st, i));\n                keep = false;\n            }\n            if (!keep && card.find(i) != card.end()) {\n                st = i;\n                keep = true;\n            }\n        }\n        bool has_zero = card.find(0) != card.end();\n        for (const auto& sec : sections) {\n            ans = max(ans, sec.length());\n            if (has_zero) {\n                ans = max(ans, sec.length() + 1);\n            }\n        }\n        for (size_t j = 0; j < sections.size() - 1; ++j) {\n            if (has_zero && sections[j].end() + 1 == sections[j + 1].begin()) {\n                ans = max(ans, sections[j].length() + sections[j + 1].length() + 1);\n            }\n        }\n        printf("%d\\n", ans);\n    }\n}')"
