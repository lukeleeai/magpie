int length() const { return end() - begin(); }\n};\n\nunordered_set<int> card;\nvector<Section> sections;\nint K, N;\n\nint main() {\n    while (true) {\n        card.clear();\n        sections.clear();\n        cin >> N >> K;\n        if (N == 0) break;\n\n        for (int i = 0; i < K; i++) {\n            int a;\n            cin >> a;\n            card.insert(a);\n        }\n\n        sections.reserve(N); // Reserve space to prevent multiple allocations\n        bool keep = false;\n        int st, ans = 0;\n        for (int i = 1; i <= N + 1; i++) {\n            if (keep && card.find(i) == card.end()) {\n                sections.emplace_back(st, i); // Use emplace_back for efficiency\n                keep = false;\n            }\n            if (!keep && card.find(i) != card.end()) {\n                st = i;\n                keep = true;\n            }\n        }\n        bool has_zero = card.count(0) > 0; // Use count for clarity\n        for (const auto& sec : sections) {\n            ans = max(ans, sec.length());\n            if (has_zero) {\n                ans = max(ans, sec.length() + 1);\n            }\n        }\n        for (size_t j = 0; j < sections.size() - 1; ++j) {\n            if (has_zero && sections[j].end() + 1 == sections[j + 1].begin()) {\n                ans = max(ans, sections[j].length() + sections[j + 1].length() + 1);\n            }\n        }\n        cout << ans << endl;\n    }\n}')"
