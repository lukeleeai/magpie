th() const { return end() - begin(); }\n};\n\nvector<int> card;\nvector<Section> sections;\nint K, N;\n\nint main() {\n    while (true) {\n        card.clear();\n        sections.clear();\n        cin >> N >> K;\n        if (N == 0) break;\n\n        card.resize(K);\n        for (int i = 0; i < K; i++) {\n            cin >> card[i];\n        }\n        sort(card.begin(), card.end());  // Sort the vector for faster access\n\n        bool keep = false;\n        int st, ans = 0;\n        for (int i = 1; i <= N + 1; i++) {\n            if (keep && !binary_search(card.begin(), card.end(), i)) {\n                sections.push_back(Section(st, i));\n                keep = false;\n            }\n            if (!keep && binary_search(card.begin(), card.end(), i)) {\n                st = i;\n                keep = true;\n            }\n        }\n        bool has_zero = binary_search(card.begin(), card.end(), 0);\n        for (const auto& sec : sections) {\n            ans = max(ans, sec.length());\n            if (has_zero) {\n                ans = max(ans, sec.length() + 1);\n            }\n        }\n        for (size_t j = 0; j < sections.size() - 1; ++j) {\n            if (has_zero && sections[j].end() + 1 == sections[j + 1].begin()) {\n                ans = max(ans, sections[j].length() + sections[j + 1].length() + 1);\n            }\n        }\n        cout << ans << endl;\n    }\n}')"
