) const { return _end; }\n    int length() const { return end() - begin(); }\n};\n\nbool card[100001]; // Assuming N can be at most 100000\nvector<Section> sections;\nint K, N;\n\nint main() {\n    while (true) {\n        fill(card, card + 100001, false); // Initialize the array\n        sections.clear();\n        cin >> N >> K;\n        if (N == 0) break;\n\n        int inputs[100]; // Assuming K will not exceed 100\n        for (int i = 0; i < K; i++) {\n            cin >> inputs[i];\n            card[inputs[i]] = true; // Set presence in the boolean array\n        }\n\n        bool keep = false;\n        int st, ans = 0;\n        for (int i = 1; i <= N + 1; i++) {\n            if (keep && !card[i]) {\n                sections.push_back(Section(st, i));\n                keep = false;\n            }\n            if (!keep && card[i]) {\n                st = i;\n                keep = true;\n            }\n        }\n        bool has_zero = card[0];\n        for (const auto& sec : sections) {\n            ans = max(ans, sec.length());\n            if (has_zero) {\n                ans = max(ans, sec.length() + 1);\n            }\n        }\n        for (size_t j = 0; j < sections.size() - 1; ++j) {\n            if (has_zero && sections[j].end() + 1 == sections[j + 1].begin()) {\n                ans = max(ans, sections[j].length() + sections[j + 1].length() + 1);\n            }\n        }\n        cout << ans << endl;\n    }\n}')"
