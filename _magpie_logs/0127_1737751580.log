 end() const { return _end; }\n    int length() const { return end() - begin(); }\n};\n\nunordered_set<int> card;\nSection sections[100]; // Assuming a maximum of 100 sections\nint K, N;\n\nint main() {\n    while (true) {\n        card.clear();\n        int sectionCount = 0; // Track the number of sections\n        if (scanf("%d %d", &N, &K) != 2 || N == 0) break;\n\n        for (int i = 0; i < K; i++) {\n            int input;\n            scanf("%d", &input);\n            card.insert(input);\n        }\n\n        bool keep = false;\n        int st, ans = 0;\n        for (int i = 1; i <= N + 1; i++) {\n            if (keep && card.find(i) == card.end()) {\n                sections[sectionCount++] = Section(st, i);\n                keep = false;\n            }\n            if (!keep && card.find(i) != card.end()) {\n                st = i;\n                keep = true;\n            }\n        }\n        bool has_zero = card.find(0) != card.end();\n        for (int j = 0; j < sectionCount; ++j) {\n            ans = max(ans, sections[j].length());\n            if (has_zero) {\n                ans = max(ans, sections[j].length() + 1);\n            }\n        }\n        for (int j = 0; j < sectionCount - 1; ++j) {\n            if (has_zero && sections[j].end() + 1 == sections[j + 1].begin()) {\n                ans = max(ans, sections[j].length() + sections[j + 1].length() + 1);\n            }\n        }\n        printf("%d\\n", ans);\n    }\n}')"
