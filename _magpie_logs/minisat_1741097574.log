	LineLLMMutation
llm_prob = 1.0
warmup = 1
warmup_strategy = last
max_steps = 10
max_time = 20000
target_fitness = 
cache_maxsize = 100
cache_keep = 0.2
batch_instances = 
batch_shuffle = True
batch_bin_shuffle = False
batch_sample_size = 1

[search.ls]
