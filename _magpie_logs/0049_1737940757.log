2025-01-27 01:22:37,857	[DEBUG]	patch(1-2)="LineLLMMutation(('source.cpp', 15), '#include<iostream>\n#include<cstdio>\n#include<cstring>\n#include<queue>\n#include<vector>\n#include<algorithm>\n\nusing namespace std;\n\ntypedef long long LL;\n#define N 2010\n#define INF 0x3f3f3f\n\nint numberOfVertices;\nint adjacencyMatrix[N][N];\nint shortestDistances[N], visitedVertices[N];\n\nvoid Initialize(int matrixSize) {\n    for(int i=0; i<=matrixSize; i++)\n        for(int j=0; j<=matrixSize; j++)\n            adjacencyMatrix[i][j]=i==j ? 0 : INF;\n}\n\nvoid Dijkstra(int sourceVertex, int matrixSize) {\n    for(int i=0; i<=matrixSize; i++)\n        shortestDistances[i]=adjacencyMatrix[sourceVertex][i];\n    memset(visitedVertices, 0, sizeof(visitedVertices));\n    visitedVertices[sourceVertex]=1;\n\n    for(int i=0; i<=matrixSize; i++) {\n        int minimumDistance=INF, index=-1;\n        for(int j=0; j<=matrixSize; j++) {\n            if(!visitedVertices[j]&&shortestDistances[j]<minimumDistance) {\n                minimumDistance=shortestDistances[j];\n                index=j;\n            }\n        }\n        if(index==-1) continue;\n        visitedVertices[index]=1;\n        for(int j=0; j<=matrixSize; j++) {\n            if(!visitedVertices[j]&&shortestDistances[j]>minimumDistance+adjacencyMatrix[index][j])\n                shortestDistances[j]=minimumDistance+adjacencyMatrix[index][j];\n        }\n    }\n}\n\nint main() {\n    int vertexA, vertexB, edgeCost, maximumVertex, index, totalCost;\n    while(scanf("%d", &numberOfVertices), numberOfVertices) {\n        Initialize(1100);\n        maximumVertex=-1;\n        for(int i=1; i<=numberOfVertices; i++) {\n            scanf("%d%d%d", &vertexA, &vertexB, &edgeCost);\n            adjacencyMatrix[vertexA][vertexB]=adjacencyMatrix[vertexB][vertexA]=min(adjacencyMatrix[vertexA][vertexB], edgeCost);\n            maximumVertex=max(maximumVertex, vertexA);\n            maximumVertex=max(maximumVertex, vertexB);\n        }\n        int totalDistance;\n        totalCost=INF;\n        for(int i=0; i<=maximumVertex; i++) {\n            Dijkstra(i, maximumVertex);\n            totalDistance=0;\n            for(int j=0; j<=maximumVertex; j++)\n                totalDistance+=shortestDistances[j];\n            if(totalDistance<totalCost) {\n                index=i;\n                totalCost=totalDistance;\n            }\n        }\n        printf("%d %d\\n", index, totalCost);\n    }\n    return 0;\n}')"
