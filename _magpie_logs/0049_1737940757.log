2025-01-27 01:26:15,617	[DEBUG]	patch(4-9)="LineLLMCrossover(('source.cpp', 13), '#include <cstdio>\n\n#include <cstring>\n\n#include <algorithm>\n\nusing namespace std;\n\n#define N 2010\n\n#define INF 0x3f3f3f\n\nint n, m, maps[N][N], vis[N], dist[N];\n\nvoid Init(int m)\n\n{\n\n    for(int i = 0; i <= m; i++)\n\n        for(int j = 0; j <= m; j++)\n\n            maps[i][j] = INF;\n\n    for(int i = 0; i <= m; i++)\n\n        maps[i][i] = 0;\n\n}\n\n\n\nvoid dij(int s, int m)\n\n{\n\n\tfor(int i=0;i<=m;i++)\n\n\t\tdist[i]=maps[s][i];\n\n\tfill(vis,vis+m+1,0);\n\n\tvis[s]=1;\n\n\tfor(int i=0;i<=m;i++){\n\n\t\tint Min=INF,index=-1;\n\n\t\tfor(int j=0;j<=m;j++){\n\n\t\t\tif(!vis[j]&&dist[j]<Min)\n\n\t\t\t{\n\n\t\t\t\tMin=dist[j];\n\n\t\t\t\tindex=j;\n\n\t\t\t}\n\n\t\t}\n\n\t\tif(index==-1) continue;\n\n\t\tvis[index]=1;\n\n\t\tfor(int j=0;j<=m;j++)\n\n\t\t{\n\n\t\t\tif(!vis[j]&&dist[j]>Min+maps[index][j])\n\n\t\t\t\tdist[j]=Min+maps[index][j];\n\n\t\t}\n\n\t}\n\n}\n\n\n\nint main()\n\n{\n\n    int a, b, c, Max, index, sum;\n\n    while(scanf("%d", &n), n)\n\n    {\n\n        Init(1100);\n\n        Max=-1;\n\n        for(int i=1; i<=n; i++)\n\n        {\n\n            scanf("%d%d%d", &a, &b, &c);\n\n            maps[a][b]=maps[b][a]=min(maps[a][b], c);\n\n            Max=max(Max, a);\n\n            Max=max(Max, b);\n\n        }\n\n        sum=INF;\n\n        for(int i=0; i<=Max; i++)\n\n        {\n\n            dij(i, Max);\n\n            int s=0;\n\n            for(int j=0; j<=Max; j++)\n\n                s+=dist[j];\n\n            if(s<sum)\n\n            {\n\n                index=i;\n\n                sum=s;\n\n            }\n\n        }\n\n        printf("%d %d\\n", index, sum);\n\n    }\n\n    return 0;\n\n}')"
