ex, source);\n\n            maxNodeIndex=max(maxNodeIndex, destination);\n\n        }\n\n        int minCostNode;\n\n        totalCost=INF;\n\n        for(int i=0; i<=maxNodeIndex; i++)\n\n        {\n\n            dijkstra(i, maxNodeIndex);\n\n            minCostNode=0;\n\n            for(int j=0; j<=maxNodeIndex; j++)\n\n                minCostNode+=shortestDistances[j];\n\n            if(minCostNode<totalCost)\n\n            {\n\n                minCostNode=i;\n\n                totalCost=minCostNode;\n\n            }\n\n        }\n\n        printf("%d %d\\n", minCostNode, totalCost);\n\n    }\n\n    return 0;\n\n}')"
