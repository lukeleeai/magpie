        int totalDistance;\n        totalCost=INF;\n        for(int i=0; i<=maximumVertex; i++) {\n            Dijkstra(i, maximumVertex);\n            totalDistance=0;\n            for(int j=0; j<=maximumVertex; j++)\n                totalDistance+=shortestDistances[j];\n            if(totalDistance<totalCost) {\n                index=i;\n                totalCost=totalDistance;\n            }\n        }\n        printf("%d %d\\n", index, totalCost);\n    }\n    return 0;\n}') | LineLLMMutation(('source.cpp', 20), '#include<iostream>\n#include<cstdio>\n#include<cstring>\n#include<algorithm>\n#include<queue>\n\nusing namespace std;\nconst int N=1100;\nconst int INF=0x3f3f3f3f;\nint n,dist[N],G[N][N],vis[N];\n\nvoid Dijkstra(int s) {\n\tfor(int i=1;i<=n;i++) dist[i]=G[s][i],vis[i]=0;\n\tdist[s]=0;vis[s]=1;\n\tfor(int k=1;k<n;k++) {\n\t\tint x=-1,mn=INF;\n\t\tfor(int i=1;i<=n;i++) if(!vis[i]&&dist[i]<mn) mn=dist[i],x=i;\n\t\tif(x==-1) return;\n\t\tvis[x]=1;\n\t\tfor(int i=1;i<=n;i++) dist[i]=min(dist[i],dist[x]+G[x][i]);\n\t}\n}\n\nint main() {\n\tscanf("%d",&n);\n\tfor(int i=1;i<=n;i++) for(int j=1;j<=n;j++) G[i][j]=(i==j?0:INF);\n\tfor(int i=1;i<=n;i++) {\n\t\tint u,v,w;scanf("%d%d%d",&u,&v,&w);\n\t\tG[u][v]=G[v][u]=min(G[u][v],w);\n\t}\n\tint ans=INF,x;\n\tfor(int i=1;i<=n;i++) {\n\t\tDijkstra(i);\n\t\tint sum=0;\n\t\tfor(int j=1;j<=n;j++) sum+=dist[j];\n\t\tif(sum<ans) ans=sum,x=i;\n\t}\n\tprintf("%d %d\\n",x,ans);\n\treturn 0;\n}')"
