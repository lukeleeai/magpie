LineLLMCrossover(('source.cpp', 34), '#include <iostream>\n#include <vector>\nusing namespace std;\n\nint n;\nvector<int> d;\n\nstring check2() {\n    int nowpos = n - 1;\n\n    for (int j = 0; j < n; j++) {\n        int canhop = nowpos - d[nowpos] / 10;\n        if (canhop <= 0) return "yes";\n\n        for (int i = nowpos; i >= canhop; i--) {\n            if (i - d[i] / 10 < nowpos) {\n                nowpos = i;\n                if (nowpos - d[nowpos] / 10 <= 0) return "yes";\n            }\n        }\n    }\n    return "no";\n}\n\nint main() {\n    scanf("%d", &n);\n    d.resize(n);\n    for (int i = 0; i < n; i++) {\n        scanf("%d", &d[i]);\n        d[i] -= d[i] % 10;\n    }\n    printf("%s\\n", check2().c_str());\n    return 0;\n}')
