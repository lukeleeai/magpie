2025-01-27 01:03:35,577	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include <iostream>\n\n#include <string>\n\n#include <algorithm>\n\n#include <stack>\n\n#include <queue>\n\n#include <cstring>\n\nusing namespace std;\n\n\n\nint dp[100][4];\n\nint func(int kaidan,int now){\n\n\tint a=0,b=0,c=0;\n\n\n\n\tif(now==kaidan){\n\n\t\treturn 1;\n\n\t}else if(now>kaidan){\n\n\t\treturn 0;\n\n\t\t}else{\n\n\t\tif(dp[now][1]==-1){\n\n\t\t\ta+=func(kaidan,now+1);\n\n\t\t\tdp[now][1]=a;\n\n\t\t}else{\n\n\t\t\ta=dp[now][1];\n\n\t\t}\n\n\t\tif(dp[now][2]==-1){\n\n\t\t\tb+=func(kaidan,now+2);\n\n\t\t\tdp[now][2]=b;\n\n\t\t}else{\n\n\t\t\tb=dp[now][2];\n\n\t\t}\n\n\t\tif(dp[now][3]==-1){\n\n\t\t\tc+=func(kaidan,now+3);\n\n\t\t\tdp[now][3]=c;\n\n\t\t}else{\n\n\t\t\tc=dp[now][3];\n\n\t\t}\n\n\t\t}\n\n\n\n\treturn a+b+c;\n\n\n\n}\n\n\n\nint main(){\n\n\tint n,ans;\n\n\n\n\twhile(cin>>n){\n\n\t    memset(dp,-1,sizeof(dp));\n\n\t\tif(n==0)break;\n\n\t\tans=func(n,0);\n\n\t\tcout<<ans/10/365+1<<endl;\n\n\n\n\n\n\n\n\t}\n\n\n\n\n\n\treturn 0;\n\n}')"

