2025-01-27 01:06:16,939	[DEBUG]	patch(4-8)="LineLLMCrossover(('source.cpp', 15), '#include <iostream>\n\n#include <string>\n\n#include <algorithm>\n\n#include <stack>\n\n#include <queue>\n\n#include <cstring> // for memset\n\nusing namespace std;\n\n\n\nint dp[100]; // memoization array\n\nint func(int kaidan,int now){\n\n\tif (dp[now] != -1) return dp[now]; // check memoization\n\n\tint a=0,b=0,c=0;\n\n\n\n\tif(now==kaidan){\n\n\t\treturn 1;\n\n\t}else if(now>kaidan){\n\n\t\treturn 0;\n\n\t\t}else{\n\n\t\ta+=func(kaidan,now+1);\n\n\t\tb+=func(kaidan,now+2);\n\n\t\tc+=func(kaidan,now+3);\n\n\t\t}\n\n\n\n\treturn dp[now] = a+b+c; // store result in memoization\n\n}\n\n\n\nlong long path_count(int steps){\n\n\tlong long dp[100] = {0}; // iteration array\n\n\tdp[0] = 1; // base case\n\n\tfor (int i = 0; i <= steps; i++) {\n\n\t\tif (i + 1 <= steps) dp[i + 1] += dp[i];\n\n\t\tif (i + 2 <= steps) dp[i + 2] += dp[i];\n\n\t\tif (i + 3 <= steps) dp[i + 3] += dp[i];\n\n\t}\n\n\treturn dp[steps];\n\n}\n\n\n\nint main(){\n\n\tint n,ans;\n\n\n\n\twhile(cin>>n){\n\n\t\tif(n==0)break;\n\n\t\tmemset(dp, -1, sizeof(dp)); // initialize memoization array\n\n\t\tans=func(n,0);\n\n\t\tcout<<ans/10/365+1<<endl;\n\n\t}\n\n\n\n\treturn 0;\n\n}')"
