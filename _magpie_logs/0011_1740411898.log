ring res = "";\n    multimap <int, int>::iterator it = table.begin();\n    for (; it != table.end(); ++it){\n        a = (*it).first;\n        b = (*it).second;\n        res = "";\n        for (i = 0; i < len; ++i){\n            char c = 0;\n            if (isalpha(str[i] ) ){\n                c = (a*(str[i] - \'a\' ) + b ) % 26 + \'a\';\n            } else {\n                c = str[i];\n            }\n            res += c;\n        }\n        if (!check_code (res ) ){\n            continue;\n        } else {\n            break;\n        }\n    }\n    return res;\n}\n\nvector <int> AffineCipher::make_alpha (void)\n{\n    vector <int> alpha;\n    int i;\n\n    for (i = 1; i < 26; ++i){\n        if (gcd(i, 26 ) == 1 ){\n            alpha.push_back(i);\n        }\n    }\n    return alpha;\n}\n\nint main()\n{\n    AffineCipher AC;\n    string str = "";\n    int n;\n\n    getline (cin, str );\n    stringstream ssn(str);\n    ssn >> n;\n\n    vector <int> alpha = AC.make_alpha();\n    int i;\n\n    for (i = 0; i < n; ++i){\n        string res = "";\n        getline (cin, str );\n        res = AC.decode (str, alpha );\n        cout << res << endl;\n    }\n\n    return 0;\n}')"
