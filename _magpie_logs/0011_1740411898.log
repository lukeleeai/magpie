ha = {0};\n    size_t index = 0;\n    for (int i = 1; i < 26; ++i) {\n        if (gcd(i, 26) == 1) {\n            alpha[index++] = i;\n        }\n    }\n    return alpha;\n}\n\nint main() {\n    AffineCipher AC;\n    string str;\n    int n;\n    getline(cin, str);\n    stringstream ssn(str);\n    ssn >> n;\n    array<int, 25> alpha = AC.make_alpha();\n    for (int i = 0; i < n; ++i) {\n        getline(cin, str);\n        cout << AC.decode(str, alpha) << endl;\n    }\n    return 0;\n}')"
