2025-02-24 15:47:54,884	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include <iostream>\n#include <vector>\n#include <string>\n#include <unordered_set>\n#include <sstream>\n#include <map>\nusing namespace std;\n\nclass AffineCipher {\npublic:\n    string decode(string, vector<int>);\n    vector<int> make_alpha(void);\nprivate:\n    int gcd(int, int);\n    bool decide_variable(int, int, const string&);\n    bool check_code(const string&);\n};\n\nint AffineCipher::gcd(int a, int b) {\n    while (b) {\n        swap(a, b);\n        b %= a;\n    }\n    return a;\n}\n\nbool AffineCipher::decide_variable(int a, int b, const string& str) {\n    unordered_set<char> code, source;\n    for (char ch : str) {\n        if (isalpha(ch)) {\n            source.insert(ch);\n        }\n    }\n    for (char c : source) {\n        char transformed = (a * (c - \'a\') + b) % 26 + \'a\';\n        if (!code.insert(transformed).second) {\n            return false;\n        }\n    }\n    return true;\n}\n\nbool AffineCipher::check_code(const string& str) {\n    const vector<string> keywords = {"this", "that"};\n    for (const string& keyword : keywords) {\n        if (str.find(keyword) != string::npos) {\n            return true;\n        }\n    }\n    return false;\n}\n\nstring AffineCipher::decode(string str, vector<int> alpha) {\n    multimap<int, int> table;\n    for (int a : alpha) {\n        for (int b = 0; b < 26; ++b) {\n            if (decide_variable(a, b, str)) {\n                table.emplace(a, b);\n            }\n        }\n    }\n\n    for (const auto& [a, b] : table) {\n        string res;\n        for (char ch : str) {\n            res += isalpha(ch) ? (a * (ch - \'a\') + b) % 26 + \'a\' : ch;\n        }\n        if (check_code(res)) {\n            return res;\n        }\n    }\n    return "";\n}\n\nvector<int> AffineCipher::make_alpha(void) {\n    vector<int> alpha;\n    for (int i = 1; i < 26; ++i) {\n        if (gcd(i, 26) == 1) {\n            alpha.push_back(i);\n        }\n    }\n    return alpha;\n}\n\nint main() {\n    AffineCipher AC;\n    string str;\n    int n;\n    getline(cin, str);\n    stringstream ssn(str);\n    ssn >> n;\n    vector<int> alpha = AC.make_alpha();\n    for (int i = 0; i < n; ++i) {\n        getline(cin, str);\n        cout << AC.decode(str, alpha) << endl;\n    }\n    return 0;\n}')"

