LineLLMCrossover(('source.cpp', 58), '#include <iostream>\n#include <unordered_map>\n#include <set>\n#include <string>\n\nusing namespace std;\n\nint main() {\n    string a;\n    unordered_map<int, int> c;\n    set<int> processed;\n    int m, n, x = 0, z = 0;\n\n    cin >> m >> n;\n    if (n == 0) {\n        printf("0 0");\n        return 0;\n    }\n    \n    auto handleCommand = [&](char cmd, int b) {\n        if (cmd == \'A\' && processed.find(b) == processed.end()) {\n            processed.insert(b);\n            x++;\n            auto it = c.find(b);\n            if (it != c.end()) {\n                z += it->second;\n            }\n        } else if (cmd == \'W\') {\n            c[b]++;\n        }\n    };\n\n    for (int i = 0; i < n; i++) {\n        int b;\n        cin >> b >> a;\n        handleCommand(a[0], b);\n    }\n    \n    printf("%d %d", x, z);\n}')
