2025-01-27 00:53:32,176	[DEBUG]	patch(4-6)="LineLLMCrossover(('source.cpp', 12), '#include<stdio.h>\n#include<algorithm>\nusing namespace std;\n\ntypedef pair<int,int> P;\n\nP mt[200];\n\nint dp[1000][201];\n\nint min(int a,int b){return a<b?a:b;}\n\nint max(int a,int b){return a>b?a:b;}\n\nint main(){\n\n\tint n,m;\n\n\twhile(1){\n\n\tscanf("%d",&n);\n\n\tif(n==0)return 0;\n\n\tfor(int i=0;i<n;i++){\n\n\t\tscanf("%d %d",&mt[i].first,&mt[i].second);\n\n\t}\n\n\tscanf("%d",&m);\n\n\tfor(int i=0;i<m;i++){\n\n\t\tscanf("%d %d",&mt[n+i].first,&mt[n+i].second);\n\n\t}\n\n\tsort(mt,mt+m+n);\n\n\tfor(int i=0;i<1000;i++)for(int j=0;j<=m+n;j++)dp[i][j]=1000;\n\n\tfor(int i=0;i<m+n;i++){\n\n\t\tint h=mt[i].first;\n\n\t\tint r=mt[i].second;\n\n\t\tdp[h][1]=min(dp[h][1],r);\n\n\t\tfor(int j=0;j<h;j++){\n\n\t\t\tfor(int k=0;k<m+n;k++){\n\n\t\t\t\tif(r>dp[j][k])dp[h][k+1]=min(dp[h][k+1],r);\n\n\t\t\t}\n\n\t\t}\n\n\t}\n\n\tint ans=0;\n\n\tfor(int i=0;i<1000;i++)for(int j=0;j<=m+n;j++){\n\n\t\tif(dp[i][j]!=1000)ans=max(ans,j);\n\n\t}\n\n\tprintf("%d\\n",ans);\n\n\t}\n\n}')"
