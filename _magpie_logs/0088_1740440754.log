 ans = 0; // Initialize answer counter\n        bool flag = false; // Initialize flag\n\n        for (int i = 0; i < N; i++) {\n            scanf("%d", &data[i]); // Read all data in one go\n            if (data[i] > 1) {\n                flag = true; // Set flag if any element > 1\n                ans++; // Count valid elements directly\n            } else if (data[i] != 0) {\n                ans++; // Count non-zero elements\n            }\n        }\n\n        if (!flag) {\n            printf("NA\\n");\n        } else {\n            printf("%d\\n", ans + 1); // Add one to account for the first valid element\n        }\n    }\n    return 0;\n}')"
