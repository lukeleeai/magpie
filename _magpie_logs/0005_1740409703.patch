LineLLMMutation(('source.cpp', 7), '#include <iostream>\n#include <vector>\n#include <numeric>\n\nusing namespace std;\n\nint main() {\n    int n;\n    while(cin >> n) {\n        if(n <= 1) {\n            cout << 0 << endl;\n            continue;\n        }\n\n        vector<int> judge(n + 1, 1);\n        judge[0] = judge[1] = 0;\n\n        // Sieve of Eratosthenes\n        for(int i = 2; i * i <= n; i++) {\n            if (judge[i]) {\n                for(int j = i * i; j <= n; j += i)\n                    judge[j] = 0;\n            }\n        }\n\n        cout << accumulate(judge.begin(), judge.end(), 0) << endl; // Output the sum of primes\n    }\n\n    return 0;\n}') + LineLLMMutation(('source.cpp', 10), '#include <cstdio>\n#include <vector>\n\nusing namespace std;\n\nint main() {\n    int n;\n    while(scanf("%d", &n) == 1) {\n        if(n <= 1) {\n            printf("0\\n");\n            continue;\n        }\n\n        vector<int> judge(n + 1, 1);\n        judge[0] = judge[1] = 0;\n\n        // Sieve of Eratosthenes\n        for(int i = 2; i * i <= n; i++) {\n            if (judge[i]) {\n                for(int j = i * i; j <= n; j += i)\n                    judge[j] = 0;\n            }\n        }\n\n        int prime_count = 0;\n        for(int i = 0; i <= n; ++i) {\n            prime_count += judge[i];\n        }\n        printf("%d\\n", prime_count); // Output the sum of primes\n    }\n\n    return 0;\n}')
