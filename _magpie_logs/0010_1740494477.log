2025-02-25 14:41:49,166	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include <iostream>\n#include <map>\n#include <sstream>\n#include <string.h>\nusing namespace std;\n\nmap<int, char> AlphabetTable;\nmap<int, int> table;\n\nchar decode(char a) {\n    int z = a - \'a\';\n    for (auto it = table.begin(); it != table.end(); ++it) {\n        if (it->second == z) return AlphabetTable[it->first];\n    }\n}\n\nvoid makeTable(int a, int b) {\n    for (int i = 0; i < 26; i++) {\n        table[i] = (a * i + b) % 26;\n    }\n}\n\nvoid makeAlphabetTable() {\n    char c = \'a\';\n    for (int i = 0; i < 26; i++) {\n        AlphabetTable[i] = c;\n        c++;\n    }\n}\n\nint main() {\n    string code, tmp;\n    int n;\n    getline(cin, code);\n    stringstream ssn(code);\n    ssn >> n;\n    makeAlphabetTable();\n    for (int i = 0; i < n; i++) {\n        getline(cin, code);\n        tmp = code;\n        for (int b = 0; b < 26; b++) {\n            for (int a = 1; a < 26; a += 2) {\n                if (a % 13 != 0) {\n                    makeTable(a, b);\n                    code = tmp;\n                    for (int j = 0; j < code.length(); j++) {\n                        if (\'a\' <= code[j] && code[j] <= \'z\') {\n                            code[j] = decode(code[j]);\n                        }\n                    }\n                    if (code.find("this") != -1 || code.find("that") != -1) {\n                        cout << code << endl;\n                        break;\n                    }\n                }\n            }\n        }\n    }\n    return 0;\n}')"

