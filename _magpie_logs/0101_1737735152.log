2025-01-24 16:24:00,015	[DEBUG]	patch(7-9)="LineLLMCrossover(('source.cpp', 24), '#include <cstdio>\n#include <vector>\n#include <memory> // Include memory header for smart pointers\nusing namespace std;\n\nstruct Node {\n    int val;\n    Node *prev, *next;\n    Node(int v) : val(v), prev(nullptr), next(nullptr) {}\n};\n\nNode *head = nullptr, *tail = nullptr;\n\nvoid add(int val) {\n    auto New = make_unique<Node>(val); // Use smart pointers for automatic memory management\n    if (!head) {\n        head = tail = New.release(); // Release ownership to the raw pointer\n    } else {\n        tail->next = New.get(); // Link the new node\n        New->prev = tail;\n        tail = New.release(); // Release ownership to the raw pointer\n    }\n}\n\nvoid del(Node *node) {\n    if (node->prev) {\n        node->prev->next = node->next;\n    } else {\n        head = node->next;\n    }\n    if (node->next) {\n        node->next->prev = node->prev;\n    } else {\n        tail = node->prev;\n    }\n    delete node; // Deleting the node remains unchanged\n}\n\nint main() {\n    int N, M, Q;\n    scanf("%d %d %d", &N, &M, &Q);\n    vector<int> OK(N, 0);\n    for (int i = 0; i < N; ++i) add(i);\n\n    Node *cur = head;\n    while (M--) {\n        int a;\n        scanf("%d", &a);\n        for (int j = 0; j < a; ++j) {\n            cur = (a & 1) ? (cur->prev ? cur->prev : tail) : (cur->next ? cur->next : head);\n        }\n        Node *tmp = cur;\n        cur = cur->next ? cur->next : head;\n        del(tmp);\n    }\n\n    for (Node *cur = head; cur; cur = cur->next) {\n        OK[cur->val] = 1;\n    }\n\n    while (Q--) {\n        int q;\n        scanf("%d", &q);\n        printf("%d\\n", OK[q]);\n    }\n}')"
