r the next available node in the pool\n\nNode* allocateNode(int val) {\n    if (poolIndex < MAX_NODES) {\n        Node* newNode = &nodePool[poolIndex++];\n        newNode->val = val;\n        newNode->prev = nullptr;\n        newNode->next = nullptr;\n        return newNode;\n    }\n    return nullptr; // Handling case where pool is exhausted (not ideal)\n}\n\nvoid add(int val) {\n    Node *New = allocateNode(val); // Use the pool for node allocation\n    if (!head) {\n        head = tail = New;\n    } else {\n        tail->next = New; // Link the new node\n        New->prev = tail;\n        tail = New; // Update tail\n    }\n}\n\nvoid del(Node *node) {\n    if (node->prev) {\n        node->prev->next = node->next;\n    } else {\n        head = node->next;\n    }\n    if (node->next) {\n        node->next->prev = node->prev;\n    } else {\n        tail = node->prev;\n    }\n    // No need to delete since we are using a pool\n}\n\nint main() {\n    int N, M, Q;\n    scanf("%d %d %d", &N, &M, &Q);\n    vector<int> OK(N, 0);\n    for (int i = 0; i < N; ++i) add(i);\n\n    Node *cur = head;\n    for (int i = 0; i < M; ++i) {\n        int a;\n        scanf("%d", &a);\n        for (int j = 0; j < a; ++j) {\n            cur = (a & 1) ? (cur->prev ? cur->prev : tail) : (cur->next ? cur->next : head);\n        }\n        Node *tmp = cur;\n        cur = cur->next ? cur->next : head;\n        del(tmp);\n    }\n\n    for (Node *cur = head; cur; cur = cur->next) {\n        OK[cur->val] = 1;\n    }\n\n    while (Q--) {\n        int q;\n        scanf("%d", &q);\n        printf("%d\\n", OK[q]);\n    }\n}')"
