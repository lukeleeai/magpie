LineLLMCrossover(('source.cpp', 8), '#include "stdio.h"\n\nconst int MAX_V = 10000;\nbool prime[MAX_V + 1];\n\nvoid sieve() {\n    for (int i = 2; i <= MAX_V; i++) {\n        prime[i] = true;\n    }\n    for (int i = 2; i * i <= MAX_V; i++) {\n        if (prime[i]) {\n            for (int k = i * i; k <= MAX_V; k += i) {\n                prime[k] = false;  // Start marking from i*i\n            }\n        }\n    }\n}\n\nint main() {\n    sieve();  // Call sieve function to initialize prime array\n    int n;\n\n    while (1) {\n        if (scanf("%d", &n) != 1 || n == 0) break;\n\n        int p1 = 0, q1 = 0;\n\n        for (int i = n; i >= 3; i--) {\n            if (prime[i] && prime[i - 2]) {\n                q1 = i;\n                p1 = i - 2;\n                break;\n            }\n        }\n\n        printf("%d %d\\n", p1, q1);\n    }\n\n    return 0;\n}')
