LineLLMCrossover(('source.cpp', 25), '#include <cstdio>\n\nconst int MAX_V = 10000;\n\nint main() {\n    int n, p, q;\n    bool prime[MAX_V + 1] = {false}; // Use bool for memory efficiency\n\n    // Initialize the prime array using the Sieve of Eratosthenes\n    for (int i = 2; i * i <= MAX_V; i++) {\n        if (!prime[i]) {\n            for (int k = i * i; k <= MAX_V; k += i) {\n                prime[k] = true; // Marking non-prime\n            }\n        }\n    }\n\n    while (true) {\n        scanf("%d", &n);\n        if (n == 0) break;\n\n        for (int i = n; i >= 3; i--) {\n            if (!prime[i] && !prime[i - 2]) { // Check for twin primes\n                p = i;\n                q = p - 2;\n                break;\n            }\n        }\n\n        printf("%d %d\\n", q, p);\n    }\n\n    return 0;\n}')
