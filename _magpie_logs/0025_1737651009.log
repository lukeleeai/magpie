ed to a vector of pairs for better performance\n    vector<string> seq;\n\n    while(cin >> n && n){\n        info.clear();\n        seq.clear();\n        while(n--){\n            cin >> number >> a >> b;\n            // Use binary search to find the number or insert it\n            auto it = find_if(info.begin(), info.end(), [&](const pair<string, int>& p) { return p.first == number; });\n            if (it == info.end()) {\n                seq.push_back(number);\n                info.emplace_back(number, a * b); // Store initial value directly\n            } else {\n                it->second = min(it->second + a * b, 1000000); // Update the existing entry directly\n            }\n        }\n        bool flag = true;\n        for(int i = 0; i < seq.size(); i++){\n            auto it = find_if(info.begin(), info.end(), [&](const pair<string, int>& p) { return p.first == seq[i]; });\n            if(it != info.end() && it->second >= 1000000){\n                flag = false;\n                cout << seq[i] << endl;\n            }\n        }\n        if(flag) cout << "NA" << endl;\n    }\n}')"
