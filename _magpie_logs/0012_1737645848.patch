LineLLMCrossover(('source.cpp', 28), '#include <iostream>\n#include <string>\n#include <cstdio>\n#include <vector>\n\nusing namespace std;\n\nint main(){\n    int n;\n    scanf("%d", &n);\n    getchar();  // Clear the newline left by scanf\n    vector<string> lines(n);\n\n    for(int i = 0; i < n; ++i) {\n        getline(cin, lines[i]);\n    }\n\n    for (const auto& s : lines) {\n        string ans;\n        bool found = false;\n\n        for(int a = 0; a < 27 && !found; a++){\n            for(int b = 0; b < 27 && !found; b++){\n                string tmp = s;\n                for(char& c : tmp) {\n                    if(isalpha(c)) {\n                        c = (a * (c - \'a\') + b) % 26 + \'a\';\n                    }\n                }\n                size_t len = tmp.size();\n                // Optimized substring search\n                for(size_t j = 0; j <= len - 4; ++j) {\n                    if((tmp[j] == \'t\' && tmp[j + 1] == \'h\' && tmp[j + 2] == \'i\' && tmp[j + 3] == \'s\') || \n                       (tmp[j] == \'t\' && tmp[j + 1] == \'h\' && tmp[j + 2] == \'a\' && tmp[j + 3] == \'t\')) {\n                        ans = tmp; found = true; break;\n                    }\n                }\n            }\n        }\n        cout << ans << endl;\n    }\n}')
