LineLLMMutation(('source.cpp', 7), '#include <cstdio>\n#include <algorithm>\n\nusing namespace std;\n\nint main() {\n    for(int caseNum = 1, weight; scanf("%d", &weight), weight; caseNum++) {\n        int itemCount;\n        scanf("%d", &itemCount);\n        \n        int dp[1001] = {0};\n        for(int i = 1; i <= itemCount; i++) {\n            int value, itemWeight;\n            scanf("%d,%d", &value, &itemWeight);\n            for(int j = weight; j >= itemWeight; j--) {\n                dp[j] = max(dp[j], dp[j - itemWeight] + value);\n            }\n        }\n\n        int maxProfit = dp[weight], bestWeight;\n        for(int j = 0; j <= weight; j++) {\n            if(maxProfit == dp[j]) { bestWeight = j; break; }\n        }\n\n        printf("Case %d:\\n", caseNum);\n        printf("%d\\n%d\\n", maxProfit, bestWeight);\n    }\n    return 0;\n}')
