LineLLMCrossover(('source.cpp', 70), "#include <iostream>\n#include <string>\n#include <vector>\n#include <iterator>\n\nusing namespace std;\n\nint main(void) {\n    string s;\n    cin >> s; \n    vector<char> t; \n    t.reserve(s.size()); // Reserve space to avoid reallocations\n\n    for (char c : s) {\n        if (c == '0' || c == '1') {\n            t.push_back(c); \n        } else if (c == 'B') {\n            if (!t.empty()) {\n                t.pop_back();\n            }\n        }\n    }\n\n    // Optimize output by using std::copy and ostream_iterator\n    copy(t.begin(), t.end(), ostream_iterator<char>(cout));\n    cout << endl;\n\n    return 0;\n}")
