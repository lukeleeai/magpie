LineLLMCrossover(('source.cpp', 30), '#include <iostream>\nusing namespace std;\n\nint solve(int n) {\n    if (n == 0) return 1; // Base case\n    if (n < 0) return 0;\n\n    int dp[4] = {1, 0, 0, 0}; // Using a circular buffer with the base case\n    for (int i = 1; i <= n; i++) {\n        dp[i % 4] = dp[(i - 1) % 4]; // dp[i] = dp[i - 1]\n        if (i >= 2) dp[i % 4] += dp[(i - 2) % 4]; // dp[i] += dp[i - 2]\n        if (i >= 3) dp[i % 4] += dp[(i - 3) % 4]; // dp[i] += dp[i - 3]\n    }\n    return dp[n % 4]; // Return last computed value\n}\n\nint main() {\n    int n;\n    while (cin >> n && n != 0) {\n        cout << (solve(n) / 3650 + 1) << endl; // Output with adjustment\n    }\n    return 0;\n}')
