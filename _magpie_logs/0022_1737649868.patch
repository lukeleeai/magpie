LineLLMCrossover(('source.cpp', 15), "#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <algorithm>\n\nusing namespace std;\n\nint n;\nvector<vector<int>> s;\n\nint calc(int y, int x, int n) {\n    int a, b, c, d;\n    n--;\n    a = s[y - 1][x - 1];\n    b = s[y - 1][x + n];\n    c = s[y + n][x - 1];\n    d = s[y + n][x + n];\n    return d - c - b + a;\n}\n\nint main() {\n    while (cin >> n, n) {\n        s.assign(n + 1, vector<int>(n + 1, 0));\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j <= n; j++) {\n                char c;\n                cin >> c;\n                s[i][j] = (c == '*') + s[i - 1][j] + s[i][j - 1] - s[i - 1][j - 1];\n            }\n        }\n\n        int ans = 0;\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j <= n; j++) {\n                int lb = 0, ub = min(n - i + 1, n - j + 1); \n                while (ub - lb > 1) {\n                    int m = (lb + ub) / 2;\n                    if (calc(i, j, m)) ub = m;\n                    else lb = m;\n                }\n                ans = max(ans, lb);\n            }\n        }\n        cout << ans << endl;\n    }\n    return 0;\n}") + LineLLMMutation(('source.cpp', 27), "#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <algorithm>\n\nusing namespace std;\n\nint n;\nvector<vector<int>> s;\n\nint calc(int y, int x, int n) {\n    int a, b, c, d;\n    n--;\n    a = s[y - 1][x - 1];\n    b = s[y - 1][x + n];\n    c = s[y + n][x - 1];\n    d = s[y + n][x + n];\n    return d - c - b + a;\n}\n\nint main() {\n    while (cin >> n, n) {\n        s.assign(n + 1, vector<int>(n + 1, 0));\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j <= n; j++) {\n                char c;\n                cin >> c;\n                s[i][j] = (c == '*') + s[i - 1][j] + s[i][j - 1] - s[i - 1][j - 1];\n            }\n        }\n\n        int ans = 0;\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j 