2025-01-27 01:14:11,541	[DEBUG]	patch(1-1)="LineLLMMutation(('source.cpp', 14), '#include <cstdio>\n#include <cfloat>\n\nusing namespace std;\n\nchar f[10][21];\n\nint n, w[10], s[10], a[10], b[10];\n\nbool u[10];\n\ndouble maxg;\n\n// Backtracking DFS to explore all valid combinations\n\nvoid dfs(int x, int tw, int m, double g) {\n\n  if (m == n) {\n\n    if (maxg < g) {\n\n      maxg = g;\n\n      for (int i=0; i<n; i++) {\n\n        b[i] = a[i]; // Save the best combination found\n\n      }\n\n    }\n\n    return;\n\n  }\n\n  if (x>=n) {\n\n    return; // End of recursion\n\n  }\n\n  if (!u[x] && tw <= s[x]) { // Check if the current item can be used\n\n    u[x] = true;\n\n    tw += w[x];\n\n    a[m] = x;\n\n    dfs(0, tw, m+1, g + w[x]*(m+1)); // Recur with the updated state\n\n    tw -= w[x];\n\n    u[x] = false;\n\n  }\n\n  dfs(x+1, tw, m, g); // Move to the next item\n\n}\n\n\n\nint main() {\n\n  while (1) {\n\n    scanf("%d", &n); // Number of items\n\n    if (!n) break; // Termination condition\n\n    for (int i=0; i<n; i++) {\n\n      scanf("%s %d %d", f[i], &w[i], &s[i]); // Read item data\n\n    }\n\n    for (int i=0; i<n; i++) {\n\n      u[i] = false; // Reset usage state\n\n    }\n\n    maxg = -DBL_MAX; // Initialize maximum gain\n\n    dfs(0, 0, 0, 0.); // Start DFS\n\n    for (int i=n-1; i>=0; i--) {\n\n      printf("%s\\n", f[b[i]]); // Output the best combination in reverse order\n\n    }\n\n  }\n\n  return 0;\n\n}')"
