2025-01-27 01:17:00,706	[DEBUG]	patch(4-8)="LineLLMCrossover(('source.cpp', 14), '#include <cstdio>\n\n#include <cfloat>\n\nusing namespace std;\n\nchar fileNames[10][21];\n\nint numFiles, weights[10], limits[10], sequence[10], bestSequence[10];\n\nbool used[10];\n\nfloat maxGain;\n\nvoid search(int index, int totalWeight, int currIndex, float gain) {\n\n  if (currIndex == numFiles) {\n\n    if (maxGain < gain) {\n\n      maxGain = gain;\n\n      for (int i=0; i<numFiles; i++) {\n\n        bestSequence[i] = sequence[i];\n\n      }\n\n    }\n\n    return;\n\n  }\n\n  if (index >= numFiles) {\n\n    return;\n\n  }\n\n  if (!used[index] && totalWeight <= limits[index]) {\n\n    used[index] = true;\n\n    totalWeight += weights[index];\n\n    sequence[currIndex] = index;\n\n    search(0, totalWeight, currIndex+1, gain + weights[index]*(currIndex+1));\n\n    totalWeight -= weights[index];\n\n    used[index] = false;\n\n  }\n\n  search(index+1, totalWeight, currIndex, gain);\n\n}\n\nint main() {\n\n  while (1) {\n\n    scanf("%d", &numFiles);\n\n    if (!numFiles) break;\n\n    for (int i=0; i<numFiles; i++) {\n\n      scanf("%s %d %d", fileNames[i], &weights[i], &limits[i]);\n\n    }\n\n    for (int i=0; i<numFiles; i++) {\n\n      used[i] = false;\n\n    }\n\n    maxGain = -DBL_MAX;\n\n    search(0, 0, 0, 0.);\n\n    for (int i=numFiles-1; i>=0; i--) {\n\n      printf("%s\\n", fileNames[bestSequence[i]]);\n\n    }\n\n  }\n\n  return 0;\n\n}')"
