   for (int index = 0; index < numFiles && found; index++) {\n\n            tempIndex = (index + currIndex) % numFiles;\n\n            if (!used[tempIndex] && totalWeight <= limits[tempIndex]) {\n\n                used[tempIndex] = true;\n\n                totalWeight += weights[tempIndex];\n\n                sequence[currIndex] = tempIndex;\n\n                gain += weights[tempIndex] * (currIndex + 1);\n\n            } else {\n\n                found = false;\n\n            }\n\n        }\n\n        if (maxGain < gain) {\n\n            maxGain = gain;\n\n            for (int i = 0; i < numFiles; i++) {\n\n                bestSequence[i] = sequence[i];\n\n            }\n\n        }\n\n    }\n\n}\n\nint main() {\n\n    while (1) {\n\n        scanf("%d", &numFiles);\n\n        if (!numFiles) break;\n\n        for (int i = 0; i < numFiles; i++) {\n\n            scanf("%s %d %d", fileNames[i], &weights[i], &limits[i]);\n\n        }\n\n        for (int i = 0; i < numFiles; i++) {\n\n            used[i] = false;\n\n        }\n\n        maxGain = -DBL_MAX;\n\n        iterativeSearch();\n\n        for (int i = numFiles - 1; i >= 0; i--) {\n\n            printf("%s\\n", fileNames[bestSequence[i]]);\n\n        }\n\n    }\n\n    return 0;\n\n}')"
