2025-02-24 16:57:42,076	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include<cstdio>\n#include<iostream>\n#define INF 2100000000\nusing namespace std;\n\nint minix(int a,int b,int c){\n    return min(a, min(b, c)); // Simplified to use std::min for clarity\n}\n\nint main(){\n    int n;\n    int masu[1002][1002];\n    int ura[1002][1002];\n    char str[1002];\n\n    while(scanf("%d", &n) && n != 0){\n        for(int i=0; i<=1001; i++)\n            fill(masu[i], masu[i]+1002, 0); // Using fill instead of nested loops\n        \n        for(int i=1; i<=n; i++){\n            scanf("%s", str);\n            for(int j=1; j<=n; j++)\n                ura[i][j] = (str[j-1] == \'.\') ? 0 : 1;\n        }\n\n        int maxi=0;\n        for(int i=1; i<=n; i++){\n            for(int j=1; j<=n; j++){\n                if(ura[i][j]==0){\n                    masu[i][j] = minix(masu[i-1][j], masu[i][j-1], masu[i-1][j-1]) + 1;\n                    maxi = max(masu[i][j], maxi);\n                }\n            }\n        }\n\n        printf("%d\\n", maxi);\n    }\n}')"

