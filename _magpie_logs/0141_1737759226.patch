LineLLMCrossover(('source.cpp', 19), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\n#include <vector>\n#include <utility>\n\nusing namespace std;\n\ntypedef pair<int, int> pii;\n#define fst first\n#define scd second\n#define rep(i,x) for(int i=0;i<(x);++i)\n\nconst int inf = 1e9;\n\nint k[150];\nvector<pii> stone[150];\nint N, M;\nint memo[150][150]; // 2D memoization\n\ninline int rec(int n, int m, int i) {\n    if (n >= N - 1) return 0;\n    if (~memo[n][m]) return memo[n][m];\n\n    long long res = inf;\n    for (int j = 0; j < k[n + 1]; ++j) {\n        long long dist = (stone[n][i].scd + stone[n + 1][j].scd) * abs(stone[n][i].fst - stone[n + 1][j].fst);\n        res = min(res, dist + rec(n + 1, m, j));\n    }\n\n    if (m < M && n + 2 < N) {\n        for (int j = 0; j < k[n + 2]; ++j) {\n            long long dist = (stone[n][i].scd + stone[n + 2][j].scd) * abs(stone[n][i].fst - stone[n + 2][j].fst);\n            res = min(res, dist + rec(n + 2, m + 1, j));\n        }\n    }\n\n    return memo[n][m] = res;\n}\n\nsigned main() {\n    while (scanf("%d %d", &N, &M), N || M) {\n        rep(i, N) {\n            scanf("%d", &k[i]);\n            stone[i].reserve(k[i]); // Optimize vector memory allocation\n            for (int j = 0; j < k[i]; ++j) {\n                int x, d; \n                scanf("%d %d", &x, &d);\n                stone[i].emplace_back(x, d); // Use emplace_back for efficiency\n            }\n        }\n\n        int ans = inf;\n        rep(i, k[0]) {\n            memset(memo, -1, sizeof(memo));\n            ans = min(ans, rec(0, 0, i));\n        }\n\n        if (M > 0) {\n            rep(i, k[1]) {\n                memset(memo, -1, sizeof(memo));\n                ans = min(ans, rec(1, 1, i));\n            }\n        }\n\n        printf("%d\\n", ans);\n    }\n}') + LineLLMMutation(('source.cpp', 35), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\n#include <vector>\n#include <utility>\n\nusing namespace std;\n\ntypedef 