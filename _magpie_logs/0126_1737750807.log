  int n, k;\n    while (scanf("%d %d", &n, &k), n || k) {\n        bool a[100001] = {false};  // Keeping this array as is for boolean checks\n        int memo[100001] = {0};     // This can be avoided by using a single integer to track counts\n        int maxCount = 0;           // To track the maximum count directly\n\n        bool hasZero = false;\n\n        for (int i = 1; i <= k; ++i) {\n            int tmp; scanf("%d", &tmp);\n            if (tmp == 0) hasZero = true;\n            else a[tmp] = true;\n        }\n\n        int start = 0; // Starting index of current sequence\n        for (int i = 1; i <= n; ++i) {\n            if (a[i]) {\n                start = (i > 1 && a[i - 1]) ? start : i;\n                memo[start]++;\n                maxCount = max(maxCount, memo[start]); // Directly updating maxCount\n            }\n        }\n\n        int finalMax = maxCount; // Final max count to return\n\n        for (int i = 1; i <= n; ++i) {\n            if (!a[i] && hasZero) {\n                int v = 0;\n                if (a[i - 1] && (i < n && a[i + 1])) {\n                    v = memo[start] + memo[start + 2] + 1;  // Using a simplified approach\n                } else if (a[i - 1]) {\n                    v = memo[start] + 1;\n                } else if (i < n && a[i + 1]) {\n                    v = memo[start + 1] + 1;\n                }\n                finalMax = max(finalMax, v);\n            }\n        }\n\n        printf("%d\\n", finalMax);\n    }\n}')"
