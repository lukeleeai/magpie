2025-01-24 20:37:06,214	[DEBUG]	patch(2-3)="LineLLMCrossover(('source.cpp', 4), '#include <cstdio>\n#include <array>\n\nusing namespace std;\n\n#define rep1(i,x) for(int i=1;i<=(x);++i)\n\nint calculateMax(int n, bool f, const array<bool, 100001>& a, const array<int, 100001>& memo, const array<int, 100001>& start) {\n    int ma = 0;\n    for (int i = 1; i <= n; i++) {\n        if (a[i]) {\n            ma = max(ma, memo[start[i]]);\n        } else if (f) {\n            int v = memo[start[i - 1]] + (i < n && a[i + 1] ? memo[start[i + 1]] : 0);\n            if (a[i - 1]) v++;\n            ma = max(ma, v);\n        }\n    }\n    return ma;\n}\n\nint main() {\n    int n, k;\n    while (scanf("%d %d", &n, &k), n || k) {\n        array<bool, 100001> a = {};\n        array<int, 100001> memo = {};\n        array<int, 100001> start = {};\n\n        bool f = false;\n\n        rep1(i, k) {\n            int tmp; scanf("%d", &tmp);\n            f = (tmp == 0) ? true : f;\n            a[tmp] = (tmp != 0);\n        }\n\n        rep1(i, n) {\n            if (a[i]) {\n                start[i] = (i > 1 && a[i - 1]) ? start[i - 1] : i;\n                memo[start[i]]++;\n            }\n        }\n\n        int ma = calculateMax(n, f, a, memo, start);\n        printf("%d\\n", ma);\n    }\n}')"
