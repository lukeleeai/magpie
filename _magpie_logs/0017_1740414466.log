2025-02-24 16:33:16,538	[DEBUG]	patch(1-6)="LineLLMMutation(('source.cpp', 11), '#include <iostream>\n#include <algorithm>\n#include <cstdio>\n\nusing namespace std;\n\nint wei; // 持てる最大の重さ\nint n; // お宝の数\nint v[1001]; // お宝の価値\nint w[1001]; // お宝の重さ\nint dp[1001][1001]; //メモテーブル\n\nint max_value(int i, int j) {\n    if(dp[i][j] != -1) {\n        return dp[i][j];\n    }\n    if (i == n) {\n        return 0;\n    } else if (j < w[i]) {\n        return dp[i][j] = max_value(i + 1, j);\n    } else {\n        return dp[i][j] = max(max_value(i + 1, j), max_value(i + 1, j - w[i]) + v[i]);\n    }\n}\n\nvoid max_weight(int ans) {\n    int w_min;\n    for (int i = wei - 1; i >= 0; i--) {\n        if(ans != max_value(0, i)) {\n            w_min = i + 1;\n            break;\n        }\n    }\n    cout << w_min << endl;\n}\n\nint main(void) {\n    int cnt = 1;\n    while (scanf("%d", &wei) == 1) {\n        if (wei == 0) break;\n        scanf("%d", &n);\n        for(int i = 0; i < n; i++) {\n            char ten;\n            scanf("%d %c %d", &v[i], &ten, &w[i]);\n        }\n        cout << "Case " << cnt << ":" << endl;\n        memset(dp, -1, sizeof(dp));\n        int ans = max_value(0, wei);\n        cout << ans << endl;\n        max_weight(ans);\n        cnt++;\n    }\n    return 0;\n}')"
