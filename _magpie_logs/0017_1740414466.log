  cin >> v[i] >> ten >> w[i];\n        }\n\n        // Optimized Iterative DP approach using a single-dimensional array\n        for (int i = 0; i < n; i++) {\n            for (int j = wei; j >= w[i]; j--) {\n                dp[j] = max(dp[j], dp[j - w[i]] + v[i]);\n            }\n        }\n\n        cout << "Case " << cnt << ":" << endl;\n        cout << dp[wei] << endl; // Maximum value\n        max_weight(dp[wei]);\n        cnt++;\n    }\n    return 0;\n}')"
