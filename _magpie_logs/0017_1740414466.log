2025-02-24 16:33:18,147	[DEBUG]	patch(1-9)="LineLLMMutation(('source.cpp', 14), '#include <iostream>\n#include <algorithm>\n#include <cstdio>\n\nusing namespace std;\n\nstruct Item {\n    int value;\n    int weight;\n    double ratio; // value-to-weight ratio\n};\n\nint wei; // 持てる最大の重さ\nint n; // お宝の数\nItem items[1001]; // お宝の情報\nint dp[1001]; //メモテーブル\n\nbool cmp(Item a, Item b) {\n    return a.ratio > b.ratio; // Sort by highest ratio\n}\n\nint max_value() {\n    memset(dp, 0, sizeof(dp));\n    for (int i = 0; i < n; i++) {\n        for (int j = wei; j >= items[i].weight; j--) {\n            dp[j] = max(dp[j], dp[j - items[i].weight] + items[i].value);\n        }\n    }\n    return dp[wei];\n}\n\nvoid max_weight(int ans) {\n    int w_min;\n    for (int i = wei - 1; i >= 0; i--) {\n        if(ans != dp[i]) {\n            w_min = i + 1;\n            break;\n        }\n    }\n    cout << w_min << endl;\n}\n\nint main(void) {\n    int cnt = 1;\n    while (scanf("%d", &wei) == 1) {\n        if (wei == 0) break;\n        scanf("%d", &n);\n        for(int i = 0; i < n; i++) {\n            char ten;\n            scanf("%d %c %d", &items[i].value, &ten, &items[i].weight);\n            items[i].ratio = (double)items[i].value / items[i].weight; // Calculate ratio\n        }\n        sort(items, items + n, cmp); // Sort items by value-to-weight ratio\n        cout << "Case " << cnt << ":" << endl;\n        int ans = max_value();\n        cout << ans << endl;\n        max_weight(ans);\n        cnt++;\n    }\n    return 0;\n}')"
