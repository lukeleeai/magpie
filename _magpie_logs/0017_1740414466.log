2025-02-24 16:37:34,389	[DEBUG]	patch(4-7)="LineLLMCrossover(('source.cpp', 15), '#include <iostream>\n#include <algorithm>\n#include <cstdio>\n\nusing namespace std;\n\nstruct Item {\n    int value;\n    int weight;\n    double ratio; // value-to-weight ratio\n};\n\nconst int max_items = 1000; // Set a maximum number of items\nint wei; // Maximum weight\nint n; // Number of items\nItem items[max_items]; // Static array for items\nint dp[100005]; // Static array for dp table\n\nbool cmp(Item a, Item b) {\n    return a.ratio > b.ratio; // Sort by highest ratio\n}\n\nint max_value() {\n    fill(dp, dp + wei + 1, 0); // Resize dp table using fill\n    for (int i = 0; i < n; i++) {\n        for (int j = wei; j >= items[i].weight; j--) {\n            dp[j] = max(dp[j], dp[j - items[i].weight] + items[i].value);\n        }\n    }\n    return dp[wei];\n}\n\nint main(void) {\n    int cnt = 1;\n    while (scanf("%d", &wei) && wei) {\n        scanf("%d", &n);\n        for (int i = 0; i < n; i++) {\n            char ten;\n            scanf("%d %c %d", &items[i].value, &ten, &items[i].weight);\n            items[i].ratio = (double)items[i].value / items[i].weight; // Calculate ratio\n        }\n        sort(items, items + n, cmp); // Sort items by value-to-weight ratio\n        printf("Case %d:\\n", cnt);\n        int ans = max_value();\n        printf("%d\\n", ans);\n        printf("%d\\n", find_min_weight(ans)); // Minimum weight\n        cnt++;\n    }\n    return 0;\n}')"
