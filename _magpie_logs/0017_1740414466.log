2025-02-24 16:36:06,033	[DEBUG]	patch(3-4)="LineLLMCrossover(('source.cpp', 9), '#include <iostream>\n#include <algorithm>\n#include <vector>\n#include <cstdio>\n\nusing namespace std;\n\nstruct Item {\n    int value;\n    int weight;\n    double ratio; // value-to-weight ratio\n};\n\nint wei; // maximum weight\nint n; // number of treasures\nvector<Item> items; // Dynamically sized items\nint dp[1001]; // DP table for maximum values\n\nbool cmp(Item a, Item b) {\n    return a.ratio > b.ratio; // Sort by highest ratio\n}\n\nvoid max_weight(int ans) {\n    int w_min;\n    for (int i = wei - 1; i >= 0; i--) {\n        if (ans != dp[i]) {\n            w_min = i + 1;\n            break;\n        }\n    }\n    cout << w_min << endl;\n}\n\nint main(void) {\n    int cnt = 1;\n    while (cin >> wei) {\n        if (wei == 0) break;\n        cin >> n;\n        items.resize(n);\n        char ten;\n        for (int i = 0; i < n; i++) {\n            cin >> items[i].value >> ten >> items[i].weight;\n            items[i].ratio = (double)items[i].value / items[i].weight; // Calculate ratio\n        }\n        sort(items.begin(), items.end(), cmp); // Sort items by value-to-weight ratio\n\n        // Initialize DP table\n        fill(dp, dp + wei + 1, 0);\n        for (const auto& item : items) {\n            for (int j = wei; j >= item.weight; j--) {\n                dp[j] = max(dp[j], dp[j - item.weight] + item.value);\n            }\n        }\n\n        cout << "Case " << cnt << ":" << endl;\n        int ans = dp[wei];\n        cout << ans << endl; // Maximum value\n        max_weight(ans);\n        cnt++;\n    }\n    return 0;\n}')"
