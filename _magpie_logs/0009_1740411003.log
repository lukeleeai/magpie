2025-02-24 15:36:21,628	[DEBUG]	patch(4-9)="LineLLMCrossover(('source.cpp', 15), '#include <cstdio>\n#include <cstring>\nusing namespace std;\n\nint a[20];\nbool memo[11][1024]; // Memoization array\n\n// Enhanced check function for strict increasing condition\nbool check(int x) {\n    int last = -1; // Initialize to -1\n    for (int i = 0; i < 10; i++) {\n        if (x & (1 << i)) {\n            if (a[i] <= last) return false; // Strictly increasing\n            last = a[i];\n        }\n    }\n    return true;\n}\n\nbool dfs(int i, int x, int pre) {\n    if (i == 10) return check(x);\n    if (memo[i][x]) return false; // Use memoization to avoid recomputation\n    bool temp = false;\n    if (a[i] > pre) temp = dfs(i + 1, x, a[i]);\n    if (!temp) temp = dfs(i + 1, x | (1 << i), pre);\n    memo[i][x] = temp; // Store result\n    return temp;\n}\n\nint main() {\n    int T;\n    scanf("%d", &T);\n    while (T--) {\n        for (int i = 0; i < 10; i++) \n            scanf("%d", &a[i]); // Efficient input handling\n        puts(dfs(0, 0, -1) ? "YES" : "NO"); // Start from index 0\n    }\n    return 0;\n}')"
