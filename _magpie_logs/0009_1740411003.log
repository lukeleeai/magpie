 <= for clarity\n            pre = a[i];\n        }\n    }\n    return true;\n}\n\nbool dfs(int i, int x, int pre) {\n    if (i == 10) return check(x);\n    int state = (x << 10) | pre; // Create a unique state representation\n    if (memo.count(state)) return memo[state]; // Check if we already computed this state\n\n    bool temp = false;\n    if (a[i] > pre) temp = dfs(i + 1, x, a[i]); // Don\'t include current element\n    temp = temp || dfs(i + 1, x | (1 << i), pre); // Include current element\n\n    memo[state] = temp; // Store the result in memoization map\n    return temp;\n}\n\nint main() {\n    int T;\n    scanf("%d", &T);\n    while (T--) {\n        for (int i = 0; i < 10; i++) scanf("%d", &a[i]);\n        memo.clear(); // Clear memoization map for each test case\n        puts(dfs(1, 0, a[0]) ? "YES" : "NO");\n    }\n    return 0;\n}')"
