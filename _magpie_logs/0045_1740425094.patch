LineLLMMutation(('source.cpp', 3), '#include <cstdio>\n#include <vector>\nusing namespace std;\n\nint n;\n\nint saiki() {\n    vector<int> dp(n + 1, 0);\n    dp[n] = 1;\n\n    for (int i = n - 1; i >= 0; --i) {\n        dp[i] = dp[i + 1] + (i + 2 <= n ? dp[i + 2] : 0) + (i + 3 <= n ? dp[i + 3] : 0);\n    }\n    return dp[0];\n}\n\nint main() {\n    while (true) {\n        scanf("%d", &n);\n        if (n == 0)\n            break;\n\n        int ans = saiki();\n        printf("%d\\n", (ans + 3649) / 3650);\n    }\n}') + LineLLMMutation(('source.cpp', 12), '#include <cstdio>\nusing namespace std;\n\nint n;\n\nint saiki() {\n    if (n == 0) return 0;\n    if (n == 1) return 1;\n    if (n == 2) return 2;\n  \n    int prev3 = 1, prev2 = 1, prev1 = 2; // Corresponding to dp[n], dp[n-1], dp[n-2]\n    \n    for (int i = 3; i <= n; ++i) {\n        int current = prev1 + prev2 + prev3;\n        prev3 = prev2;\n        prev2 = prev1;\n        prev1 = current;\n    }\n    return prev1;\n}\n\nint main() {\n    while (true) {\n        scanf("%d", &n);\n        if (n == 0)\n            break;\n\n        int ans = saiki();\n        printf("%d\\n", (ans + 3649) / 3650);\n    }\n}')
