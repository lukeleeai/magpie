LineLLMCrossover(('source.cpp', 10), '#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <climits>\n\nusing namespace std;\n\nint n;\nvector<int> w, s;\nvector<int> bestIndex;\nint bestG;\n\nvoid solve(int k, vector<int>& index, int g, int sumW, int usedMask) {\n    if (g >= bestG) return;  // Early exit if the current fitness is already worse\n    if (k == n) {\n        bestG = g;\n        bestIndex = index;\n        return;\n    }\n\n    for (int i = 0; i < n; ++i) {\n        if (usedMask & (1 << i) || s[i] < sumW) // Combine checks to reduce nesting\n            continue;\n\n        index[k] = i;\n        solve(k + 1, index, g + (n - k) * w[i], sumW + w[i], usedMask | (1 << i));\n    }\n}\n\nint main() {\n    for (;;) {\n        cin >> n;\n        if (n == 0)\n            return 0;\n\n        vector<string> name(n);\n        w.resize(n);\n        s.resize(n);\n        for (int i = 0; i < n; ++i)\n            cin >> name[i] >> w[i] >> s[i];\n\n        bestG = INT_MAX;\n        vector<int> index(n);\n        solve(0, index, 0, 0, 0);\n        for (int i = n - 1; i >= 0; --i)\n            cout << name[bestIndex[i]] << endl;\n    }\n}')
