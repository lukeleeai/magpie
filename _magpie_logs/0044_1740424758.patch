LineLLMMutation(('source.cpp', 24), '#include <cstdio>\n#include <vector>\n\nusing namespace std;\n\nint func(int kaidan, int now, vector<int>& memo) {\n    if (now == kaidan) {\n        return 1;\n    } else if (now > kaidan) {\n        return 0;\n    }\n    \n    if (memo[now] != -1) {\n        return memo[now]; // Return cached result\n    }\n\n    memo[now] = func(kaidan, now + 1, memo) +\n                func(kaidan, now + 2, memo) +\n                func(kaidan, now + 3, memo);\n\n    return memo[now];\n}\n\nint main() {\n    int n, ans;\n\n    while (scanf("%d", &n) == 1) {\n        if (n == 0) break;\n        vector<int> memo(n + 1, -1); // Create memoization vector\n        ans = func(n, 0, memo);\n        printf("%d\\n", ans / 10 / 365 + 1);\n    }\n\n    return 0;\n}')
