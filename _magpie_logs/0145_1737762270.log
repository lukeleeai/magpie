ded in iterative approach\n}\n\nint main(void) {\n    while (scanf("%d%d", &m, &n), n, m) {\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j <= m; j++) {\n                scanf("%d", &ice[i][j]); // Read ice values\n                masu[i][j] = ice[i][j]; // Initialize masu directly\n            }\n        }\n\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j <= m; j++) {\n                if (masu[i][j] == 1) {\n                    func(i, j);\n                }\n            }\n        }\n\n        printf("%d\\n", mx);\n        mx = 0; // Reset for the next case\n    }\n\n    return 0;\n}')"
