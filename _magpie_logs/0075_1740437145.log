 dp[2][5001] = {};\n        dp[0][0] = 1.0;\n\n        for (int i = 0; i < X; i++) cin >> jump[i];\n\n        for (int i = 0; i < Z; i++) {\n            cin >> N >> E >> A;\n            switch (E) {\n                case 1: ivent[N].fr = A; break;\n                case 2: ivent[N].sc = A; break;\n                case 3: ivent[N].sc = -A; break;\n            }\n        }\n\n        for (int i = 0; i < Y; i++) {\n            // Use modulo to alternate between rows\n            int current = (i + 1) % 2;\n            int previous = i % 2;\n\n            // Reset the current dp row\n            fill(dp[current], dp[current] + 5001, 0.0);\n            \n            for (int j = 0; j <= i * 100; j++) {\n                if (dp[previous][j]) {\n                    for (int k = 0; k < X; k++) {\n                        int p_mas = min(i + jump[k], Y);\n                        int p_money = ivent[p_mas].sc + j;\n                        if (p_money < 0) p_money = 0;\n                        p_mas = min(p_mas + ivent[p_mas].fr, Y);\n                        dp[current][p_money] += dp[previous][j] / X;\n                    }\n                }\n            }\n        }\n\n        double ans = 0.0;\n        for (int i = 0; i < 5001; i++) {\n            ans += dp[Y % 2][i] * i;\n        }\n\n        cout << (int)ans << endl;\n    }\n}')"
