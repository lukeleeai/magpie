2025-01-27 01:33:24,516	[DEBUG]	patch(1-3)="LineLLMCrossover(('source.cpp', 0), '#include <iostream>\n\n#include <queue>\n\nusing namespace std;\n\n#define rep(i,n) for(int i=0;i<n;i++)\n\ntypedef pair<pair<int,int>,int> NODE;\n\n#define X first.second\n\n#define Y first.first\n\n#define depth second;\n\n\n\nint odd_x[] = {-1, 1, 0, 0, 1,1};\n\nint odd_y[] = { 0, 0,-1, 1,-1, 1};\n\n\n\nint even_x[] = {-1, 1, 0, 0,-1,-1};\n\nint even_y[] = { 0, 0,-1, 1,-1, 1};\n\n\n\nint main(){\n\n\tint point[100][100];\n\n\tint height,width,a_position,b_position,times,x,y,squares;\n\n\twhile(cin >> width  && width){\n\n\t\tint answer = 0;\n\n\t\tcin >> height;\n\n\t\trep(i,100)rep(j,100)point[i][j] = 0;\n\n\t\tcin >> times;\n\n\t\trep(i,times){\n\n\t\t\tcin >> a_position >> b_position;\n\n\t\t\ta_position--;b_position--;\n\n\t\t\tpoint[b_position][a_position] = i+1;\n\n\t\t}\n\n\t\tcin >> squares;\n\n\t\trep(P,squares){\n\n\t\t\tcin >> a_position >> b_position;\n\n\t\t\ta_position--;b_position--;\n\n\t\t\tpoint[b_position][a_position] = 50;\n\n\n\n\t\t\tint pt[100] = {0};\n\n\t\t\trep(i,height)rep(j,width){\n\n\t\t\t\tx = j,y = i;\n\n\t\t\t\tqueue<NODE> Q;\n\n\t\t\t\tpair<int,int> dp[100];\n\n\t\t\t\tbool done[100][100]={0};\n\n\t\t\t\tQ.push( make_pair(make_pair(y,x),0\t) );\n\n\t\t\t\twhile( Q.size() ){\n\n\t\t\t\t\tNODE q = Q.front(); Q.pop();\n\n\t\t\t\t\tif(point[q.Y][q.X]){\n\n\t\t\t\t\t\tdp[q.depth].first++;\n\n\t\t\t\t\t\tdp[q.depth].second = point[q.Y][q.X];\n\n\t\t\t\t  }\n\n\t\t\t\t\tif( q.Y % 2 == 1){\n\n\t\t\t\t\t\trep(L,6){\n\n\t\t\t\t\t\t\tif( q.X+odd_x[L] >=0 && q.X+odd_x[L] < width && q.Y+odd_y[L] < height && q.Y+odd_y[L]>=0 ){\n\n\t\t\t\t\t\t\t\t\tif( !done[q.Y+odd_y[L]][q.X+odd_x[L]] )Q.push( make_pair(make_pair(q.Y+odd_y[L],q.X+odd_x[L]),q.depth+1) );\n\n\t\t\t\t\t\t\t\t  \tdone[q.Y+odd_y[L]][q.X+odd_x[L]] = true;\n\n\t\t\t\t\t\t\t}\n\n\t\t\t\t\t\t}\n\n\t\t\t\t\t}else{\n\n\t\t\t\t\t\trep(L,6){\n\n\t\t\t\t\t\t\tif( q.X+even_x[L] >=0 && q.X+even_x[L] < width && q.Y+even_y[L] < height && q.Y+even_y[L]>=0 ){\n\n\t\t\t\t\t\t\t\t\t\tif( !done[q.Y+even_y[L]][q.X+even_x[L]] )Q.push( make_pair(make_pair(q.Y+even_y[L],q.X+even_x[L]),q.depth+1) );\n\n\t\t\t\t\t\t\t\t  \tdone[q.Y+even_y[L]][q.X+even_x[L]] = true;\n\n\t\t\t\t\t\t\t}\n\n\t\t\t\t\t\t}\n\n\t\t\t\t\t}\n\n\t\t\t\t}\n\n\t\t\t\trep(I,100){\n\n\t\t\t\t\tif(dp[I].first){\n\n\t\t\t\t\t\tif(dp[I].first==1)\n\n\t\t\t\t\t\t\tpt[dp[I].second-1]++;\n\n\t\t\t\t\t\tbreak;\n\n\t\t\t\t\t}\n\n\t\t\t\t}\n\n\t\t\t}\n\n\t\t\t\tanswer = max(pt[49],answer);\n\n\t\t\t\tpoint[b_position][a_position] = 0;\n\n\t\t\t}\n\n\t\t\tcout << answer << endl;\n\n\t}\n\n\n\n}')"
