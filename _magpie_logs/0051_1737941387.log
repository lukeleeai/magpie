\t\t\t\t\t}\n\n\t\t\t\t}\n\n\t\t\t\trep(I,100){\n\n\t\t\t\t\tif(dp[I].first){\n\n\t\t\t\t\t if(dp[I].first==1)\n\n\t\t\t\t\t  pt[dp[I].second-1]++;\n\n\t\t\t\t\t break;\n\n\t\t\t\t\t}\n\n\t\t\t\t}\n\n\t\t\t}\n\n\t\t\tret = max(pt[49],ret);\n\n\t\t\tpoint[b][a] = 0;\n\n\t\t}\n\n\t\tcout << ret << endl;\n\n\t}\n\n}')"
