y[L]][q.Q_X+ex[L]] = true;\n\n\t\t\t\t\t\t\t}\n\n\t\t\t\t\t\t}\n\n\t\t\t\t\t}\n\n\t\t\t\t}\n\n\t\t\t\trep(I,100){\n\n\t\t\t\t\tif(dp[I].first){\n\n\t\t\t\t\t\tif(dp[I].first==1)\n\n\t\t\t\t\t\t\tpt[dp[I].second-1]++;\n\n\t\t\t\t\t\tbreak;\n\n\t\t\t\t\t}\n\n\t\t\t\t}\n\n\t\t\t}\n\n\t\t\tret = max(pt[49],ret);\n\n\t\t\tpt[b][a] = 0;\n\n\t\t}\n\n\t\tcout << ret << endl;\n\n\t}\n\n\n\n}')"
