LineLLMCrossover(('source.cpp', 13), '#include <iostream>\n\n#include <vector>\n\n\n\nusing namespace std;\n\n\n\nint main() {\n\n\tint n;\n\n\twhile ( cin >> n, n ) {\n\n\t\tint h[200], r[200];\n\n\t\tfor (int i = 0; i < n; ++i) {\n\n\t\t\tcin >> h[i] >> r[i];\n\n\t\t}\n\n\t\tint M; cin >> M;\n\n\t\tfor (int i = 0; i < M; ++i) {\n\n\t\t\tcin >> h[n+i] >> r[n+i];\n\n\t\t}\n\n\t\tn += M;\n\n\n\n\t\tvector<vector<int>> m(n, vector<int>(n, 1e9));\n\n\t\tfor (int i = 0; i < n; ++i) {\n\n\t\t\tm[i][i] = 0;\n\n\t\t\tfor (int j = 0; j < n; ++j) {\n\n\t\t\t\tif (h[i] < h[j] && r[i] < r[j]) {\n\n\t\t\t\t\tm[i][j] = -1;\n\n\t\t\t\t}\n\n\t\t\t}\n\n\t\t}\n\n\t\tint ans = 0;\n\n\t\tfor (int k = 0; k < n; ++k) for (int i = 0; i < n; ++i) for (int j = 0; j < n; ++j) {\n\n\t\t\tif (m[i][k] && m[k][j]) {\n\n\t\t\t\tm[i][j] = min(m[i][j], m[i][k] + m[k][j]);\n\n\t\t\t}\n\n\t\t\tans = min(ans, m[i][j]);\n\n\t\t}\n\n\t\tcout << (-ans + 1) << endl;\n\n\t}\n\n}')
