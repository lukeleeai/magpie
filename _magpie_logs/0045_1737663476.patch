LineLLMCrossover(('source.cpp', 34), '#include <cstdio>\nusing namespace std;\n\nconst int MAX_N = 1000; // Set a reasonable maximum size for n\nint main() {\n    while (true) {\n        int n;\n        scanf("%d", &n);\n        if (n == 0)\n            break;\n\n        int dp[4] = {1, 0, 0, 0}; // Base case for dp[0] = 1\n\n        for (int i = 1; i <= n; ++i) {\n            int current = dp[(i - 1) % 4]; // Use a local variable for better performance\n            if (i >= 2) current += dp[(i - 2) % 4]; // Update current based on previous states\n            if (i >= 3) current += dp[(i - 3) % 4]; // Update current based on previous states\n            dp[i % 4] = current; // Store the result back into dp array\n        }\n\n        int ans = dp[n % 4];\n        printf("%d\\n", (ans / 3650) + (ans % 3650 != 0)); // Output the result with proper formatting\n    }\n}')
