LineLLMCrossover(('source.cpp', 0), '#include <cstdio>\n#include <cstring>\nusing namespace std;\n\nint a[20];\nbool memo[11][1024]; // Memoization array\n\nbool check(int x) {\n    int pre = 0;\n    for (int i = 0; i < 10; i++) if (x & (1 << i)) {\n        if (a[i] < pre) return false;\n        pre = a[i];\n    }\n    return true;\n}\n\nbool dfs(int i, int x, int pre) {\n    if (i == 10) return check(x);\n    if (memo[i][x]) return false; // Use memoization to avoid recomputation\n    bool temp = false;\n    if (a[i] > pre) temp = dfs(i + 1, x, a[i]);\n    if (!temp) temp = dfs(i + 1, x | (1 << i), pre);\n    memo[i][x] = temp; // Store result\n    return temp;\n}\n\nint main() {\n    int T;\n    scanf("%d", &T);\n    while (T--) {\n        for (int i = 0; i < 10; i++) scanf("%d", &a[i]);\n        puts(dfs(1, 0, a[0]) ? "YES" : "NO");\n    }\n    return 0;\n}')
