;\narray<int, N> dp;\n\nint calc() {\n    dp[n - 1] = 0; // Base case\n    priority_queue<pair<int, int>, vector<pair<int, int>>, greater<pair<int, int>>> minHeap; // Min-heap for minimum cost\n\n    // Initialize the heap with the last element\'s cost\n    minHeap.push({0, n - 1});\n\n    // Using a sliding window to maintain the minimum\n    for (int i = n - 2; i >= 0; i--) {\n        // Remove elements from the heap that are out of the current window\n        while (!minHeap.empty() && minHeap.top().second > i + k) {\n            minHeap.pop();\n        }\n\n        // Get the minimum cost from the heap\n        if (!minHeap.empty()) {\n            dp[i] = minHeap.top().first + abs(a[i] - a[minHeap.top().second]);\n        } else {\n            dp[i] = numeric_limits<int>::max(); // If no valid jump exists\n        }\n\n        // Push the current element\'s cost into the heap\n        minHeap.push({dp[i], i});\n    }\n\n    return dp[0];\n}\n\nint main() {\n    scanf("%d%d", &n, &k);\n\n    for (int i = 0; i < n; i++) {\n        scanf("%d", &a[i]);\n    }\n\n    fill(dp.begin(), dp.end(), -1);\n    cout << calc();\n\n    return 0;\n}')"
