 k;\narray<int, N> a;\narray<int, N> dp;\n\nint calc() {\n    dp[n - 1] = 0; // Base case\n\n    for(int i = n - 2; i >= 0; i--) {\n        int localRet = numeric_limits<int>::max();\n        deque<pair<int, int>> dq; // Pair of (dp value, index)\n\n        for(int j = 1; j <= min(k, n - i - 1); j++) {\n            while (!dq.empty() && dq.back().first >= dp[i + j]) {\n                dq.pop_back(); // Maintain decreasing order\n            }\n            dq.emplace_back(dp[i + j], i + j); // Maintain the index for reference\n\n            // Remove elements that are out of the current window\n            if (!dq.empty() && dq.front().second == i + j - k - 1) {\n                dq.pop_front();\n            }\n\n            localRet = min(localRet, dq.front().first + abs(a[i] - a[i + j]));\n        }\n        dp[i] = localRet;\n    }\n\n    return dp[0];\n}\n\nint main() {\n    scanf("%d%d", &n, &k);\n\n    for(int i = 0; i < n; i++) {\n        scanf("%d", &a[i]);\n    }\n\n    fill(dp.begin(), dp.end(), -1);\n\n    cout << calc();\n\n    return 0;\n}')"
