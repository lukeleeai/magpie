int N = 1e5 + 1;\n\nint n, k;\narray<int, N> a;\narray<int, N> dp;\n\nint calc() {\n    dp[n - 1] = 0; // Base case\n\n    deque<int> dq; // Deque to store indices of potential minimums\n\n    for(int i = n - 2; i >= 0; i--) {\n        // Remove indices that are out of the current window\n        while(!dq.empty() && dq.front() >= i + k) {\n            dq.pop_front();\n        }\n\n        // Update the deque with the current index\n        while(!dq.empty() && dp[dq.back()] >= dp[i + k]) {\n            dq.pop_back();\n        }\n        dq.push_back(i + k);\n\n        // Now the front of the deque holds the index of the minimum dp value in range [i+1, i+k]\n        int localRet = numeric_limits<int>::max();\n        if (!dq.empty()) {\n            localRet = dp[dq.front()] + abs(a[i] - a[dq.front()]);\n        }\n        \n        dp[i] = localRet;\n    }\n\n    return dp[0];\n}\n\nint main() {\n    scanf("%d%d", &n, &k);\n\n    for(int i = 0; i < n; i++) {\n        scanf("%d", &a[i]);\n    }\n\n    fill(dp.begin(), dp.end(), -1);\n\n    cout << calc();\n\n    return 0;\n}')"
