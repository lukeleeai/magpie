2025-02-24 23:56:18,806	[DEBUG]	patch(1-5)="LineLLMMutation(('source.cpp', 10), '#include <cstdio>\n#include <algorithm>\n#include <vector>\n#include <string>\n#include <set>\nusing namespace std;\n\n#define INF (1 << 30)\ntypedef multiset<int>::iterator itr;\n\nint main() {\n    int N, Q;\n    scanf("%d %d", &N, &Q);\n    vector<int> stmp(N), comp(N);\n    char buff[1024];\n    \n    for (int i = 0; i < N; i++) {\n        scanf("%d", &stmp[i]);\n        comp[i] = stmp[i];\n    }\n    \n    sort(comp.begin(), comp.end());\n    \n    multiset<int> sym;\n    while (Q--) {\n        scanf("%s %d", buff, &a);\n        if (*buff == \'A\') { // ADD\n            sym.insert(stmp[a - 1]);\n        } else if (*buff == \'R\') { // REMOVE\n            try {\n                sym.erase(sym.lower_bound(stmp[a - 1]));\n            } catch (...) {}\n        } else { // CHECK\n            int left = 0, right = INF;\n            while (left != right) {\n                int center = (left + right) / 2;\n                int pre = 0, BAN = 0;\n                for (itr it = sym.begin(); it != sym.end(); it++) {\n                    int p = distance(comp.begin(), lower_bound(comp.begin(), comp.end(), *it - center));\n                    BAN += max(p - pre, 0);\n                    pre = distance(comp.begin(), upper_bound(comp.begin(), comp.end(), *it));\n                }\n                BAN += max(N - pre, 0);\n                if (BAN <= a) right = center; else left = center + 1;\n            }\n            if (left != INF) printf("%d\\n", left); else puts("NA");\n        }\n    }\n    return 0;\n}')"
