LineLLMCrossover(('source.cpp', 32), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\nconst int maxn = 100005; // Assuming a maximum size based on typical constraints\nint a[maxn];\n\nint main() {\n    int n, k;\n\n    while (scanf("%d %d", &n, &k), n || k) {\n        // Using a single scanf call to read the entire array for better performance\n        for (int i = 0; i < n; i++) {\n            scanf("%d", &a[i]);\n        }\n\n        // Initialize the maximum sum with the sum of the first k elements\n        int sum = 0;\n        for (int i = 0; i < k; i++) {\n            sum += a[i];\n        }\n        int max_sum = sum; // Store the maximum sum found\n\n        // Use a sliding window technique to update the sum efficiently\n        for (int i = k; i < n; i++) {\n            sum += a[i] - a[i - k]; // Sliding window sum update\n            max_sum = max(max_sum, sum); // Update maximum sum if needed\n        }\n        printf("%d\\n", max_sum);\n    }\n}')
