LineLLMCrossover(('source.cpp', 15), '#include <cstdio>\nusing namespace std;\n\nint main() {\n    int n;\n    int a[] = {0, 1, 2, 3, 5, 7, 8, 9};\n\n    while (scanf("%d", &n) && n) {\n        int i = 0, power = 1;\n        while (power <= n) { // Using power-based approach to find the highest power of 8\n            power *= 8;\n            i++;\n        }\n        power /= 8; // step back to the last valid power\n\n        char output[12]; // Allocate enough space for the output\n        int idx = 0; // Index for output array\n\n        for (i--; i >= 0; i--) {\n            output[idx++] = \'0\' + a[n >> (i * 3)];\n            n &= (1 << (i * 3)) - 1;\n        }\n\n        output[idx] = \'\\0\'; // Null-terminate the string\n        puts(output); // Use puts for better performance over printf\n    }\n    return 0;\n}')
