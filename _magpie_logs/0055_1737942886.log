2025-01-27 01:56:59,250	[DEBUG]	patch(1-10)="LineLLMMutation(('source.cpp', 15), '#include<cstdio>\n\n// Define infinity as a large number for initialization\n\nconst int INF = 1 << 29;\n\n// Declare variables for the number of nodes and edges\n\nint n, m;\n\n// Declare a 3D array for distance and time\n\nint d[2][3000][3000];\n\n// Function to initialize the distance array\n\nvoid initDist(){\n\n\tfor(int i = 0; i != n; ++i)\n\n\t\tfor(int j = 0; j != n; ++j)\n\n\t\t\tfor(int k = 0; k != 2; ++k)\n\n\t\t\t\td[k][i][j] = i == j ? 0 : INF;\n\n}\n\n// Function to input edges\n\nvoid inputEdges(){\n\n\tint a, b, c, t;\n\n\tfor(int i = 0; i != m; ++i){\n\n\t\tscanf("%d%d%d%d", &a, &b, &c, &t);\n\n\t\td[0][a-1][b-1] = d[0][b-1][a-1] = c;\n\n\t\td[1][a-1][b-1] = d[1][b-1][a-1] = t;\n\n\t}\n\n}\n\n// Function to perform Floyd-Warshall algorithm\n\nvoid floyd(){\n\n\tfor(int k = 0; k != n; ++k)\n\n\t\tfor(int i = 0; i != n; ++i)\n\n\t\t\tfor(int j = 0; j != n; ++j)\n\n\t\t\t\tfor(int l = 0; l != 2; ++l)\n\n\t\t\t\t\td[l][i][j] = std::min(d[l][i][j], d[l][i][k] + d[l][k][j]);\n\n}\n\n// Main function\n\nint main(){\n\n\tscanf("%d%d", &n, &m);\n\n\tinitDist();\n\n\tinputEdges();\n\n\tfloyd();\n\n\tint k;\n\n\tscanf("%d", &k);\n\n\t// Query the shortest distances\n\n\twhile(k--){\n\n\t\tint p, q, r;\n\n\t\tscanf("%d%d%d", &p, &q, &r);\n\n\t\tprintf("%d\\n", d[r][p-1][q-1]);\n\n\t}\n\n\treturn 0;\n\n}')"
