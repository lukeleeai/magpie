lgorithm>\n#include <vector>\n#include <cstring>\nusing namespace std;\n\n#define rep(i,n) for(int i = 0; i < n; i++)\n\nstruct P { int x, y; P() {} P(int a, int b) { x = a, y = b; } };\n\nint operator -(P a, P b) {\n    return abs(a.x - b.x) + abs(a.y - b.y);\n}\n\n#define INF (1 << 21)\n\nint dp[6][1000]; // Reduced from 1 << 5 to 6 since we only need to track the current and previous state\n\nint main() {\n    int W, H;\n    while (scanf("%d %d", &W, &H), W) {\n        P s, g;\n        vector<P> v[6];\n        rep(i, H) rep(j, W) {\n            char c; \n            scanf(" %c", &c);\n            if (c == \'S\') s = P(j, i);\n            else if (c == \'G\') g = P(j, i);\n            else if (c != \'.\') v[c - \'1\'].push_back(P(j, i));\n        }\n\n        memset(dp, INF, sizeof(dp)); // Initialize dp using memset for efficiency\n\n        // Setting initial values for dp array using only two loops\n        rep(i, 5) {\n            for (int j = 0; j < v[(i + 1) % 5].size(); ++j) {\n                dp[(i + 1) % 5][j] = s - v[(i + 1) % 5][j];\n            }\n        }\n\n        // Main DP logic with reduced memory usage\n        rep(bit, (1 << 5) - 1) rep(x, 5) {\n            int y = (x + 1) % 5;\n            rep(i, v[x].size()) {\n                if (dp[x][i] == INF) break; \n                rep(j, v[y].size()) {\n                    dp[y][j] = min(dp[y][j], dp[x][i] + (v[x][i] - v[y][j]));\n                }\n            }\n        }\n\n        int ans = INF, cho = -1;\n        rep(i, 5) rep(j, v[i].size()) {\n            int cst = dp[i][j] + (g - v[i][j]);\n            int w = (i + 1) % 5;\n            if (ans >= cst) {\n                if (ans == cst) {\n                    cho = min(cho, w);\n                } else {\n                    cho = w;\n                    ans = cst;\n                }\n            }\n        }\n\n        if (ans == INF) printf("NA\\n");\n        else printf("%d %d\\n", cho + 1, ans);\n    }\n}')"
