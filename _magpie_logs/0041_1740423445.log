2025-02-24 19:02:27,393	[DEBUG]	patch(2-2)="LineLLMMutation(('source.cpp', 19), '#include <iostream>\n#include <vector>\n#include <limits>\n\nusing namespace std;\n\nint main() {\n    int n;\n    while (cin >> n, n) {\n        vector<int> h, r;\n        h.reserve(n); // Reserve memory to avoid resizing\n        r.reserve(n);\n\n        for (int i = 0; i < n; ++i) {\n            int height, radius;\n            cin >> height >> radius;\n            h.push_back(height);\n            r.push_back(radius);\n        }\n\n        int M; cin >> M;\n        h.resize(n + M);\n        r.resize(n + M);\n\n        for (int i = 0; i < M; ++i) {\n            cin >> h[n + i] >> r[n + i];\n        }\n        \n        n += M;\n        vector<vector<int>> m(n, vector<int>(n, numeric_limits<int>::max())); // Initialize with max value\n\n        for (int i = 0; i < n; ++i) {\n            for (int j = 0; j < n; ++j) {\n                if (h[i] < h[j] && r[i] < r[j]) {\n                    m[i][j] = -1;\n                }\n            }\n        }\n\n        int ans = numeric_limits<int>::max(); // Get maximum possible value\n        for (int k = 0; k < n; ++k) \n            for (int i = 0; i < n; ++i) \n                for (int j = 0; j < n; ++j) {\n                    if (m[i][k] != numeric_limits<int>::max() && m[k][j] != numeric_limits<int>::max()) {\n                        m[i][j] = min(m[i][j], m[i][k] + m[k][j]);\n                    }\n                    ans = min(ans, m[i][j]);\n                }\n\n        cout << (-ans + 1) << endl;\n    }\n}')"
