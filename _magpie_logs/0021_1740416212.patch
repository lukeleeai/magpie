LineLLMMutation(('source.cpp', 24), '#include<cstdio>\n#include<iostream>\n#define INF 2100000000\n\nusing namespace std;\n\nint minix(int a,int b,int c){\n    if(b>=a && c>=a){\n        return a;\n    }\n    if(a>=b && c>=b){\n        return b;\n    }\n    if(b>=c && a>=c){\n        return c;\n    }\n}\n\nint main(){\n    int n;\n    int masu[1002][1002];\n    int ura[1002][1002];\n    char str[1002];\n    while(1){\n        for(int i=0;i<=1001;i++){\n            for(int j=0;j<=1001;j++){\n                masu[i][j]=0;\n            }\n        }\n        scanf("%d",&n);\n        if(n==0){\n            break;\n        }\n        for(int i=1;i<=n;i++){\n            scanf("%s",str);\n            for(int j=1;j<=n;j++){\n                if(str[j-1]==\'.\'){\n                    ura[i][j]=0;\n                }else{\n                    ura[i][j]=1;\n                }\n            }\n        }\n\n        int maxi=0;\n        for(int i=1;i<=n;i++){\n            for(int j=1;j<=n;j++){\n                if(ura[i][j]==0){\n                    masu[i][j]=minix(masu[i-1][j],masu[i][j-1],masu[i-1][j-1])+1;\n                    maxi=max(masu[i][j],maxi);\n                }\n            }\n        }\n        printf("%d\\n",maxi);\n    }\n}')
