LineLLMCrossover(('source.cpp', 15), '#include <iostream>\n#include <cstdio> // Use scanf for faster input\nusing namespace std;\n\nint N, M, L, R, s[50003], t[50003], e[50003], c[10003]; \nlong long d[10003];\n\nint main() {\n    scanf("%d %d", &N, &M); // Use scanf for faster input\n\n    while (true) {\n        scanf("%d %d %d", &s[R], &t[R], &e[R]);\n        s[R]--, t[R]--; // Adjust indices\n        if (!e[R]) break; \n        R++;\n    }\n\n    scanf("%d", &L); // Use scanf for faster input\n\n    for (int i = 0; i < L; i++) {\n        for (int j = 0; j < M; j++) \n            scanf("%d", &c[j]); // Use scanf for faster input\n\n        fill(d, d + N, 0); // Reset d array\n\n        for (int j = 0; j < R; j++) \n            d[s[j]] += c[t[j]] * e[j];\n\n        for (int j = 0; j < N; j++) \n            cout << (j ? " " : "") << d[j];\n        cout << endl;\n    }\n}')
