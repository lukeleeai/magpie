'#include <cstdio>\n#include <array>\n\nconst int kMaxSquare = 64;\nconst int kMaxValue = 1000;\nint roulette[4];\n\ntypedef struct {\n    int type;\n    int value;\n} BoardState;\n\nBoardState board[kMaxSquare];\n\ndouble bp[kMaxSquare][kMaxValue + 1]; // Use fixed-size array instead of std::map\n\nint bp_func(int X, int Y) {\n    double prob = 1.0 / static_cast<double>(X);\n    bp[0][0] = 1.0;\n\n    for (int n = 0; n < Y; n++) {\n        for (int j = 0; j <= kMaxValue; j++) {\n            if (bp[n][j] > 0) { // Check if there is a valid probability\n                for (int k = 0; k < X; k++) {\n                    int pos = (n + roulette[k] < Y) ? n + roulette[k] : Y;\n\n                    if (board[pos].type == 1)\n                        bp[(pos + board[pos].value < Y) ? pos + board[pos].value : Y][j]\n                            += bp[n][j] * prob;\n                    else if (board[pos].type == 2)\n                        bp[pos][j + board[pos].value] += bp[n][j] * prob;\n                    else if (board[pos].type == 3)\n                        bp[pos][(j - board[pos].value > 0) ? j - board[pos].value : 0]\n                            += bp[n][j] * prob;\n                    else\n                        bp[pos][j] += bp[n][j] * prob;\n                }\n            }\n        }\n    }\n\n    double res = 0.0;\n    for (int j = 0; j <= kMaxValue; j++)\n        res += static_cast<double>(j) * bp[Y][j];\n\n    return static_cast<int>(res);\n}\n\nint main() {\n    while (true) {\n        int X, Y, Z;\n        scanf("%d %d %d", &X, &Y, &Z);\n        if (X == 0) return 0;\n\n        for (int i = 0; i < X; i++)\n            scanf("%d", &roulette[i]);\n\n        for (int i = 0; i < kMaxSquare; i++)\n            board[i] = {0, 0};\n\n        for (; Z > 0; Z--) {\n            int N, E, A;\n            scanf("%d %d %d", &N, &E, &A);\n            board[N] = {E, A};\n        }\n\n        printf("%d\\n", bp_func(X, Y));\n    }\n}')"
