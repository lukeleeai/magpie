LineLLMMutation(('source.cpp', 14), '#include <cstdio>\n\nusing namespace std;\n\ntypedef long long ll;\n\nll gcd(ll a, ll b) {\n    return (!b) ? a : gcd(b, a % b);\n}\n\nint main() {\n    int n;\n    ll d[10], v[10], t[10];\n\n    for (;;) {\n        scanf("%d", &n);\n        if (!n) break;\n\n        for (int i = 0; i < n; i++) scanf("%lld %lld", &d[i], &v[i]);\n        t[0] = 1;\n        for (int i = 1; i < n; i++) {\n            t[i] = t[i - 1] * d[i - 1] * v[i];\n            for (int j = 0; j < i; j++) t[j] *= d[i] * v[i - 1];\n            ll T = t[0];\n            for (int j = 1; j <= i; j++) T = gcd(T, t[j]);\n            for (int j = 0; j <= i; j++) t[j] /= T;\n        }\n\n        for (int i = 0; i < n; i++) printf("%lld\\n", t[i]);\n    }\n}') + LineLLMMutation(('source.cpp', 22), '#include <cstdio>\n#include <numeric> // Include for std::gcd\n\nusing namespace std;\n\ntypedef long long ll;\n\nint main() {\n    int n;\n    ll d[10], v[10], t[10];\n\n    for (;;) {\n        scanf("%d", &n);\n        if (!n) break;\n\n        for (int i = 0; i < n; i++) scanf("%lld %lld", &d[i], &v[i]);\n        \n        t[0] = 1;\n        ll common_gcd;\n\n        for (int i = 1; i < n; i++) {\n            t[i] = t[i - 1] * d[i - 1] * v[i];\n            for (int j = 0; j < i; j++) {\n                t[j] *= d[i] * v[i - 1];\n            }\n            common_gcd = t[0];\n            for (int j = 1; j <= i; j++) {\n                common_gcd = gcd(common_gcd, t[j]);\n            }\n            for (int j = 0; j <= i; j++) t[j] /= common_gcd;\n        }\n\n        for (int i = 0; i < n; i++) printf("%lld\\n", t[i]);\n    }\n}') + LineLLMMutation(('source.cpp', 25), '#include <cstdio>\n#include <numeric> // Include for std::gcd\nusing namespace std;\n\ntypedef long long ll;\n\nint main() {\n    int n;\n    ll d[10], v[10], t[10];\n\n    for (;;) {\n        scanf("%d", &n);\n        if (!n) break;\n\n        for (int i = 0; i < n; i++) scanf("%lld %lld", &d[i], &v[i]);\n     