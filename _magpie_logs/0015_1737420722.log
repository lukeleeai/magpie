2025-01-21 00:55:03,750	[DEBUG]	patch(1-3)="LineLLMCrossover(('source.cpp', 1), '#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cmath>\n\nusing namespace std;\n\nconstexpr int INF = 0x3f3f3f3f;\n\nclass SegmentTree {\npublic:\n    SegmentTree(int n) : n(n) {\n        data.resize(4 * n, INF);\n    }\n    \n    void update(int idx, int value, int node = 1, int left = 1, int right = n) {\n        if (left == right) {\n            data[node] = min(data[node], value);\n        } else {\n            int mid = (left + right) / 2;\n            if (idx <= mid) {\n                update(idx, value, node * 2, left, mid);\n            } else {\n                update(idx, value, node * 2 + 1, mid + 1, right);\n            }\n            data[node] = min(data[node * 2], data[node * 2 + 1]);\n        }\n    }\n\n    int query(int l, int r, int node = 1, int left = 1, int right = n) {\n        if (l > r) return INF;\n        if (l == left && r == right) return data[node];\n        int mid = (left + right) / 2;\n        return min(query(l, min(r, mid), node * 2, left, mid),\n                   query(max(l, mid + 1), r, node * 2 + 1, mid + 1, right));\n    }\n\nprivate:\n    vector<int> data;\n    int n;\n};\n\nint main() {\n    int n, k;\n    cin >> n >> k;\n\n    vector<int> h(n + 1);\n    for (int i = 1; i <= n; i++) cin >> h[i];\n\n    SegmentTree segTree(n);\n    segTree.update(1, 0);\n\n    for (int i = 2; i <= n; i++) {\n        int minVal = segTree.query(max(1, i - k), i - 1);\n        segTree.update(i, minVal + abs(h[i] - h[minVal]));\n    }\n    cout << segTree.query(n, n) << endl;\n\n    return 0;\n}')"
