2025-02-24 16:00:04,461	[DEBUG]	patch(0-10)="LineLLMMutation(('source.cpp', 9), '#include <iostream>\n#include <string>\n#include <algorithm>\n#include <cmath>\n#include <thread>\n#include <vector>\n#define loop(i,a,b) for(int i=a;i<b;i++)\n#define rep(i,a) loop(i,0,a)\nusing namespace std;\n\nvoid transformAndSearch(string& s, string& ans, bool& han, int a, int b) {\n    string tmp = s; // Copy original string\n    for (size_t j = 0; j < tmp.size(); j++) {\n        if (isalpha(tmp[j])) {\n            tmp[j] = (a * (tmp[j] - \'a\') + b) % 26 + \'a\';\n        }\n    }\n    if (tmp.find("this") != string::npos || tmp.find("that") != string::npos) {\n        ans = tmp;\n        han = true;\n    }\n}\n\nint main() {\n    int n;\n    cin >> n;\n    rep(i,n) {\n        string s;\n        if (i == 0) getline(cin, s);\n        getline(cin, s);\n        \n        string ans;\n        bool han = false;\n        vector<thread> threads;\n        rep(a, 27) {\n            rep(b, 27) {\n                threads.emplace_back(transformAndSearch, ref(s), ref(ans), ref(han), a, b);\n            }\n        }\n        for (auto& t : threads) t.join(); // Wait for all threads to finish\n        cout << ans << endl;\n    }\n}')"
