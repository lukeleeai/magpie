2025-02-24 16:01:03,617	[DEBUG]	patch(1-4)="LineLLMCrossover(('source.cpp', 1), '#include <cstdio>\n#include <string>\n#include <algorithm>\n#include <cmath>\n#define loop(i,a,b) for(int i=a;i<b;i++)\n#define rep(i,a) loop(i,0,a)\nusing namespace std;\n\nint main() {\n    int n;\n    scanf("%d", &n);\n    rep(i,n) {\n        char s[1000];\n        if (i == 0) getchar(); // Consume newline\n        scanf("%[^\\n]", s); // Read until newline\n        \n        string ans;\n        bool han = false;\n        rep(a, 27) {\n            rep(b, 27) {\n                string tmp(s);\n                for (size_t j = 0; j < tmp.size(); j++) {\n                    if (isalpha(tmp[j])) \n                        tmp[j] = (a * (tmp[j] - \'a\') + b) % 26 + \'a\';\n                }\n                \n                if (tmp.find("this") != string::npos || tmp.find("that") != string::npos) {\n                    ans = tmp;\n                    han = true;\n                    break;\n                }\n                if (han) break;\n            }\n            if (han) break;\n        }\n        printf("%s\\n", ans.c_str());\n    }\n}')"
