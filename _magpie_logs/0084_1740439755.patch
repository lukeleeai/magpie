LineLLMMutation(('source.cpp', 19), '#include <iostream>\n#define C 300000\nusing namespace std;\n\nint main() {\n    int n, q;\n    cin >> n >> q;\n    int c[300000], query[100000];\n    bool has_c[C + 1] = {false}; // Initialization combined\n\n    for (int i = 0; i < n; i++) {\n        cin >> c[i];\n        has_c[c[i]] = true; // Populate has_c array in the same loop\n    }\n\n    for (int i = 0; i < q; i++) {\n        cin >> query[i];\n        int max_r = -1;\n        for (int r = query[i] - 1; r >= 0; r--) {\n            for (int k = 0; ; k++) {\n                int x = k * query[i] + r;\n                if (x > C) break;\n                if (has_c[x]) {\n                    max_r = max(r, max_r);\n                    break;\n                }\n            }\n            if (max_r >= 0) break;\n        }\n        cout << max_r << endl;\n    }\n    return 0;\n}') + LineLLMMutation(('source.cpp', 20), '#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cstdio>\n#define C 300000\nusing namespace std;\n\nint main() {\n    int n, q;\n    scanf("%d %d", &n, &q);\n    vector<int> c(n);\n    vector<int> query(q);\n    bool has_c[C + 1] = {false};\n\n    for (int i = 0; i < n; i++) {\n        scanf("%d", &c[i]);\n        has_c[c[i]] = true;\n    }\n\n    for (int i = 0; i < q; i++) {\n        scanf("%d", &query[i]);\n        int max_r = -1;\n        for (int r = query[i] - 1; r >= 0; r--) {\n            for (int k = 0; ; k++) {\n                int x = k * query[i] + r;\n                if (x > C) break;\n                if (has_c[x]) {\n                    max_r = r; // No need to use max here since we are iterating downwards\n                    break;\n                }\n            }\n            if (max_r >= 0) break;\n        }\n        printf("%d\\n", max_r);\n    }\n    return 0;\n}')
