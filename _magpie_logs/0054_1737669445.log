2025-01-23 21:58:29,092	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include <cstdio>\n#include <vector>\n#include <queue>\n#include <utility>\n\nusing namespace std;\n\ntypedef pair<int, int> pii;\n\nconst int inf = 1e9;\nvector<pii> G[100];\nint d[100];\n\nvoid dijkstra(int s, int mode) {\n    priority_queue<pii, vector<pii>, greater<pii>> q;\n    fill(d, d + 100, inf);\n    d[s] = 0;\n    q.push(pii(0, s));\n\n    while (!q.empty()) {\n        pii p = q.top(); q.pop();\n        int v = p.second;\n        for (const auto& edge : G[v]) {\n            int a = mode == 0 ? edge.first : edge.second;\n            if (d[edge.first] > d[v] + a) {\n                d[edge.first] = d[v] + a;\n                q.push(pii(d[edge.first], edge.first));\n            }\n        }\n    }\n}\n\nsigned main() {\n    int N, M;\n    while (scanf("%d %d", &N, &M), N || M) {\n        for (int i = 0; i < M; ++i) G[i].clear();\n        for (int i = 0; i < N; ++i) {\n            int a, b, cost, time; scanf("%d %d %d %d", &a, &b, &cost, &time); a--; b--;\n            G[a].emplace_back(b, cost);\n            G[b].emplace_back(a, cost);\n        }\n\n        int K; scanf("%d", &K);\n        for (int i = 0; i < K; ++i) {\n            int p, q, r; scanf("%d %d %d", &p, &q, &r); p--; q--;\n            dijkstra(p, r);\n            printf("%d\\n", d[q]);\n        }\n    }\n}')"
