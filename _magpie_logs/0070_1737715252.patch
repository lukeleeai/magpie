LineLLMCrossover(('source.cpp', 34), '#include <cstdio>\nusing namespace std;\n\nint main() {\n    int n;\n    while (scanf("%d", &n), n) {\n        int ice[10] = {}; // Frequency array for digits 0-9\n\n        for (int i = 0; i < n; ++i) {\n            int a;\n            scanf("%d", &a);\n            ice[a]++;\n        }\n\n        for (int i = 0; i < 10; ++i) {\n            putchar(ice[i] ? \'*\' : \'-\'); // Use putchar to output \'*\' or \'-\'\n            for (int j = 1; j < ice[i]; ++j) {\n                putchar(\'*\'); // Output \'*\' for counts greater than 1\n            }\n            putchar(\'\\n\'); // New line for each digit\n        }\n    }\n}')
