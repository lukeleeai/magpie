2025-02-24 17:04:07,732	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\n\nint n;\nint s[1001][1024];\n\nint calc(int y, int x, int n) {\n    int a, b, c, d;\n    n--;\n    a = s[y - 1][x - 1];\n    b = s[y - 1][x + n];\n    c = s[y + n][x - 1];\n    d = s[y + n][x + n];\n    return d - c - b + a;\n}\n\nint main() {\n    while (scanf("%d", &n), n) {\n        memset(s, 0, sizeof(s));\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j <= n; j++) {\n                char c;\n                scanf(" %c", &c);\n                s[i][j] = (c == \'*\') + s[i - 1][j] + s[i][j - 1] - s[i - 1][j - 1];\n            }\n        }\n\n        int ans = 0;\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j <= n; j++) {\n                int lb = 0, ub = n - max(i, j) + 2;\n                while (ub - lb > 1) {\n                    int m = (lb + ub) / 2;\n                    if (calc(i, j, m)) ub = m;\n                    else lb = m;\n                }\n                ans = max(ans, lb);\n            }\n        }\n        printf("%d\\n", ans);\n    }\n    return 0;\n}')"

