LineLLMCrossover(('source.cpp', 12), '#include <cstdio>\n#include <algorithm>\n\nusing namespace std;\n\nconst int MAXN = 100; // Assuming a reasonable max input size\n\nint main() {\n    int N;\n    int data[MAXN]; // Use a fixed-size array instead of vector\n\n    while (true) {\n        scanf("%d", &N);\n        if (N == 0) break;\n\n        int ans = 1; // Start counting from 1\n        bool hasGreaterThanOne = false;\n\n        for (int i = 0; i < N; i++) {\n            scanf("%d", &data[i]);\n            if (data[i] > 1) {\n                hasGreaterThanOne = true;\n            }\n            if (data[i] != 0) ans++;\n        }\n\n        if (!hasGreaterThanOne) {\n            printf("NA\\n");\n        } else {\n            if (N == 1) {\n                printf("2\\n");\n            } else {\n                printf("%d\\n", ans);\n            }\n        }\n    }\n    \n    return 0;\n}')
