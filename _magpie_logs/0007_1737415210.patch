LineLLMCrossover(('source.cpp', 58), '#include "stdc++.h"\n\nusing namespace std;\n\ntypedef long long int int64;\n\nint main() {\n    int64 n, k;\n    cin >> n >> k;\n\n    vector<int64> h(n);\n    for (int64 i = 0; i < n; i++)\n        cin >> h[i];\n\n    vector<int64> ans(n);\n    ans[0] = 0;\n    ans[1] = abs(h[1] - h[0]);\n\n    for (int64 i = 2; i < n; i++) {\n        int64 min_val = ans[i - 1] + abs(h[i] - h[i - 1]);\n        int64 jump_cost; // Declare jump_cost outside the inner loop\n        for (int64 j = 2; j <= k && j <= i; j++) {\n            jump_cost = abs(h[i] - h[i - j]);\n            min_val = std::min(min_val, jump_cost + ans[i - j]);\n        }\n        ans[i] = min_val;\n    }\n    cout << ans[n - 1];\n}') + LineLLMMutation(('source.cpp', 85), '#include "stdc++.h"\n\nusing namespace std;\n\ntypedef long long int int64;\n\nint main() {\n    int64 n, k;\n    cin >> n >> k;\n\n    vector<int64> h(n);\n    for (int64 i = 0; i < n; i++)\n        cin >> h[i];\n\n    vector<int64> ans(n);\n    ans[0] = 0;\n    ans[1] = abs(h[1] - h[0]);\n\n    for (int64 i = 2; i < n; i++) {\n        int64 min_val = ans[i - 1] + abs(h[i] - h[i - 1]);\n        for (int64 j = 2; j <= k && j <= i; j++) {\n            // Calculate the jump cost in a more efficient way\n            int64 jump_cost = abs(h[i] - h[i - j]);\n            min_val = std::min(min_val, jump_cost + ans[i - j]);\n        }\n        ans[i] = min_val;\n    }\n    cout << ans[n - 1];\n}')
