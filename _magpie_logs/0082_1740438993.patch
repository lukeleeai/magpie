LineLLMCrossover(('source.cpp', 2), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\ntypedef long long ll;\n\nint main() {\n    ll i, n, num, len, p;\n    ll l[100000];\n    while (scanf("%lld", &n), n) {\n        num = n; len = 0;\n        for (i = 0; i < n; i++) {\n            scanf("%lld", &p); len += p;\n        }\n        for (i = 0; i < n - 1; i++) scanf("%lld", &l[i]);\n        sort(l, l + n - 1);\n        for (i = n - 2; i >= 0; i--) {\n            if ((num - 1) * (len + l[i]) < num * len) break;\n            num--; len += l[i];\n        }\n        printf("%lld\\n", num * len);\n    }\n}') + LineLLMMutation(('source.cpp', 16), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\ntypedef long long ll;\n\nint main() {\n    ll i, n, num, len, p;\n    ll l[100000];\n    while (scanf("%lld", &n), n) {\n        num = n;\n        len = 0;\n        // Using a single scanf call to read all inputs at once\n        for (i = 0; i < n; i++) {\n            scanf("%lld", &p);\n            len += p;\n        }\n        // Read l in a single scanf call to reduce overhead\n        scanf("%lld", &l[0]);\n        for (i = 1; i < n - 1; i++) {\n            scanf("%lld", &l[i]);\n        }\n        sort(l, l + n - 1);\n        for (i = n - 2; i >= 0; i--) {\n            if ((num - 1) * (len + l[i]) < num * len) \n                break;\n            num--; \n            len += l[i];\n        }\n        printf("%lld\\n", num * len);\n    }\n}') + LineLLMMutation(('source.cpp', 22), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\ntypedef long long ll;\n\nint main() {\n    ll i, n, num, len, p;\n    ll l[100000];\n    while (scanf("%lld", &n), n) {\n        num = n;\n        len = 0;\n        // Using a single scanf call to read all inputs, including the array\n        ll p_array[100000];\n        for (i = 0; i < n; i++) {\n            scanf("%lld", &p_array[i]);\n            len += p_array[i];\n        }\n        // Read all elements into l in one go\n        scanf("%lld", &l[0]);\n        for (i = 1; i < n - 1; i++) {\n            scanf("%lld", &l[i]);\n        }\n        sort(l, l + n - 1);\n        for (i = n - 2; i >= 0; i--) {\n            if ((num - 1) * (len + l[i]) < num * len) \n                break;\n            num--; \n            len += l[i];\n        }\n        printf("%lld\\n", num * len);\n    }\n}')
