LineLLMMutation(('source.cpp', 2), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\nlong long d[10], v[10];\n\nvoid compute(int n) {\n    for (int i = 2; i <= min(d[n], v[n]); i++) {\n        while (d[n] % i == 0 && v[n] % i == 0) {\n            d[n] /= i;\n            v[n] /= i;\n        }\n    }\n}\n\nint main() {\n    int n;\n    while (scanf("%d", &n), n) {\n        long long a, b;\n        for (int i = 0; i < n; i++) {\n            scanf("%lld %lld", &d[i], &v[i]);\n            compute(i);\n        }\n        a = (d[0] * d[1]) / __gcd(d[0], d[1]);\n        b = __gcd(v[0], v[1]);\n        for (int i = 2; i < n; i++) {\n            a = (a * d[i]) / __gcd(a, d[i]);\n            b = __gcd(b, v[i]);\n        }\n        for (int i = 0; i < n; i++) {\n            printf("%lld\\n", a * v[i] / (b * d[i]));\n        }\n    }\n    return 0;\n}') + LineLLMMutation(('source.cpp', 18), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\nlong long d[10], v[10];\n\nlong long gcd(long long a, long long b) {\n    while (b) {\n        long long temp = b;\n        b = a % b;\n        a = temp;\n    }\n    return a;\n}\n\nvoid compute(int n) {\n    long long g = gcd(d[n], v[n]);\n    d[n] /= g;\n    v[n] /= g;\n}\n\nint main() {\n    int n;\n    while (scanf("%d", &n), n) {\n        long long a, b;\n        for (int i = 0; i < n; i++) {\n            scanf("%lld %lld", &d[i], &v[i]);\n            compute(i);\n        }\n        a = (d[0] * d[1]) / gcd(d[0], d[1]);\n        b = gcd(v[0], v[1]);\n        for (int i = 2; i < n; i++) {\n            a = (a * d[i]) / gcd(a, d[i]);\n            b = gcd(b, v[i]);\n        }\n        for (int i = 0; i < n; i++) {\n            printf("%lld\\n", a * v[i] / (b * d[i]));\n        }\n    }\n    return 0;\n}')
