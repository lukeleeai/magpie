2025-01-24 11:55:13,899	[DEBUG]	patch(10-8)="LineLLMCrossover(('source.cpp', 37), '#include <cstdio>\n#include <algorithm>\n\n#define FOR(i,e) for(int i=0;i<(int)(e);i++)\n\nusing namespace std;\n\nint main(){\n    double pb[51][5001]; // Retaining size from Parent 4 for optimization\n    int x, y, z;\n    int v[100], e[51], a[51]; \n\n    while(scanf("%d %d %d", &x, &y, &z) == 3 && (x || y || z)){\n        FOR(i, x) scanf("%d", &v[i]);\n        FOR(i, y + 1) e[i] = a[i] = 0;\n\n        FOR(i, z){\n            int n, m, l;\n            scanf("%d %d %d", &n, &m, &l);\n            e[n] = m; a[n] = l;\n        }\n\n        FOR(i, y + 1) fill(pb[i], pb[i] + 5001, 0.0); \n        pb[0][0] = 1.0;\n\n        for (int i = 0; i < y; i++) {\n            for (int j = 0; j < 5001; j++) {\n                if (pb[i][j] > 0.0) {\n                    double currentValue = pb[i][j] / x; // Precompute the division\n                    for (int k = 0; k < x; k++) {\n                        int next = min(y, i + v[k]), value = j;\n\n                        if (e[next] == 1) next = min(y, next + a[next]);\n                        else if (e[next] == 2) value += a[next];\n                        else if (e[next] == 3) value = max(0, j - a[next]);\n\n                        pb[next][value] += currentValue; // Use the precomputed value\n                    }\n                }\n            }\n        }\n\n        double ans = 0.0;\n        for (int i = 0; i < 5001; i++) ans += pb[y][i] * i;\n        printf("%d\\n", (int)(ans));\n    }\n}')"
