      FOR(i, z){\n            int n, m, l;\n            scanf("%d %d %d", &n, &m, &l);\n            e[n] = m; a[n] = l;\n        }\n\n        // Using a single loop to fill the pb array\n        pb[0] = 1.0; // Setting the initial condition\n\n        for (int i = 0; i < y; i++) {\n            double* current = pb + i * 5001; // Use a pointer for better cache performance\n            double* next = pb + (i + 1) * 5001; // Precompute next pointer\n\n            // Zero out the next pb row\n            fill(next, next + 5001, 0.0);\n\n            for (int j = 0; j < 5001; j++) {\n                if (current[j] > 0.0) {\n                    for (int k = 0; k < x; k++) {\n                        int nextIndex = min(y, i + v[k]), value = j;\n\n                        if (e[nextIndex] == 1) nextIndex = min(y, nextIndex + a[nextIndex]);\n                        else if (e[nextIndex] == 2) value += a[nextIndex];\n                        else if (e[nextIndex] == 3) value = max(0, j - a[nextIndex]);\n\n                        next[nextIndex * 5001 + value] += current[j] / x; \n                    }\n                }\n            }\n        }\n\n        double ans = 0.0;\n        for (int i = 0; i < 5001; i++) ans += pb[y * 5001 + i] * i;\n        printf("%d\\n", (int)(ans));\n    }\n}')"
