LineLLMMutation(('source.cpp', 6), '#include <iostream>\n#include <vector>\n#include <algorithm>\n\nusing namespace std;\n\nint main() {\n    int n;\n\n    while (true) {\n        cin >> n;\n        if (n == 0)\n            break;\n\n        vector<int> t(n);\n        long long c = 0;\n\n        for (int& x : t) {\n            cin >> x;\n        }\n\n        sort(t.begin(), t.end());\n\n        for (size_t i = 0; i < t.size() - 1; i++) {\n            c += t[i] * (n - i - 1);\n        }\n\n        cout << c << endl;\n    }\n\n    return 0;\n}') + LineLLMMutation(('source.cpp', 15), '#include <iostream>\n#include <algorithm>\n\nusing namespace std;\n\nconst int MAXN = 100000; // Assuming a maximum size for the input\nint t[MAXN];\n\nint main() {\n    int n;\n\n    while (true) {\n        cin >> n;\n        if (n == 0)\n            break;\n\n        long long c = 0;\n\n        for (int i = 0; i < n; i++) {\n            cin >> t[i];\n        }\n\n        sort(t, t + n);\n\n        for (size_t i = 0; i < n - 1; i++) {\n            c += t[i] * (n - i - 1);\n        }\n\n        cout << c << endl;\n    }\n\n    return 0;\n}') + LineLLMMutation(('source.cpp', 30), '#include <cstdio>\n#include <algorithm>\n\nusing namespace std;\n\nconst int MAXN = 100000; // Assuming a maximum size for the input\nint t[MAXN];\n\nint main() {\n    int n;\n\n    while (true) {\n        scanf("%d", &n);\n        if (n == 0)\n            break;\n\n        long long c = 0;\n\n        for (int i = 0; i < n; i++) {\n            scanf("%d", &t[i]);\n        }\n\n        sort(t, t + n);\n\n        for (size_t i = 0; i < n - 1; i++) {\n            c += t[i] * (n - i - 1);\n        }\n\n        printf("%lld\\n", c);\n    }\n\n    return 0;\n}')
