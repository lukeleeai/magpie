010];\n\nint main() {\n    int n;\n    cin >> n;\n    int sumw = 0;\n\n    for(int i = 0; i < n; i++) {\n        cin >> items[i].c >> items[i].w;\n        sumw += items[i].w;\n    }\n\n    fill(dp, dp + 1001, 1001);\n\n    for(int i = 0; i < n; i++)\n        if (i < n - 1 && (items[i].c >= items[i + 1].w || items[i + 1].c >= items[i].w)) \n            dp[i] = 1;\n\n    for (int k = 2; k < n; k++) {\n        for (int i = 0; i + k < n; i++) {\n            int prev = dp[i];\n            if ((dp[i + 1] == 1 && items[i].c >= sumw - items[i].w) || \n                (prev == 1 && items[i + k].c >= sumw - items[i].w))\n                dp[i] = 1;\n            else \n                dp[i] = min(prev, dp[i]) + 1;\n\n            for (int j = i + 1; j < i + k; j++)\n                dp[i] = min(dp[i], dp[j] + dp[j + 1]);\n        }\n    }\n    cout << dp[0] << endl;\n    return 0;\n}')"
