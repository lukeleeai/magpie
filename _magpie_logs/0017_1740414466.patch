LineLLMMutation(('source.cpp', 20), '#include <iostream>\n#include <algorithm>\n#include <vector>\n#include <cstdio>\n\nusing namespace std;\n\nint wei; // maximum weight\nint n; // number of treasures\nvector<int> v, w; // value and weight of treasures\nvector<int> dp; // DP table\n\nint find_min_weight(int ans) {\n    for (int i = wei; i >= 0; i--) {\n        if (ans != dp[i]) {\n            return i + 1; // Return the minimum weight as soon as found\n        }\n    }\n    return 0; // Default return if not found\n}\n\nint main(void) {\n    int cnt = 1;\n    while (scanf("%d", &wei) && wei) {\n        dp.assign(wei + 1, 0);\n        scanf("%d", &n);\n        v.resize(n);\n        w.resize(n);\n        \n        char ten;\n        for (int i = 0; i < n; i++) {\n            scanf("%d %c %d", &v[i], &ten, &w[i]);\n        }\n\n        // Iterative DP approach\n        for (int i = 0; i < n; i++) {\n            for (int j = wei; j >= w[i]; j--) {\n                dp[j] = max(dp[j], dp[j - w[i]] + v[i]);\n            }\n        }\n\n        printf("Case %d:\\n", cnt);\n        printf("%d\\n", dp[wei]); // Maximum value\n        printf("%d\\n", find_min_weight(dp[wei])); // Minimum weight\n        cnt++;\n    }\n    return 0;\n}') + LineLLMMutation(('source.cpp', 26), '#include <iostream>\n#include <algorithm>\n#include <vector>\n#include <cstdio>\n\nusing namespace std;\n\nint wei; // maximum weight\nint n; // number of treasures\nvector<int> v, w; // value and weight of treasures\nint dp[200005]; // DP table with fixed size to avoid dynamic resizing\n\nint find_min_weight(int ans) {\n    for (int i = wei; i >= 0; i--) {\n        if (ans != dp[i]) {\n            return i + 1; // Return the minimum weight as soon as found\n        }\n    }\n    return 0; // Default return if not found\n}\n\nint main(void) {\n    int cnt = 1;\n    while (scanf("%d", &wei) && wei) {\n        fill(dp, dp + wei + 1, 0); // Use fill instead of assign for better performance\n        scanf("%d", &n);\n        v.resize(n);\n        w.resize(n);\n        \n        for (int i = 0; i < n; i++) {\n            char ten; // Read the character but don\'t store it\n            scanf("%d %c %d", &v[i], &ten, &w[i]);\n        }\n\n        // Iterative DP approach\n        for (int i = 0; i < n; i++) {\n            for (int j = wei; j >= w[i]; j--) {\n                dp[j] = max(dp[j], dp[j - w[i]] + v[i]);\n            }\n        }\n\n        printf("Case %d:\\n", cnt);\n        printf("%d\\n", dp[wei]); // Maximum value\n        printf("%d\\n", find_min_weight(dp[wei])); // Minimum weight\n        cnt++;\n    }\n    return 0;\n}')
