LineLLMCrossover(('source.cpp', 8), "#include <iostream>\n#include <algorithm>\n\nvoid ToOctalNumber(int n) {\n    if (n == 0) {\n        putchar('0');  // Using putchar for faster output\n        return;\n    }\n    \n    char buffer[12];  // Enough to hold octal representation of a 32-bit integer\n    int index = 0;\n    \n    while (n > 0) {\n        int octDigit = (n & 7);\n        buffer[index++] = (octDigit < 4 ? octDigit : (octDigit == 4 ? 5 : octDigit + 2)) + '0';\n        n >>= 3;\n    }\n    \n    // Output in reverse order\n    while (index > 0) {\n        putchar(buffer[--index]);  // Using putchar for faster output\n    }\n}\n\nint main() {\n    std::ios::sync_with_stdio(false);  // Improved I/O performance\n    int n;\n    while (std::cin >> n, n) {\n        ToOctalNumber(n);\n        putchar('\\n');  // Using putchar for faster output\n    }\n}")
