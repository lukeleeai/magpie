2025-01-21 01:29:06,122	[DEBUG]	patch(2-17)="LineLLMCrossover(('source.cpp', 10), '#include <iostream>\n#include <vector>\n#include <cmath>\n#include <queue>\n\nusing namespace std;\n\nint n;\nint k;\nvector<int> arr(100004, 0);\nvector<int> memo(100004, -1);\n\nint cost() {\n    priority_queue<pair<int, int>, vector<pair<int, int>>, greater<pair<int, int>>> pq; // Min-heap\n    memo[n - 1] = 0;\n    pq.push({0, n - 1});\n    \n    while (!pq.empty()) {\n        int current_cost = pq.top().first;\n        int idx = pq.top().second;\n        pq.pop();\n\n        for (int j = 1; j <= k; ++j) {\n            if (idx - j < 0) break;\n            int next_cost = abs(arr[idx] - arr[idx - j]) + current_cost;\n            if (memo[idx - j] == -1 || next_cost < memo[idx - j]) {\n                memo[idx - j] = next_cost;\n                pq.push({next_cost, idx - j});\n            }\n        }\n    }\n    return memo[0];\n}\n\nint main() {\n    cin >> n >> k;\n    for (int i = 0; i < n; ++i) cin >> arr[i];\n    cout << cost() << endl;\n    return 0;\n}')"
