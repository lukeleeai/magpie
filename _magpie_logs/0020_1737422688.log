2025-01-21 01:27:47,770	[DEBUG]	patch(1-6)="LineLLMCrossover(('source.cpp', 4), '#include <iostream>\n#include <vector>\n#include <cmath>\n#include <thread>\n\nusing namespace std;\n\nint n;\nint k;\nvector<int> arr(100004, 0);\nvector<int> memo(100004, -1);\n\nvoid computeCost(int start, int end) {\n    for (int i = start; i < end; ++i) {\n        for (int j = 1; j <= k; ++j) {\n            if (i + j >= n) break;\n            int temp = abs(arr[i + j] - arr[i]) + memo[i + j];\n            memo[i] = (memo[i] == -1) ? temp : min(memo[i], temp);\n        }\n    }\n}\n\nint cost() {\n    fill(memo.begin(), memo.begin() + n, -1);\n    memo[n - 1] = 0;\n    memo[n - 2] = abs(arr[n - 2] - arr[n - 1]);\n\n    thread t1(computeCost, 0, n / 2);\n    thread t2(computeCost, n / 2, n - 2);\n    t1.join();\n    t2.join();\n    \n    return memo[0];\n}\n\nint main() {\n    cin >> n >> k;\n    for (int i = 0; i < n; ++i) cin >> arr[i];\n    cout << cost() << endl;\n    return 0;\n}')"
