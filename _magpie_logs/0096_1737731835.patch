LineLLMCrossover(('source.cpp', 24), '#include <iostream>\n#include <array>\n#include <algorithm>\n#include <deque>\n\nusing namespace std;\n\nint d, n;\narray<int, 105> a, e, r;\narray<int, 105 * 101> memo;\n\nconst int INF = 1000000000;\n\nvoid bfs_deque() {\n    deque<pair<int, pair<int, int>>> q; // Use deque for faster push/pop operations\n    q.push_back({0, {0, d}});\n    memo.fill(INF); // Initialize memo with INF\n    memo[0 * 101 + d] = 0; // Adjusted index for memo\n\n    while (!q.empty()) {\n        auto [c, exp_end] = q.front();\n        q.pop_front(); // Use pop_front for deque\n        int exp = exp_end.first;\n        int end = exp_end.second;\n\n        for (int i = 0; i < n; i++) {\n            if (exp < r[i]) continue;\n            int new_exp = min(exp + e[i], 100);\n            int new_end = max(end - a[i], 0);\n            if (memo[new_exp * 101 + new_end] > c + 1) {\n                memo[new_exp * 101 + new_end] = c + 1;\n                q.push_back({c + 1, {new_exp, new_end}}); // Use push_back for deque\n            }\n        }\n    }\n}\n\nint main() {\n    while (cin >> d >> n, d) {\n        for (int i = 0; i < n; i++) cin >> a[i] >> e[i] >> r[i];\n        bfs_deque();\n        int ans = INF;\n        for (int i = 0; i < 101; i++) ans = min(ans, memo[i * 101]); // Adjusted index for memo\n        cout << (ans == INF ? "NA" : to_string(ans)) << endl;\n    }\n    return 0;\n}') + LineLLMMutation(('source.cpp', 41), '#include <iostream>\n#include <array>\n#include <algorithm>\n#include <deque>\n\nusing namespace std;\n\nint d, n;\narray<int, 105> a, e, r;\narray<int, 105 * 101> memo;\n\nconst int INF = 1e9;\n\nvoid bfs_deque() {\n    deque<pair<int, pair<int, int>>> q;\n    q.emplace_back(0, make_pair(0, d)); // Use emplace_back for efficiency\n    fill(memo.begin(), memo.end(), INF);\n    memo[0 * 101 + d] = 0;\n\n    while (!q.empty()) {\n        auto [c, exp_end] = q.front();\n        q.pop_front();\n        int exp = exp_end.first;\n        int end = exp_end.second;\n\n        for (int i = 0; i < n; i++) {\n            if (exp < r[i]) continue;\n            int new_exp = min(exp + e[i], 100);\n            int new_end = max(end - a[i], 0);\n            if (memo[new_exp * 101 + new_end] > c + 1) {\n                memo[new_exp * 101 + new_end] = c + 1;\n                q.emplace_back(c + 1, make_pair(new_exp, new_end)); // Use emplace_back for efficiency\n            }\n        }\n    }\n}\n\nint main() {\n    while (cin >> d >> n, d) {\n        for (int i = 0; i < n; i++) cin >> a[i] >> e[i] >> r[i];\n        bfs_deque();\n        int ans = INF;\n        for (int i = 0; i < 101; i++) ans = min(ans, memo[i * 101]);\n        cout << (ans == INF ? "NA" : to_string(ans)) << endl;\n    }\n    return 0;\n}')
