LineLLMCrossover(('source.cpp', 14), '#include <cstdio>\n#include <map>\n\nconst int kMaxSquare = 64;\n\nint roulette[4];\n\nstruct BoardState {\n    int type;\n    int value;\n};\n\nBoardState board[kMaxSquare];\n\nint bp(int X, int Y) {\n    std::map<int, double> bp[kMaxSquare];\n    double prob = 1.0f / X;\n    bp[0][0] = 1.0f;\n\n    for (int n = 0; n < Y; n++) {\n        for (auto& it : bp[n]) {\n            for (int k = 0; k < X; k++) {\n                int pos = std::min(n + roulette[k], Y);\n                int newValue = it.first;\n                switch (board[pos].type) {\n                    case 1:\n                        bp[std::min(pos + board[pos].value, Y)][newValue] += it.second * prob;\n                        break;\n                    case 2:\n                        bp[pos][newValue + board[pos].value] += it.second * prob;\n                        break;\n                    case 3:\n                        bp[pos][std::max(newValue - board[pos].value, 0)] += it.second * prob;\n                        break;\n                    default:\n                        bp[pos][newValue] += it.second * prob;\n                        break;\n                }\n            }\n        }\n    }\n\n    double res = 0.0f;\n    for (const auto& it : bp[Y])\n        res += static_cast<double>(it.first) * it.second;\n    return static_cast<int>(res);\n}\n\nint main() {\n    while (true) {\n        int X, Y, Z;\n        scanf("%d %d %d", &X, &Y, &Z);\n        if (X == 0) break;\n\n        for (int i = 0; i < X; i++)\n            scanf("%d", &roulette[i]);\n\n        for (int i = 0; i < kMaxSquare; i++)\n            board[i] = {0, 0};\n\n        for (; Z > 0; Z--) {\n            int N, E, A;\n            scanf("%d %d %d", &N, &E, &A);\n            board[N] = {E, A};\n        }\n\n        printf("%d\\n", bp(X, Y));\n    }\n}')
