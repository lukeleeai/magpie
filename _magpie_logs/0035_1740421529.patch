LineLLMCrossover(('source.cpp', 8), '#include <cstdio>\n#include <array>\n#include <cstring>\nusing namespace std;\n\nconst int MAX_X = 10000;\n\nint main() {\n    array<bool, MAX_X + 1> prime;\n    prime.fill(true);\n    prime[0] = prime[1] = false; // 0 and 1 are not prime\n    int n;\n\n    // Sieve of Eratosthenes optimization\n    for (int i = 2; i * i <= MAX_X; i++) {\n        if (prime[i]) {\n            for (int k = i * i; k <= MAX_X; k += i) {\n                prime[k] = false; // mark as non-prime\n            }\n        }\n    }\n\n    // Read input and find prime twins\n    while (true) {\n        scanf("%d", &n);\n        if (n == 0) break;\n\n        int max = -1;\n        for (int i = (n % 2 == 0 ? n - 1 : n); i >= 2; i -= 2) { // Check only odd numbers\n            if (prime[i] && prime[i - 2]) {\n                max = i;\n                break;\n            }\n        }\n\n        if (max != -1)\n            printf("%d %d\\n", max - 2, max);\n    }\n\n    return 0;\n}')
