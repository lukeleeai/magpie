LineLLMMutation(('source.cpp', 8), '#include <cstdio>\n#include <array>\n#include <algorithm>\n#include <functional>\nusing namespace std;\n\ntypedef long long ll;\n\nint main() {\n    auto count_rooms_lesseq_than = [](ll newRoomNo) {\n        array<int, 10> t = {0};\n        int d;\n        for (d = 0; newRoomNo; ++d, newRoomNo /= 10)\n            t[d] = newRoomNo % 10;\n\n        for (int i = d - 1; i > 0; --i) {\n            if (t[i] == 4 || t[i] == 6) {\n                --t[i];\n                fill(t.begin(), t.begin() + i, 9);\n                break;\n            }\n        }\n\n        ll res = 0;\n        for (int i = 0; i < d; ++i) {\n            ll a = 1 << (3 * i);\n            res += (t[i] - (t[i] >= 6 ? 2 : t[i] >= 4 ? 1 : 0)) * a;\n        }\n        return res;\n    };\n\n    int n;\n    while (scanf("%d", &n), n) {\n        ll l = 1, u = n * 10LL;\n        while (l < u) {\n            ll m = (l + u) >> 1;\n            ll t = count_rooms_lesseq_than(m);\n            l = t < n ? m + 1 : l;\n            u = t < n ? u : m;\n        }\n        printf("%lld\\n", l);\n    }\n    return 0;\n}') + LineLLMMutation(('source.cpp', 16), '#include <cstdio>\n#include <array>\n#include <algorithm>\nusing namespace std;\n\ntypedef long long ll;\n\nint main() {\n    auto count_rooms_lesseq_than = [](ll newRoomNo) {\n        array<int, 10> t = {0};\n        int d = 0;\n        while (newRoomNo) {\n            t[d++] = newRoomNo % 10;\n            newRoomNo /= 10;\n        }\n\n        for (int i = d - 1; i > 0; --i) {\n            if (t[i] == 4 || t[i] == 6) {\n                --t[i];\n                fill(t.begin(), t.begin() + i, 9);\n                break;\n            }\n        }\n\n        ll res = 0;\n        ll a = 1; // Initialize the multiplier outside of the loop\n        for (int i = 0; i < d; ++i) {\n            res += (t[i] - (t[i] >= 6 ? 2 : t[i] >= 4 ? 1 : 0)) * a;\n            a *= 8; // Update the multiplier to 8 instead of using bit shift\n        }\n        return res;\n    };\n\n    int n;\n    while (scanf("%d", &n), n) {\n        ll l = 1, u = n * 10LL;\n        while (l < u) {\n            ll m = (l + u) >> 1;\n            ll t = count_rooms_lesseq_than(m);\n            l = t < n ? m + 1 : l;\n            u = t < n ? u : m;\n        }\n        printf("%lld\\n", l);\n    }\n    return 0;\n}') + LineLLMMutation(('source.cpp', 23), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\ntypedef long long ll;\n\nint main() {\n    auto count_rooms_lesseq_than = [](ll newRoomNo) {\n        int t[10] = {0}; // Use a simple array instead of std::array\n        int d = 0;\n        while (newRoomNo) {\n            t[d++] = newRoomNo % 10;\n            newRoomNo /= 10;\n        }\n\n        for (int i = d - 1; i > 0; --i) {\n            if (t[i] == 4 || t[i] == 6) {\n                --t[i];\n                fill(t, t + i, 9);\n                break;\n            }\n        }\n\n        ll res = 0;\n        ll a = 1; // Keep multiplier initialization outside of the loop\n        for (int i = 0; i < d; ++i) {\n            res += (t[i] - (t[i] >= 6 ? 2 : t[i] >= 4 ? 1 : 0)) * a;\n            a *= 8; // Use multiplication instead of bit shifting for clarity\n        }\n        return res;\n    };\n\n    int n;\n    while (scanf("%d", &n), n) {\n        ll l = 1, u = n * 10LL;\n        while (l < u) {\n            ll m = (l + u) / 2; // Simplified division for clarity\n            ll t = count_rooms_lesseq_than(m);\n            l = t < n ? m + 1 : l;\n            u = t < n ? u : m;\n        }\n        printf("%lld\\n", l);\n    }\n    return 0;\n}')
