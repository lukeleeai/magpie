                used[i][j] = true;\n                    while(!que.empty()) {\n                        P p = que.front(); que.pop();\n                        rep(k, 4) {\n                            int nx = p.F + dx[k], ny = p.S + dy[k];\n                            if(0 <= nx && nx < x.size() - 1 && 0 <= ny && ny < y.size() - 1 && !used[ny][nx]) {\n                                used[ny][nx] = true;\n                                que.push(P(nx, ny));\n                            }\n                        }\n                    }\n                }\n            }\n        }\n        printf("%d\\n", cnt);\n    }\n    return 0;\n}')"
