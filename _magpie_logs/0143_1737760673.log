2025-01-24 23:40:27,603	[DEBUG]	patch(11-8)="LineLLMCrossover(('source.cpp', 37), '#include <cstdio>\n#include <algorithm>\n#include <vector>\n#include <queue>\n\n#define F first\n#define S second\n#define pb push_back\n#define rep(i,n) for(int i=0;i<n;i++)\n#define all(n) n.begin(),n.end()\n\nusing namespace std;\n\nbool used[3010][3010];\nstatic const short dy[] = {0,1,0,-1};\nstatic const short dx[] = {1,0,-1,0};\nint h, w;\ntypedef pair<int,int> P;\n\nint main() {\n    int n;\n    while (scanf("%d %d", &w, &h) && (w + h != 0)) {\n        scanf("%d", &n);\n        vector<int> x1(n), x2(n), y1(n), y2(n);\n        vector<int> x, y;\n\n        for(int i = 0; i < n; i++) {\n            scanf("%d %d %d %d", &x1[i], &y1[i], &x2[i], &y2[i]);\n            x.pb(x1[i]); y.pb(y1[i]); x.pb(x2[i]); y.pb(y2[i]);\n        }\n        x.pb(0); x.pb(w); y.pb(0); y.pb(h);\n        \n        sort(all(x)); sort(all(y));\n        x.erase(unique(all(x)), x.end()); y.erase(unique(all(y)));\n\n        vector<int> x_map(3010, -1), y_map(3010, -1);\n        for (int i = 0; i < x.size(); ++i) x_map[x[i]] = i;\n        for (int i = 0; i < y.size(); ++i) y_map[y[i]] = i;\n\n        int limx = x.size(), limy = y.size();\n        vector<vector<bool>> used(limy, vector<bool>(limx, false)); // Optimized initialization\n\n        rep(i, n) {\n            x1[i] = x_map[x1[i]];\n            y1[i] = y_map[y1[i]];\n            x2[i] = x_map[x2[i]];\n            y2[i] = y_map[y2[i]];\n        }\n\n        // Optimize edge usage\n        for(int i = 0; i < limy; ++i) used[i][limx - 1] = true;\n        for(int j = 0; j < limx; ++j) used[limy - 1][j] = true;\n\n        queue<P> que;\n\n        rep(i, n) for(int k = x1[i]; k < x2[i]; k++) {\n            for(int j = y1[i]; j < y2[i]; j++) used[j][k] = true;\n        }\n\n        int cnt = 0;\n        rep(i, limy) {\n            rep(j, limx) {\n                if(!used[i][j]) {\n                    que.push(P(j, i));\n                    cnt++;\n                    used[i][j] = true;\n                    while(!que.empty()) {\n                        P p = que.front(); que.pop();\n                        rep(k, 4) {\n                            int nx = p.F + dx[k], ny = p.S + dy[k];\n                            if(0 <= nx && nx < limx - 1 && 0 <= ny && ny < limy - 1 && !used[ny][nx]) {\n                                used[ny][nx] = true;\n                                que.push(P(nx, ny));\n                            }\n                        }\n                    }\n                }\n            }\n        }\n        printf("%d\\n", cnt);\n    }\n    return 0;\n}')"

