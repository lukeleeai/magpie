2025-01-21 00:39:58,973	[DEBUG]	patch(5-20)="LineLLMCrossover(('source.cpp', 26), '#include <iostream>\n#include <vector>\n#include <utility>\n#include <algorithm>\n\nusing namespace std;\n\ntypedef long long ll;\n\nll read(){\n    ll x = 0, f = 1; char c = getchar();\n    while(c < \'0\' || c > \'9\'){if(c == \'-\') f = -1; c = getchar();}\n    while(c >= \'0\' && c <= \'9\'){x = x * 10 + c - \'0\'; c = getchar();}\n    return x * f;\n}\n\nint n;\nvector<ll> a;\nvector<pair<int,int>> b;\n\nvoid upd(int x, int y){\n    int num1 = b[x].first;\n    int num3 = b[y].first;\n    b[x].first = max(num1, num3);\n    b[x].second = (num1 > num3) ? max(b[x].second, num3) : max(num1, b[y].second);\n}\n\nint main() {\n    n = read();\n    a.resize(1 << n);\n    b.resize(1 << n);\n    for(int i = 0; i < (1 << n); i++)\n        a[i] = read();\n    for(int i = 0; i < (1 << n); i++)\n        b[i].first = a[i], b[i].second = -1e9;\n\n    for(int k = 0; k < n; k++) {\n        for(int i = 0; i < (1 << n); i++) {\n            if((i & (1 << k)) != 0) continue;\n            upd(i | (1 << k), i);\n        }\n    }\n    int lastans = 0;\n    for(int i = 1; i < (1 << n); i++) {\n        lastans = max(lastans, b[i].first + b[i].second);\n        printf("%d\\n", lastans);\n    }\n    return 0;\n}')"
