2025-01-21 00:49:46,888	[DEBUG]	patch(9-6)="LineLLMCrossover(('source.cpp', 66), "#include <iostream>\n#include <array>\n#include <utility>\n#include <algorithm>\n\nusing namespace std;\n\ntypedef long long ll;\n\nconst int MAX_SIZE = 1000100;\n\nll read(){\n    ll x = 0; char c = getchar();\n    while(c < '0' || c > '9') c = getchar();\n    while(c >= '0' && c <= '9'){ x = x * 10 + c - '0'; c = getchar(); }\n    return x;\n}\n\nint n;\narray<ll, MAX_SIZE> a;\narray<pair<int,int>, MAX_SIZE> b;\n\nvoid upd(int x, int y) {\n    int num1 = b[x].first;\n    int num3 = b[y].first;\n    b[x].first = max(num1, num3);\n    b[x].second = max(b[x].second, min(num1, num3));\n}\n\nint main() {\n    n = read();\n    for(int i = 0; i < (1 << n); i++)\n        a[i] = read();\n    for(int i = 0; i < (1 << n); i++)\n        b[i].first = a[i], b[i].second = -1e9;\n\n    for(int k = 0; k < n; k++){\n        for(int i = 0; i < (1 << n); i++){\n            if((i & (1 << k)) == 0) {\n                upd(i | (1 << k), i);\n            }\n        }\n    }\n\n    int lastans = 0;\n    for(int i = 1; i < (1 << n); i++){\n        lastans = max(lastans, b[i].first + b[i].second);\n        cout << lastans << endl;\n    }\n    return 0;\n}")"
