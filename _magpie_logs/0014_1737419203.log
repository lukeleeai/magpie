2025-01-21 00:49:46,387	[DEBUG]	patch(9-5)="LineLLMCrossover(('source.cpp', 65), '#include <iostream>\n#include <array>\n#include <utility>\n#include <algorithm>\n\nusing namespace std;\n\ntypedef long long ll;\n\nconst int MAX_SIZE = 1000100;\n\nll read(){\n    ll x = 0, f = 1; char c = getchar();\n    while(c < \'0\' || c > \'9\'){if(c == \'-\') f = -1; c = getchar();}\n    while(c >= \'0\' && c <= \'9\'){x = x * 10 + c - \'0\'; c = getchar();}\n    return x * f;\n}\n\nint n;\narray<ll, MAX_SIZE> a;\narray<pair<int,int>, MAX_SIZE> b;\n\nvoid upd(int x, int y) {\n    int num1 = b[x].first;\n    int num3 = b[y].first;\n    if (num1 > num3) {\n        b[x].second = max(b[x].second, num3);\n    } else {\n        b[x].second = max(num1, b[y].second);\n    }\n    b[x].first = max(num1, num3);\n}\n\nint main(){\n    n = read();\n    for(int i = 0; i < (1 << n); i++)\n        a[i] = read();\n    \n    fill(b.begin(), b.begin() + (1 << n), make_pair(0, -1e9));\n    for(int i = 0; i < (1 << n); i++)\n        b[i].first = a[i];\n\n    for(int k = 0; k < n; k++){\n        int mask = 1 << k; \n        for(int i = 0; i < (1 << n); i++){\n            if((i & mask) == 0) {\n                upd(i | mask, i);\n            }\n        }\n    }\n\n    int lastans = 0;\n    for(int i = 1; i < (1 << n); i++){\n        lastans = max(lastans, b[i].first + b[i].second);\n        printf("%d\\n", lastans);\n    }\n    return 0;\n}')"
