2025-01-21 00:29:04,764	[DEBUG]	patch(0-20)="LineLLMMutation(('source.cpp', 19), '#include <iostream>\n#include <unordered_map>\n#include <thread>\n#include <vector>\n\nusing namespace std;\n\ntypedef long long ll;\n\nvoid update(unordered_map<ll, ll>& b, const unordered_map<ll, ll>& a, int n) {\n    for(int k=0;k<n;k++){\n        for(int i=1;i<(1<<n);i++){\n            if((i&(1<<k))!=0) continue;\n            b[i|(1<<k)]=max(b[i|(1<<k)], a[i]);\n        }\n    }\n}\n\nint main(){\n    ll x, n;\n    cin >> n;\n    unordered_map<ll, ll> a;\n    unordered_map<ll, ll> b;\n\n    for(int i=1;i<(1<<n);i++)\n        cin >> a[i];\n\n    vector<thread> threads;\n    threads.emplace_back(update, ref(b), ref(a), n);\n    \n    for (auto& t : threads) {\n        t.join();\n    }\n    \n    ll lastans = LLONG_MIN;\n    for (const auto& pair : b) {\n        lastans = max(lastans, pair.second);\n    }\n    cout << lastans << endl;\n    return 0;\n}')"
