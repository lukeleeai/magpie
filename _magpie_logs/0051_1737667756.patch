                            done[newY][newX] = true;\n                        }\n                    }\n                }\n\n                for (int I = 0; I < 100; ++I) {\n                    if(dp[I].first) {\n                        if(dp[I].first == 1)\n                            pt[dp[I].second - 1]++;\n                        break;\n                    }\n                }\n            }\n\n            ret = max(pt[49], ret);\n            point[b][a] = 0;\n        }\n\n        printf("%d\\n", ret);\n    }\n}') + LineLLMMutation(('source.cpp', 41), '#include <iostream>\n#include <cstdio>\n#include <array>\n#include <queue>\n\nusing namespace std;\n\n#define rep(i,n) for(int i=0; i<n; i++)\n\ntypedef pair<pair<int,int>,int> NODE;\n\n#define X first.second\n#define Y first.first\n#define depth second\n\nint ox[] = {-1, 1, 0, 0, 1, 1};\nint oy[] = { 0, 0,-1, 1,-1, 1};\nint ex[] = {-1, 1, 0, 0,-1,-1};\nint ey[] = { 0, 0,-1, 1,-1, 1};\n\nint main() {\n    int point[100][100] = {0}; // Using static array for improved performance\n    int h, w, a, b, t, x, y, s;\n\n    while(scanf("%d", &w) && w) {\n        int ret = 0;\n        scanf("%d", &h);\n        scanf("%d", &t);\n\n        rep(i, t) {\n            scanf("%d%d", &a, &b);\n            a--; b--;\n            point[b][a] = i + 1;\n        }\n\n        scanf("%d", &s);\n        rep(P, s) {\n            scanf("%d%d", &a, &b);\n            a--; b--;\n            point[b][a] = 50;\n\n            array<int, 100> pt = {0};\n            rep(i, h) rep(j, w) {\n                x = j, y = i;\n                queue<NODE> Q;\n                pair<int, int> dp[100] = { {0, 0} };\n                bool done[100][100] = {false};\n                Q.push(make_pair(make_pair(y, x), 0));\n                done[y][x] = true;\n\n                while(!Q.empty()) {\n                    NODE q = Q.front(); Q.pop();\n                    if(point[q.Y][q.X]) {\n                        dp[q.depth].first++;\n                        dp[q.de