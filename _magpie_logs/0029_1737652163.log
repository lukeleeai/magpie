rn x1;\n}\n\nlong long int findCycleLength(long long int a, long long int m) {\n    long long int p = 1, count = 0;\n    // Use a more efficient way to find cycle length\n    do {\n        p = (p * a) % m; // Reduces number of multiplications\n        count++;\n    } while (p != 1 && count < m); // Adding a safeguard to prevent infinite loops\n    return count;\n}\n\nint main() {\n    long long int a[3], m[3], c[3] = {0};\n\n    while (1) {\n        cin >> a[0] >> m[0] >> a[1] >> m[1] >> a[2] >> m[2];\n        if (!a[0]) break;\n\n        for (int i = 0; i < 3; i++) {\n            long long int inv = modInverse(a[i], m[i]);\n            c[i] = findCycleLength(inv, m[i]);\n        }\n\n        cout << lcm(lcm(c[0], c[1]), c[2]) << endl;\n    }\n    return 0;\n}')"

