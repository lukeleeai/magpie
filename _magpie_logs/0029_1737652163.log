ion\n            do {\n                current = (current * inv) % m[i]; // Use the pre-calculated inverse\n                p[i] = current; // Update only once\n                c[i] += 1;\n            } while (current != 1);\n        }\n\n        cout << lcm(lcm(c[0], c[1]), c[2]) << endl;\n    }\n    return 0;\n}") | LineLLMMutation(('source.cpp', 31), "#include <iostream>\n#include <cstdio>\n#include <cstring>\nusing namespace std;\n\nlong long int gcd(long long int a, long long int b){\n    while (b != 0) {\n        long long int temp = b;\n        b = a % b;\n        a = temp;\n    }\n    return a;\n}\n\nlong long int lcm(long long int a, long long int b){\n    return (a / gcd(a, b)) * b; // Rearranged to prevent overflow\n}\n\nlong long int modInverse(long long int a, long long int m) {\n    if (gcd(a, m) != 1) return -1; // Return -1 if a and m are not coprime\n    long long int m0 = m, t, q;\n    long long int x0 = 0, x1 = 1;\n\n    while (a > 1) {\n        q = a / m;\n        t = m;\n\n        m = a % m, a = t;\n        t = x0;\n\n        x0 = x1 - q * x0;\n        x1 = t;\n    }\n\n    if (x1 < 0) x1 += m0;\n\n    return x1;\n}\n\nint main(){\n    long long int a[3], m[3], p[3] = {1, 1, 1}, c[3] = {0};\n\n    while (true) {\n        memset(c, 0, sizeof(c));\n        if (!(cin >> a[0] >> m[0] >> a[1] >> m[1] >> a[2] >> m[2]) || a[0] == 0) break;\n\n        for (int i = 0; i < 3; i++) {\n            long long int inv = modInverse(a[i], m[i]); // Calculate modular inverse\n            if (inv == -1) continue; // Skip if inverse doesn't exist\n            long long int current = p[i]; // Use a temporary variable for multiplication\n            do {\n                current = (current * inv) % m[i]; // Use the pre-calculated inverse\n                p[i] = current; // Update only once\n                c[i] += 1;\n            } while (current != 1);\n        }\n\n        cout << lcm(lcm(c[0], c[1]), c[2]) << endl;\n    }\n    return 0;\n}")"
