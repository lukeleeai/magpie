 long int b){\n    while (b != 0) {\n        long long int temp = b;\n        b = a % b;\n        a = temp;\n    }\n    return a;\n}\n\nlong long int lcm(long long int a, long long int b){\n    return a * b / gcd(a, b);\n}\n\n// Function to perform modular exponentiation\nlong long int mod_exp(long long int base, long long int exp, long long int mod) {\n    long long int result = 1;\n    while (exp > 0) {\n        if (exp % 2 == 1) {\n            result = (result * base) % mod;\n        }\n        base = (base * base) % mod;\n        exp /= 2;\n    }\n    return result;\n}\n\nint main(){\n    long long int a[3], m[3], p[3] = {1, 1, 1}, c[3] = {0};\n\n    while (true) {\n        memset(c, 0, sizeof(c));\n        // Using a single line of input to read all values at once\n        if (!(cin >> a[0] >> m[0] >> a[1] >> m[1] >> a[2] >> m[2]) || a[0] == 0) break;\n\n        for (int i = 0; i < 3; i++) {\n            // Using modular exponentiation instead of the loop\n            p[i] = mod_exp(a[i], 1, m[i]);\n            while (p[i] != 1) {\n                c[i] += 1;\n                p[i] = (p[i] * a[i]) % m[i];\n            }\n        }\n\n        cout << lcm(lcm(c[0], c[1]), c[2]) << endl;\n    }\n    return 0;\n}')"
