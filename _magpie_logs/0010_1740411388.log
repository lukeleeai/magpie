; i < 26; i++) {\n        table[a][i] = (a * i + b) % 26; // Store results in a 2D array\n    }\n}\n\nvoid makeAlphabetTable() {\n    char c = \'a\';\n    for(int i = 0; i < 26; i++) {\n        AlphabetTable[i] = c++;\n    }\n}\n\nint main() {\n    string code, tmp;\n    int n;\n\n    getline(cin, code);\n    stringstream ssn(code);\n    ssn >> n;\n\n    makeAlphabetTable();\n    for(int i = 0; i < n; i++) {\n        getline(cin, code);\n        tmp = code;\n\n        for(int b = 0; b < 26; b++) {\n            for(int a = 1; a < 26; a += 2) {\n                if(a % 13 != 0) {\n                    makeTable(a, b); // Precompute only once for (a, b)\n                    code = tmp;\n\n                    for(int j = 0; j < code.length(); j++) {\n                        if(\'a\' <= code[j] && code[j] <= \'z\') {\n                            code[j] = decode(code[j], a); // Pass a_param to decode\n                        }\n                    }\n\n                    if(code.find("this") != -1 || code.find("that") != -1) {\n                        cout << code << endl;\n                        break;\n                    }\n                }\n            }\n        }\n    }\n\n    return 0;\n}')"
