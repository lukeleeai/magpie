2025-02-24 15:38:40,161	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include <iostream>\n#include <map>\n#include <sstream>\n#include <string.h>\nusing namespace std;\n\nchar AlphabetTable[26];\n\nint table[26];\n\nchar decode(char a) {\n    return AlphabetTable[table[a - \'a\']];\n}\n\nvoid makeTable(int a, int b) {\n    for(int i = 0; i < 26; i++) {\n        table[i] = (a * i + b) % 26;\n    }\n}\n\nvoid makeAlphabetTable() {\n    for(int i = 0; i < 26; i++) {\n        AlphabetTable[i] = \'a\' + i;\n    }\n}\n\nint main() {\n    string code, tmp;\n    int n;\n    getline(cin, code);\n    stringstream ssn(code);\n    ssn >> n;\n    makeAlphabetTable();\n    for(int i = 0; i < n; i++) {\n        getline(cin, code);\n        tmp = code;\n        for(int b = 0; b < 26; b++) {\n            for(int a = 1; a < 26; a += 2) {\n                if(a % 13 != 0) {\n                    makeTable(a, b);\n                    code = tmp;\n                    for(char& ch : code) {\n                        if(\'a\' <= ch && ch <= \'z\') {\n                            ch = decode(ch);\n                        }\n                    }\n                    if(code.find("this") != -1 || code.find("that") != -1) {\n                        cout << code << endl;\n                        break;\n                    }\n                }\n            }\n        }\n    }\n    return 0;\n}')"

