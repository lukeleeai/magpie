 n;\n    makeAlphabetTable();\n    \n    // Pre-compute transformation for odd values of \'a\'\n    map<int, string> transformations;\n    for(int b = 0; b < 26; b++) {\n        for(int a = 1; a < 26; a += 2) {\n            if(a % 13 != 0) {\n                makeTable(a, b);\n                string transformed = "";\n                for(char ch = \'a\'; ch <= \'z\'; ch++) {\n                    transformed += decode(ch);\n                }\n                transformations[a * 100 + b] = transformed; // Store in map\n            }\n        }\n    }\n\n    for(int i = 0; i < n; i++) {\n        getline(cin, code);\n        tmp = code;\n        for(auto& [key, trans] : transformations) {\n            code = tmp;\n            for(char& ch : code) {\n                if(\'a\' <= ch && ch <= \'z\') {\n                    ch = trans[ch - \'a\']; // Use precomputed transformation\n                }\n            }\n            if(code.find("this") != string::npos || code.find("that") != string::npos) {\n                cout << code << endl;\n                break;\n            }\n        }\n    }\n    return 0;\n}')"
