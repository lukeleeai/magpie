 = \'a\' + i;\n    }\n}\n\nint main() {\n    int n;\n    cin >> n;\n    cin.ignore(); // to ignore the newline character after reading n\n    makeAlphabetTable();\n\n    vector<string> codes(n);\n    for(int i = 0; i < n; i++) {\n        getline(cin, codes[i]);\n    }\n\n    // Precompute the transformation for all a, b combinations\n    vector<vector<char>> transformation(26, vector<char>(26));\n    for(int b = 0; b < 26; b++) {\n        for(int a = 1; a < 26; a += 2) {\n            if(a % 13 != 0) {\n                makeTable(a, b);\n                for(int i = 0; i < 26; i++) {\n                    transformation[b][i] = decode(\'a\' + i);\n                }\n            }\n        }\n    }\n\n    for(const string& tmp : codes) {\n        string code = tmp;\n        for(int b = 0; b < 26; b++) {\n            for(int a = 1; a < 26; a += 2) {\n                if(a % 13 != 0) {\n                    code = tmp; // reset code for each (a, b)\n                    for(char& ch : code) {\n                        if(\'a\' <= ch && ch <= \'z\') {\n                            ch = transformation[b][ch - \'a\'];\n                        }\n                    }\n                    if(code.find("this") != string::npos || code.find("that") != string::npos) {\n                        cout << code << endl;\n                        break;\n                    }\n                }\n            }\n        }\n    }\n    return 0;\n}')"
