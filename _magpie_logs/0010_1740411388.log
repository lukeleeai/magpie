2025-02-24 15:40:27,963	[DEBUG]	patch(1-3)="LineLLMCrossover(('source.cpp', 1), '#include <iostream>\n#include <map>\n#include <sstream>\n#include <string>\n#include <vector>\nusing namespace std;\n\nchar AlphabetTable[26];\nint table[26];\n\nchar decode(char a) {\n    return AlphabetTable[table[a - \'a\']];\n}\n\nvoid makeTable(int a, int b) {\n    for(int i = 0; i < 26; i++) {\n        table[i] = (a * i + b) % 26;\n    }\n}\n\nvoid makeAlphabetTable() {\n    for(int i = 0; i < 26; i++) {\n        AlphabetTable[i] = \'a\' + i;\n    }\n}\n\nint main() {\n    vector<string> codes;\n    string line;\n    int n;\n    cin >> n;\n    cin.ignore(); // to ignore the newline character after reading n\n    makeAlphabetTable();\n\n    while (n--) {\n        getline(cin, line);\n        codes.push_back(line);\n    }\n\n    for(const string& tmp : codes) {\n        string code = tmp;\n        for(int b = 0; b < 26; b++) {\n            for(int a = 1; a < 26; a += 2) {\n                if(a % 13 != 0) {\n                    makeTable(a, b);\n                    for(char& ch : code) {\n                        if(\'a\' <= ch && ch <= \'z\') {\n                            ch = decode(ch);\n                        }\n                    }\n                    if(code.find("this") != string::npos || code.find("that") != string::npos) {\n                        cout << code << endl;\n                        break;\n                    }\n                }\n            }\n        }\n    }\n    return 0;\n}')"
