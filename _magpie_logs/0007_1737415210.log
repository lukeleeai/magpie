2025-01-20 23:22:01,209	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include "stdc++.h"\n\nusing namespace std;\n\ntypedef long long int int64;\ntypedef unsigned long long int uint64;\ntypedef vector<int64> vi;\ntypedef vector<bool> vb;\ntypedef vector<char> vc;\ntypedef pair<int64,int64> pi;\n\nbool doubleSame(double a, double b) {\n    const double eps = 1e-15;\n    return (std::abs(a - b) <= eps * std::abs(a));\n}\n\nint main() {\n    int64 n, k;\n    cin >> n >> k;\n\n    vector<int64> h(n);\n    for (int64 i = 0; i < n; i++)\n        cin >> h[i];\n\n    vector<int64> ans(n);\n    ans[0] = 0;\n    ans[1] = std::abs(h[1] - h[0]);\n\n    for (int64 i = 2; i < n; i++) {\n        ans[i] = std::abs(h[i] - h[i - 1]) + ans[i - 1];\n        for (int64 j = 2; j <= i && j <= k; j++)\n            ans[i] = min(ans[i], std::abs(h[i] - h[i - j]) + ans[i - j]);\n    }\n    cout << ans[n - 1];\n}')"

