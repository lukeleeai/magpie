LineLLMCrossover(('source.cpp', 6), '#include <cstdio>\n#include <vector>\n#include <algorithm>\nusing namespace std;\n\nint main() {\n    int n;\n    while (true) {\n        scanf("%d", &n);\n        if (n == 0) break;\n\n        long long c = 0;\n        vector<int> t(n);\n\n        for (int i = 0; i < n; i++) {\n            scanf("%d", &t[i]);\n        }\n\n        sort(t.begin(), t.end());\n\n        for (int i = 0; i < n - 1; i++) {\n            c += t[i] * (n - 1 - i);  // Cumulative product calculation\n        }\n\n        printf("%lld\\n", c);  // Output result\n    }\n    return 0;\n}') + LineLLMMutation(('source.cpp', 21), '#include <cstdio>\n#include <vector>\n#include <algorithm>\nusing namespace std;\n\nint main() {\n    int n;\n    while (true) {\n        scanf("%d", &n);\n        if (n == 0) break;\n\n        long long c = 0;\n        vector<int> t(n);\n\n        for (int i = 0; i < n; i++) {\n            scanf("%d", &t[i]);\n        }\n\n        sort(t.begin(), t.end());\n\n        long long prefix_sum = 0; // To hold the cumulative sum\n        for (int i = 0; i < n - 1; i++) {\n            prefix_sum += t[i]; // Update the prefix sum\n            c += prefix_sum; // Add the prefix sum to c\n        }\n\n        printf("%lld\\n", c);  // Output result\n    }\n    return 0;\n}')
