2025-02-25 00:21:24,109	[DEBUG]	patch(4-8)="LineLLMCrossover(('source.cpp', 15), '#include <cstdio>\n#include <algorithm>\n#include <limits>\n\nusing namespace std;\n\nconst int maxn = 111;\nint D, N, a[maxn], e[maxn], r[maxn], dp[maxn][maxn];\n\nint main() {\n    while (scanf("%d %d", &D, &N), D | N) {\n        for (int i = 0; i < N; i++) scanf("%d %d %d", &a[i], &e[i], &r[i]);\n\n        int maxr = *max_element(r, r + N);\n        fill(&dp[0][0], &dp[0][0] + sizeof(dp) / sizeof(dp[0][0]), numeric_limits<int>::max());\n\n        dp[0][0] = 0;\n\n        for (int i = 0; i < D; i++) {\n            for (int j = 0; j <= maxr; j++) {\n                if (dp[i][j] == numeric_limits<int>::max()) continue; // Skip unreachable states\n                for (int k = 0; k < N; k++) {\n                    if (j >= r[k]) {\n                        int p = min(j + e[k], maxr), q = min(i + a[k], D);\n                        dp[q][p] = min(dp[q][p], dp[i][j] + 1);\n                    }\n                }\n            }\n        }\n\n        int ret = *min_element(dp[D], dp[D] + maxr + 1);\n        if (ret == numeric_limits<int>::max()) printf("NA\\n");\n        else printf("%d\\n", ret);\n    }\n}')"
