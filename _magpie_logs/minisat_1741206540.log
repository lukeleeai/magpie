se is unit under assignment:\n            if (!found_watch) {\n                *j++ = Watcher(cr, first);\n                if (value(first) == l_False) {\n                    confl = cr;\n                    qhead = trail.size();\n                    while (i < end)\n                        *j++ = *i++;\n                } else {\n                    uncheckedEnqueue(first, cr);\n                }\n            }\n        }\n        ws.shrink(i - j);\n    }\n    propagations += num_props;\n    simpDB_props -= num_props;\n\n    return confl;\n}"}])"
