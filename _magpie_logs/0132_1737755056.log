2025-01-24 21:47:26,655	[DEBUG]	patch(2-1)="LineLLMCrossover(('source.cpp', 6), '#include <cstdio>\n#include <queue>\n#include <vector>\n#include <climits>\nusing namespace std;\n\nconst int MAX_ISLANDS = 101;\nvector<vector<pair<int, int>>> connections(MAX_ISLANDS);\nint dis[MAX_ISLANDS];\n\nvoid calculateShortestPath(int start) {\n    queue<int> Q;\n    fill(dis, dis + MAX_ISLANDS, INT_MAX);\n    dis[start] = 0;\n    Q.push(start);\n    while (!Q.empty()) {\n        int current = Q.front();\n        Q.pop();\n        for (const auto& edge : connections[current]) {\n            int neighbor = edge.first;\n            int weight = edge.second;\n            if (dis[neighbor] > dis[current] + weight) {\n                dis[neighbor] = dis[current] + weight;\n                Q.push(neighbor);\n            }\n        }\n    }\n}\n\nint main() {\n    int island, query, kind, start, goal, price;\n    scanf("%d %d", &island, &query);\n    while (island != 0) {\n        for (int i = 0; i < MAX_ISLANDS; i++) {\n            connections[i].clear();\n        }\n        for (int i = 0; i < query; i++) {\n            scanf("%d", &kind);\n            if (kind == 1) {\n                scanf("%d %d %d", &start, &goal, &price);\n                connections[start].emplace_back(goal, price);\n                connections[goal].emplace_back(start, price);\n            } else {\n                scanf("%d %d", &start, &goal);\n                calculateShortestPath(start);\n                printf("%d\\n", dis[goal] == INT_MAX ? -1 : dis[goal]);\n            }\n        }\n        scanf("%d %d", &island, &query);\n    }\n    return 0;\n}')"

