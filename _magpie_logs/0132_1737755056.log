2025-01-24 21:46:21,804	[DEBUG]	patch(1-2)="LineLLMCrossover(('source.cpp', 0), '#include <cstdio>\n#include <queue>\n#include <cstring>\n#include <climits>\nusing namespace std;\n\nqueue<int> Q;\nint island, query, kind, start, goal, price;\nint connect[101][101];\nint dis[101];\n\nvoid initializeGraph() {\n    for (int i = 0; i < 101; i++) {\n        fill(connect[i], connect[i] + 101, INT_MAX);\n    }\n}\n\nvoid calculateShortestPath() {\n    Q.push(start);\n    fill(dis, dis + 101, INT_MAX);\n    dis[start] = 0;\n    while (!Q.empty()) {\n        int current = Q.front();\n        Q.pop();\n        for (int i = 1; i <= island; i++) {\n            if (connect[current][i] != INT_MAX && dis[i] > dis[current] + connect[current][i]) {\n                dis[i] = dis[current] + connect[current][i];\n                Q.push(i);\n            }\n        }\n    }\n}\n\nint main() {\n    scanf("%d %d", &island, &query);\n    while (island != 0) {\n        initializeGraph();\n        for (int i = 0; i < query; i++) {\n            scanf("%d", &kind);\n            if (kind == 1) {\n                scanf("%d %d %d", &start, &goal, &price);\n                connect[start][goal] = min(connect[start][goal], price);\n                connect[goal][start] = connect[start][goal]; // Avoiding redundant checks\n            } else {\n                scanf("%d %d", &start, &goal);\n                calculateShortestPath();\n                printf("%d\\n", dis[goal] == INT_MAX ? -1 : dis[goal]);\n            }\n        }\n        scanf("%d %d", &island, &query);\n    }\n    return 0;\n}')"
