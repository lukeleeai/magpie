2025-01-24 21:45:33,174	[DEBUG]	patch(0-7)="LineLLMMutation(('source.cpp', 6), '#include "stdio.h"\n#include "queue"\n#include "climits"\nusing namespace std;\n\nclass Graph {\npublic:\n    int connect[101][101];\n    int dis[101];\n    int island;\n\n    Graph(int n) {\n        island = n;\n        memset(connect, 0x3f, sizeof(connect));\n    }\n\n    void addEdge(int start, int goal, int price) {\n        connect[start][goal] = min(connect[start][goal], price);\n        connect[goal][start] = connect[start][goal];\n    }\n\n    int shortestPath(int start, int goal) {\n        queue<int> Q;\n        fill(dis, dis + 101, INT_MAX);\n        dis[start] = 0;\n        Q.push(start);\n        while (!Q.empty()) {\n            int current = Q.front();\n            Q.pop();\n            for (int i = 1; i <= island; i++) {\n                if (connect[current][i] != INT_MAX && dis[i] > dis[current] + connect[current][i]) {\n                    dis[i] = dis[current] + connect[current][i];\n                    Q.push(i);\n                }\n            }\n        }\n        return dis[goal] == INT_MAX ? -1 : dis[goal];\n    }\n};\n\nint main() {\n    int island, query, kind, start, goal, price;\n    scanf("%d %d", &island, &query);\n    Graph g(island);\n    while (island != 0) {\n        for (int i = 0; i < query; i++) {\n            scanf("%d", &kind);\n            if (kind == 1) {\n                scanf("%d %d %d", &start, &goal, &price);\n                g.addEdge(start, goal, price);\n            } else {\n                scanf("%d %d", &start, &goal);\n                printf("%d\\n", g.shortestPath(start, goal));\n            }\n        }\n        scanf("%d %d", &island, &query);\n    }\n    return 0;\n}')"
