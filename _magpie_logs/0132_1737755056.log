2025-01-24 21:49:35,139	[DEBUG]	patch(4-9)="LineLLMCrossover(('source.cpp', 12), '#include <cstdio>\n#include <queue>\n#include <climits>\n#include <vector>\nusing namespace std;\n\nconst int MAX_ISLANDS = 101;\nvector<vector<int>> connections(MAX_ISLANDS, vector<int>(MAX_ISLANDS, INT_MAX));\nint dis[MAX_ISLANDS];\n\nvoid initializeGraph() {\n    for (int i = 0; i < MAX_ISLANDS; i++) {\n        fill(connections[i].begin(), connections[i].end(), INT_MAX);\n    }\n}\n\nvoid calculateShortestPath(int start) {\n    queue<int> Q;\n    fill(dis, dis + MAX_ISLANDS, INT_MAX);\n    dis[start] = 0;\n    Q.push(start);\n    while (!Q.empty()) {\n        int current = Q.front();\n        Q.pop();\n        for (int neighbor = 0; neighbor < MAX_ISLANDS; neighbor++) {\n            if (connections[current][neighbor] != INT_MAX && dis[neighbor] > dis[current] + connections[current][neighbor]) {\n                dis[neighbor] = dis[current] + connections[current][neighbor];\n                Q.push(neighbor);\n            }\n        }\n    }\n}\n\nint main() {\n    int island, query, kind, start, goal, price;\n    scanf("%d %d", &island, &query);\n    while (island != 0) {\n        initializeGraph();\n        for (int i = 0; i < query; i++) {\n            scanf("%d", &kind);\n            if (kind == 1) {\n                scanf("%d %d %d", &start, &goal, &price);\n                connections[start][goal] = min(connections[start][goal], price);\n                connections[goal][start] = connections[start][goal]; // Avoiding redundant checks\n            } else {\n                scanf("%d %d", &start, &goal);\n                calculateShortestPath(start);\n                printf("%d\\n", dis[goal] == INT_MAX ? -1 : dis[goal]);\n            }\n        }\n        scanf("%d %d", &island, &query);\n    }\n    return 0;\n}')"
