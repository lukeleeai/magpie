2025-02-24 19:53:12,586	[DEBUG]	patch(2-1)="LineLLMMutation(('source.cpp', 14), '#include <iostream>\n#include <sstream>\n#include <iomanip>\n#include <algorithm>\n#include <cmath>\n#include <string>\n#include <vector>\n#include <list>\n#include <queue>\n#include <stack>\n#include <set>\n#include <map>\n#include <bitset>\n#include <numeric>\n#include <climits>\n#include <cfloat>\n\nusing namespace std;\n\nint n;\nvector<int> w, s;\nvector<bool> used;\nvector<int> bestIndex;\nint bestG;\n\nvoid solve(int k, vector<int>& index, int g, int sumW) {\n    if(k == n) {\n        if(g < bestG) {\n            bestG = g;\n            bestIndex = index;\n        }\n        return;\n    }\n\n    for(int i=0; i<n; ++i) {\n        if(used[i])\n            continue;\n        used[i] = true;\n        if(s[i] >= sumW) {\n            index[k] = i;\n            solve(k+1, index, g+(n-k)*w[i], sumW+w[i]);\n        }\n        used[i] = false;\n    }\n}\n\nint main() {\n    for(;;) {\n        cin >> n;\n        if(n == 0)\n            return 0;\n\n        vector<string> name(n);\n        w.resize(n);\n        s.resize(n);\n        for(int i=0; i<n; ++i)\n            cin >> name[i] >> w[i] >> s[i];\n\n        bestG = INT_MAX;\n        used.assign(n, false);\n        vector<int> index(n);\n        solve(0, index, 0, 0);\n        for(int i=n-1; i>=0; --i)\n            cout << name[bestIndex[i]] << endl;\n    }\n}') | LineLLMMutation(('source.cpp', 18), '#include <iostream>\n#include <sstream>\n#include <iomanip>\n#include <algorithm>\n#include <cmath>\n#include <string>\n#include <vector>\n#include <list>\n#include <queue>\n#include <stack>\n#include <set>\n#include <map>\n#include <bitset>\n#include <numeric>\n#include <climits>\n#include <cfloat>\n\nusing namespace std;\n\nint n;\nvector<int> w, s;\nvector<bool> used;\nvector<int> bestIndex;\nint bestG;\n\nvoid solve(int k, vector<int>& index, int g, int sumW) {\n    if (k == n) {\n        if (g < bestG) {\n            bestG = g;\n            bestIndex = index;\n        }\n        return;\n    }\n\n    // Use a single loop with a condition to select valid indices instead of nested looping\n    for (int i = 0; i < n; ++i) {\n        if (used[i] || s[i] < sumW)  // Skip used indices and invalid weights\n            continue;\n        \n        used[i] = true;\n        index[k] = i;  // Set index before recursive call\n        solve(k + 1, index, g + (n - k) * w[i], sumW + w[i]);\n        used[i] = false;\n    }\n}\n\nint main() {\n    for (;;) {\n        cin >> n;\n        if (n == 0)\n            return 0;\n\n        vector<string> name(n);\n        w.resize(n);\n        s.resize(n);\n        for (int i = 0; i < n; ++i)\n            cin >> name[i] >> w[i] >> s[i];\n\n        bestG = INT_MAX;\n        used.assign(n, false);\n        vector<int> index(n);\n        solve(0, index, 0, 0);\n        for (int i = n - 1; i >= 0; --i)\n            cout << name[bestIndex[i]] << endl;\n    }\n}')"
