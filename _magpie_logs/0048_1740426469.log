2025-02-24 19:49:52,776	[DEBUG]	patch(0-9)="LineLLMMutation(('source.cpp', 8), '#include <iostream>\n#include <vector>\n#include <unordered_map>\n#include <algorithm>\n#include <climits>\n\nusing namespace std;\n\nint n;\nvector<int> w, s;\nvector<int> bestIndex;\nint bestG;\nunordered_map<string, int> memo;\n\nstring createKey(int k, int sumW) {\n    return to_string(k) + "-" + to_string(sumW);\n}\n\nvoid solve(int k, vector<int>& index, int g, int sumW) {\n    if (k == n) {\n        if (g < bestG) {\n            bestG = g;\n            bestIndex = index;\n        }\n        return;\n    }\n\n    string key = createKey(k, sumW);\n    if (memo.find(key) != memo.end() && memo[key] <= g)\n        return;\n\n    memo[key] = g;\n\n    for (int i = 0; i < n; ++i) {\n        if (find(index.begin(), index.begin() + k, i) != index.begin() + k)\n            continue;\n\n        if (s[i] >= sumW) {\n            index[k] = i;\n            solve(k + 1, index, g + (n - k) * w[i], sumW + w[i]);\n        }\n    }\n}\n\nint main() {\n    for (;;) {\n        cin >> n;\n        if (n == 0)\n            return 0;\n\n        vector<string> name(n);\n        w.resize(n);\n        s.resize(n);\n        for (int i = 0; i < n; ++i)\n            cin >> name[i] >> w[i] >> s[i];\n\n        bestG = INT_MAX;\n        vector<int> index(n);\n        solve(0, index, 0, 0);\n        for (int i = n - 1; i >= 0; --i)\n            cout << name[bestIndex[i]] << endl;\n    }\n}')"
