LineLLMCrossover(('source.cpp', 25), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\nint n;\nint a[100005];\nint x[100005];\nint state[100005];\n\nvoid initializeArrays(int* arr, int size, int value) {\n    fill(arr, arr + size, value);\n}\n\nint main() {\n    scanf("%d", &n);\n    for(int i = 0; i < n; i++) {\n        scanf("%d", &a[i]);\n    }\n    initializeArrays(state, n, -1);\n    initializeArrays(x, n, -1); \n\n    int ans = 0;\n    for(int i = 0; i < n; i++) {\n        if(x[i] != -1) continue; \n        int p = i, c = 0;\n        while(state[p] == -1) {\n            state[p] = (c << 16) | i; \n            x[p] = c++;\n            p = (p + a[p]) % n;\n        }\n        if((state[p] & 0xFFFF) == i) ans += (c - (state[p] >> 16));\n    }\n\n    printf("%d\\n", ans);\n    return 0;\n}') + LineLLMMutation(('source.cpp', 39), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\nint n;\nint a[100005];\nint x[100005];\nint state[100005];\n\nint main() {\n    scanf("%d", &n);\n    for(int i = 0; i < n; i++) {\n        scanf("%d", &a[i]);\n    }\n    \n    // Directly initializing arrays using a simple loop instead of a function call\n    fill(state, state + n, -1);\n    fill(x, x + n, -1); \n\n    int ans = 0;\n    for(int i = 0; i < n; i++) {\n        if(x[i] != -1) continue; \n        int p = i, c = 0;\n        while(state[p] == -1) {\n            state[p] = (c << 16) | i; \n            x[p] = c++;\n            p = (p + a[p]) % n;\n        }\n        if((state[p] & 0xFFFF) == i) ans += (c - (state[p] >> 16));\n    }\n\n    printf("%d\\n", ans);\n    return 0;\n}')
