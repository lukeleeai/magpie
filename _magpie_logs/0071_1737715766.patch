LineLLMCrossover(('source.cpp', 21), '#include <iostream>\n#include <vector>\n#include <map>\n#include <limits>\n#include <unordered_map>\n#include <cstdio> // for scanf and printf\nusing namespace std;\n\n#define MAX 1000\n#define INF (1e9)\n\nstruct Edge {\n    int to, cost, c;\n    Edge(int to, int cost, int c) : to(to), cost(cost), c(c) {}\n};\n\nint main() {\n    int M, D, N, K;\n    int d[MAX][1 << 6];\n    while (scanf("%d%d%d%d", &M, &N, &K, &D), M) {\n        unordered_map<int, vector<Edge>> G;\n        vector<int> cake(M);\n        for (int i = 0; i < M; i++) {\n            scanf("%d", &cake[i]);\n        }\n        int idx = 0, c;\n        string a, b;\n        map<string, int> mp;\n        for (int i = 0; i < D; i++) {\n            cin >> a >> b >> c;\n            if (!mp.count(a)) mp[a] = idx++;\n            if (!mp.count(b)) mp[b] = idx++;\n            G[mp[a]].emplace_back(mp[b], c, (a[0] == \'C\') ? a[1] - \'1\' : -1);\n            G[mp[b]].emplace_back(mp[a], c, (b[0] == \'C\') ? b[1] - \'1\' : -1);\n        }\n\n        int s = mp["H"], t = mp["D"];\n        fill(d[0], d[0] + MAX * (1 << 6), INF);\n        d[s][0] = 0;\n        bool update = true;\n\n        while (update) {\n            update = false;\n            for (int i = 0; i < (int)mp.size(); i++) {\n                for (auto &edge : G[i]) {\n                    for (int S = (1 << 6) - 1; S >= 0; S--) {\n                        int ncost = d[i][S];\n                        if (ncost == INF) continue;\n                        ncost += edge.cost * K;\n                        if (edge.c == -1) {\n                            if (ncost < d[edge.to][S]) {\n                                d[edge.to][S] = ncost;\n                                update = true;\n                            }\n                        } else {\n                            if (S >> edge.c & 1) continue;\n                            if (ncost - cake[edge.c] < d[edge.to][S | (1 << edge.c)]) {\n                                d[edge.to][S | (1 << edge.c)] = ncost - cake[edge.c];\n                                update = true;\n                            }\n                        }\n                    }\n                }\n            }\n        }\n\n        int res = INF;\n        for (int i = 0; i < (1 << 6); i++) {\n            res = min(res, d[t][i]);\n        }\n\n        printf("%d\\n", res);\n    }\n    return 0;\n}') + LineLLMMutation(('source.cpp', 36), '#include <iostream>\n#include <vector>\n#include <map>\n#include <limits>\n#include <unordered_map>\n#include <cstdio> // for scanf and printf\nusing namespace std;\n\n#define MAX 1000\n#define INF (1e9)\n\nstruct Edge {\n    int to, cost, c;\n    Edge(int to, int cost, int c) : to(to), cost(cost), c(c) {}\n};\n\nint main() {\n    int M, D, N, K;\n    while (scanf("%d%d%d%d", &M, &N, &K, &D), M) {\n        unordered_map<int, vector<Edge>> G;\n        vector<int> cake(M);\n        for (int i = 0; i < M; i++) {\n            scanf("%d", &cake[i]);\n        }\n        int idx = 0, c;\n        string a, b;\n        map<string, int> mp;\n        for (int i = 0; i < D; i++) {\n            cin >> a >> b >> c;\n            if (!mp.count(a)) mp[a] = idx++;\n            if (!mp.count(b)) mp[b] = idx++;\n            G[mp[a]].emplace_back(mp[b], c, (a[0] == \'C\') ? a[1] - \'1\' : -1);\n            G[mp[b]].emplace_back(mp[a], c, (b[0] == \'C\') ? b[1] - \'1\' : -1);\n        }\n\n        int s = mp["H"], t = mp["D"];\n        // Dynamically allocate distance array based on the number of vertices and mask size\n        vector<vector<int>> d(idx, vector<int>(1 << 6, INF));\n        d[s][0] = 0;\n        bool update = true;\n\n        while (update) {\n            update = false;\n            for (int i = 0; i < idx; i++) {\n                for (auto &edge : G[i]) {\n                    for (int S = (1 << 6) - 1; S >= 0; S--) {\n                        int ncost = d[i][S];\n                        if (ncost == INF) continue;\n                        ncost += edge.cost * K;\n                        if (edge.c == -1) {\n                            if (ncost < d[edge.to][S]) {\n                                d[edge.to][S] = ncost;\n                                update = true;\n                            }\n                        } else {\n                            if (S >> edge.c & 1) continue;\n                            if (ncost - cake[edge.c] < d[edge.to][S | (1 << edge.c)]) {\n                                d[edge.to][S | (1 << edge.c)] = ncost - cake[edge.c];\n                                update = true;\n                            }\n                        }\n                    }\n                }\n            }\n        }\n\n        int res = INF;\n        for (int i = 0; i < (1 << 6); i++) {\n            res = min(res, d[t][i]);\n        }\n\n        printf("%d\\n", res);\n    }\n    return 0;\n}') + LineLLMMutation(('source.cpp', 38), '#include <iostream>\n#include <vector>\n#include <map>\n#include <limits>\n#include <unordered_map>\n#include <cstdio> // for scanf and printf\nusing namespace std;\n\n#define MAX 1000\n#define INF (1e9)\n\nstruct Edge {\n    int to, cost, c;\n    Edge(int to, int cost, int c) : to(to), cost(cost), c(c) {}\n};\n\nint main() {\n    int M, D, N, K;\n    while (scanf("%d%d%d%d", &M, &N, &K, &D), M) {\n        unordered_map<int, vector<Edge>> G;\n        vector<int> cake(M);\n        for (int i = 0; i < M; i++) {\n            scanf("%d", &cake[i]);\n        }\n        int idx = 0, c;\n        string a, b;\n        map<string, int> mp;\n        for (int i = 0; i < D; i++) {\n            cin >> a >> b >> c;\n            if (!mp.count(a)) mp[a] = idx++;\n            if (!mp.count(b)) mp[b] = idx++;\n            G[mp[a]].emplace_back(mp[b], c, (a[0] == \'C\') ? a[1] - \'1\' : -1);\n            G[mp[b]].emplace_back(mp[a], c, (b[0] == \'C\') ? b[1] - \'1\' : -1);\n        }\n\n        int s = mp["H"], t = mp["D"];\n        vector<vector<int>> d(idx, vec