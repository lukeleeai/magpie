k;\n        for (int i = 0; i < n; i++) {\n            scanf("%s %d %d", f[i], &w[i], &s[i]);\n        }\n        fill(u, u + n, false);\n        double maxg = -1e9;\n        maxg = dfs(0, 0, 0, maxg, 0.); // Capture the returned maxg\n        vector<int> result;\n        for (int i = n - 1; i >= 0; i--) {\n            if (u[i]) {\n                result.push_back(i);\n            }\n        }\n        for (int i : result) {\n            printf("%s\\n", f[i]);\n        }\n    }\n    return 0;\n}')"
