     tw += w[x];\n        a[m] = x;\n        dfs(0, tw, m + 1, g + w[x] * (m + 1));\n        tw -= w[x];\n        u[x] = false;\n    }\n\n    dfs(x + 1, tw, m, g);\n}\n\nint main() {\n    while (1) {\n        scanf("%d", &n);\n        if (!n) break;\n        Item items[10];\n        for (int i = 0; i < n; i++) {\n            scanf("%s %d %d", items[i].name, &items[i].weight, &items[i].strength);\n        }\n\n        // Sort items based on weight-to-strength ratio\n        sort(items, items + n, compare);\n\n        fill(u, u + n, false);\n        maxg = -1e9;\n        dfs(0, 0, 0, 0.);\n        for (int i = n - 1; i >= 0; i--) {\n            printf("%s\\n", items[b[i]].name);\n        }\n    }\n    return 0;\n}')"
