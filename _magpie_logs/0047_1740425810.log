n            a[m] = x;\n            stk.push({0, tw, m + 1, g + w[x] * (m + 1)});\n            tw -= w[x];\n            u[x] = false;\n        }\n\n        stk.push({x + 1, tw, m, g});\n    }\n}\n\nint main() {\n    while (1) {\n        scanf("%d", &n);\n        if (!n) break;\n        for (int i = 0; i < n; i++) {\n            scanf("%s %d %d", f[i], &w[i], &s[i]);\n        }\n        fill(u, u + n, false);\n        double maxg = -1e9;\n        iterative_dfs(maxg);\n        for (int i = n - 1; i >= 0; i--) {\n            printf("%s\\n", f[b[i]]);\n        }\n    }\n    return 0;\n}')"
