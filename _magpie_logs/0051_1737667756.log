     }\n                    } else {\n                        rep(L, 6) {\n                            if(q.X + ex[L] >= 0 && q.X + ex[L] < w && q.Y + ey[L] < h && q.Y + ey[L] >= 0) {\n                                if(!done[q.Y + ey[L]][q.X + ex[L]]) Q.push(make_pair(make_pair(q.Y + ey[L], q.X + ex[L]), q.depth + 1));\n                                done[q.Y + ey[L]][q.X + ex[L]] = true;\n                            }\n                        }\n                    }\n                }\n\n                for (int I = 0; I < 100; ++I) {\n                    if(dp[I].first) {\n                        if(dp[I].first == 1)\n                            pt[dp[I].second - 1]++;\n                        break;\n                    }\n                }\n            }\n\n            ret = max(pt[49], ret);\n            point[b][a] = 0;\n        }\n\n        printf("%d\\n", ret);\n    }\n}')"
