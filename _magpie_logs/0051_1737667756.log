2025-01-23 21:34:51,681	[DEBUG]	patch(3-6)="LineLLMCrossover(('source.cpp', 9), '#include <iostream>\n#include <queue>\n#include <cstdio>\n#include <vector>\n\nusing namespace std;\n\n#define rep(i,n) for(int i=0; i<n; i++)\n\ntypedef pair<pair<int,int>,int> NODE;\n\n#define X first.second\n#define Y first.first\n#define depth second\n\nint ox[] = {-1, 1, 0, 0, 1, 1};\nint oy[] = { 0, 0,-1, 1,-1, 1};\nint ex[] = {-1, 1, 0, 0,-1,-1};\nint ey[] = { 0, 0,-1, 1,-1, 1};\n\nint main() {\n    int point[100][100] = {0}; // Static array initialization\n    int h, w, a, b, t, x, y, s;\n\n    while(scanf("%d", &w) && w) {\n        int ret = 0;\n        scanf("%d", &h);\n        scanf("%d", &t);\n\n        rep(i, t) {\n            scanf("%d%d", &a, &b);\n            a--; b--;\n            point[b][a] = i + 1;\n        }\n\n        scanf("%d", &s);\n        rep(P, s) {\n            scanf("%d%d", &a, &b);\n            a--; b--;\n            point[b][a] = 50;\n\n            vector<int> pt(100, 0); // Dynamic allocation for counting\n            rep(i, h) rep(j, w) {\n                x = j, y = i;\n                queue<NODE> Q;\n                pair<int, int> dp[100] = { {0, 0} }; // Initialize dp array\n                bool done[100][100] = {0};\n                Q.push(make_pair(make_pair(y, x), 0));\n\n                while(Q.size()) {\n                    NODE q = Q.front(); Q.pop();\n                    if(point[q.Y][q.X]) {\n                        dp[q.depth].first++;\n                        dp[q.depth].second = point[q.Y][q.X];\n                    }\n\n                    if(q.Y % 2 == 1) {\n                        rep(L, 6) {\n                            if(q.X + ox[L] >= 0 && q.X + ox[L] < w && q.Y + oy[L] < h && q.Y + oy[L] >= 0) {\n                                if(!done[q.Y + oy[L]][q.X + ox[L]]) Q.push(make_pair(make_pair(q.Y + oy[L], q.X + ox[L]), q.depth + 1));\n                                done[q.Y + oy[L]][q.X + ox[L]] = true;\n                            }\n                        }\n                    } else {\n                        rep(L, 6) {\n                            if(q.X + ex[L] >= 0 && q.X + ex[L] < w && q.Y + ey[L] < h && q.Y + ey[L] >= 0) {\n                                if(!done[q.Y + ey[L]][q.X + ex[L]]) Q.push(make_pair(make_pair(q.Y + ey[L], q.X + ex[L]), q.depth + 1));\n                                done[q.Y + ey[L]][q.X + ex[L]] = true;\n                            }\n                        }\n                    }\n                }\n\n                for (int I = 0; I < 100; ++I) {\n                    if(dp[I].first) {\n                        if(dp[I].first == 1)\n                            pt[dp[I].second - 1]++;\n                        break;\n                    }\n                }\n            }\n\n            ret = max(pt[49], ret);\n            point[b][a] = 0;\n        }\n\n        printf("%d\\n", ret);\n    }\n}')"

