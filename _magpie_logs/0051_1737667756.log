h(make_pair(make_pair(newY, newX), q.depth + 1));\n                            done[newY][newX] = true;\n                        }\n                    }\n                }\n\n                for (int I = 0; I < 100; ++I) {\n                    if(dp[I].first) {\n                        if(dp[I].first == 1)\n                            pt[dp[I].second - 1]++;\n                        break;\n                    }\n                }\n            }\n\n            ret = max(pt[49], ret);\n            point[b][a] = 0;\n        }\n\n        printf("%d\\n", ret);\n    }\n}')"
