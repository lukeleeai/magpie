format_debug = patch({counter})="{patch}"{diffifbest}
format_fitness = {:.2f}
format_ratio = {:.2%%}
format_patchif = 
	 --> {patch}
format_diffif = 
	{diff}

[software]
path = dataset/magpie_dataset/train/0051
