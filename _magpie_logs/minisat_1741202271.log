);\n\n                while (i < end) *j++ = *i++;\n            } else {\n                uncheckedEnqueue(c[0], cr);\n            }\n\n        NextClause:;\n        }\n        ws.shrink(i - j);\n    }\n\n    propagations += num_props;\n    simpDB_props -= num_props;\n\n    return confl;\n}"}])"

