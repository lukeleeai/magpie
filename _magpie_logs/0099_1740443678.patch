LineLLMCrossover(('source.cpp', 5), '#include <cstdio>\nusing namespace std;\n\nsize_t N, M, Q, p = 0, r, a, prv[200007], nxt[200007];\n\nint main() {\n    scanf("%zu %zu %zu", &N, &M, &Q);\n\n    for (size_t i = 0; i < N; i++) \n        prv[i] = (i + N - 1) % N, nxt[i] = (i + 1) % N;\n\n    for (size_t i = 0; i < M; i++) {\n        scanf("%zu", &a);\n        for (size_t j = 0; j < a; j++) \n            p = a % 2 ? prv[p] : nxt[p];\n\n        nxt[prv[p]] = nxt[p], prv[nxt[p]] = prv[p];\n\n        r = nxt[p], prv[p] = nxt[p] = -1, p = r;\n    }\n\n    for (size_t i = 0; i < Q; i++) {\n        scanf("%zu", &a);\n        printf("%d\\n", (prv[a] != -1 ? 1 : 0));\n    }\n\n    return 0;\n}') + LineLLMMutation(('source.cpp', 25), '#include <cstdio>\nusing namespace std;\n\nsize_t N, M, Q, p = 0, r, a, prv[200007], nxt[200007];\n\nint main() {\n    scanf("%zu %zu %zu", &N, &M, &Q);\n\n    // Optimize the initialization of prv and nxt arrays\n    for (size_t i = 0; i < N; i++) {\n        prv[i] = (i == 0) ? N - 1 : i - 1; // Simplified previous index\n        nxt[i] = (i == N - 1) ? 0 : i + 1; // Simplified next index\n    }\n\n    for (size_t i = 0; i < M; i++) {\n        scanf("%zu", &a);\n        for (size_t j = 0; j < a; j++)\n            p = a % 2 ? prv[p] : nxt[p];\n\n        nxt[prv[p]] = nxt[p], prv[nxt[p]] = prv[p];\n\n        r = nxt[p], prv[p] = nxt[p] = -1, p = r;\n    }\n\n    for (size_t i = 0; i < Q; i++) {\n        scanf("%zu", &a);\n        printf("%d\\n", (prv[a] != -1 ? 1 : 0));\n    }\n\n    return 0;\n}')
