lue(p) == l_False) {\n                    analyzeFinal(~p, conflict);\n                    return l_False;\n                } else {\n                    next = p;\n                    break;\n                }\n            }\n\n            if (next == lit_Undef) {\n                decisions++;\n                next = pickBranchLit();\n\n                if (next == lit_Undef)\n                    return l_True;\n            }\n\n            newDecisionLevel();\n            uncheckedEnqueue(next);\n        }\n    }\n}', '613:703')"
