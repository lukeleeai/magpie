            int a, b, c; \n            scanf("%d %d %d", &a, &b, &c);\n            a--, b--;\n            cost[a][b] = cost[b][a] = c;\n        }\n\n        vector<P> can_free;\n        for (int i = 0; i < N; ++i) {\n            for (int j = 0; j < N; ++j) {\n                if (cost[i][j] != INF && i != j) {\n                    for (int k = 0; k < N; ++k) {\n                        if (cost[j][k] != INF && i != k && j != k) {\n                            can_free.emplace_back(i, k);\n                        }\n                    }\n                }\n            }\n        }\n\n        // Optimizing the nested loops with Floyd-Warshall\n        for (int k = 0; k < N; ++k) {\n            for (int i = 0; i < N; ++i) {\n                if (cost[i][k] == INF) continue; // Skip unnecessary iterations\n                for (int j = 0; j < N; ++j) {\n                    if (cost[k][j] == INF) continue; // Skip unnecessary iterations\n                    cost[i][j] = min(cost[i][j], cost[i][k] + cost[k][j]);\n                }\n            }\n        }\n\n        int ans = cost[0][N - 1];\n        for (const auto& p : can_free) {\n            ans = min(cost[0][p.x] + cost[p.y][N - 1], ans);\n        }\n\n        printf("%d\\n", ans);\n    }\n}')"
