LineLLMCrossover(('source.cpp', 35), '#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cstdio>\n#include <limits>\n\nusing namespace std;\n\nstruct P {\n    int x, y;\n    P(int x, int y): x(x), y(y) {}\n};\n\nconst int INF = numeric_limits<int>::max();\n\nint main() {\n    int N, M;\n\n    while (scanf("%d %d", &N, &M), N || M) {\n        vector<int> cost(N * N, INF);\n        for (int i = 0; i < N; ++i) cost[i * N + i] = 0;\n\n        for (int i = 0; i < M; ++i) {\n            int a, b, c; \n            scanf("%d %d %d", &a, &b, &c);\n            a--, b--;\n            cost[a * N + b] = cost[b * N + a] = min(cost[a * N + b], c);\n        }\n\n        vector<P> can_free;\n        for (int i = 0; i < N; ++i) {\n            for (int j = 0; j < N; ++j) {\n                if (i != j && cost[i * N + j] != INF) {\n                    for (int k = 0; k < N; ++k) {\n                        if (k != i && k != j && cost[j * N + k] != INF) {\n                            can_free.emplace_back(i, k);\n                        }\n                    }\n                }\n            }\n        }\n\n        for (int k = 0; k < N; ++k) {\n            for (int i = 0; i < N; ++i) {\n                if (cost[i * N + k] == INF) continue;\n                for (int j = 0; j < N; ++j) {\n                    if (cost[k * N + j] == INF) continue;\n                    cost[i * N + j] = min(cost[i * N + j], cost[i * N + k] + cost[k * N + j]);\n                }\n            }\n        }\n\n        int ans = cost[0 * N + (N - 1)];\n        for (const auto& p : can_free) {\n            ans = min(cost[0 * N + p.x] + cost[p.y * N + (N - 1)], ans);\n        }\n\n        printf("%d\\n", ans);\n    }\n}')
