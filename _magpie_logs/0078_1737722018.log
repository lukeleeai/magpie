2025-01-24 12:35:14,965	[DEBUG]	patch(0-10)="LineLLMMutation(('source.cpp', 9), '#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cstdio>\n#include <queue>\n#include <utility>\n\nusing namespace std;\n\nconst int INF = 1000000000;\n\nint main() {\n    int N, M;\n\n    while (scanf("%d %d", &N, &M), N || M) {\n        vector<vector<pair<int, int>>> graph(N);\n        for (int i = 0; i < M; ++i) {\n            int a, b, c; \n            scanf("%d %d %d", &a, &b, &c);\n            a--, b--;\n            graph[a].emplace_back(b, c);\n            graph[b].emplace_back(a, c);\n        }\n\n        vector<int> dist(N, INF);\n        dist[0] = 0;\n        priority_queue<pair<int, int>, vector<pair<int, int>>, greater<pair<int, int>>> pq;\n        pq.emplace(0, 0);\n\n        while (!pq.empty()) {\n            auto [d, u] = pq.top(); pq.pop();\n            if (d > dist[u]) continue;\n\n            for (auto& [v, w] : graph[u]) {\n                if (dist[u] + w < dist[v]) {\n                    dist[v] = dist[u] + w;\n                    pq.emplace(dist[v], v);\n                }\n            }\n        }\n\n        printf("%d\\n", dist[N - 1]);\n    }\n}')"
