2025-01-24 12:35:00,503	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include <iostream>\n#include <vector>\n#include <algorithm>\n\nusing namespace std;\n\nstruct P {\n    int x, y;\n    P(int x, int y): x(x), y(y) {}\n};\n\nconst int INF = 1000000000;\n\nint cost[300][300];\n\nint main() {\n    int N, M;\n\n    while (cin >> N >> M, N || M) {\n        fill(&cost[0][0], &cost[0][0] + sizeof(cost) / sizeof(cost[0][0]), INF);\n        for (int i = 0; i < N; ++i) cost[i][i] = 0;\n\n        for (int i = 0; i < M; ++i) {\n            int a, b, c; \n            cin >> a >> b >> c;\n            a--, b--;\n            cost[a][b] = cost[b][a] = c;\n        }\n\n        vector<P> can_free;\n        for (int i = 0; i < N; ++i) {\n            for (int j = 0; j < N; ++j) {\n                if (cost[i][j] != INF && i != j) {\n                    for (int k = 0; k < N; ++k) {\n                        if (cost[j][k] != INF && i != k && j != k)\n                            can_free.emplace_back(i, k);\n                    }\n                }\n            }\n        }\n\n        for (int k = 0; k < N; ++k) {\n            for (int i = 0; i < N; ++i) {\n                for (int j = 0; j < N; ++j) {\n                    cost[i][j] = min(cost[i][j], cost[i][k] + cost[k][j]);\n                }\n            }\n        }\n\n        int ans = cost[0][N - 1];\n        for (const auto& p : can_free) {\n            ans = min(cost[0][p.x] + cost[p.y][N - 1], ans);\n        }\n\n        cout << ans << endl;\n    }\n}')"

