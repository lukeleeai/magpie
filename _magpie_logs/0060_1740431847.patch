LineLLMCrossover(('source.cpp', 12), '#include <iostream>\n#include <cstdio>\nusing namespace std;\n\nconst int t[8] = { 0, 1, 2, 3, 5, 7, 8, 9 };\nlong long results[100]; // Array for results\nint index = 0; // To track results\n\nlong long int solve(int n) {\n    long long s = 0, multiplier = 1; \n    while (n > 0) {\n        s += t[n % 8] * multiplier; // Using modulus for clarity\n        multiplier *= 10;\n        n >>= 3; // Right shift for efficiency\n    }\n    return s;\n}\n\nint main() {\n    int n;\n    while (cin >> n, n) {\n        results[index++] = solve(n); // Store results\n    }\n    for (int i = 0; i < index; i++) {\n        printf("%lld\\n", results[i]); // Print results in one go\n    }\n}')
