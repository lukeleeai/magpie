2025-02-24 18:24:43,952	[DEBUG]	patch(2-9)="LineLLMMutation(('source.cpp', 20), 'Polygon ConvexHull(vector<Point> ps) {\n    int n = ps.size();\n    sort(ps.begin(), ps.end());\n\n    Polygon ch_u;\n    ch_u.reserve(n); // Reserve space for upper hull\n    for (int i = n - 1; i >= 0; i--) {\n        ch_u.pb(ps[i]);\n        while (ch_u.size() >= 3 && ccw(ch_u[ch_u.size() - 3], ch_u[ch_u.size() - 2], ch_u[ch_u.size() - 1]) != CCW) {\n            ch_u[ch_u.size() - 2] = ch_u[ch_u.size() - 1];\n            ch_u.pop_back();\n        }\n    }\n\n    Polygon ch_l;\n    ch_l.reserve(n); // Reserve space for lower hull\n    for (int i = 0; i < n; i++) {\n        ch_l.pb(ps[i]);\n        while (ch_l.size() >= 3 && ccw(ch_l[ch_l.size() - 3], ch_l[ch_l.size() - 2], ch_l[ch_l.size() - 1]) != CCW) {\n            ch_l[ch_l.size() - 2] = ch_l[ch_l.size() - 1];\n            ch_l.pop_back();\n        }\n    }\n\n    Polygon ch = ch_u;\n    ch.insert(ch.end(), ch_l.begin(), ch_l.end() - 1);\n    return ch;\n}')"
