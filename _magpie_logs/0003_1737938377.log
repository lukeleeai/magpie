format_diffif = 
	{diff}

[software]
path = dataset/magpie_dataset/train/0003
target_files = 
	source.cpp
software = BasicSoftware
model_rules = 
	*.params : ParamFileConfigModel
	*.xml : SrcmlModel
	* : LineModel
