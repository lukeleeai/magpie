LineLLMCrossover(('source.cpp', 14), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\nconst int INF = 1000000;\nconst int maxn = 100;\n\nint main() {\n    int n, m, a, b, cost, time, k, p, q, r;\n    int t[maxn][maxn], c[maxn][maxn];\n\n    while (scanf("%d %d", &n, &m), n || m) {\n        for (int i = 0; i < m; i++) {\n            fill(t[i], t[i] + m, INF);\n            fill(c[i], c[i] + m, INF);\n            t[i][i] = c[i][i] = 0;\n        }\n\n        for (int i = 0; i < n; i++) {\n            scanf("%d %d %d %d", &a, &b, &cost, &time);\n            t[a - 1][b - 1] = t[b - 1][a - 1] = time;\n            c[a - 1][b - 1] = c[b - 1][a - 1] = cost;\n        }\n\n        for (int x = 0; x < m; x++) {\n            bool updated = false;\n            for (int i = 0; i < m; i++) {\n                for (int j = 0; j < m; j++) {\n                    if (t[i][j] > t[i][x] + t[x][j]) {\n                        t[i][j] = t[i][x] + t[x][j];\n                        updated = true;\n                    }\n                    if (c[i][j] > c[i][x] + c[x][j]) {\n                        c[i][j] = c[i][x] + c[x][j];\n                        updated = true;\n                    }\n                }\n                if (!updated) break;\n            }\n        }\n\n        scanf("%d", &k);\n        for (int i = 0; i < k; i++) {\n            scanf("%d %d %d", &p, &q, &r);\n            printf("%d\\n", r ? t[p - 1][q - 1] : c[p - 1][q - 1]);\n        }\n    }\n}')
