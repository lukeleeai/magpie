LineLLMCrossover(('source.cpp', 8), '#include <stdio.h>\n#include <math.h>\n\nbool flag[1000000];\n\nint main(void) {\n    long long i, j, p, n, count;\n    p = (long long)sqrt(1000000.0);\n\n    for (i = 3; i <= p; i += 2) {\n        if (!flag[i]) {\n            for (j = i * i; j <= 1000000; j += 2 * i) {\n                flag[j] = true;\n            }\n        }\n    }\n\n    while (scanf("%lld", &n) != EOF) {\n        if (n == 1 || n == 0) {\n            count = 0;\n        } else {\n            count = 1;\n            for (i = 3; i <= n; i += 2) {\n                if (!flag[i]) {\n                    count++;\n                }\n            }\n        }\n        printf("%lld\\n", count);\n    }\n\n    return 0;\n}')
