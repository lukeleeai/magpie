2025-01-25 00:37:59,592	[DEBUG]	patch(0-10)="LineLLMMutation(('source.cpp', 9), '#include <cstdio>\n#include <vector>\n#include <algorithm>\n#include <thread>\n#include <future>\nusing namespace std;\n\nlong long calculate_distance(const vector<int>& S, const vector<int>& T, int start, int end) {\n    long long distance_ = 0;\n    for (int i = start; i < end; i++) {\n        int l = *(upper_bound(S.begin(), S.end(), T[i]) - 1);\n        int r = *lower_bound(S.begin(), S.end(), T[i]);\n        distance_ += min(T[i] - l, r - T[i]);\n    }\n    return distance_;\n}\n\nint main() {\n    int D, N, M;\n    while (true) {\n        scanf("%d", &D);\n        if (D == 0) { break; }\n        scanf("%d %d", &N, &M);\n        \n        vector<int> S(N + 1);\n        vector<int> T(M);\n        S[0] = 0;\n        S[N] = D;\n\n        for (int i = 1; i < N; i++) { scanf("%d", &S[i]); }\n        for (int i = 0; i < M; i++) { scanf("%d", &T[i]); }\n\n        sort(S.begin(), S.end());\n\n        auto f1 = async(launch::async, calculate_distance, ref(S), ref(T), 0, M / 2);\n        auto f2 = async(launch::async, calculate_distance, ref(S), ref(T), M / 2, M);\n        long long distance_ = f1.get() + f2.get();\n\n        printf("%lld\\n", distance_);\n    }\n    return 0;\n}')"
