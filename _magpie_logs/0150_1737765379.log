\nint main() {\n    int D, N, M;\n    while (true) {\n        if (scanf("%d", &D) != 1 || D == 0) { break; }\n        scanf("%d %d", &N, &M);\n        \n        vector<int> S(N + 2); // Using vector for automatic size management\n        vector<int> T(M);     // Using vector for dynamic size\n        \n        S[0] = 0;\n        S[N + 1] = D;\n\n        // Read the input into the S array more efficiently\n        for (int i = 1; i <= N; i++) { \n            scanf("%d", &S[i]); \n        }\n        for (int i = 0; i < M; i++) { \n            scanf("%d", &T[i]); \n        }\n\n        sort(S.begin(), S.begin() + N + 2); // Sort vector instead of array\n\n        long long distance_ = 0;\n        for (int i = 0; i < M; i++) {\n            // Use binary search to find the closest points\n            int l = *(upper_bound(S.begin(), S.begin() + N + 2, T[i]) - 1);\n            int r = *lower_bound(S.begin(), S.begin() + N + 2, T[i]);\n            distance_ += min(T[i] - l, r - T[i]);\n        }\n\n        printf("%lld\\n", distance_);\n    }\n    return 0;\n}')"
