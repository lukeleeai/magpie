ude <numeric>\n#include <vector>\nusing namespace std;\n\nint main() {\n    int D, N, M;\n    while (true) {\n        scanf("%d", &D);\n        if (D == 0) { break; }\n        scanf("%d %d", &N, &M);\n        \n        vector<int> S(N + 1); // Using vector for dynamic sizing\n        vector<int> T(M); // Using vector for dynamic sizing\n        S[0] = 0;\n        S[N] = D;\n\n        for (int i = 1; i < N; i++) { scanf("%d", &S[i]); }\n        for (int i = 0; i < M; i++) { scanf("%d", &T[i]); }\n\n        sort(S.begin(), S.end()); // Sorting the vector\n\n        long long distance_ = accumulate(T.begin(), T.end(), 0LL, [&](long long acc, int ti) {\n            int l = *(upper_bound(S.begin(), S.end(), ti) - 1);\n            int r = *lower_bound(S.begin(), S.end(), ti);\n            return acc + min(ti - l, r - ti);\n        });\n\n        printf("%lld\\n", distance_);\n    }\n    return 0;\n}')"
