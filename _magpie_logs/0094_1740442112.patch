LineLLMCrossover(('source.cpp', 9), '#include <cstdio>\n#include <algorithm>\n#include <cstring>\nusing namespace std;\n\nconst int INF = 0x3f3f3f3f;\nint dp[101][101][101];\n\nstruct P {\n    int a, e, r;\n    void in() {\n        scanf("%d %d %d", &a, &e, &r);\n    }\n    bool operator<(const P &rhs) const {\n        return r < rhs.r;\n    }\n} p[100];\n\nint main() {\n    int d, n;\n    while (scanf("%d %d", &d, &n), d || n) {\n        for (int i = 0; i < n; ++i) {\n            p[i].in();\n        }\n        sort(p, p + n);\n        memset(dp, INF, sizeof(dp));\n        dp[0][0][0] = 0;\n\n        for (int i = 0; i < n; ++i) {\n            for (int j = 0; j <= 100; ++j) {\n                for (int k = 0; k <= d; ++k) {\n                    dp[i + 1][j][k] = min(dp[i + 1][j][k], dp[i][j][k]);\n                    if (j >= p[i].r) {\n                        int newEnergy = min(100, j + p[i].e);\n                        int newA = min(d, k + p[i].a);\n                        dp[i + 1][newEnergy][newA] = min(dp[i + 1][newEnergy][newA], dp[i + 1][j][k] + 1);\n                    }\n                }\n            }\n        }\n        int ans = INF;\n        for (int i = 0; i < 101; ++i) {\n            ans = min(ans, dp[n][i][d]);\n        }\n        if (ans == INF) puts("NA");\n        else printf("%d\\n", ans);\n    }\n}') + LineLLMMutation(('source.cpp', 24), '#include <cstdio>\n#include <algorithm>\n#include <cstring>\n#include <vector>\nusing namespace std;\n\nconst int INF = 0x3f3f3f3f;\nconst int MAX_N = 100;\nconst int MAX_D = 100;\n\nstruct P {\n    int a, e, r;\n    void in() {\n        scanf("%d %d %d", &a, &e, &r);\n    }\n    bool operator<(const P &rhs) const {\n        return r < rhs.r;\n    }\n} p[MAX_N];\n\nint main() {\n    int d, n;\n    while (scanf("%d %d", &d, &n), d || n) {\n        vector<vector<vector<int>>> dp(n + 1, vector<vector<int>>(101, vector<int>(d + 1, INF)));\n        dp[0][0][0] = 0;\n\n        for (int i = 0; i < n; ++i) {\n            p[i].in();\n        }\n        sort(p, p + n);\n\n        for (int i = 0; i < n; ++i) {\n            for (int j = 0; j <= 100; ++j) {\n                for (int k = 0; k <= d; ++k) {\n                    dp[i + 1][j][k] = min(dp[i + 1][j][k], dp[i][j][k]);\n                    if (j >= p[i].r) {\n                        int newEnergy = min(100, j + p[i].e);\n                        int newA = min(d, k + p[i].a);\n                        dp[i + 1][newEnergy][newA] = min(dp[i + 1][newEnergy][newA], dp[i + 1][j][k] + 1);\n                    }\n                }\n            }\n        }\n\n        int ans = INF;\n        for (int i = 0; i < 101; ++i) {\n            ans = min(ans, dp[n][i][d]);\n        }\n        if (ans == INF) puts("NA");\n        else printf("%d\\n", ans);\n    }\n}')
