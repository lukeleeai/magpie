2025-02-24 16:06:36,800	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include <cstdio>\n#include <vector>\n#include <cstring>\n#include <algorithm>\n\n#define INF 100000000\n#define pb push_back\n\nusing namespace std;\n\ntypedef pair<int, int> P;\ntypedef long long int ll;\n\nint w, n;\nint t = 0;\nint dp[1001][1001];\nvector<P> vec;\n\nint rec(int i, int j) {\n    if (dp[i][j] >= 0) return dp[i][j];\n    int res;\n    if (i == n) res = 0;\n    else if (j < vec[i].second) res = rec(i + 1, j);\n    else res = max(rec(i + 1, j), rec(i + 1, j - vec[i].second) + vec[i].first);\n    return dp[i][j] = res;\n}\n\nint main() {\n    while (scanf("%d", &w)) {\n        t++;\n        if (w == 0) break;\n        memset(dp, -1, sizeof(dp));\n        scanf("%d", &n);\n        for (int i = 0; i < n; i++) {\n            int temp1, temp2;\n            char trash;\n            scanf("%d%c%d", &temp1, &trash, &temp2);\n            vec.pb(P(temp1, temp2));\n        }\n        printf("Case %d:\\n", t);\n        printf("%d\\n", rec(0, w));\n        for (int i = 1; i <= w; i++) {\n            if (rec(0, w - i) != rec(0, w)) {\n                printf("%d\\n", w - i + 1);\n                break;\n            }\n        }\n        vec.clear();\n    }\n}')"

