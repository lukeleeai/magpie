LineLLMCrossover(('source.cpp', 8), '#include <cstdio>\n#include <algorithm>\n\nusing namespace std;\n\nint main() {\n    long long int num1, num2, gcd, res, lcm;\n\n    while (scanf("%lld%lld", &num1, &num2) == 2) {\n        if (num1 == 0 || num2 == 0) {\n            printf("GCD and LCM are undefined for zero input.\\n");\n            continue;\n        }\n        \n        res = num1 * num2;\n        while (num2 != 0) {\n            long long int temp = num2;\n            num2 = num1 % num2;\n            num1 = temp;\n        }\n        gcd = num1;\n        lcm = res / gcd;\n\n        printf("%lld %lld\\n", gcd, lcm);\n    }\n\n    return 0;\n}')
