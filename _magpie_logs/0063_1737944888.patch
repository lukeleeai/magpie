LineLLMMutation(('source.cpp', 21), '#include<cstdio>\n\n#include<algorithm>\n\nusing namespace std;\n\n\n\nlong long d[10],v[10];\n\n\n\nvoid compute(int n){\n\n    for(int i = 2 ; i <= min(d[n],v[n]) ; i++){\n\n        if(d[n]%i==0||v[n]%i==0){\n\n            while(d[n]%i==0&&v[n]%i==0){\n\n                d[n] /= i;\n\n                v[n] /= i;\n\n            }\n\n        }\n\n    }\n\n}\n\n\n\nint main(){\n\n    int n;\n\n\n\n    while(scanf("%d",&n),n){\n\n        long long a,b;\n\n        for(int i = 0 ; i < n ; i++){\n\n            scanf("%lld%lld",&d[i],&v[i]);\n\n            compute(i);\n\n        }\n\n\n\n        a = (d[0]*d[1])/__gcd(d[0],d[1]);\n\n        b = __gcd(v[0],v[1]);\n\n\n\n        for(int i = 2 ; i < n ; i++){\n\n            a = (a*d[i])/__gcd(a,d[i]);\n\n            b = __gcd(b,v[i]);\n\n        }\n\n\n\n        for(int i = 0 ; i < n ; i++){\n\n            printf("%lld\\n",a*v[i]/(b*d[i]));\n\n        }\n\n    }\n\n\n\n    return 0;\n\n}')
