LineLLMMutation(('source.cpp', 14), '#include <cstdio>\n#include <cmath>\n#include <algorithm>\n#include <array>\n#include <vector>\n\nusing namespace std;\n\nconst int MAXN = 31;\nconst int MAXSTATE = 65536;\n\narray<array<int, MAXSTATE>, MAXN> dp;\n\nvoid func(int N, int C) {\n    array<array<int, 16>, MAXN> beat;\n    array<array<int, 16>, MAXN> push;\n    int maximum = 0;\n\n    for (int i = 0; i < N; i++) {\n        for (int k = 0; k < 16; k++) scanf("%d", &beat[i][k]);\n    }\n\n    for (int i = 0; i < C; i++) {\n        for (int k = 0; k < 16; k++) scanf("%d", &push[i][k]);\n    }\n\n    int tmp, S, code;\n    array<int, 16> work[MAXN];\n    S = 1;\n    code = 0;\n    for (int i = 0; i < 16; i++) {\n        code += S * beat[0][i];\n        S *= 2;\n    }\n    dp[1][code] = 0;\n\n    for (int k = 0; k < C; k++) {\n        tmp = 0;\n        for (int p = 0; p < 16; p++) {\n            work[k][p] = beat[0][p];\n            if (work[k][p] == 1) {\n                if (push[k][p] == 1) {\n                    work[k][p] = 0;\n                    tmp++;\n                }\n            }\n        }\n\n        S = 1;\n        code = 0;\n        for (int i = 0; i < 16; i++) {\n            code += S * work[k][i];\n            S *= 2;\n        }\n        dp[1][code] = max(dp[1][code], tmp);\n        maximum = max(maximum, dp[1][code]);\n    }\n\n    for (int i = 1; i < N; i++) {\n        for (int state = 0; state < MAXSTATE; state++) {\n            if (dp[i][state] != -1) {\n                S = 1;\n                code = 0;\n                for (int loop = 0; loop < 16; loop++) {\n                    if (state & (1 << loop)) {\n                        code += S;\n                    } else {\n                        code += S * beat[i][loop];\n                    }\n                    S *= 2;\n                }\n                dp[i + 1][code] = dp[i][state];\n\n                for (int k = 0; k < C; k++) {\n                    tmp = 0;\n                    for (int p = 0; p < 16; p++) {\n                        if (state & (1 << p)) {\n                            if (push[k][p] == 1) {\n                                work[k][p] = 0;\n                                tmp++;\n                            } else {\n                                work[k][p] = 1;\n                            }\n                        } else {\n                            work[k][p] = beat[i][p];\n                            if (work[k][p] == 1) {\n                                if (push[k][p] == 1) {\n                                    work[k][p] = 0;\n                                    tmp++;\n                                }\n                            }\n                        }\n                    }\n\n                    S = 1;\n                    code = 0;\n                    for (int a = 0; a < 16; a++) {\n                        code += S * work[k][a];\n                        S *= 2;\n                    }\n                    dp[i + 1][code] = max(dp[i + 1][code], tmp + dp[i][state]);\n                }\n            }\n        }\n    }\n\n    for (int i = 0; i < MAXSTATE; i++) maximum = max(maximum, dp[N][i]);\n    printf("%d\\n", maximum);\n}\n\nint main() {\n    int N, C;\n\n    while (true) {\n        scanf("%d %d", &N, &C);\n        if (N == 0 && C == 0) break;\n\n        for (int i = 0; i <= N; i++) {\n            fill(dp[i].begin(), dp[i].end(), -1); // Reset dp array for each N.\n        }\n\n        func(N, C);\n    }\n\n    return 0;\n}') + LineLLMMutation(('source.cpp', 26), '#include <cstdio>\n#include <cmath>\n#include <algorithm>\n#include <array>\n#include <vector>\n#include <cstring> // Include for memset\n\nusing namespace std;\n\nconst int MAXN = 31;\nconst int MAXSTATE = 65536;\n\narray<array<int, MAXSTATE>, MAXN> dp;\n\nvoid func(int N, int C) {\n    array<array<int, 16>, MAXN> beat;\n    array<array<int, 16>, MAXN> push;\n    int maximum = 0;\n\n    // Read beat data\n    for (int i = 0; i < N; i++) {\n        sca