2025-02-24 20:39:20,163	[DEBUG]	patch(1-1)="LineLLMMutation(('source.cpp', 0), '#include <cstdio>\n#include <vector>\n#include <queue>\n#include <algorithm>\n\nusing namespace std;\n\ntypedef pair<int, int> pii;\nconst int inf = 1e9;\nconst int maxn = 100;\n\nstruct edge {\n    int to, cost, time;\n    edge(int to0, int cost0, int time0) : to(to0), cost(cost0), time(time0) {}\n};\n\nvector<edge> G[maxn];\nint d[maxn];\n\nvoid dijkstra(int s, int mode) {\n    priority_queue<pii, vector<pii>, greater<pii>> q;\n    fill(d, d + maxn, inf);\n    d[s] = 0;\n    q.push({0, s});\n    \n    while (!q.empty()) {\n        pii p = q.top(); q.pop();\n        int v = p.second;\n        for (const auto& e : G[v]) {\n            int a = mode == 0 ? e.cost : e.time;\n            if (d[e.to] > d[v] + a) {\n                d[e.to] = d[v] + a;\n                q.push({d[e.to], e.to});\n            }\n        }\n    }\n}\n\nsigned main() {\n    int N, M;\n    while (scanf("%d %d", &N, &M), N || M) {\n        for (int i = 0; i < M; ++i) G[i].clear();\n        for (int i = 0; i < N; ++i) {\n            int a, b, cost, time; scanf("%d %d %d %d", &a, &b, &cost, &time); a--; b--;\n            G[a].emplace_back(b, cost, time);\n            G[b].emplace_back(a, cost, time);\n        }\n        int K; scanf("%d", &K);\n        for (int i = 0; i < K; ++i) {\n            int p, q, r; scanf("%d %d %d", &p, &q, &r); p--; q--;\n            dijkstra(p, r);\n            printf("%d\\n", d[q]);\n        }\n    }\n}')"

