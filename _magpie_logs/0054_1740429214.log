ector<int> heap;\n    heap.push_back(s);\n\n    while (!heap.empty()) {\n        // Extract the minimum element (simple linear search for demonstration; can be optimized further)\n        int v = heap[0];\n        heap.erase(heap.begin()); // Remove the first element\n        visited[v] = true;\n\n        for (const auto& e : G[v]) {\n            if (visited[e.to]) continue; // Skip visited nodes\n            int a = mode == 0 ? e.cost : e.time;\n            if (d[e.to] > d[v] + a) {\n                d[e.to] = d[v] + a;\n                heap.push_back(e.to);\n                // Simple insertion sort to maintain order (can be replaced by a more efficient method)\n                sort(heap.begin(), heap.end(), [&](int lhs, int rhs) {\n                    return d[lhs] > d[rhs]; // Min-heap property\n                });\n            }\n        }\n    }\n}\n\nsigned main() {\n    int N, M;\n    while (cin >> N >> M, N || M) {\n        for (int i = 0; i < M; ++i) G[i].clear();\n        for (int i = 0; i < N; ++i) {\n            int a, b, cost, time; cin >> a >> b >> cost >> time; a--; b--;\n            G[a].emplace_back(b, cost, time);\n            G[b].emplace_back(a, cost, time);\n        }\n        int K; cin >> K;\n        for (int i = 0; i < K; ++i) {\n            int p, q, r; cin >> p >> q >> r; p--; q--;\n            dijkstra(p, r);\n            cout << d[q] << endl;\n        }\n    }\n}')"
