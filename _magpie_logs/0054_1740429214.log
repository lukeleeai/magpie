n                d[e.to] = d[v] + a;\n\n                q.push(MP(d[e.to], e.to));\n\n            }\n\n        }\n\n    }\n\n}\n\n\n\nsigned main()\n\n{\n\n    ios::sync_with_stdio(false);\n\n    cin.tie(0);\n\n\n\n    while (cin >> N >> M, N || M) {\n\n        rep(i, M) G[i].clear();\n\n\n\n        rep(i, N) {\n\n            int a, b, cost, time; cin >> a >> b >> cost >> time; a--; b--;\n\n            G[a].PB(edge(b, cost, time));\n\n            G[b].PB(edge(a, cost, time));\n\n        }\n\n\n\n        int K; cin >> K;\n\n\n\n        rep(i, K) {\n\n            int p, q, r; cin >> p >> q >> r; p--; q--;\n\n            dijkstra(p, r);\n\n            cout << d[q] << endl;\n\n        }\n\n    }\n\n}')"
