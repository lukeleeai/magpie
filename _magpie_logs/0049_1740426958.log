2025-02-24 19:57:43,078	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include <iostream>\n#include <vector>\n#include <algorithm>\nusing namespace std;\n\ntypedef long long LL;\n#define N 2010\n#define INF 0x3f3f3f\n\nint n;\nint maps[N][N];\nint dist[N], vis[N];\n\nvoid Init(int m) {\n    for (int i = 0; i <= m; i++)\n        for (int j = 0; j <= m; j++)\n            maps[i][j] = (i == j) ? 0 : INF;\n}\n\nvoid dij(int s, int m) {\n    for (int i = 0; i <= m; i++)\n        dist[i] = maps[s][i];\n\n    fill(vis, vis + m + 1, 0);\n    vis[s] = 1;\n\n    for (int i = 0; i <= m; i++) {\n        int Min = INF, index = -1;\n        for (int j = 0; j <= m; j++) {\n            if (!vis[j] && dist[j] < Min) {\n                Min = dist[j];\n                index = j;\n            }\n        }\n        if (index == -1) continue;\n        vis[index] = 1;\n        for (int j = 0; j <= m; j++) {\n            if (!vis[j] && dist[j] > Min + maps[index][j])\n                dist[j] = Min + maps[index][j];\n        }\n    }\n}\n\nint main() {\n    int a, b, c, Max, index, sum;\n    while (cin >> n, n) {\n        Init(1100);\n        Max = -1;\n        for (int i = 1; i <= n; i++) {\n            cin >> a >> b >> c;\n            maps[a][b] = maps[b][a] = min(maps[a][b], c);\n            Max = max(Max, max(a, b));\n        }\n        int s;\n        sum = INF;\n        for (int i = 0; i <= Max; i++) {\n            dij(i, Max);\n            s = 0;\n            for (int j = 0; j <= Max; j++)\n                s += dist[j];\n            if (s < sum) {\n                index = i;\n                sum = s;\n            }\n        }\n        cout << index << " " << sum << endl;\n    }\n    return 0;\n}')"
