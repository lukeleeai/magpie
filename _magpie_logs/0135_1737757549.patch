LineLLMCrossover(('source.cpp', 33), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\n\nint main() {\n    int n, k;\n    int x[101][101], y[101][101], h[101], h2[101][201];\n    bool s[101] = {false};\n\n    while (scanf("%d %d", &n, &k), n || k) {\n        memset(x, 127, sizeof(x));\n        memset(s, false, sizeof(s));\n        memset(h, 0, sizeof(h));\n        int sum = 1000000000;\n\n        for (int i = 0; i < k; i++) {\n            memset(y, 127, sizeof(y));\n            sum = 1000000000;\n            int a;\n            scanf("%d", &a);\n\n            if (a == 0) {\n                int b, c;\n                scanf("%d %d", &b, &c);\n                y[0][b] = 0;\n\n                if (s[c] && s[b]) {\n                    for (int j = 1; j <= n; j++) {\n                        for (int l = 1; l <= n; l++) {\n                            if (y[j - 1][l] < 100000000) {\n                                for (int m = 1; m <= h[l]; m++) {\n                                    y[j][h2[l][m]] = min(y[j][h2[l][m]], y[j - 1][l] + x[l][h2[l][m]]);\n                                }\n                            }\n                        }\n                    }\n                }\n\n                for (int j = 1; j <= n; j++) {\n                    sum = min(sum, y[j][c]);\n                }\n                printf("%d\\n", sum >= 1000000000 ? -1 : sum);\n            }\n\n            if (a == 1) {\n                int b, c, d;\n                scanf("%d %d %d", &b, &c, &d);\n                x[b][c] = min(x[b][c], d);\n                x[c][b] = min(x[c][b], d);\n                s[c] = true;\n                s[b] = true;\n                h[b]++;\n                h[c]++;\n                h2[b][h[b]] = c;\n                h2[c][h[c]] = b;\n            }\n        }\n    }\n    return 0;\n}')
