a(int s, int mode)\n\n{\n\n    priority_queue<pair<int, int>, vector<pair<int, int>>, greater<pair<int, int>>> q;\n\n\n\n    fill(d, d + m, 1e9);\n\n    d[s] = 0;\n\n\n\n    q.push({0, s});\n\n\n\n    while (q.size()) {\n\n        pair<int, int> p = q.top(); q.pop();\n\n        int v = p.second;\n\n        for (const auto& e : g[v]) {\n\n            int a = mode == 0 ? e.cost : e.time;\n\n            if (d[e.to] > d[v] + a) {\n\n                d[e.to] = d[v] + a;\n\n                q.push({d[e.to], e.to});\n\n            }\n\n        }\n\n    }\n\n}\n\n\n\nint main()\n\n{\n\n    scanf("%d%d", &n, &m);\n\n    while (n || m) {\n\n        for (int i = 0; i < m; ++i) g[i].clear();\n\n\n\n        for (int i = 0; i < n; ++i) {\n\n            int a, b, cost, time; scanf("%d%d%d%d", &a, &b, &cost, &time); a--; b--;\n\n            g[a].emplace_back(b, cost, time);\n\n            g[b].emplace_back(a, cost, time);\n\n        }\n\n\n\n        int k; scanf("%d", &k);\n\n\n\n        for (int i = 0; i < k; ++i) {\n\n            int p, q, r; scanf("%d%d%d", &p, &q, &r); p--; q--;\n\n            dijkstra(p, r);\n\n            printf("%d\\n", d[q]);\n\n        }\n\n        scanf("%d%d", &n, &m);\n\n    }\n\n}')"

