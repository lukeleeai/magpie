2025-01-27 01:50:50,945	[DEBUG]	patch(0-9)="LineLLMMutation(('source.cpp', 8), '#include <cstdio>\n\n#include <queue>\n\n\n\nusing namespace std;\n\n\n\nint N, M;\n\n\n\nstruct path {\n\n    int to, cost, time;\n\n    path(int to0,int cost0,int time0) {\n\n        to = to0; cost = cost0; time = time0;\n\n    };\n\n};\n\n\n\nvector<path> G[100];\n\nint d[100];\n\n\n\nvoid find_shortest_path(int s, int mode)\n\n{\n\n    priority_queue<pii, vector<pii>, greater<pii> > q;\n\n\n\n    fill(d, d + M, inf);\n\n    d[s] = 0;\n\n\n\n    q.push(MP(0, s));\n\n\n\n    while (q.size()) {\n\n        pii p = q.top(); q.pop();\n\n        int v = p.scd;\n\n        rep(u, G[v].size()) {\n\n            path e = G[v][u];\n\n            int a = mode == 0 ? e.cost : e.time;\n\n            if (d[e.to] > d[v] + a) {\n\n                d[e.to] = d[v] + a;\n\n                q.push(MP(d[e.to], e.to));\n\n            }\n\n        }\n\n    }\n\n}\n\n\n\nsigned main()\n\n{\n\n    ios::sync_with_stdio(false);\n\n    cin.tie(0);\n\n\n\n    while (cin >> N >> M, N || M) {\n\n        rep(i, M) G[i].clear();\n\n\n\n        rep(i, N) {\n\n            int a, b, cost, time; cin >> a >> b >> cost >> time; a--; b--;\n\n            G[a].PB(path(b, cost, time));\n\n            G[b].PB(path(a, cost, time));\n\n        }\n\n\n\n        int K; cin >> K;\n\n\n\n        rep(i, K) {\n\n            int p, q, r; cin >> p >> q >> r; p--; q--;\n\n            find_shortest_path(p, r);\n\n            cout << d[q] << endl;\n\n        }\n\n    }\n\n}')"
