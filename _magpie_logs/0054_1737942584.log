kstra(int startNode, int mode)\n\n{\n\n    priority_queue<pair<int, int>, vector<pair<int, int>>, greater<pair<int, int>>> priorityQueue;\n\n\n\n    fill(distances, distances + edgeCount, 1e9);\n\n    distances[startNode] = 0;\n\n\n\n    priorityQueue.push({0, startNode});\n\n\n\n    while (priorityQueue.size()) {\n\n        pair<int, int> p = priorityQueue.top(); priorityQueue.pop();\n\n        int currentNode = p.second;\n\n        for (int i = 0; i < graph[currentNode].size(); ++i) {\n\n            Edge e = graph[currentNode][i];\n\n            int weight = mode == 0 ? e.cost : e.time;\n\n            if (distances[e.to] > distances[currentNode] + weight) {\n\n                distances[e.to] = distances[currentNode] + weight;\n\n                priorityQueue.push({distances[e.to], e.to});\n\n            }\n\n        }\n\n    }\n\n}\n\n\n\nint main()\n\n{\n\n    scanf("%d%d", &nodeCount, &edgeCount);\n\n    while (nodeCount || edgeCount) {\n\n        for(int i = 0; i < edgeCount; ++i) graph[i].clear();\n\n\n\n        for(int i = 0; i < nodeCount; ++i) {\n\n            int a, b, cost, time; scanf("%d%d%d%d", &a, &b, &cost, &time); a--; b--;\n\n            graph[a].push_back(Edge(b, cost, time));\n\n            graph[b].push_back(Edge(a, cost, time));\n\n        }\n\n\n\n        int K; scanf("%d", &K);\n\n\n\n        for(int i = 0; i < K; ++i) {\n\n            int p, q, r; scanf("%d%d%d", &p, &q, &r); p--; q--;\n\n            dijkstra(p, r);\n\n            printf("%d\\n", distances[q]);\n\n        }\n\n        scanf("%d%d", &nodeCount, &edgeCount);\n\n    }\n\n    return 0;\n\n}')"
