LineLLMCrossover(('source.cpp', 9), '#include <cstdio>\n\n#include <queue>\n\nusing namespace std;\n\n\n\nstruct Edge {\n\n    int to, cost, time;\n\n    Edge(int to0,int cost0,int time0) {\n\n        to = to0; cost = cost0; time = time0;\n\n    };\n\n};\n\n\n\nint n, m;\n\n\n\nvector<Edge> g[100];\n\nint d[100];\n\n\n\nvoid dijkstra(int s, int mode)\n\n{\n\n    priority_queue<pair<int, int>, vector<pair<int, int>>, greater<pair<int, int>>> q;\n\n\n\n    fill(d, d + m, 1e9);\n\n    d[s] = 0;\n\n\n\n    q.push({0, s});\n\n\n\n    while (q.size()) {\n\n        pair<int, int> p = q.top(); q.pop();\n\n        int v = p.second;\n\n        for (int u = 0; u < g[v].size(); ++u) {\n\n            Edge e = g[v][u];\n\n            int a = mode == 0 ? e.cost : e.time;\n\n            if (d[e.to] > d[v] + a) {\n\n                d[e.to] = d[v] + a;\n\n                q.push({d[e.to], e.to});\n\n            }\n\n        }\n\n    }\n\n}\n\n\n\nint main()\n\n{\n\n    scanf("%d%d", &n, &m);\n\n    while (n || m) {\n\n        for (int i = 0; i < m; ++i) g[i].clear();\n\n\n\n        for (int i = 0; i < n; ++i) {\n\n            int a, b, cost, time; scanf("%d%d%d%d", &a, &b, &cost, &time); a--; b--;\n\n            g[a].push_back(Edge(b, cost, time));\n\n            g[b].push_back(Edge(a, cost, time));\n\n        }\n\n\n\n        int k; scanf("%d", &k);\n\n\n\n        for (int i = 0; i < k; ++i) {\n\n            int p, q, r; scanf("%d%d%d", &p, &q, &r); p--; q--;\n\n            dijkstra(p, r);\n\n            printf("%d\\n", d[q]);\n\n        }\n\n        scanf("%d%d", &n, &m);\n\n    }\n\n}') + LineLLMMutation(('source.cpp', 27), '#include <cstdio>\n\n#include <vector>\n\n#include <functional>\n\nusing namespace std;\n\n\n\nstruct Edge {\n\n    int to, cost, time;\n\n    Edge(int to0,int cost0,int time0) {\n\n        to = to0; cost = cost0; time = time0;\n\n    };\n\n};\n\n\n\nint n, m;\n\n\n\nvector<Edge> g[100];\n\nint d[100];\n\n\n\nvoid dijkstra(int s, int mode)\n\n{\n\n    const int