2025-01-27 01:52:36,518	[DEBUG]	patch(2-1)="LineLLMMutation(('source.cpp', 10), '#include <cstdio>\n#include <queue>\nusing namespace std;\n\nstruct edge {\n\n    int to, cost, time;\n\n    edge(int to0,int cost0,int time0) {\n\n        to = to0; cost = cost0; time = time0;\n\n    };\n\n};\n\n\n\nint N, M;\n\n\n\nvector<edge> G[100];\n\nint d[100];\n\n\n\nvoid dijkstra(int s, int mode)\n\n{\n\n    priority_queue<pair<int, int>, vector<pair<int, int>>, greater<pair<int, int>>> q;\n\n\n\n    fill(d, d + M, 1e9);\n\n    d[s] = 0;\n\n\n\n    q.push({0, s});\n\n\n\n    while (q.size()) {\n\n        pair<int, int> p = q.top(); q.pop();\n\n        int v = p.second;\n\n        for (int u = 0; u < G[v].size(); ++u) {\n\n            edge e = G[v][u];\n\n            int a = mode == 0 ? e.cost : e.time;\n\n            if (d[e.to] > d[v] + a) {\n\n                d[e.to] = d[v] + a;\n\n                q.push({d[e.to], e.to});\n\n            }\n\n        }\n\n    }\n\n}\n\n\n\nint main()\n\n{\n\n    scanf("%d%d", &N, &M);\n\n    while (N || M) {\n\n        for(int i = 0; i < M; ++i) G[i].clear();\n\n\n\n        for(int i = 0; i < N; ++i) {\n\n            int a, b, cost, time; scanf("%d%d%d%d", &a, &b, &cost, &time); a--; b--;\n\n            G[a].push_back(edge(b, cost, time));\n\n            G[b].push_back(edge(a, cost, time));\n\n        }\n\n\n\n        int K; scanf("%d", &K);\n\n\n\n        for(int i = 0; i < K; ++i) {\n\n            int p, q, r; scanf("%d%d%d", &p, &q, &r); p--; q--;\n\n            dijkstra(p, r);\n\n            printf("%d\\n", d[q]);\n\n        }\n\n        scanf("%d%d", &N, &M);\n\n    }\n\n    return 0;\n\n}')"

