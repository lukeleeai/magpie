LineLLMCrossover(('source.cpp', 12), '#include <cstdio>\n#include <algorithm>\n\nusing namespace std;\n\nint main() {\n    int b, a;\n\n    while (true) {\n        if (scanf("%d", &b) != 1 || b == 0) break; // Improved input validation\n\n        int current_sum = 0, max_sum = 0;\n        for (int i = 0; i < b; i++) {\n            scanf("%d", &a);\n            current_sum += a;\n            max_sum = max(max_sum, current_sum);\n            if (current_sum < 0) current_sum = 0; // Reset on negative sum\n        }\n\n        printf("%d\\n", max_sum);\n    }\n}')
