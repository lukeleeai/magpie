lude <iostream>\n#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\ntypedef long long ll;\n\nconst int MAXN = 100005; // Define a constant for maximum size\n\nint main() {\n    int d;\n    while (scanf("%d", &d), d) {\n        int n, m;\n        scanf("%d%d", &n, &m); // Combined input for n and m\n        int x[MAXN]; // Use a fixed-size array\n        x[0] = 0;\n        \n        // Combined input for x\n        for (int i = 1; i < n; i++) {\n            scanf("%d", &x[i]);\n        }\n        \n        int c[MAXN]; // Use a fixed-size array\n        for (int i = 0; i < m; i++) {\n            scanf("%d", &c[i]);\n        }\n\n        // We can sort the array using a fixed size\n        int p[MAXN + 1]; // Array for sorting\n        copy(x, x + n, p);\n        p[n] = d; // Add d to the end\n        sort(p, p + n + 1); // Sort the array\n\n        ll res = 0;\n        for (int i = 0; i < m; i++) {\n            auto lb = lower_bound(p, p + n + 1, c[i]);\n            if (c[i] != 0) res += min(*lb - c[i], c[i] - *(lb - 1));\n        }\n        cout << res << endl;\n    }\n}')"
