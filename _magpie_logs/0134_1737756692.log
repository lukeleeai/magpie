2025-01-24 22:19:41,603	[DEBUG]	patch(4-3)="LineLLMCrossover(('source.cpp', 12), '#include <iostream>\n#include <vector>\n#include <limits>\n#include <queue>\nusing namespace std;\n\nconst int MAX = 100000000;\nconst int Is = 110;\n\nint dik(int s, int g, const vector<vector<int>>& map) {\n    vector<int> cost(Is, MAX);\n    vector<bool> visited(Is, false);\n    cost[s] = 0;\n    priority_queue<pair<int, int>, vector<pair<int, int>>, greater<pair<int, int>>> pq;\n    pq.push({0, s});\n\n    while (!pq.empty()) {\n        auto [current_cost, current_node] = pq.top();\n        pq.pop();\n\n        if (visited[current_node]) continue;\n        visited[current_node] = true;\n\n        for (int j = 0; j < Is; j++) {\n            if (map[current_node][j] != MAX && !visited[j]) {\n                if (cost[j] > current_cost + map[current_node][j]) {\n                    cost[j] = current_cost + map[current_node][j];\n                    pq.push({cost[j], j});\n                }\n            }\n        }\n    }\n    return cost[g] == MAX ? -1 : cost[g]; // Return -1 if not reachable\n}\n\nint main() {\n    int n, k, req, a, b, c, d, e, ans;\n    while (cin >> n >> k, n != 0 || k != 0) {\n        vector<vector<int>> map(Is, vector<int>(Is, MAX));\n\n        while (k--) {\n            cin >> req;\n            if (req) {\n                cin >> c >> d >> e;\n                if (e < map[c][d]) map[c][d] = map[d][c] = e;\n            } else {\n                cin >> a >> b;\n                if ((ans = dik(a, b, map)) != MAX) cout << ans << endl;\n                else cout << "-1" << endl;\n            }\n        }\n    }\n    return 0;\n}')"
