2025-01-24 22:16:09,510	[DEBUG]	patch(1-1)="LineLLMMutation(('source.cpp', 7), '#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <limits>\nusing namespace std;\n\nconst int MAX = 100000000;\nconst int Is = 110;\n\nint dik(int s, int g, int n, const vector<vector<int>>& map) {\n    vector<int> cost(Is, MAX);\n    vector<bool> visited(Is, false);\n    cost[s] = 0;\n\n    for (int i = 0; i < n; i++) {\n        int min_cost = MAX + 1, min_index = -1;\n        for (int j = 0; j < Is; j++) {\n            if (!visited[j] && cost[j] < min_cost) {\n                min_cost = cost[j];\n                min_index = j;\n            }\n        }\n        if (min_index == -1) break;\n        visited[min_index] = true;\n\n        for (int j = 0; j < Is; j++) {\n            if (map[min_index][j] != MAX && cost[j] > cost[min_index] + map[min_index][j]) {\n                cost[j] = cost[min_index] + map[min_index][j];\n            }\n        }\n    }\n    return cost[g];\n}\n\nint main() {\n    int n, k, req, a, b, c, d, e, ans;\n    while (scanf("%d %d", &n, &k), n != 0 || k != 0) {\n        vector<vector<int>> map(Is, vector<int>(Is, MAX));\n        \n        while (k--) {\n            scanf("%d", &req);\n            if (req) {\n                scanf("%d %d %d", &c, &d, &e);\n                if (e < map[c][d]) map[c][d] = map[d][c] = e;\n            } else {\n                scanf("%d %d", &a, &b);\n                if ((ans = dik(a, b, n, map)) != MAX) printf("%d\\n", ans);\n                else printf("-1\\n");\n            }\n        }\n    }\n    return 0;\n}')"
