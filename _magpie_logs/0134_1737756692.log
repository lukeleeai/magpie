ctor\n\nint dik(int s, int g) {\n    vector<int> cost(Is, MAX);\n    cost[s] = 0;\n    priority_queue<pair<int, int>, vector<pair<int, int>>, greater<pair<int, int>>> pq;\n    pq.push({0, s}); // {cost, node}\n\n    while (!pq.empty()) {\n        auto [current_cost, current_node] = pq.top();\n        pq.pop();\n\n        if (current_cost > cost[current_node]) continue;\n\n        for (int j = 0; j < Is; j++) {\n            if (map[current_node][j] != MAX) {\n                int new_cost = cost[current_node] + map[current_node][j];\n                if (new_cost < cost[j]) {\n                    cost[j] = new_cost;\n                    pq.push({new_cost, j}); // Push the updated cost and node into the priority queue\n                }\n            }\n        }\n    }\n    return cost[g] == MAX ? -1 : cost[g]; // Return -1 if not reachable\n}\n\nint main() {\n    int n, k, req, a, b, c, d, e, ans;\n    while (cin >> n >> k, n != 0 || k != 0) {\n        fill(&map[0][0], &map[0][0] + sizeof(map) / sizeof(map[0][0]), MAX); // Initialize the map\n\n        while (k--) {\n            cin >> req;\n            if (req) {\n                cin >> c >> d >> e;\n                if (e < map[c][d]) {\n                    map[c][d] = e;\n                    map[d][c] = e; // Ensure undirected graph property\n                }\n            } else {\n                cin >> a >> b;\n                if ((ans = dik(a, b)) != MAX) cout << ans << endl;\n                else cout << "-1" << endl;\n            }\n        }\n    }\n    return 0;\n}')"
