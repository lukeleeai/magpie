2025-01-24 22:14:42,247	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include <iostream>\n#include <vector>\nusing namespace std;\n\nconst int MAX = 100000000;\nconst int Is = 110;\n\nint n, k, req, a, b, c, d, e, i, j, map[Is][Is], ans;\n\nint dik(int s, int g) {\n    vector<int> cost(Is, MAX), f(Is, 0);\n    cost[s] = 0;\n\n    for (i = 0; i < Is; i++) {\n        f[s] = 1;\n        for (j = 0; j < Is; j++) \n            if (!f[j] && map[s][j] != MAX && cost[j] > cost[s] + map[s][j]) \n                cost[j] = cost[s] + map[s][j];\n\n        int min = MAX + 1;\n        for (j = 0; j < Is; j++) \n            if (!f[j] && min > cost[j]) \n                min = cost[s = j];\n    }\n    return cost[g];\n}\n\nint main() {\n    while (cin >> n >> k, n != 0 || k != 0) {\n        for (i = 0; i < Is; i++) {\n            for (j = 0; j < Is; j++) {\n                map[i][j] = MAX;\n            }\n        }\n\n        while (k--) {\n            cin >> req;\n            if (req) {\n                cin >> c >> d >> e;\n                if (e < map[c][d]) map[c][d] = map[d][c] = e;\n            } else {\n                cin >> a >> b;\n                if ((ans = dik(a, b)) != MAX) cout << ans << endl;\n                else cout << "-1" << endl;\n            }\n        }\n    }\n    return 0;\n}')"

