2025-01-24 22:25:35,560	[DEBUG]	patch(9-6)="LineLLMCrossover(('source.cpp', 35), '#include <iostream>\n#include <limits>\n#include <queue>\nusing namespace std;\n\nconst int MAX = 100000000;\nconst int Is = 110;\n\nint dik(int s, int g, const int map[Is][Is]) {\n    int cost[Is];\n    fill(cost, cost + Is, MAX);\n    priority_queue<pair<int, int>, vector<pair<int, int>>, greater<pair<int, int>>> pq;\n    cost[s] = 0;\n    pq.push({0, s}); // {cost, node}\n\n    while (!pq.empty()) {\n        auto [current_cost, current_node] = pq.top();\n        pq.pop();\n\n        if (current_cost > cost[current_node]) continue;\n\n        for (int j = 0; j < Is; j++) {\n            if (map[current_node][j] != MAX) {\n                int new_cost = current_cost + map[current_node][j];\n                if (cost[j] > new_cost) {\n                    cost[j] = new_cost;\n                    pq.push({new_cost, j});\n                }\n            }\n        }\n    }\n    return cost[g] == MAX ? -1 : cost[g];\n}\n\nint main() {\n    int n, k, req, a, b, c, d, e, ans;\n    while (cin >> n >> k, n != 0 || k != 0) {\n        int map[Is][Is];\n        fill(&map[0][0], &map[0][0] + sizeof(map) / sizeof(int), MAX); // Efficient initialization\n\n        while (k--) {\n            cin >> req;\n            if (req) {\n                cin >> c >> d >> e;\n                if (e < map[c][d]) {\n                    map[c][d] = e;\n                    map[d][c] = e; // Ensure undirected graph property\n                }\n            } else {\n                cin >> a >> b;\n                if ((ans = dik(a, b, map)) != MAX) cout << ans << endl;\n                else cout << "-1" << endl;\n            }\n        }\n    }\n    return 0;\n}')"
