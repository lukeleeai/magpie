2025-01-24 22:24:17,601	[DEBUG]	patch(8-4)="LineLLMCrossover(('source.cpp', 29), '#include <iostream>\n#include <vector>\n#include <limits>\n#include <queue>\n#include <functional>\nusing namespace std;\n\nconst int MAX = 100000000;\nconst int Is = 110;\n\nint dik(int s, int g, const vector<vector<int>>& map) {\n    vector<int> cost(Is, MAX);\n    cost[s] = 0;\n    priority_queue<pair<int, int>, vector<pair<int, int>>, greater<pair<int, int>>> pq;\n    pq.emplace(0, s); // {cost, node}\n\n    while (!pq.empty()) {\n        auto [min_cost, min_index] = pq.top();\n        pq.pop();\n\n        if (min_cost > cost[min_index]) continue; // Skip if we have found a better cost already\n\n        for (int j = 0; j < Is; j++) {\n            if (map[min_index][j] != MAX) {\n                int new_cost = cost[min_index] + map[min_index][j];\n                if (new_cost < cost[j]) {\n                    cost[j] = new_cost;\n                    pq.emplace(new_cost, j); // Push the updated cost and node into the priority queue\n                }\n            }\n        }\n    }\n    return cost[g] == MAX ? -1 : cost[g]; // Return -1 if not reachable\n}\n\nint main() {\n    int n, k, req, a, b, c, d, e, ans;\n    while (cin >> n >> k, n != 0 || k != 0) {\n        vector<vector<int>> map(Is, vector<int>(Is, MAX));\n        \n        while (k--) {\n            cin >> req;\n            if (req) {\n                cin >> c >> d >> e;\n                map[c][d] = map[d][c] = min(map[c][d], e); // Use min directly\n            } else {\n                cin >> a >> b;\n                if ((ans = dik(a, b, map)) != MAX) cout << ans << endl;\n                else cout << "-1" << endl;\n            }\n        }\n    }\n    return 0;\n}')"
