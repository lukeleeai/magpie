LineLLMCrossover(('source.cpp', 13), '#include <cstdio>\n#include <cstring>\nusing namespace std;\n\nint main() {\n    unsigned int s[10] = {0}, a;\n    int n;\n    char output[100] = "";\n\n    while (true) {\n        scanf("%d", &n);\n        if (n == 0) break;\n\n        for (int i = 0; i < n; i++) {\n            scanf("%d", &a);\n            s[a]++;\n        }\n\n        for (int i = 0; i < 10; i++) {\n            if (s[i] == 0) {\n                strcat(output, "-\\n");\n            } else {\n                for (unsigned int j = 0; j < s[i]; j++) {\n                    strcat(output, "*");\n                }\n                strcat(output, "\\n");\n            }\n            s[i] = 0;\n        }\n        printf("%s", output); // Print all at once\n        output[0] = \'\\0\'; // Reset output buffer for the next input\n    }\n    return 0;\n}')
