LineLLMCrossover(('source.cpp', 34), '#include <cstdio>\nusing namespace std;\n\nint t[10][10], u[10][10], ans[10][10], n, flg;\n\nint compute();\nvoid change(int, int);\n\nint main() {\n    scanf("%d", &n);\n    while (n--) {\n        flg = 0;\n        for (int i = 0; i < 10; i++) {\n            for (int j = 0; j < 10; j++) {\n                scanf("%d", &t[i][j]);\n                ans[i][j] = 0;\n            }\n        }\n        for (int mask = 0; mask < (1 << 10); ++mask) {\n            for (int i = 0; i < 10; ++i) {\n                ans[0][i] = (mask & (1 << i)) ? 1 : 0;\n            }\n            if (compute()) {\n                for (int i = 0; i < 10; i++) {\n                    for (int j = 0; j < 10; j++) {\n                        if (j) printf(" ");\n                        printf("%d", ans[i][j]);\n                    }\n                    printf("\\n");\n                }\n                break;\n            }\n        }\n    }\n    return 0;\n}\n\nint compute() {\n    for (int i = 0; i < 10; i++) {\n        for (int j = 0; j < 10; j++) {\n            u[i][j] = t[i][j];\n            if (i) ans[i][j] = 0; // Maintain previous logic\n        }\n    }\n    for (int i = 0; i < 10; i++) {\n        if (ans[0][i]) change(0, i);\n    }\n    for (int i = 1; i < 10; i++) {\n        for (int j = 0; j < 10; j++) {\n            if (u[i - 1][j]) {\n                ans[i][j] = 1;\n                change(i, j);\n            }\n        }\n    }\n    for (int i = 0; i < 10; i++) {\n        if (u[9][i]) return 0; // Check if last row has active cells\n    }\n    return 1; // No active cells found\n}\n\nvoid change(int y, int x) {\n    u[y][x] = !u[y][x];\n    if (y > 0) u[y - 1][x] = !u[y - 1][x];\n    if (x > 0) u[y][x - 1] = !u[y][x - 1];\n    if (y < 9) u[y + 1][x] = !u[y + 1][x];\n    if (x < 9) u[y][x + 1] = !u[y][x + 1];\n}')
