LineLLMCrossover(('source.cpp', 29), '#include <cstdio>\n#include <algorithm>\n\nusing namespace std;\n\nlong long d[10], v[10];\n\n// Optimized GCD function using the Euclidean algorithm\nlong long gcd(long long a, long long b) {\n    return b == 0 ? a : gcd(b, a % b); // Recursive GCD\n}\n\nvoid compute(int n) {\n    long long gcd_dv = gcd(d[n], v[n]); // Calculate GCD once\n    d[n] /= gcd_dv; // Reduce d[n] by GCD\n    v[n] /= gcd_dv; // Reduce v[n] by GCD\n}\n\nint main() {\n    int n;\n    while (scanf("%d", &n), n) {\n        long long a = 1, b = 0; // Initialize for LCM and GCD\n        for (int i = 0; i < n; i++) {\n            scanf("%lld %lld", &d[i], &v[i]); // using scanf for faster input\n            compute(i);\n            if (i == 0) {\n                a = d[i];\n                b = v[i];\n            } else {\n                a = (a * d[i]) / gcd(a, d[i]); // Use calculated GCD\n                b = gcd(b, v[i]);\n            }\n        }\n        for (int i = 0; i < n; i++) {\n            printf("%lld\\n", a * v[i] / (b * d[i])); // using printf for faster output\n        }\n    }\n    return 0;\n}')
