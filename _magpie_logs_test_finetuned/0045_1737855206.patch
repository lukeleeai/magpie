LineLLMCrossover(('source.cpp', 10), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\ntypedef long long ll;\n\nll n, ans, r = 0, g = 0, b = 0;\nchar s[4010];\n\nint main() {\n    scanf("%lld", &n);\n    scanf("%s", s + 1);\n\n    for (int i = 1; i <= n; i++) {\n        if (s[i] == \'R\') r++;\n        if (s[i] == \'G\') g++;\n        if (s[i] == \'B\') b++;\n    }\n\n    ans = r * g * b; // Initial count of all combinations\n    for (int len = 1; len <= n; len++) {\n        for (int j = 1; j <= n - 2 * len; j++) {\n if (s[j] != s[j + len] && s[j] != s[j + 2 * len] && s[j + len] != s[j + 2 * len])\n     ans--;\n        }\n    }\n\n    printf("%lld\\n", ans);\n    return 0;\n}')
