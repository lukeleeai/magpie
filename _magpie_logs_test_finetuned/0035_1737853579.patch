LineLLMMutation(('source.cpp', 6), '#include <cstdio>\n#include <cstring>\nusing namespace std;\n\nint main() {\n    long long n, z = 0, r = 0, g = 0, b = 0;\n    scanf("%lld", &n);\n    char s[n + 1];\n    scanf("%s", s);\n    for (long long i = 0; i < n; i++) {\n        if (s[i] == \'R\') {\n z += g * b;\n r++;\n        } else if (s[i] == \'G\') {\n z += r * b;\n g++;\n        } else if (s[i] == \'B\') {\n z += r * g;\n b++;\n        }\n    }\n    for (long long o = 3; o - 1 < n; o += 2) {\n        for (long long i = o - 1; i < n; i++) {\n if (s[i] != s[i - o + 1] && s[i - o + 1] != s[i - o / 2] && s[i - o / 2] != s[i])\n     z--;\n        }\n    }\n    printf("%lld\\n", z);\n    return 0;\n}')
