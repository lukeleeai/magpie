LineLLMCrossover(('source.cpp', 13), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\n\ntypedef long long ll;\n\nconst int N = 1e5 + 5;\n\nint n, m, a[N], mem[N];\n\nint solve(int i = 0) {\n    if (i >= n) return 1e9;\n    if (i == n - 1) return 0;\n\n    if (mem[i] != -1) return mem[i];\n\n    mem[i] = 1e9;\n    for (int j = 1; j <= m && i + j < n; ++j)\n        mem[i] = min(mem[i], solve(i + j) + abs(a[i] - a[i + j]));\n\n    return mem[i];\n}\n\nint main() {\n    scanf("%d%d", &n, &m);\n    for (int i = 0; i < n; ++i)\n        scanf("%d", a + i);\n    memset(mem, -1, sizeof mem);\n    printf("%d", solve());\n    return 0;\n}')
