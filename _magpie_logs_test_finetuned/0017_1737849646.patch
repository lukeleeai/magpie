LineLLMCrossover(('source.cpp', 17), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\n#include <cmath>\nusing namespace std;\n\nconst long long INF = 1e18;\nlong long n, k;\nlong long a[100005];\n\nlong long solve(){\n    long long dp[100005];\n    fill(dp, dp + n, INF);\n    dp[n - 1] = 0;\n    for(long long index = n - 2; index >= 0; index--){\n        for(long long i = 1; i <= k; i++){\n if(index + i < n){\n     dp[index] = min(dp[index], abs(a[index] - a[index + i]) + dp[index + i]);\n }\n        }\n    }\n    return dp[0];\n}\n\nint main(){\n    scanf("%lld %lld", &n, &k);\n    for(long long i = 0; i < n; i++){\n        scanf("%lld", &a[i]);\n    }\n    printf("%lld\\n", solve());\n    return 0;\n}')
