2025-01-26 01:45:48,180	[DEBUG]	patch(0-10)="LineLLMMutation(('source.cpp', 9), '#include<queue>\n#include<cstdio>\n#include<vector>\n#include<cstring>\n#include<algorithm>\n\nusing namespace std;\n\nint n,m;\n\nvector<int> X,Y,fa,rank;\n\ndouble ans;\n\nstruct ed {\n    int from,to;\n    double len;\n} edge[300000];\n\nint find(int x) {\n    if(x != fa[x])\n        fa[x] = find(fa[x]);\n    return fa[x];\n}\n\nvoid Union(int x, int y) {\n    x = find(x);\n    y = find(y);\n    if(x != y) {\n        if(rank[x] < rank[y]) swap(x, y);\n        fa[y] = x;\n        if(rank[x] == rank[y]) rank[x]++;\n    }\n}\n\nvoid work() {\n    int cnt = 0;\n    for(int i = 1; i <= m; i++) {\n        int A = edge[i].from, B = edge[i].to;\n        if(find(A) != find(B)) {\n Union(A, B);\n ans += edge[i].len;\n cnt++;\n        }\n        if(cnt >= n - 1) break;\n    }\n}\n\nint main() {\n    scanf("%d%d", &n, &m);\n    X.resize(n + 1);\n    Y.resize(n + 1);\n    fa.resize(n + 1);\n    rank.assign(n + 1, 0);\n    for(int i = 1; i <= n; i++) {\n        scanf("%d%d", &X[i], &Y[i]);\n        fa[i] = i;\n    }\n    for(int i = 1, a, b; i <= m; i++) {\n        scanf("%d%d", &a, &b);\n        edge[i].from = a;\n        edge[i].to = b;\n        edge[i].len = sqrt((X[a] - X[b]) * (X[a] - X[b]) + (Y[a] - Y[b]) * (Y[a] - Y[b]));\n    }\n    sort(edge + 1, edge + 1 + m, [](ed x, ed y) { return x.len > y.len; });\n    work();\n    printf("%.3lf\\n", ans);\n    return 0;\n}')"
