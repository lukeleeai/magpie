LineLLMMutation(('source.cpp', 4), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\n\nint N, A, B, rings[100], G[100][100];\nbool used[100];\n\nint rec(int pos) {\n    int ret = 1; \n    used[pos] = true;\n\n    for(int i = 0; i < rings[pos]; i++) {\n        int r = G[pos][i];\n        if(!used[r]) {\n ret = max(ret, rec(r) + 1);\n        }\n    }\n\n    used[pos] = false;\n    return ret;\n}\n\nint main() {\n    while(true) {\n        scanf("%d", &N);\n        if(N == 0) { break; }\n\n        memset(rings, 0, sizeof(rings));\n        memset(used, false, sizeof(used));\n\n        for(int i = 0; i < N; i++) {\n scanf("%d%d", &A, &B);\n A--; B--;\n G[A][rings[A]] = B; \n G[B][rings[B]] = A; \n rings[A]++; \n rings[B]++;\n        }\n\n        int nodes = 0;\n        for(int i = 0; i < 100; i++) {\n if(rings[i]) {\n     nodes++;\n }\n        }\n\n        int ret = 0;\n        for(int i = 0; i < 100; i++) {\n ret = max(ret, rec(i));\n if(ret == nodes) break;\n        }\n\n        printf("%d\\n", ret);\n    }\n\n    return 0;\n}')
