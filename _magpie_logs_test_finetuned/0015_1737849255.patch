LineLLMMutation(('source.cpp', 4), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\n\nconst int N = 2e5 + 5;\nlong long dp[N];\nint h[N];\n\nint main() {\n    int n, k;\n    scanf("%d%d", &n, &k);\n    for(int i = 1; i <= n; ++i) {\n        scanf("%d", &h[i]);\n    }\n    memset(dp, 0x3f, sizeof(dp));\n    dp[1] = 0;\n\n    for(int i = 1; i <= n; ++i) {\n        for(int j = 1; j <= k; ++j) {\n if(i - j < 1) break;\n dp[i] = min(dp[i], dp[i - j] + abs(h[i] - h[i - j]));\n        }\n    }\n    printf("%lld\\n", dp[n]);\n    return 0;\n}') + LineLLMMutation(('source.cpp', 16), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\n#include <climits>\nusing namespace std;\n\nconst int N = 2e5 + 5;\nlong long dp[N];\nint h[N];\n\nint main() {\n    int n, k;\n    scanf("%d%d", &n, &k);\n    for(int i = 1; i <= n; ++i) {\n        scanf("%d", &h[i]);\n    }\n    fill(dp, dp + N, LLONG_MAX);\n    dp[1] = 0;\n\n    for(int i = 1; i <= n; ++i) {\n        for(int j = 1; j <= k && i - j > 0; ++j) {\n dp[i] = min(dp[i], dp[i - j] + abs(h[i] - h[i - j]));\n        }\n    }\n    printf("%lld\\n", dp[n]);\n    return 0;\n}')
