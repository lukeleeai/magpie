LineLLMCrossover(('source.cpp', 12), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\n\n#define ll long long\nconst ll INF = 1e18;\n\nll n, k, ara[200005], dp[200005];\n\nll cal(int pos) {\n    if (pos > n) return INF;\n    if (dp[pos] != -1) return dp[pos];\n    if (pos == n) return 0;\n\n    dp[pos] = abs(ara[pos + 1] - ara[pos]) + cal(pos + 1);\n    for (int i = 2; i <= k; i++) {\n        dp[pos] = min(dp[pos], abs(ara[pos] - ara[pos + i]) + cal(pos + i));\n    }\n    return dp[pos];\n}\n\nint main() {\n    scanf("%lld%lld", &n, &k);\n    memset(dp, -1, sizeof dp);\n    for (int i = 1; i <= n; i++) {\n        scanf("%lld", &ara[i]);\n    }\n    ara[n + 1] = INF; // Set the last element to INF\n    printf("%lld\\n", cal(1));\n    return 0;\n}')
