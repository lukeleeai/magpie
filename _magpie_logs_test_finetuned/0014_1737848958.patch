LineLLMMutation(('source.cpp', 6), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\ntypedef long long ll;\n\nll read() {\n    ll x = 0, f = 1;\n    char c = getchar();\n    while (c < \'0\' || c > \'9\') { if (c == \'-\') f = -1; c = getchar(); }\n    while (c >= \'0\' && c <= \'9\') { x = x * 10 + c - \'0\'; c = getchar(); }\n    return x * f;\n}\n\nint n;\nint a[1000100];\npair<int, int> b[1000100];\nconst int maxN = 1 << 20; // Assuming n will not exceed 20\n\nvoid upd(int x, int y) {\n    int num1 = b[x].first, num2 = b[x].second, num3 = b[y].first, num4 = b[y].second;\n    b[x].first = max(num1, num3);\n    if (num1 > num3) b[x].second = max(num2, num3);\n    else b[x].second = max(num1, num4);\n}\n\nint main() {\n    n = read();\n    int limit = 1 << n; // Precompute limit\n    for (int i = 0; i < limit; i++)\n        a[i] = read();\n    for (int i = 0; i < limit; i++)\n        b[i].first = a[i], b[i].second = -1e9;\n    for (int k = 0; k < n; k++) {\n        for (int i = 0; i < limit; i++) {\n            if ((i & (1 << k)) != 0) continue;\n            upd(i | (1 << k), i);\n        }\n    }\n    int lastans = 0;\n    for (int i = 1; i < limit; i++) {\n        lastans = max(lastans, b[i].first + b[i].second);\n        printf("%d\\n", lastans);\n    }\n    return 0;\n}')
