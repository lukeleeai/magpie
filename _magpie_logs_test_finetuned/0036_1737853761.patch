LineLLMCrossover(('source.cpp', 12), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\n\nint n, k, f[1100000], w[1100000];\n\nint main() {\n    scanf("%d%d", &n, &k);\n    for (int i = 0; i <= n; i++) {\n        f[i] = 0x3f3f3f3f; // Initialize only necessary elements\n    }\n    for (int i = 1; i <= n; i++) {\n        scanf("%d", &w[i]);\n    }\n    f[1] = 0;\n    for (int i = 2; i <= n; i++) {\n        for (int j = 1; j <= k && i - j > 0; j++) {\n f[i] = min(f[i], f[i - j] + abs(w[i - j] - w[i]));\n        }\n    }\n    printf("%d\\n", f[n]);\n}')
