LineLLMCrossover(('source.cpp', 12), '#include <bits/stdc++.h>\nusing namespace std;\n\nconst int N = 16;\nconst long long MN = -1e9 * N;\nint n;\nint a[N][N];\nlong long dp[1 << N];\nlong long value[1 << N];\nint arr[N];\n\nlong long get_cost(int sz) {\n    long long ret = 0;\n    for (int i = 0; i < sz; i++)\n        for (int j = i + 1; j < sz; j++)\n ret += a[arr[i]][arr[j]];\n    return ret;\n}\n\nlong long solve(int msk = (1 << n) - 1) {\n    if (!msk) return 0;\n    long long &ret = dp[msk];\n    if (ret != MN) return ret;\n    ret = MN;\n    for (int cur_msk = msk; cur_msk; cur_msk = (cur_msk - 1) & msk) {\n        ret = max(ret, value[cur_msk] + solve(msk ^ cur_msk));\n    }\n    return ret;\n}\n\nint main() {\n    scanf("%d", &n);\n    for (int i = 0; i < n; i++)\n        for (int j = 0; j < n; j++)\n scanf("%d", &a[i][j]);\n    fill(dp, dp + (1 << n), MN);\n    for (int i = 0; i < (1 << n); i++) {\n        int idx = 0;\n        for (int j = 0; j < n; j++) {\n if (i & (1 << j)) arr[idx++] = j;\n        }\n        value[i] = get_cost(idx);\n    }\n    printf("%lld\\n", solve());\n}')
