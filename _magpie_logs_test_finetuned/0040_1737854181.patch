LineLLMMutation(('source.cpp', 11), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\n\n#define ALL(x) begin(x), end(x)\n\ntypedef long long ll;\n\nconst int OO = 0x3f3f3f3f;\n\nint n, k;\nint arr[100005];\nint mem[100005];\n\nint solve(int x) {\n    if (x == n - 1) return 0;\n    if (mem[x] != OO) return mem[x];\n    for (int i = 1; i <= k && (x + i) <= n - 1; i++) {\n        mem[x] = min(mem[x], solve(x + i) + abs(arr[x] - arr[x + i]));\n    }\n    return mem[x];\n}\n\nint main() {\n    scanf("%d %d", &n, &k);\n    for (int i = 0; i < n; i++) {\n        mem[i] = OO;\n        scanf("%d", &arr[i]);\n    }\n    printf("%d\\n", solve(0));\n    return 0;\n}')
