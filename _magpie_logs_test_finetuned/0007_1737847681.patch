LineLLMCrossover(('source.cpp', 14), '#include <cstdio>\n#include <vector>\n#include <cstdlib>\nusing namespace std;\n\ntypedef long long int int64;\n\nint main() {\n    int64 n, k;\n    scanf("%lld%lld", &n, &k);\n\n    vector<int64> h(n);\n    for(int64 i = 0; i < n; i++)\n        scanf("%lld", &h[i]);\n\n    vector<int64> ans(n);\n    ans[0] = 0;\n    ans[1] = abs(h[1] - h[0]);\n\n    for(int64 i = 2; i < n; i++) {\n        ans[i] = abs(h[i] - h[i - 1]) + ans[i - 1];\n        for(int64 j = 2; j <= i && j <= k; j++)\n ans[i] = min(ans[i], abs(h[i] - h[i - j]) + ans[i - j]);\n    }\n    printf("%lld\\n", ans[n - 1]);\n}')
