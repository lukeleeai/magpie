LineLLMCrossover(('source.cpp', 9), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\n\nconst int N = 1e5 + 1;\n\nint n, a[N], dp[N], k;\n\nint calc(int i) {\n    if (i == n - 1) return 0;\n    if (i >= n) return 1e9 + 10;\n\n    int &ret = dp[i];\n    if (ret != -1) return ret;\n\n    ret = 1e9 + 10;\n    for (int j = 1; j <= k; j++)\n        ret = min(calc(i + j) + abs(a[i] - a[i + j]), ret);\n\n    return ret;\n}\n\nint main() {\n    scanf("%d%d", &n, &k);\n    for (int i = 0; i < n; i++) {\n        scanf("%d", &a[i]);\n    }\n    memset(dp, -1, sizeof dp);\n    printf("%d\\n", calc(0));\n    return 0;\n}')
