LineLLMMutation(('source.cpp', 8), '#include <iostream>\n#include <cstdio>\n#include <cmath>\nusing namespace std;\n\nconst int maxn = 100004;\nint n, k;\nint arr[maxn];\nint memo[maxn];\n\nint cost(int i) {\n    if(i >= n - 1) return 0;\n    if(i == n - 2) return abs(arr[n - 2] - arr[n - 1]);\n\n    if(memo[i] == -1) {\n        for(int j = 1; j <= k; ++j) {\n if(i + j > n - 1) break;\n int temp = abs(arr[i + j] - arr[i]) + cost(i + j);\n memo[i] = (memo[i] == -1) ? temp : min(memo[i], temp);\n        }\n    }\n    return memo[i];\n}\n\nint main() {\n    scanf("%d %d", &n, &k);\n    for(int i = 0; i < n; ++i) scanf("%d", &arr[i]);\n    fill(memo, memo + maxn, -1);\n    printf("%d\\n", cost(0));\n    return 0;\n}')
