LineLLMCrossover(('source.cpp', 8), '#include <bits/stdc++.h>\nusing namespace std;\n\nint main() {\n    int n, c;\n    cin >> n >> c;\n    vector<long long> v(n);\n    for (int i = 0; i < n; i++) cin >> v[i];\n\n    vector<long long> mem(n, -1);\n    function<long long(int)> solve = [&](int i) {\n        if (i == n - 1) return 0LL;\n        if (mem[i] != -1) return mem[i];\n        long long ret = solve(i + 1) + abs(v[i + 1] - v[i]);\n        for (int k = 2; k <= c; k++)\n            if (k + i < n) ret = min(ret, solve(i + k) + abs(v[i + k] - v[i]));\n        return mem[i] = ret;\n    };\n\n    cout << solve(0) << "\\n";\n}')
