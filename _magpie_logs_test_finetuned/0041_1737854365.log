2025-01-26 01:22:32,511	[DEBUG]	patch(2-5)="LineLLMMutation(('source.cpp', 16), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\n#define ll long long\n\ninline int gi() {\n    int f = 1, sum = 0; char ch = getchar();\n    while (ch > \'9\' || ch < \'0\') { if (ch == \'-\') f = -1; ch = getchar(); }\n    while (ch >= \'0\' && ch <= \'9\') { sum = (sum << 3) + (sum << 1) + ch - \'0\'; ch = getchar(); }\n    return f * sum;\n}\n\nconst int N = 100010;\nint a[N], b[N], n, p[N], c[N << 2], Mx;\nll cnt;\n\nint lowbit(int x) { return x & (-x); }\nvoid Add(int x, int d) { while (x <= Mx) { c[x] += d; x += lowbit(x); } }\nint sum(int x) { int ret = 0; while (x) { ret += c[x]; x -= lowbit(x); } return ret; }\n\nbool check(int mid) {\n    for (int i = 1; i <= n; i++)\n        a[i] = (p[i] < mid) ? -1 : 1;\n\n    ll ans = 0;\n    for (int i = 1; i <= n; i++) {\n        a[i] += a[i - 1];\n        if (a[i] >= 0) ans++;\n    }\n\n    memset(c, 0, sizeof(c)); Mx = 0;\n    for (int i = 1; i <= n; i++) {\n        a[i] += n + 1; Mx = max(Mx, a[i]);\n    }\n\n    for (int i = 1; i <= n; i++) {\n        ans += sum(a[i]);\n        Add(a[i], 1);\n    }\n    return cnt - ans < cnt / 2 + 1;\n}\n\nint main() {\n    n = gi();\n    for (int i = 1; i <= n; i++) p[i] = gi();\n    sort(p + 1, p + n + 1);\n    cnt = 1ll * n * (n - 1) / 2ll + n;\n\n    int l = 1, r = n, ans = 0;\n    while (l <= r) {\n        int mid = (l + r) >> 1;\n        if (check(mid)) { ans = mid; l = mid + 1; }\n        else r = mid - 1;\n    }\n    printf("%d\\n", p[ans]);\n    return 0;\n}')"
