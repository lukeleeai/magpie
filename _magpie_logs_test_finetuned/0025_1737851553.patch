LineLLMCrossover(('source.cpp', 11), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\n#define ll long long\n\nconst int maxn = 1e5 + 5;\n\nint main() {\n    int k, x;\n    scanf("%d%d", &k, &x);\n    int t = min(x + k - 1, 1000000);\n    for (int i = max(x - k + 1, -1000000); i <= t; i++)\n        printf("%d%c", i, (i == t) ? \'\\n\' : \' \');\n    return 0;\n}')
