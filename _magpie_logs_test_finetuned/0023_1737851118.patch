LineLLMCrossover(('source.cpp', 12), '#include <cstdio>\nusing namespace std;\n\nint main() {\n    char a[10];\n    int m, n, b, x = 0, z = 0;\n    scanf("%d%d", &m, &n);\n    int c[100005] = {0}, d[100005] = {0};\n    \n    for (int i = 1; i <= n; i++) {\n        scanf("%d%s", &b, a);\n        if (a[0] == \'A\' && d[b] != -1) {\n d[b] = -1;\n x++;\n z += c[b];\n        } else if (a[0] == \'W\') {\n c[b]++;\n        }\n    }\n    printf("%d %d\\n", (n == 0) ? 0 : x, (n == 0) ? 0 : z);\n}')
