LineLLMCrossover(('source.cpp', 6), '#include <cstdio>\n#include <algorithm>\n#include <climits>\nusing namespace std;\n\nint n, k;\nlong long vi[200005];\nlong long mem[200005];\nbool vis[200005];\n\nlong long solve(int indx) {\n    if (indx == n - 1) return 0;\n    if (vis[indx]) return mem[indx];\n    vis[indx] = true;\n    mem[indx] = LLONG_MAX;\n    for (int i = indx + 1; i <= min(indx + k, n - 1); i++) {\n        mem[indx] = min(mem[indx], solve(i) + abs(vi[indx] - vi[i]));\n    }\n    return mem[indx];\n}\n\nint main() {\n    scanf("%d%d", &n, &k);\n    for (int i = 0; i < n; i++) {\n        scanf("%lld", &vi[i]);\n    }\n    printf("%lld\\n", solve(0));\n    return 0;\n}')
