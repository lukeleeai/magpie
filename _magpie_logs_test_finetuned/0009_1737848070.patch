LineLLMCrossover(('source.cpp', 15), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\n#define ll long long\nconst ll INF = 1LL << 60;\n\nll N, K, h[100010], dp[100010];\n\nvoid minimize(ll& a, ll b) {\n    if (a > b) {\n        a = b;\n    }\n}\n\nint main() {\n    scanf("%lld %lld", &N, &K);\n    for (int i = 0; i < N; i++) {\n        scanf("%lld", &h[i]);\n    }\n    fill(dp, dp + N, INF);\n    dp[0] = 0;\n\n    for (int i = 0; i < N; i++) {\n        for (int j = i + 1; j <= min(i + K, N - 1); j++) {\n minimize(dp[j], dp[i] + abs(h[i] - h[j]));\n        }\n    }\n\n    printf("%lld\\n", dp[N - 1]);\n}')
