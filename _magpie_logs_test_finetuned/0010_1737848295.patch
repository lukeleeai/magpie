LineLLMCrossover(('source.cpp', 13), '#include <cstdio>\nusing namespace std;\n\nlong long a[10000];\n\nint main() {\n    int n;\n    scanf("%d", &n);\n    for (int i = 1; i <= n; i++) {\n        scanf("%lld", &a[i]);\n    }\n    long long ans = 0;\n    while (true) {\n        long long maxn = a[1];\n        int id = 1;\n        for (int i = 2; i <= n; i++) {\n if (maxn < a[i]) {\n     maxn = a[i];\n     id = i;\n }\n        }\n        if (maxn <= n - 1) break;\n        for (int i = 1; i <= n; i++) {\n a[i] = (i == id) ? maxn % n : a[i] + maxn / n;\n        }\n        ans += maxn / n;\n    }\n    printf("%lld\\n", ans);\n}')
