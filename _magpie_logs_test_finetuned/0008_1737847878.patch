LineLLMMutation(('source.cpp', 6), '#include <iostream>\n#include <vector>\n#include <cmath>\n#include <algorithm>\nusing namespace std;\n\nlong long n, k;\n\nint main() {\n    cin >> n >> k;\n    vector<long long> l(n), l1(n);\n\n    for (int i = 0; i < n; i++) {\n        cin >> l[i];\n    }\n\n    for (int i = 1; i < n; i++) {\n        l1[i] = l1[i - 1] + abs(l[i - 1] - l[i]);\n        for (int j = 1; j <= min(i * 1LL, k); j++) {\n l1[i] = min(l1[i], l1[i - j] + abs(l[i - j] - l[i]));\n        }\n    }\n\n    cout << max(0LL, l1[n - 1]) << endl;\n}') + LineLLMMutation(('source.cpp', 13), '#include <iostream>\n#include <cmath>\n#include <algorithm>\nusing namespace std;\n\nlong long n, k;\nlong long l[100000], l1[100000];\n\nint main() {\n    cin >> n >> k;\n\n    for (int i = 0; i < n; i++) {\n        cin >> l[i];\n    }\n\n    for (int i = 1; i < n; i++) {\n        l1[i] = l1[i - 1] + abs(l[i - 1] - l[i]);\n        for (int j = 1; j <= min(i * 1LL, k); j++) {\n l1[i] = min(l1[i], l1[i - j] + abs(l[i - j] - l[i]));\n        }\n    }\n\n    cout << max(0LL, l1[n - 1]) << endl;\n}') + LineLLMMutation(('source.cpp', 19), '#include <cstdio>\n#include <cmath>\n#include <algorithm>\nusing namespace std;\n\nlong long n, k;\nlong long l[100000], l1[100000];\n\nint main() {\n    scanf("%lld%lld", &n, &k);\n\n    for (int i = 0; i < n; i++) {\n        scanf("%lld", &l[i]);\n    }\n\n    l1[0] = 0; // Initialize the first element\n    for (int i = 1; i < n; i++) {\n        l1[i] = l1[i - 1] + abs(l[i - 1] - l[i]);\n        // Optimize inner loop by limiting the range and avoiding unnecessary calculations\n        for (int j = 1; j <= k && j <= i; j++) {\n l1[i] = min(l1[i], l1[i - j] + abs(l[i - j] - l[i]));\n        }\n    }\n\n    printf("%lld\\n", max(0LL, l1[n - 1]));\n}')
