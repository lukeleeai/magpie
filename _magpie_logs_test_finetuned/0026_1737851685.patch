LineLLMCrossover(('source.cpp', 8), '#include <cstdio>\n#include <algorithm>\n#include <limits>\nusing namespace std;\n\nconst int N = 100005;\nint f[N], a[N];\n\nint main() {\n    int n, k;\n    scanf("%d%d", &n, &k);\n    fill(f, f + N, numeric_limits<int>::max());\n    for (int i = 1; i <= n; i++) scanf("%d", &a[i]);\n    f[1] = 0;\n\n    for (int i = 2; i <= n; i++) {\n        for (int j = 1; j <= k && i - j >= 1; j++) {\n f[i] = min(f[i], f[i - j] + abs(a[i] - a[i - j]));\n        }\n    }\n\n    printf("%d\\n", f[n]);\n}')
