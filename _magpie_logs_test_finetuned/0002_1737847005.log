2025-01-25 23:20:06,576	[DEBUG]	patch(5-9)="LineLLMCrossover(('source.cpp', 14), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\n\n#define ll long long\n#define mx 100005\n#define inf 100000000000000000LL\n\nll arr[mx], dp[mx];\nint n, k;\n\nll absolute(ll x) {\n    return (x < 0) ? -x : x;\n}\n\nll solve(int pos) {\n    if (pos == n) return 0;\n    if (dp[pos] != inf) return dp[pos];\n    dp[pos] = inf;\n    for (int i = 1; i <= k; i++) {\n        int nxt = pos + i;\n        if (nxt > n) break;\n        dp[pos] = min(dp[pos], absolute(arr[pos] - arr[nxt]) + solve(nxt));\n    }\n    return dp[pos];\n}\n\nint main() {\n    while (scanf("%d%d", &n, &k)) {\n        for (int i = 1; i <= n; i++)\n scanf("%lld", &arr[i]);\n        fill(dp, dp + mx, inf);\n        printf("%lld\\n", solve(1));\n        return 0;\n    }\n}\n')"
