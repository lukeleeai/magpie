LineLLMMutation(('source.cpp', 10), '#include <cstdio>\n#include <vector>\n#include <algorithm>\nusing namespace std;\n\nint main() {\n    int n, m, q;\n    scanf("%d %d %d", &n, &m, &q);\n    int a[q], b[q], c[q], d[q];\n    for (int i = 0; i < q; i++) {\n        scanf("%d %d %d %d", &a[i], &b[i], &c[i], &d[i]);\n    }\n\n    int cnt = 0;\n    vector<int> v[100000];\n    for (int i0 = 0; i0 < m; i0++) {\n        for (int i1 = i0; i1 < m; i1++) {\n for (int i2 = i1; i2 < m; i2++) {\n     for (int i3 = i2; i3 < m; i3++) {\n         for (int i4 = i3; i4 < m; i4++) {\n  for (int i5 = i4; i5 < m; i5++) {\n      for (int i6 = i5; i6 < m; i6++) {\n          for (int i7 = i6; i7 < m; i7++) {\n              for (int i8 = i7; i8 < m; i8++) {\n                  for (int i9 = i8; i9 < m; i9++) {\n                      v[cnt] = {i0, i1, i2, i3, i4, i5, i6, i7, i8, i9};\n                      cnt++;\n                  }\n              }\n          }\n      }\n  }\n         }\n     }\n }\n        }\n    }\n\n    long long int max = 0;\n    for (int i = 0; i < cnt; i++) {\n        long long int sum = 0;\n        for (int j = 0; j < q; j++) {\n int aj = a[j] - 1;\n int bj = b[j] - 1;\n if (v[i][bj] - v[i][aj] == c[j]) {\n     sum += d[j];\n }\n        }\n        if (sum > max) max = sum;\n    }\n\n    printf("%lld\\n", max);\n}')
