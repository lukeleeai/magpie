LineLLMMutation(('source.cpp', 25), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\ntypedef long long ll;\n\nll n, k, arr[100005];\nll memo[100005];\n\nint main() {\n    scanf("%lld%lld", &n, &k);\n    for (int i = 0; i < n; i++) {\n        scanf("%lld", &arr[i]);\n    }\n    fill(memo, memo + n, 1e9);\n    memo[n - 1] = 0; // Base case\n    for (ll i = n - 2; i >= 0; i--) {\n        for (int j = 1; j <= k && i + j < n; j++) {\n memo[i] = min(memo[i], abs(arr[i] - arr[i + j]) + memo[i + j]);\n        }\n    }\n    printf("%lld\\n", memo[0]);\n    return 0;\n}')
