2025-01-26 13:29:45,247	[DEBUG]	patch(4-10)="LineLLMCrossover(('source.cpp', 14), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\ntypedef long long ll;\n\nconstexpr int INF = 2000000000;\n\nint points[100005][2]; // 2D array to store x+y and x-y\n\nint main() {\n    int n, x, y;  \n    scanf("%d", &n);\n    int minX = INF, minY = INF, maxX = -INF, maxY = -INF;\n\n    for(int i = 0; i < n; i++) {\n        scanf("%d%d", &x, &y);\n        points[i][0] = x + y; // Store first part\n        points[i][1] = x - y; // Store second part\n        minX = min(minX, points[i][0]);\n        maxX = max(maxX, points[i][0]);\n        minY = min(minY, points[i][1]);\n        maxY = max(maxY, points[i][1]);\n    }\n\n    int result1 = 0, result2 = 0;\n    for(int i = 0; i < n; i++) {\n        int f = points[i][0], s = points[i][1];\n        result1 = max(result1, min(max(f - minX, s - minY), max(maxX - f, maxY - s)));\n        result2 = max(result2, min(max(f - minX, maxY - s), max(maxX - f, s - minY)));\n    }\n\n    printf("%d\\n", min(result1, result2));\n}')"
