 (int j = 1; j <= w; j++) {\n            if (map[i][j] == \'S\') {\n                sx = i;\n                sy = j;\n            }\n        }\n    }\n\n    queue<node> q;\n    q.push({sx, sy, 0, 0});\n    vis[0][sx][sy] = true;\n\n    int ans = -1;\n    while (!q.empty()) {\n        node cur = q.front();\n        if (cur.n == n) {\n            ans = cur.deep;\n            break;\n        }\n        q.pop();\n\n        for (int i = 0; i < 4; i++) {\n            int tx = cur.x + dx[i];\n            int ty = cur.y + dy[i];\n            if (map[tx][ty] != \'X\' && !vis[cur.n][tx][ty]) {\n                node t = {tx, ty, cur.deep + 1, cur.n};\n                if (map[tx][ty] == \'1\' + t.n) {\n                    t.n++;\n                }\n                vis[t.n][tx][ty] = true;\n                q.push(t);\n            }\n        }\n    }\n\n    printf("%d\\n", ans);\n    return 0;\n}')"
