mory\n\nstruct node {\n    int x;\n    int y;\n    int deep;\n    int n;\n};\n\nint dx[] = {0, 0, 1, -1};\nint dy[] = {1, -1, 0, 0};\n\nint main() {\n    CLR(vis, false);\n    CLR(map, \'X\');\n    int h, w, n;\n    scanf("%d %d %d", &h, &w, &n);\n    \n    int sx, sy;\n    getchar();\n    for (int i = 1; i <= h; i++) {\n        fgets(map[i] + 1, w + 2, stdin); // Read the whole row at once\n        for (int j = 1; j <= w; j++) {\n            if (map[i][j] == \'S\') {\n                sx = i;\n                sy = j;\n            }\n        }\n    }\n\n    node t;\n    t.x = sx;\n    t.y = sy;\n    t.deep = 0;\n    t.n = 0;\n    \n    queue<node> q;\n    vis[sx][sy] = true; // Adjusted to only track the starting position\n    q.push(t);\n    \n    int ans = -1;\n    while (!q.empty()) {\n        node cur = q.front();\n        q.pop(); // Moved pop to the beginning for cleaner logic\n\n        if (cur.n == n) {\n            ans = cur.deep;\n            break;\n        }\n\n        for (int i = 0; i < 4; i++) {\n            int tx = cur.x + dx[i];\n            int ty = cur.y + dy[i];\n            if (tx > 0 && tx <= h && ty > 0 && ty <= w && map[tx][ty] != \'X\' && !vis[tx][ty]) {\n                node next = cur;\n                next.x = tx;\n                next.y = ty;\n                next.deep++;\n                if (map[tx][ty] == \'1\' + next.n) {\n                    next.n++;\n                }\n                vis[tx][ty] = true; // Only mark the cell as visited\n                q.push(next);\n            }\n        }\n    }\n\n    printf("%d\\n", ans);\n    return 0;\n}')"

