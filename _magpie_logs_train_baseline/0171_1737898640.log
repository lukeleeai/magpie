char();\n\n    int sx, sy;\n    for (int i = 1; i <= h; i++) {\n        for (int j = 1; j <= w; j++) {\n            map[i][j] = getchar();\n            if (map[i][j] == \'S\') {\n                sx = i;\n                sy = j;\n            }\n        }\n        getchar();\n    }\n\n    node start = {sx, sy, 0, 0};\n    queue<node> q;\n    vis[0][sx][sy] = true;\n    q.push(start);\n\n    int ans = -1;\n    while (!q.empty()) {\n        node cur = q.front();\n        if (cur.n == n) {\n            ans = cur.deep;\n            break;\n        }\n        q.pop();\n\n        for (int i = 0; i < 4; i++) {\n            int tx = cur.x + dx[i];\n            int ty = cur.y + dy[i];\n            if (map[tx][ty] != \'X\' && !vis[cur.n][tx][ty]) {\n                node next = {tx, ty, cur.deep + 1, cur.n};\n                if (map[tx][ty] == \'1\' + next.n) {\n                    next.n++;\n                }\n                vis[next.n][tx][ty] = true;\n                q.push(next);\n            }\n        }\n    }\n\n    cout << ans << endl;\n    return 0;\n}') | LineLLMMutation(('source.cpp', 22), '#include <cstdio>\n#include <queue>\n#include <vector>\n\nusing namespace std;\n\nconst int MAXN = 1010;\n\nchar map[MAXN][MAXN]; // Changed to a 2D array for better cache locality\nbool vis[MAXN][MAXN]; // Reduced to 2D to save memory and improve access speed\n\nstruct node {\n    int x, y, deep, n;\n};\n\nint dx[] = {0, 0, 1, -1};\nint dy[] = {1, -1, 0, 0};\n\nint main() {\n    int h, w, n;\n    scanf("%d %d %d", &h, &w, &n);\n    getchar();\n\n    int sx, sy;\n    for (int i = 1; i <= h; i++) {\n        for (int j = 1; j <= w; j++) {\n            map[i][j] = getchar();\n            if (map[i][j] == \'S\') {\n                sx = i;\n                sy = j;\n            }\n        }\n        getchar();\n    }\n\n    node start = {sx, sy, 0, 0};\n    queue<node> q;\n    vis[sx][sy] = true; // Optimized to 2D array\n    q.push(start);\n\n    int ans = -1;\n    while (!q.empty()) {