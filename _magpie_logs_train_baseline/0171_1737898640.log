2025-01-26 13:38:56,045	[DEBUG]	patch(0-8)="LineLLMMutation(('source.cpp', 7), '#include <iostream>\n#include <cstring>\n#include <cstdio>\n#include <cmath>\n#include <string>\n#include <queue>\n\n#define CLR(ARR, NUM) memset(ARR, NUM, sizeof(ARR))\n#define faster_io() ios_base::sync_with_stdio(false)\n\nusing namespace std;\n\nconst int MAXN = 1010;\nconst int MAXN_VIS = 10 * MAXN * MAXN;\n\nchar map[MAXN][MAXN];\nbool vis[MAXN_VIS];\n\nstruct node {\n    int x, y, state; // Combine deep and n into state\n};\n\nint main() {\n    CLR(vis, false);\n    CLR(map, \'X\');\n    int h, w, n;\n    scanf("%d %d %d", &h, &w, &n);\n    \n    int sx, sy;\n    getchar();\n    for (int i = 1; i <= h; i++) {\n        fgets(map[i] + 1, w + 2, stdin);\n        for (int j = 1; j <= w; j++) {\n            if (map[i][j] == \'S\') {\n                sx = i;\n                sy = j;\n            }\n        }\n    }\n\n    queue<node> q;\n    q.push({sx, sy, 0}); // Initialize with state 0\n    vis[sx * MAXN + sy] = true;\n\n    int ans = -1;\n    while (!q.empty()) {\n        node cur = q.front();\n        q.pop();\n\n        if (cur.state % 10 == n) { // Check if we reached the final state\n            ans = cur.state / 10; // Get the depth\n            break;\n        }\n\n        for (int d = 0; d < 4; d++) {\n            int tx = cur.x + (d == 0) - (d == 1);\n            int ty = cur.y + (d == 2) - (d == 3);\n            if (map[tx][ty] != \'X\' && !vis[tx * MAXN + ty]) {\n                int new_state = cur.state + 1;\n                if (map[tx][ty] == \'1\' + (cur.state % 10)) {\n                    new_state += 10; // Increment n\n                }\n                vis[tx * MAXN + ty] = true;\n                q.push({tx, ty, new_state});\n            }\n        }\n    }\n\n    printf("%d\\n", ans);\n    return 0;\n}')"
