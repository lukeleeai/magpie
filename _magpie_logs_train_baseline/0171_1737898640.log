t(map, \'X\', sizeof(map));\n\n    int h, w, n;\n    scanf("%d %d %d", &h, &w, &n);\n    getchar();\n\n    int sx, sy;\n    for (int i = 1; i <= h; i++) {\n        for (int j = 1; j <= w; j++) {\n            map[i][j] = getchar();\n            if (map[i][j] == \'S\') {\n                sx = i;\n                sy = j;\n            }\n        }\n        getchar();\n    }\n\n    node t = {sx, sy, 0, 0};\n    queue<node> q;\n    vis[sx][sy] = true; // Only track the current position\n    q.push(t);\n\n    int ans = -1;\n    while (!q.empty()) {\n        node cur = q.front();\n        q.pop();\n\n        if (cur.n == n) {\n            ans = cur.deep;\n            break;\n        }\n\n        for (int i = 0; i < 4; i++) {\n            int tx = cur.x + dx[i];\n            int ty = cur.y + dy[i];\n            if (map[tx][ty] != \'X\' && !vis[tx][ty]) {\n                node nxt = {tx, ty, cur.deep + 1, cur.n};\n                if (map[tx][ty] == \'1\' + nxt.n) {\n                    nxt.n++;\n                }\n                vis[tx][ty] = true;\n                q.push(nxt);\n            }\n        }\n    }\n\n    cout << ans << endl;\n    return 0;\n}')"
