(dp[j][1], dp[j][1]);\n            dp[j+1][0] = min(dp[j+1][0], dp[j][1] + cut[i]);\n        }\n        swap(cur,nxt);\n    }\n\n    printf("%d\\n",min(dp[n/2][0],dp[n/2][1]));\n}')"
