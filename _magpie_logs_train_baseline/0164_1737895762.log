or INT_MAX\n\nusing namespace std;\n\ntypedef pair<int,int> P;\ntypedef pair<int,P> P1;\ntypedef pair<P,P> P2;\ntypedef long long ll;\n\n#define pu push\n#define pb push_back\n#define mp make_pair\n#define eps 1e-7\n#define INF 2000000000\n#define f first\n#define s second\n#define rep(i,x) for(int i=0;i<x;i++)\n\nint cut[10005];\nint dp[2][5005][2];\n\nint main() {\n    srand((unsigned int)time(NULL));\n    int n; \n    scanf("%d", &n);\n    \n    for(int i = 1; i < n; i++) \n        scanf("%d", &cut[i]);\n\n    // Use INT_MAX instead of 1e8 for better readability and standard practice\n    for(int i = 0; i < 2; i++) \n        for(int j = 0; j < 5005; j++) \n            for(int k = 0; k < 2; k++) \n                dp[i][j][k] = INT_MAX;\n\n    dp[0][1][0] = 0; \n    int cur = 0, nxt = 1;\n\n    for(int i = 1; i < n; i++) {\n        for(int j = 0; j < 5005; j++) \n            for(int k = 0; k < 2; k++) \n                dp[nxt][j][k] = INT_MAX;\n\n        for(int j = 0; j <= n / 2; j++) {\n            dp[nxt][j + 1][0] = min(dp[nxt][j + 1][0], dp[cur][j][0]);\n            dp[nxt][j][1] = min(dp[nxt][j][1], dp[cur][j][0] + cut[i]);\n            dp[nxt][j][1] = min(dp[nxt][j][1], dp[cur][j][1]);\n            dp[nxt][j + 1][0] = min(dp[nxt][j + 1][0], dp[cur][j][1] + cut[i]);\n        }\n\n        swap(cur, nxt);\n    }\n\n    printf("%d\\n", min(dp[cur][n / 2][0], dp[cur][n / 2][1]));\n}')"
