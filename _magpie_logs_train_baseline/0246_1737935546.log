1) + newEnergy);\n            }\n        }\n    }\n    dp[day][currentCost][currentPlace][usedTwos] = ret;\n    return ret;\n}\n\nint main() {\n    while(scanf(" %d %d %d %d", &countCities, &totalDays, &maxWeight, &maxTwo), countCities) {\n        for(int i = 0; i < countCities; ++i)\n            for(int j = 0; j < totalDays; ++j) scanf(" %d", &energy[i][j]);\n        for(int i = 0; i < countCities; ++i)\n            for(int j = 0; j < totalDays; ++j) scanf(" %d", &fuel[i][j]);\n\n        memset(dp, -1, sizeof(dp));\n        int ans = 0;\n        for(int i = 0; i < countCities; ++i) ans = max(ans, calculateMaxEnergy(0, 0, i, 0));\n        printf("%d\\n", ans);\n    }\n    return 0;\n}')"
