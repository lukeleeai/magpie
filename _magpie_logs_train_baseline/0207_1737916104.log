\nvector<int> zonbi, dis, costco;\nvector<vector<int>> pairs;\n\nvoid updateQueue(vector<P>& queue, int cost, int node) {\n    queue.push_back({cost, node});\n    sort(queue.begin(), queue.end());\n}\n\nsigned main() {\n    cin >> n >> m >> k >> s >> p >> q;\n    zonbi.resize(k);\n    dis.assign(n + 1, INF);\n    costco.assign(n + 1, INF);\n    pairs.resize(n + 1);\n\n    for (int i = 0; i < k; i++) {\n        cin >> zonbi[i];\n    }\n\n    for (int i = 0; i < m; i++) {\n        int x, y;\n        cin >> x >> y;\n        pairs[x].push_back(y);\n        pairs[y].push_back(x);\n    }\n\n    vector<P> pq;\n    for (int i = 0; i < k; i++) {\n        updateQueue(pq, 0, zonbi[i]);\n        dis[zonbi[i]] = 0;\n    }\n\n    while (!pq.empty()) {\n        auto current = pq.front();\n        pq.erase(pq.begin());\n        int cost = current.first;\n        int start = current.second;\n        if (s == cost) continue;\n\n        for (int j : pairs[start]) {\n            if (dis[j] > cost + 1) {\n                dis[j] = cost + 1;\n                updateQueue(pq, cost + 1, j);\n            }\n        }\n    }\n\n    updateQueue(pq, 0, 1);\n    costco[1] = 0;\n\n    while (!pq.empty()) {\n        auto current = pq.front();\n        pq.erase(pq.begin());\n        int cost = current.first;\n        int start = current.second;\n\n        for (int i : pairs[start]) {\n            int hoge = (dis[i] == 0) ? 0 : (dis[i] == INF ? p : q);\n            if (i == n) hoge = 0;\n\n            if (costco[i] > cost + hoge) {\n                costco[i] = cost + hoge;\n                updateQueue(pq, cost + hoge, i);\n            }\n        }\n    }\n\n    cout << costco[n] << endl;\n    return 0;\n}')"
