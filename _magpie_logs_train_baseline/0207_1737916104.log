LineLLMCrossover(('source.cpp', 15), '#include <cstdio>\n#include <queue>\n#include <vector>\n#include <algorithm>\n\nusing namespace std;\n\n#define INF 1e18\ntypedef pair<long long, long long> P;\n#define MP make_pair\n\nlong long n, m, k, s, p, q;\nvector<long long> zonbi, dis, costco;\npriority_queue<P, vector<P>, greater<P>> pq;\nvector<vector<long long>> pairs;\n\nint main() {\n    scanf("%lld %lld %lld %lld %lld %lld", &n, &m, &k, &s, &p, &q);\n    zonbi.resize(k);\n    dis.assign(n + 1, INF);\n    costco.assign(n + 1, INF);\n    pairs.resize(n + 1);\n\n    for (long long i = 0; i < k; i++) {\n        scanf("%lld", &zonbi[i]);\n    }\n\n    for (long long i = 0; i < m; i++) {\n        long long x, y;\n        scanf("%lld %lld", &x, &y);\n        pairs[x].push_back(y);\n        pairs[y].push_back(x);\n    }\n\n    for (long long i : zonbi) {\n        pq.push(MP(0, i));\n        dis[i] = 0;\n    }\n\n    while (!pq.empty()) {\n        auto [cost, start] = pq.top();\n        pq.pop();\n        if (s == cost) continue;\n\n        for (long long j : pairs[start]) {\n            if (dis[j] > cost + 1) {\n                dis[j] = cost + 1;\n                pq.push(MP(cost + 1, j));\n            }\n        }\n    }\n\n    pq.push(MP(0, 1));\n    costco[1] = 0;\n\n    while (!pq.empty()) {\n        auto [cost, start] = pq.top();\n        pq.pop();\n\n        for (long long i : pairs[start]) {\n            long long hoge = (dis[i] == 0) ? 0 : (dis[i] == INF ? p : q);\n            if (i == n) hoge = 0;\n\n            if (costco[i] > cost + hoge) {\n                costco[i] = cost + hoge;\n                pq.push(MP(cost + hoge, i));\n            }\n        }\n    }\n\n    printf("%lld\\n", costco[n]);\n    return 0;\n}')
