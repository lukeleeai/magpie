LineLLMCrossover(('source.cpp', 15), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\n\ntypedef long long ll;\n\nll n, l;\nll a[100010];\nconst ll INF = 0xfffffffff;\n\nint main() {\n    ll ans = 0;\n    scanf("%lld%lld", &n, &l);\n    for (ll i = 0; i < n; i++) scanf("%lld", &a[i]);\n\n    ll max_a = -1; // Track the maximum value of a encountered\n    for (ll i = 0; i < n; i++) {\n        max_a = max(max_a, a[i]); // Update the maximum value\n        ll res = l - a[i];\n        if (max_a > a[i]) {\n            res += (l - a[i]);\n        }\n        ans = max(ans, res);\n    }\n    \n    printf("%lld\\n", ans);\n}')
