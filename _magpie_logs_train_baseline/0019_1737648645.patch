LineLLMCrossover(('source.cpp', 24), '#include<cstdio>\n#include<cstring>\nusing namespace std;\n\nint n, s;\nint memo[1024][1000];\n\nint search(int stat, int sum, int dep) {\n    if (dep == n) return memo[stat][sum] = (s == sum);\n    if (sum > s) return 0; // Early termination if the sum exceeds target\n    if (~memo[stat][sum]) return memo[stat][sum];\n\n    int cnt = 0;\n    for (int i = 0; i < 10; i++) {\n        if (!(stat & (1 << i))) {\n            stat |= 1 << i; // Mark the bit as used\n            cnt += search(stat, sum + i * (n - dep), dep + 1);\n            stat &= ~(1 << i); // Unmark the bit\n        }\n    }\n    return memo[stat][sum] = cnt;\n}\n\nint main() {\n    while (scanf("%d%d", &n, &s) == 2) {\n        for (int i = 0; i < 1024; i++) for (int j = 0; j < 1000; j++) memo[i][j] = -1;\n        if (n > 10 || s >= 1000) {\n            puts("0");\n            continue;\n        }\n        printf("%d\\n", search(0, 0, 0));\n    }\n    return 0;\n}') + LineLLMMutation(('source.cpp', 40), '#include<cstdio>\n#include<cstring>\nusing namespace std;\n\nint n, s;\nint memo[1024][1000];\n\nint search(int stat, int sum, int dep) {\n    if (dep == n) return memo[stat][sum] = (s == sum);\n    if (sum > s) return 0; // Early termination if the sum exceeds target\n    if (~memo[stat][sum]) return memo[stat][sum];\n\n    int cnt = 0;\n    for (int i = 0; i < 10; i++) {\n        if (!(stat & (1 << i))) {\n            stat |= 1 << i; // Mark the bit as used\n            cnt += search(stat, sum + i * (n - dep), dep + 1);\n            stat &= ~(1 << i); // Unmark the bit\n        }\n    }\n    return memo[stat][sum] = cnt;\n}\n\nint main() {\n    while (scanf("%d%d", &n, &s) == 2) {\n        memset(memo, -1, sizeof(memo)); // Optimized initialization\n        if (n > 10 || s >= 1000) {\n            puts("0");\n            continue;\n        }\n        printf("%d\\n", search(0, 0, 0));\n    }\n    return 0;\n}')
