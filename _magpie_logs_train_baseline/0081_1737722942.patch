LineLLMCrossover(('source.cpp', 30), '#include <cstdio>\n#include <algorithm>\n\nusing namespace std;\n\nint main() {\n    int x;\n\n    while (scanf("%d", &x), x) {\n        if (x % 1111 == 0) {\n            puts("NA");\n        } else {\n            int ans;\n            for (ans = 0; x != 6174; ++ans) {\n                int s[4];\n                // Directly extract digits using a single pass\n                for (int i = 3; i >= 0; --i) {\n                    s[i] = x % 10; // Extract digit\n                    x /= 10; // Remove last digit\n                }\n                sort(s, s + 4);\n                // Construct numbers a and b\n                int a = s[0] * 1000 + s[1] * 100 + s[2] * 10 + s[3]; \n                int b = s[3] * 1000 + s[2] * 100 + s[1] * 10 + s[0]; \n                x = b - a; // Calculate new x\n            }\n            printf("%d\\n", ans);\n        }\n    }\n}')
