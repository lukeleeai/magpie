LineLLMCrossover(('source.cpp', 33), '#include <cstdio>\n#include <numeric>\nusing namespace std;\n\nlong long gcd(long long a, long long b) {\n    while (b != 0) {\n        a %= b;\n        swap(a, b);\n    }\n    return a;\n}\n\nint main() {\n    long long num1, num2;\n    while (true) {\n        if (scanf("%lld %lld", &num1, &num2) != 2) break; // Check input condition\n        if (num1 < 0 || num2 < 0) {\n            printf("Invalid input\\n");\n            continue; // Continue to next iteration if input is invalid\n        }\n        long long gcdValue = gcd(num1, num2);\n        long long lcm = (num1 / gcdValue) * num2; // Optimized LCM calculation\n        printf("%lld %lld\\n", gcdValue, lcm);\n    }\n    return 0;\n}')
