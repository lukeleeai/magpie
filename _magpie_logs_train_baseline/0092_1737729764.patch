LineLLMCrossover(('source.cpp', 33), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\nint N, M, L, R, s[50003], t[50003], e[50003]; \nlong long d[50003], c[10003];\n\nint main() {\n    scanf("%d %d", &N, &M);\n    while (true) {\n        scanf("%d %d %d", &s[R], &t[R], &e[R]); \n        s[R]--, t[R]--;\n        if (!e[R]) break; \n        R++;\n    }\n    scanf("%d", &L);\n    for (int i = 0; i < L; i++) {\n        for (int j = 0; j < M; j++) \n            scanf("%lld", &c[j]);\n\n        // Zeroing the array using a loop for initialization\n        for (int j = 0; j < N; j++) {\n            d[j] = 0; \n        }\n        for (int j = 0; j < R; j++) \n            d[s[j]] += c[t[j]] * e[j];\n\n        for (int j = 0; j < N; j++) {\n            printf("%lld", d[j]);\n            if (j < N-1) printf(" ");\n        }\n        printf("\\n");\n    }\n}')
