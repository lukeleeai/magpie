LineLLMCrossover(('source.cpp', 34), '#include <cstdio>\n#include <vector>\n\nusing namespace std;\n\nint main() {\n    int n, m;\n    while (scanf("%d", &n), n) {\n        vector<char> to(256); // Initialize to 256 characters\n\n        char a, b;\n\n        fill(to.begin(), to.end(), 0); // Initialize to 0 (identity mapping)\n        for (int i = 0; i < 256; ++i) {\n            to[i] = i; // Default to mapping character to itself\n        }\n\n        for (int i = 0; i < n; ++i) {\n            scanf(" %c %c", &a, &b);\n            to[a] = b; // Map character a to b\n        }\n\n        scanf("%d", &m);\n        vector<char> str(m); // Use a vector to avoid multiple reallocations\n        for (int i = 0; i < m; ++i) {\n            scanf(" %c", &a);\n            str[i] = to[a]; // Direct access with vector\n        }\n\n        printf("%.*s\\n", m, str.data()); // Use a single output operation\n    }\n    return 0;\n}')
