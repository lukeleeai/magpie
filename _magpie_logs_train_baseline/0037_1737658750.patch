LineLLMCrossover(('source.cpp', 29), '#include <stdio.h>\n#include <cstring>\n\nint main() {\n    int suu;\n    const int MAX_V = 10000; \n    bool prime[MAX_V + 1] = {0}; // Initialize array with zeros\n\n    for (int i = 2; i * i <= MAX_V; i++) {\n        if (!prime[i]) {\n            for (int k = i * i; k <= MAX_V; k += i) {\n                prime[k] = true; // Mark non-prime\n            }\n        }\n    }\n\n    while (scanf("%d", &suu), suu) { // Simplified input condition\n        int an1 = -1, an2 = -1;\n        for (int k = suu; k >= 2; k--) { // Check backwards for efficiency\n            if (!prime[k - 2] && !prime[k]) {\n                an1 = k - 2;\n                an2 = k;\n                printf("%d %d\\n", an1, an2);\n                break;\n            }\n        }\n    }\n    return 0;\n}')
