gment\n        itr1 = itr2 + 1; // Move to the next segment\n\n        // Find the end of the second segment\n        while (itr1 < N - 1 && L[itr1] == L[itr1 + 1]) {\n            itr1++;\n        }\n\n        // Calculate the total count for the combined segments\n        count += (itr2 - (itr2 - 1 < 0 ? 0 : 1)) + (itr1 - itr2);\n        result = max(result, count);\n        \n        itr1++; // Move to the next position after the second segment\n    }\n\n    cout << result << endl;\n    return 0;\n}")"
