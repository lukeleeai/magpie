LineLLMCrossover(('source.cpp', 14), '#include <cstdio>\nusing namespace std;\n\nint n, b[2][100100], f[2][100100];\nbool v[100100];\n\nint dfs(int s, int now, int maxi, int num) {\n    v[now] = true;\n    for(int i = 0; i < 2; i++) {\n        int next = b[i][now];\n        if (!v[next]) {\n            if (maxi < f[i][now]) {\n                maxi = f[i][now];\n                num = 1; // reset num on a new max\n            } else if (maxi == f[i][now]) {\n                num++; // increment if equal\n            }\n            if(next == s) return num; // immediate return if target found\n            return dfs(s, next, maxi, num); // continue searching\n        }\n    }\n    return (maxi == f[1][s]) ? num + 1 : (maxi < f[1][s]) ? 1 : num;\n}\n\nint main() {\n    while(scanf("%d", &n), n) {\n        for(int i = 0; i < n; i++) {\n            scanf("%d %d %d %d", &b[0][i], &f[0][i], &b[1][i], &f[1][i]);\n            v[i] = false;\n        }\n\n        int ans = 1;\n        for(int i = 0; i < n; i++) {\n            if(!v[i]) {\n                v[i] = true;\n                ans = (ans * dfs(i, b[0][i], f[0][i], 1)) % 10007; // consistent logic\n            }\n        }\n        printf("%d\\n", ans);\n    }\n}')
