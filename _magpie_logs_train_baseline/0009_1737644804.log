2025-01-23 15:12:14,097	[DEBUG]	patch(4-1)="LineLLMCrossover(('source.cpp', 12), '#include <iostream>\n#include <cstdio>\n#include <stack>\n#include <cstring>\n\nusing namespace std;\n\nint a[20];\nbool memo[11][1024]; // memoization array for dfs\n\nbool check(int x) {\n    int pre = 0;\n    for (int i = 0; i < 10; i++) if (x & (1 << i)) {\n        if (a[i] < pre) return false;\n        pre = a[i];\n    }\n    return true;\n}\n\nbool iterative_dfs() {\n    stack<pair<int, pair<int, int>>> s;\n    s.push({1, {0, a[0]}});\n    \n    while (!s.empty()) {\n        auto [i, p] = s.top(); s.pop();\n        int x = p.first;\n        int pre = p.second;\n\n        if (i == 10) {\n            if (check(x)) return true;\n            continue;\n        }\n\n        if (memo[i][x]) continue; // check if already calculated\n        if (a[i] > pre) {\n            s.push({i + 1, {x, a[i]}});\n        }\n        s.push({i + 1, {x | (1 << i), pre}});\n        memo[i][x] = true; // mark as calculated\n    }\n    return false;\n}\n\nint main() {\n    int T;\n    scanf("%d", &T);\n    while (T--) {\n        for (int i = 0; i < 10; i++) scanf("%d", &a[i]);\n        memset(memo, false, sizeof(memo)); // clear memoization array\n        printf("%s\\n", iterative_dfs() ? "YES" : "NO");\n    }\n    return 0;\n}')"
