LineLLMCrossover(('source.cpp', 15), '#include <cstdio>\n#include <unordered_map>\n#include <vector>\n#include <string>\n#include <algorithm>\n#include <cstring>\n\nusing namespace std;\n\nunordered_map<string, bool> bmap;\nint card[10];\nint selected[4];\nbool used[10];\nint n, k, num;\n\nvoid solve(int m) {\n    if (m == k) {\n        string str;\n        for (int i = 0; i < k; i++) str += to_string(selected[i]);\n        if (bmap.find(str) == bmap.end()) num++;\n        bmap[str] = true;\n    } else {\n        for (int i = 0; i < n; i++) {\n            if (!used[i]) {\n                used[i] = true;\n                selected[m] = card[i];\n                solve(m + 1);\n                used[i] = false;\n            }\n        }\n    }\n}\n\nint main() {\n    while (scanf("%d %d", &n, &k), n) {\n        for (int i = 0; i < n; i++) scanf("%d", &card[i]);\n        memset(used, false, sizeof(used));\n        bmap.clear();\n        num = 0;\n        solve(0);\n        printf("%d\\n", num);\n    }\n}')
