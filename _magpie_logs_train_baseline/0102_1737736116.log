2025-01-24 16:30:03,257	[DEBUG]	patch(0-7)="LineLLMMutation(('source.cpp', 6), '#include <iostream>\n#include <vector>\n#include <algorithm>\nusing namespace std;\n\ntypedef long long i64;\n\nstruct ProblemData {\n    vector<i64> c, w, sum;\n    vector<vector<int>> dp;\n};\n\nint main() {\n    int n;\n    cin >> n;\n    ProblemData data;\n    data.c.resize(n);\n    data.w.resize(n);\n    data.sum.resize(n + 1, 0);\n    data.dp.resize(n + 1, vector<int>(n + 1, 1e9));\n\n    for(int i = 0; i < n; ++i) {\n        cin >> data.c[i] >> data.w[i];\n    }\n\n    for(int i = 1; i <= n; ++i) {\n        data.sum[i] = data.sum[i - 1] + data.w[i - 1];\n    }\n\n    for(int i = 0; i <= n; ++i) {\n        data.dp[i][i + 1] = 1;\n    }\n\n    for(int w = 2; w <= n; ++w) {\n        for(int l = 0; l < n; ++l) {\n            int r = l + w;\n            if(r > n) continue;\n\n            for(int mid = l + 1; mid < r; ++mid) {\n                data.dp[l][r] = min(data.dp[l][r], data.dp[l][mid] + data.dp[mid][r]);\n            }\n\n            i64 w_s_left = data.sum[r] - data.sum[l + 1];\n            if(data.c[l] >= w_s_left && data.dp[l + 1][r] == 1) {\n                data.dp[l][r] = 1;\n            }\n\n            i64 w_s_right = data.sum[r - 1] - data.sum[l];\n            if(data.c[r - 1] >= w_s_right && data.dp[l][r - 1] == 1) {\n                data.dp[l][r] = 1;\n            }\n        }\n    }\n\n    cout << data.dp[0][n] << endl;\n}')"

