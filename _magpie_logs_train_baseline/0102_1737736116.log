      data.cumulative_sum[i + 1] = data.cumulative_sum[i] + data.weights[i];\n    }\n\n    data.dp[0] = 0; // Base case\n\n    for(size_t l = 0; l < n; ++l) {\n        size_t r = l + 1; // Initialize r to be the next element\n        while (r <= n) {\n            i64 left_weight = data.cumulative_sum[r] - data.cumulative_sum[l + 1];\n            if(data.capacities[l] >= left_weight) {\n                data.dp[r] = min(data.dp[r], data.dp[l] + 1);\n            }\n\n            i64 right_weight = data.cumulative_sum[r - 1] - data.cumulative_sum[l];\n            if(data.capacities[r - 1] >= right_weight) {\n                data.dp[r] = min(data.dp[r], data.dp[l] + 1);\n            }\n            r++; // Move r to the next element\n        }\n    }\n\n    cout << data.dp[n] << endl; // Output the result for the entire array\n}')"
