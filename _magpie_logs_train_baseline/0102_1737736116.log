2025-01-24 16:29:53,811	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include <cstdio>\n#include <vector>\n#include <algorithm>\nusing namespace std;\n\ntypedef long long i64;\ntypedef pair<i64,i64> P;\n\nint n;\ni64 c[1010], w[1010], sum[1010];\nint dp[1010][1010];\n\nint main() {\n    scanf("%d", &n);\n    for(int i = 0; i < n; ++i) {\n        scanf("%lld %lld", &c[i], &w[i]);\n    }\n\n    for(int i = 1; i <= n; ++i) {\n        sum[i] = sum[i - 1] + w[i - 1];\n    }\n\n    auto getsum = [&](int l, int r) {\n        return sum[r] - sum[l];\n    };\n\n    for(int i = 0; i <= 1000; ++i) \n        for(int j = 0; j <= 1000; ++j) \n            dp[i][j] = 1e9;\n\n    for(int i = 0; i <= 1000; ++i) \n        dp[i][i + 1] = 1;\n\n    for(int w = 2; w <= n; ++w) {\n        for(int l = 0; l < n; ++l) {\n            int r = l + w;\n            if(r > n) continue;\n\n            for(int mid = l + 1; mid < r; ++mid) {\n                dp[l][r] = min(dp[l][r], dp[l][mid] + dp[mid][r]);\n            }\n\n            i64 w_s = getsum(l + 1, r);\n            if(c[l] >= w_s && dp[l + 1][r] == 1) {\n                dp[l][r] = 1;\n            }\n\n            w_s = getsum(l, r - 1);\n            if(c[r - 1] >= w_s && dp[l][r - 1] == 1) {\n                dp[l][r] = 1;\n            }\n        }\n    }\n\n    printf("%d\\n", dp[0][n]);\n}')"

