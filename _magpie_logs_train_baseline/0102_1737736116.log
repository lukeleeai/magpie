+l) {\n        i64 left_weight = 0; // Initialize left_weight outside the inner loop\n        for(size_t r = l + 1; r <= n; ++r) {\n            left_weight += data.weights[r - 1]; // Accumulate left_weight in a single pass\n            if(data.capacities[l] >= left_weight) {\n                dp[r] = min(dp[r], 1LL);\n            }\n\n            // Use accumulate for right_weight to minimize the need for cumulative_sum vector\n            i64 right_weight = accumulate(data.weights.begin() + l, data.weights.begin() + r, 0LL);\n            if(data.capacities[r - 1] >= right_weight) {\n                dp[r] = min(dp[r], 1LL);\n            }\n        }\n    }\n\n    cout << dp[n] << endl; // Output the result for the entire array\n}')"
