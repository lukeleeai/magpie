ons\n    for(size_t i = 0; i < n; ++i) {\n        i64 total_weight = 0;\n        for(size_t j = i + 1; j <= n; ++j) {\n            total_weight += data.weights[j - 1]; // Accumulate weights\n            if(data.capacities[i] >= total_weight) {\n                dp[j] = min(dp[j], dp[i] + 1);\n            }\n            if(j < n && data.capacities[j] >= (data.cumulative_sum[j] - data.cumulative_sum[i])) {\n                dp[j + 1] = min(dp[j + 1], dp[i] + 1);\n            }\n        }\n    }\n\n    cout << dp[n] << endl;\n}')"
