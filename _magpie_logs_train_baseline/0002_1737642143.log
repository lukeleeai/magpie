2025-01-23 14:27:41,151	[DEBUG]	patch(7-1)="LineLLMCrossover(('source.cpp', 20), '#include <cstdio>\n#include <numeric>\nusing namespace std;\n\nlong long gcd(long long a, long long b) {\n    while (b != 0) {\n        a %= b;\n        swap(a, b);\n    }\n    return a;\n}\n\nint main() {\n    long long num1, num2;\n    while (scanf("%lld %lld", &num1, &num2) == 2 && num1 >= 0 && num2 >= 0) {\n        long long gcdValue = gcd(num1, num2);\n        long long lcm = (num1 / gcdValue) * num2; // Direct calculation of LCM\n        printf("%lld %lld\\n", gcdValue, lcm);\n    }\n    if (num1 < 0 || num2 < 0) {\n        printf("Invalid input\\n");\n    }\n    return 0;\n}')"

