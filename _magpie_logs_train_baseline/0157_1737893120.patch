LineLLMCrossover(('source.cpp', 11), '#include <iostream>\n#include <vector>\n#include <unordered_set>\nusing namespace std;\n\nint n = {}, k = {};\nstring integer[11] = {};\nvector<string> num = {};\nint chousen[11] = {};\nunordered_set<string> complete_integer;\nstring answer;\nint integer_count = 0;\n\nvoid operation() {\n    for (int i = 1; i <= n; i++) {\n        if (chousen[i] == 0) {\n            chousen[i] = 1;\n            num.push_back(integer[i]);\n\n            if (num.size() == k) {\n                answer.clear();\n                for (const auto& str : num) {\n                    answer += str;\n                }\n                if (complete_integer.insert(answer).second) {\n                    integer_count++;\n                }\n            } else {\n                operation();\n            }\n            num.pop_back();\n            chousen[i] = 0;\n        }\n    }\n}\n\nint main() {\n    while (true) {\n        cin >> n >> k;\n        if (n == 0 && k == 0) break;\n\n        for (int i = 1; i <= n; i++) {\n            cin >> integer[i];\n        }\n\n        operation();\n        cout << integer_count << endl;\n\n        n = {};\n        k = {};\n        for (int i = 0; i <= 10; i++) {\n            integer[i] = {};\n            chousen[i] = {};\n        }\n        num.clear();\n        complete_integer.clear();\n        answer.clear();\n        integer_count = 0;\n    }\n    return 0;\n}')
