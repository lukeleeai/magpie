format_fitness = {:.2f}
format_ratio = {:.2%%}
format_patchif = 
	 --> {patch}
format_diffif = 
	{diff}

[software]
path = dataset/magpie_dataset/train/0221
target_files = 
	source.cpp
software = BasicSoftware
model_rules = 
