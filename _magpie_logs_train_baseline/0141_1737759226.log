2025-01-24 23:03:08,535	[DEBUG]	patch(4-5)="LineLLMCrossover(('source.cpp', 14), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\n#include <vector>\n#include <utility>\n\nusing namespace std;\n\ntypedef pair<int, int> pii;\n#define fst first\n#define scd second\n#define rep(i,x) for(int i=0;i<(x);++i)\n\nconst int inf = 1e9;\n\nint k[150];\nvector<pii> stone[150];\nint N, M;\nint memo[150][150]; // Reduced the third dimension to save space\n\nvoid clear_memo() {\n    for (int i = 0; i < 150; ++i)\n        for (int j = 0; j < 150; ++j)\n            memo[i][j] = -1; // Clear only 2D memoization\n}\n\ninline int rec(int n, int m, int i) {\n    if (n >= N - 1) return 0;\n    if (~memo[n][m]) return memo[n][m];\n\n    long long res = inf;\n    for (int j = 0; j < k[n + 1]; ++j) {\n        long long dist = (stone[n][i].scd + stone[n + 1][j].scd) * abs(stone[n][i].fst - stone[n + 1][j].fst);\n        res = min(res, dist + rec(n + 1, m, j));\n    }\n\n    if (m < M && n + 2 < N) {\n        for (int j = 0; j < k[n + 2]; ++j) {\n            long long dist = (stone[n][i].scd + stone[n + 2][j].scd) * abs(stone[n][i].fst - stone[n + 2][j].fst);\n            res = min(res, dist + rec(n + 2, m + 1, j));\n        }\n    }\n\n    return memo[n][m] = res;\n}\n\nsigned main() {\n    while (scanf("%d %d", &N, &M), N || M) {\n        rep(i, N) {\n            scanf("%d", &k[i]);\n            stone[i].resize(k[i]);\n            rep(j, k[i]) {\n                int x, d; scanf("%d %d", &x, &d);\n                stone[i][j] = make_pair(x, d);\n            }\n        }\n\n        int ans = inf;\n        rep(i, k[0]) {\n            clear_memo();\n            ans = min(ans, rec(0, 0, i));\n        }\n\n        if (M > 0) {\n            rep(i, k[1]) {\n                clear_memo();\n                ans = min(ans, rec(1, 1, i));\n            }\n        }\n\n        printf("%d\\n", ans);\n    }\n}')"

