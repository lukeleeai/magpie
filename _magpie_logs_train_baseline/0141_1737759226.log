2025-01-24 23:13:43,409	[DEBUG]	patch(9-10)="LineLLMCrossover(('source.cpp', 30), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\n#include <vector>\n#include <utility>\n\nusing namespace std;\n\ntypedef pair<int, int> pii;\n#define fst first\n#define scd second\n#define rep(i, x) for (int i = 0; i < (x); ++i)\n\nconst int inf = 1e9;\n\nint k[150];\nvector<pii> stone[150];\nint N, M;\nlong long dist[150][150][150]; // Precomputed distances\nint memo[150][150]; // Reduced the third dimension to 2D to save space\n\nvoid compute_distances() {\n    for (int n = 0; n < N; ++n) {\n        for (int j = 0; j < k[n]; ++j) {\n            for (int m = 0; m < k[n + 1]; ++m) {\n                dist[n][j][m] = (stone[n][j].scd + stone[n + 1][m].scd) * abs(stone[n][j].fst - stone[n + 1][m].fst);\n            }\n            if (n + 2 < N) {\n                for (int m = 0; m < k[n + 2]; ++m) {\n                    dist[n][j][m + k[n + 1]] = (stone[n][j].scd + stone[n + 2][m].scd) * abs(stone[n][j].fst - stone[n + 2][m].fst);\n                }\n            }\n        }\n    }\n}\n\ninline int rec(int n, int m, int i) {\n    if (n >= N - 1) return 0;\n    if (~memo[n][m]) return memo[n][m];\n\n    long long res = inf;\n    for (int j = 0; j < k[n + 1]; ++j) {\n        res = min(res, dist[n][i][j] + rec(n + 1, m, j));\n    }\n\n    if (m < M && n + 2 < N) {\n        for (int j = 0; j < k[n + 2]; ++j) {\n            res = min(res, dist[n][i][j + k[n + 1]] + rec(n + 2, m + 1, j));\n        }\n    }\n\n    return memo[n][m] = res;\n}\n\nsigned main() {\n    while (scanf("%d %d", &N, &M), N || M) {\n        rep(i, N) {\n            scanf("%d", &k[i]);\n            stone[i].resize(k[i]);\n            rep(j, k[i]) {\n                int x, d; scanf("%d %d", &x, &d);\n                stone[i][j] = make_pair(x, d);\n            }\n        }\n\n        compute_distances(); // Precompute distances\n\n        int ans = inf;\n        rep(i, k[0]) {\n            memset(memo, -1, sizeof(memo));\n            ans = min(ans, rec(0, 0, i));\n        }\n\n        if (M > 0) {\n            rep(i, k[1]) {\n                memset(memo, -1, sizeof(memo));\n                ans = min(ans, rec(1, 1, i));\n            }\n        }\n\n        printf("%d\\n", ans);\n    }\n}') | LineLLMMutation(('source.cpp', 45), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\n#include <vector>\n#include <utility>\n\nusing namespace std;\n\ntypedef pair<int, int> pii;\n#define fst first\n#define scd second\n#define rep(i, x) for (int i = 0; i < (x); ++i)\n\nconst int inf = 1e9;\n\nint k[150];\nvector<pii> stone[150];\nint N, M;\nlong long dist[150][150][150]; // Precomputed distances\nint memo[150][150]; // Reduced the third dimension to 2D to save space\n\nvoid compute_distances() {\n    for (int n = 0; n < N; ++n) {\n        for (int j = 0; j < k[n]; ++j) {\n            int x1 = stone[n][j].fst;\n            int d1 = stone[n][j].scd;\n            for (int m = 0; m < k[n + 1]; ++m) {\n                int x2 = stone[n + 1][m].fst;\n                int d2 = stone[n + 1][m].scd;\n                dist[n][j][m] = (d1 + d2) * abs(x1 - x2);\n            }\n            if (n + 2 < N) {\n                for (int m = 0; m < k[n + 2]; ++m) {\n                    int x3 = stone[n + 2][m].fst;\n                    dist[n][j][m + k[n + 1]] = (d1 + stone[n + 2][m].scd) * abs(x1 - x3);\n                }\n            }\n        }\n    }\n}\n\ninline int rec(int n, int m, int i) {\n    if (n >= N - 1) return 0;\n    if (~memo[n][m]) return memo[n][m];\n\n    long long res = inf;\n    for (int j = 0; j < k[n + 1]; ++j) {\n        res = min(res, dist[n][i][j] + rec(n + 1, m, j));\n    }\n\n    if (m < M && n + 2 < N) {\n        for (int j = 0; j < k[n + 2]; ++j) {\n            res = min(res, dist[n][i][j + k[n + 1]] + rec(n + 2, m + 1, j));\n        }\n    }\n\n    return memo[n][m] = res;\n}\n\nsigned main() {\n    while (scanf("%d %d", &N, &M), N || M) {\n        rep(i, N) {\n            scanf("%d", &k[i]);\n            stone[i].resize(k[i]);\n            rep(j, k[i]) {\n                int x, d; scanf("%d %d", &x, &d);\n                stone[i][j] = make_pair(x, d);\n            }\n        }\n\n        compute_distances(); // Precompute distances\n\n        int ans = inf;\n        rep(i, k[0]) {\n            memset(memo, -1, sizeof(memo));\n            ans = min(ans, rec(0, 0, i));\n        }\n\n        if (M > 0) {\n            rep(i, k[1]) {\n                memset(memo, -1, sizeof(memo));\n                ans = min(ans, rec(1, 1, i));\n            }\n        }\n\n        printf("%d\\n", ans);\n    }\n}')"
