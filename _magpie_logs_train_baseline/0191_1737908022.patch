LineLLMCrossover(('source.cpp', 12), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\n#define Rep(i,N) for(int i = 0; i < N; i++)\n\ninline void chmax(int &a, int b) { a = max(a, b); }\n\nint main() {\n    int N, M;\n    int A[5005], B[5005];\n    int maxv = 0;\n\n    scanf("%d %d", &N, &M);\n    Rep(i, N) scanf("%d", &A[i]);\n    Rep(i, M) scanf("%d", &B[i]);\n\n    int dp[5005] = {0}; // Single array for DP\n    Rep(i, M) {\n        for (int j = N - 1; j >= 0; j--) { // Backward traversal\n            if (A[j] == B[i]) chmax(dp[j + 1], dp[j] + 1);\n            chmax(maxv, dp[j + 1]);\n        }\n    }\n\n    printf("%d\\n", maxv);\n    return 0;\n}')
