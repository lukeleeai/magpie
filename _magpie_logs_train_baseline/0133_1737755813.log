2025-01-24 22:06:52,867	[DEBUG]	patch(6-5)="LineLLMCrossover(('source.cpp', 22), '#include <iostream>\n#include <cstdio>\n#include <algorithm>\n#include <vector>\n#include <queue>\nusing namespace std;\n\nlong long int cost[101][101], k, n, a, b, c, d, e, which;\nvector<long long> go(101);\nvector<bool> used(101);\n\nvoid dij(int s) {\n    fill(go.begin(), go.end(), 10000000);\n    fill(used.begin(), used.end(), false);\n    go[s] = 0;\n\n    priority_queue<pair<long long, int>, vector<pair<long long, int>>, greater<pair<long long, int>>> pq;\n    pq.push({0, s});\n\n    while (!pq.empty()) {\n        int v = pq.top().second;\n        pq.pop();\n        if (used[v]) continue;\n        used[v] = true;\n\n        for (int i = 0; i < 100; i++) {\n            if (go[v] + cost[v][i] < go[i]) {\n                go[i] = go[v] + cost[v][i];\n                pq.push({go[i], i});\n            }\n        }\n    }\n}\n\nint main() {\n    for (;;) {\n        cin >> n >> k;\n        if (n == 0 && k == 0) break;\n\n        fill(&cost[0][0], &cost[0][0] + sizeof(cost) / sizeof(cost[0][0]), 10000000);\n        for (int i = 0; i < k; i++) {\n            cin >> which;\n            if (!which) {\n                cin >> a >> b;\n                dij(a - 1);\n                cout << (go[b - 1] != 10000000 ? go[b - 1] : -1) << endl;\n            } else {\n                cin >> c >> d >> e;\n                cost[c - 1][d - 1] = min(cost[c - 1][d - 1], e);\n                cost[d - 1][c - 1] = min(cost[d - 1][c - 1], e);\n            }\n        }\n    }\n    return 0;\n}')"
