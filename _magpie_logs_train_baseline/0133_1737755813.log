/ Replacing priority_queue with a vector-based approach for optimization\n    vector<pair<long long, int>> pq;\n    pq.push_back({0, s});\n\n    while (!pq.empty()) {\n        // Sort the vector to get the minimum element (inefficient but for demonstration)\n        sort(pq.begin(), pq.end());\n        int v = pq.front().second;\n        pq.erase(pq.begin());\n\n        if (used[v]) continue;\n        used[v] = true;\n\n        for (int i = 0; i < 100; i++) {\n            if (go[v] + cost[v][i] < go[i]) {\n                go[i] = go[v] + cost[v][i];\n                pq.push_back({go[i], i});\n            }\n        }\n    }\n}\n\nint main() {\n    for (;;) {\n        cin >> n >> k;\n        if (n == 0 && k == 0) break;\n\n        fill(&cost[0][0], &cost[0][0] + sizeof(cost) / sizeof(cost[0][0]), 10000000);\n        for (int i = 0; i < k; i++) {\n            cin >> which;\n            if (!which) {\n                cin >> a >> b;\n                dij(a - 1);\n                cout << (go[b - 1] != 10000000 ? go[b - 1] : -1) << endl;\n            } else {\n                cin >> c >> d >> e;\n                cost[c - 1][d - 1] = min(cost[c - 1][d - 1], e);\n                cost[d - 1][c - 1] = min(cost[d - 1][c - 1], e);\n            }\n        }\n    }\n    return 0;\n}')"
