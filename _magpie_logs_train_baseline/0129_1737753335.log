 current sum\n    }\n    dfs(x + 1, currentSum); // Move to next row\n    \n    // Revert toggles and restore current sum\n    for (int i = 0; i < m; i++) {\n        currentSum -= (columnCount[i] > n / 2) ? 1 : -1; // Restore current sum\n        a[x][i] ^= 1; // Revert back\n        columnCount[i] += (a[x][i] ? 1 : -1); // Restore precomputed count\n    }\n    dfs(x + 1, currentSum); // Move to next row\n}\n\nint main() {\n    while (~scanf("%d%d", &n, &m)) {\n        if (n == 0 && m == 0) break;\n        memset(a, 0, sizeof(a));\n        memset(columnCount, 0, sizeof(columnCount)); // Initialize precomputed counts\n        ans = 0;\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < m; j++) {\n                scanf("%d", &a[i][j]);\n                columnCount[j] += a[i][j]; // Build initial count\n            }\n        }\n        dfs(0, 0); // Start dfs with initial sum as 0\n        printf("%d\\n", ans);\n    }\n    return 0;\n}')"
