; // Efficient calculation using precomputed counts\n    }\n\n    int currentMax = sum;\n\n    // Toggle and explore further\n    for (int i = 0; i < m; i++) {\n        a[x][i] ^= 1; // Toggle\n        columnCount[i] += (a[x][i] ? 1 : -1); // Adjust precomputed count\n    }\n    currentMax = max(currentMax, sum + dfs(x + 1));\n    \n    // Revert back\n    for (int i = 0; i < m; i++) {\n        a[x][i] ^= 1; // Revert back\n        columnCount[i] += (a[x][i] ? 1 : -1); // Restore precomputed count\n    }\n\n    // Explore without toggling\n    currentMax = max(currentMax, dfs(x + 1));\n    \n    // Store result in memoization map\n    memo[x] = currentMax;\n\n    return currentMax;\n}\n\nint main() {\n    while (~scanf("%d%d", &n, &m)) {\n        if (n == 0 && m == 0) break;\n        memset(a, 0, sizeof(a));\n        memset(columnCount, 0, sizeof(columnCount)); // Initialize precomputed counts\n        ans = 0;\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < m; j++) {\n                scanf("%d", &a[i][j]);\n                columnCount[j] += a[i][j]; // Build initial count\n            }\n        }\n        ans = dfs(0); // Call modified dfs\n        printf("%d\\n", ans);\n    }\n    return 0;\n}')"
