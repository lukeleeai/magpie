1 : 1); // Adjust precomputed count\n            a[x][i] ^= 1; // Toggle\n        }\n    }\n    dfs(x + 1, toggleMask); // Move to the next row\n    dfs(x + 1, ~toggleMask); // Explore the other path without toggling\n\n    // Revert changes back to original state\n    for(int i = 0; i < m; i++) {\n        if (toggleMask & (1 << i)) {\n            columnCount[i] += (a[x][i] ? 1 : -1);\n            a[x][i] ^= 1; // Revert toggle\n        }\n    }\n}\n\nint main() {\n    while(~scanf("%d%d", &n, &m)) {\n        if(n == 0 && m == 0) break;\n        memset(a, 0, sizeof(a));\n        memset(columnCount, 0, sizeof(columnCount));\n        ans = 0;\n        for(int i = 0; i < n; i++) {\n            for(int j = 0; j < m; j++) {\n                scanf("%d", &a[i][j]);\n                columnCount[j] += a[i][j]; // Build initial count\n            }\n        }\n        dfs(0, (1 << m) - 1); // Start DFS with all toggles possible\n        printf("%d\\n", ans);\n    }\n    return 0;\n}')"
