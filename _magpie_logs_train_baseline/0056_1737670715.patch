LineLLMCrossover(('source.cpp', 33), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\nint main() {\n    int n, m, a, b, cost, time, k, p, q, r;\n    int data[100][100][2]; // data[i][j][0] for time, data[i][j][1] for cost\n\n    for (;;) {\n        scanf("%d %d", &n, &m);\n        if (!n && !m) break;\n\n        // Optimize initialization of data array\n        for (int x = 0; x < m; x++) {\n            fill(data[x][0], data[x][0] + 2 * m, 1000000);\n            data[x][x][0] = 0;\n            data[x][x][1] = 0;\n        }\n\n        for (int i = 0; i < n; i++) {\n            scanf("%d %d %d %d", &a, &b, &cost, &time);\n            data[a - 1][b - 1][0] = time;\n            data[b - 1][a - 1][0] = time;\n            data[a - 1][b - 1][1] = cost;\n            data[b - 1][a - 1][1] = cost;\n        }\n\n        for (int x = 0; x < m; x++) {\n            for (int i = 0; i < m; i++) {\n                for (int j = 0; j < m; j++) {\n                    data[i][j][0] = min(data[i][j][0], data[i][x][0] + data[x][j][0]);\n                    data[i][j][1] = min(data[i][j][1], data[i][x][1] + data[x][j][1]);\n                }\n            }\n        }\n\n        scanf("%d", &k);\n        for (int i = 0; i < k; i++) {\n            scanf("%d %d %d", &p, &q, &r);\n            printf("%d\\n", data[p - 1][q - 1][r ? 0 : 1]);\n        }\n    }\n}')
