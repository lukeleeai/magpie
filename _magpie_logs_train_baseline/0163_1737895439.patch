LineLLMCrossover(('source.cpp', 4), '#include <vector>\n#include <iostream>\n#include <algorithm>\n#include <cstdio>\n#define INF (1 << 25)\nusing namespace std;\n\nint main() {\n    int N;\n    scanf("%d", &N);\n    vector<int> D(N - 1);\n    for (int i = 0; i < N - 1; i++) {\n        scanf("%d", &D[i]);\n    }\n\n    vector<vector<int>> dp(N / 2 + 1, vector<int>(2, INF));\n    dp[0][0] = 0;\n\n    for (int i = 1; i < N; i++) {\n        for (int j = N / 2; j >= 0; j--) {\n            dp[j][0] = min(dp[j][0], dp[j][1] + D[i - 1]);\n            if (j != 0) {\n                dp[j][1] = min(dp[j - 1][1], dp[j - 1][0] + D[i - 1]);\n            }\n        }\n    }\n\n    printf("%d\\n", min(dp[N / 2][0], dp[N / 2][1]));\n    return 0;\n}')
