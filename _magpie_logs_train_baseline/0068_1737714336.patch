LineLLMCrossover(('source.cpp', 30), '#include <cstdio>\n\nint main() {\n    int n;\n\n    while (scanf("%d", &n), n) {\n        int max_p = 0; // Start with max_p = 0 for better initialization\n        int max_d = -1; // Set max_d to -1 to avoid unnecessary comparisons\n\n        for (int i = 0; i < n; i++) {\n            int p, d1, d2;\n            scanf("%d %d %d", &p, &d1, &d2); // Combined input for efficiency\n\n            int total_d = d1 + d2; // Efficient total distance calculation\n            if (total_d > max_d) {\n                max_d = total_d;\n                max_p = p; // Update max_p based on the best total_d\n            }\n        }\n\n        printf("%d %d\\n", max_p, max_d);\n    }\n}')
