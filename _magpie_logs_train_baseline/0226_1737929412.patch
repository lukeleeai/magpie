LineLLMCrossover(('source.cpp', 5), '#include <cstdio>\n#include <cctype>\n#include <deque>\n#include <algorithm>\n#include <cstring>\nusing namespace std;\n\n#define REP(i, N) for(int i=0; i<(int)(N); ++i)\n\nint unit[20];\nint need[20];\n\nint nextInt() {\n    int r = 0, ch;\n    while (isspace(ch = getchar()));\n    do { r = r * 10 + ch - \'0\'; } while (isdigit(ch = getchar()));\n    return r;\n}\n\nbool visited[1 << 20];\n\nstruct State {\n    int one, mask, have;\n};\n\nint solve(int N, int U) {\n    memset(visited, 0, sizeof(visited));\n    deque<State> up;\n    State s = {0, 0, 0};\n    visited[s.mask] = 1;\n    up.push_back(s);\n\n    while (!up.empty()) {\n        s = up.front(); up.pop_front();\n        if (s.have >= U) return s.one;\n\n        for (int i = 0; i < N; i++) {\n            if (visited[s.mask | (1 << i)] == 0 && (s.mask | need[i]) == s.mask) {\n                State next = {s.one + 1, s.mask | (1 << i), s.have + unit[i]};\n                visited[next.mask] = 1;\n                up.push_back(next);\n            }\n        }\n    }\n    return -1;\n}\n\nint main() {\n    for (;;) {\n        int N = nextInt(), U = nextInt();\n        if (N == 0 && U == 0) break;\n\n        memset(need, 0, sizeof(need));\n        int all = 0;\n        REP(i, N) {\n            unit[i] = nextInt();\n            all += unit[i];\n            int K = nextInt();\n            REP(k, K) {\n                int x = nextInt();\n                need[i] |= (1 << x);\n            }\n        }\n\n        if (all == U) {\n            printf("%d\\n", N);\n            continue;\n        }\n\n        int best = solve(N, U);\n        printf("%d\\n", best);\n    }\n}') + LineLLMMutation(('source.cpp', 19), '#include <cstdio>\n#include <cctype>\n#include <deque>\n#include <algorithm>\n#include <cstring>\nusing namespace std;\n\n#define REP(i, N) for(int i=0; i<(int)(N); ++i)\n\nint unit[20];\nint need[20];\n\nint nextInt() {\n    int r = 0;\n    int ch;\n    while (isspace(ch = getchar())); // Skip whitespace\n    do {\n        r = r * 10 + (ch - \'0\'); // Convert character to integer\n    } while (isdigit(ch = getchar())); // Read until a non-digit\n    return r;\n}\n\nbool visited[1 << 20];\n\nstruct State {\n    int one, mask, have;\n};\n\nint solve(int N, int U) {\n    memset(visited, 0, sizeof(visited));\n    deque<State> up;\n    State s = {0, 0, 0};\n    visited[s.mask] = 1;\n    up.push_back(s);\n\n    while (!up.empty()) {\n        s = up.front(); up.pop_front();\n        if (s.have >= U) return s.one;\n\n        for (int i = 0; i < N; i++) {\n            if (!visited[s.mask | (1 << i)] && (s.mask | need[i]) == s.mask) {\n                State next = {s.one + 1, s.mask | (1 << i), s.have + unit[i]};\n                visited[next.mask] = 1;\n                up.push_back(next);\n            }\n        }\n    }\n    return -1;\n}\n\nint main() {\n    for (;;) {\n        int N = nextInt(), U = nextInt();\n        if (N == 0 && U == 0) break;\n\n        memset(need, 0, sizeof(need));\n        int all = 0;\n        REP(i, N) {\n            unit[i] = nextInt();\n            all += unit[i];\n            int K = nextInt();\n            REP(k, K) {\n                int x = nextInt();\n                need[i] |= (1 << x);\n            }\n        }\n\n        if (all == U) {\n            printf("%d\\n", N);\n            continue;\n        }\n\n        int best = solve(N, U);\n        printf("%d\\n", best);\n    }\n}')
