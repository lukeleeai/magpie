2025-01-26 17:48:12,491	[DEBUG]	patch(3-4)="LineLLMMutation(('source.cpp', 25), '#include <cstdio>  \n#include <iostream>  \nusing namespace std;  \n  \nint main() {  \n    int N; // total data input  \n    long long sum = 0; // buffer for sum  \n    long long MaxMin = 0; // final result  \n    scanf("%d", &N);  \n  \n    int inputBuffer; // buffer for input data  \n    long long a1_sum, a2_sum; // sum of region1, region2  \n  \n    // Using a single array for input and calculation, avoiding unnecessary duplication  \n    int InArray[N];  \n  \n    for (int i = 0; i < N; i++) {  \n        scanf("%d", &inputBuffer);  \n        InArray[i] = inputBuffer;  \n        sum += inputBuffer; // Calculate sum on the go  \n    }  \n  \n    long long average = (sum + 2) / 3; // Compute average with ceiling division  \n  \n    for (int a1 = 0; a1 < N; a1++) {  \n        a1_sum = 0;  \n        for (int a2 = a1 + 1; a2 < N; a2++) {  \n            a1_sum += InArray[a2 - 1];  \n            if (a1_sum < average) continue;  \n  \n            long long average2 = (sum - a1_sum + 1) / 2;  \n  \n            a2_sum = 0;  \n            for (int a3 = a2 + 1; a3 < N; a3++) {  \n                a2_sum += InArray[a3 - 1];  \n                if (a2_sum < average2) continue;  \n  \n                MaxMin = max(MaxMin, a2_sum - InArray[a3 - 1]);  \n                MaxMin = max(MaxMin, sum - a1_sum - a2_sum);  \n                break;  \n            }  \n            break;  \n        }  \n    }  \n  \n    printf("%lld\\n", MaxMin);  \n    return 0;  \n}')"
