delete_prob = 0.0
offspring_elitism = 0.2
offspring_crossover = 0.4
offspring_mutation = 0.4
uniform_rate = 0.5
batch_reset = True
llm_type = baseline

[search.minify]
do_cleanup = True
do_rebuild = True
do_simplify = True
round_robin_limit = 3


