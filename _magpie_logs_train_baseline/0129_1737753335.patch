LineLLMCrossover(('source.cpp', 33), '#include <cstdio>\n#include <cstring>\nusing namespace std;\n\nint n, m, ans;\nint a[11][100001];\nint columnCount[100001];\n\nvoid dfs(int x) {\n    if (x >= n) return;\n\n    int sum = 0;\n    for (int i = 0; i < m; i++) {\n        sum += (columnCount[i] > n / 2) ? columnCount[i] : (n - columnCount[i]);\n    }\n\n    if (sum > ans) ans = sum;\n    dfs(x + 1);\n    \n    for (int i = 0; i < m; i++) {\n        a[x][i] ^= 1; // Toggle\n        columnCount[i] += (a[x][i] ? 1 : -1);\n    }\n    dfs(x + 1);\n    \n    for (int i = 0; i < m; i++) {\n        a[x][i] ^= 1; // Revert back\n        columnCount[i] += (a[x][i] ? 1 : -1);\n    }\n}\n\nint main() {\n    while (~scanf("%d%d", &n, &m)) {\n        if (n == 0 && m == 0) break;\n        memset(a, 0, sizeof(a));\n        memset(columnCount, 0, sizeof(columnCount)); \n        ans = 0;\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < m; j++) {\n                scanf("%d", &a[i][j]);\n                columnCount[j] += a[i][j];\n            }\n        }\n        dfs(0);\n        printf("%d\\n", ans);\n    }\n    return 0;\n}')
