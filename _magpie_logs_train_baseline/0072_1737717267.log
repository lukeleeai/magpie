2025-01-24 11:20:39,073	[DEBUG]	patch(3-3)="LineLLMCrossover(('source.cpp', 11), '#include <iostream>\n#include <vector>\n#include <stack>\nusing namespace std;\n\nbool visit[26];\nvector<int> g[26];\n\nbool dfs(int v) {\n    stack<int> s;\n    s.push(v);\n    visit[v] = true;\n    bool f = false;\n\n    while (!s.empty()) {\n        int curr = s.top();\n        s.pop();\n        for (int i : g[curr]) {\n            if (!visit[i]) {\n                visit[i] = true;\n                s.push(i);\n                f = true;\n            }\n        }\n    }\n    return f;\n}\n\nint graph_num(void) {\n    int res = 0;\n    for (int i = 0; i < 26; i++)\n        if (!visit[i] && dfs(i)) res++;\n    return res;\n}\n\nint main() {\n    int n, pre[26] = {0}, suf[26] = {0}, h, t;\n    string s;\n\n    while (cin >> n && n) {\n        fill(begin(visit), end(visit), false);\n        \n        for (int i = 0; i < 26; i++) g[i].clear();\n\n        for (int i = 0; i < n; i++) {\n            cin >> s;\n            h = s[0] - \'a\', t = s[s.size() - 1] - \'a\';\n            pre[h]++;\n            suf[t]++;\n            g[h].push_back(t);\n            g[t].push_back(h);\n        }\n\n        if (graph_num() != 1) cout << "NG\\n";\n        else {\n            cout << (equal(begin(pre), end(pre), begin(suf)) ? "OK\\n" : "NG\\n");\n        }\n    }\n}')"
