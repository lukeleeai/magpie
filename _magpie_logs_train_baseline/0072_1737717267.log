  return res;\n}\n\nint main() {\n    int n, pre[26], suf[26], h, t;\n    string s;\n\n    while (cin >> n && n) {\n        fill(begin(visit), end(visit), false);\n        fill(begin(pre), end(pre), 0);\n        fill(begin(suf), end(suf), 0);\n        \n        for (auto& neighbors : g) neighbors.clear(); // clear the adjacency list\n\n        for (int i = 0; i < n; i++) {\n            cin >> s;\n            h = s[0] - \'a\', t = s[s.size() - 1] - \'a\';\n            pre[h]++;\n            suf[t]++;\n            g[h].insert(t); // set edge for h -> t\n            g[t].insert(h); // set edge for t -> h\n        }\n\n        if (graph_num() != 1) cout << "NG\\n";\n        else {\n            bool equal = true;\n            for (int i = 0; i < 26; i++) {\n                if (pre[i] != suf[i]) {\n                    equal = false;\n                    break;\n                }\n            }\n            cout << (equal ? "OK\\n" : "NG\\n");\n        }\n    }\n}')"
