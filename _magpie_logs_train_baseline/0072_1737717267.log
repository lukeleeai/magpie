2025-01-24 11:22:56,014	[DEBUG]	patch(5-8)="LineLLMCrossover(('source.cpp', 14), '#include <iostream>\n#include <array>\nusing namespace std;\n\nbool visit[26];\narray<array<int, 26>, 26> g;\n\nbool dfs(int v) {\n    visit[v] = true;\n    bool f = false;\n\n    for (int i = 0; i < 26; i++) {\n        if (g[v][i] && !visit[i]) {\n            f = true;\n            dfs(i);\n        }\n    }\n    return f;\n}\n\nint graph_num(void) {\n    int res = 0;\n    for (int i = 0; i < 26; i++)\n        if (!visit[i] && dfs(i)) res++;\n    return res;\n}\n\nint main() {\n    int n, pre[26], suf[26], h, t;\n    string s;\n\n    while (cin >> n && n) {\n        fill(begin(visit), end(visit), false);\n        fill(begin(pre), end(pre), 0);\n        fill(begin(suf), end(suf), 0);\n        \n        g.fill(array<int, 26>{}); // clear the adjacency list\n\n        for (int i = 0; i < n; i++) {\n            cin >> s;\n            h = s[0] - \'a\', t = s[s.size() - 1] - \'a\';\n            pre[h]++;\n            suf[t]++;\n            g[h][t] = 1; // set edge for h -> t\n            g[t][h] = 1; // set edge for t -> h\n        }\n\n        if (graph_num() != 1) cout << "NG\\n";\n        else {\n            bool equal = true;\n            for (int i = 0; i < 26; i++) {\n                if (pre[i] != suf[i]) {\n                    equal = false;\n                    break;\n                }\n            }\n            cout << (equal ? "OK\\n" : "NG\\n");\n        }\n    }\n}')"
