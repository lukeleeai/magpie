LineLLMMutation(('source.cpp', 20), '#include <iostream>\n#include <vector>\n#include <map>\n#include <queue>\nusing namespace std;\n\ninline int upb(int n) {\n    return 32 - __builtin_clz(n);\n}\n\nint main() {\n    vector<bool> close(1 << (5 * 5), false);\n    vector<int> cls(1000000);\n    int cls_cnt = 0;\n\n    for (int n; cin >> n, !(n == 0); ) {\n        vector<vector<int>> pats(n * n + 1);\n        vector<vector<int>> tmp(n, vector<int>(n, 0));\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                for (int k = i; k < n; k++) {\n                    for (int l = j; l < n; l++) {\n                        for (int a = i; a <= k; a++)\n                            for (int b = j; b <= l; b++)\n                                tmp[a][b] = 1;\n\n                        int bd = 0;\n                        for (int a = 0; a < n; a++) {\n                            for (int b = 0; b < n; b++) {\n                                bd = (bd << 1) | tmp[a][b];\n                            }\n                        }\n\n                        pats[upb(bd)].push_back(bd);\n                        for (int a = i; a <= k; a++)\n                            for (int b = j; b <= l; b++)\n                                tmp[a][b] = 0;\n                    }\n                }\n            }\n        }\n\n        int bd = 0;\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                int t; cin >> t;\n                bd = (bd << 1) | t;\n            }\n        }\n\n        queue<int> mm;\n        mm.push(bd);\n        close[bd] = true;\n        cls[cls_cnt++] = bd;\n        while (!mm.empty()) {\n            int dep = mm.front() >> 25;\n            int cbd = mm.front() & 0x1ffffff;\n            mm.pop();\n\n            int ub = 32 - __builtin_clz(cbd);\n            const vector<int> &ps = pats[ub];\n            int sz = ps.size();\n            for (int i = 0; i < sz; i++) {\n                int nbd = cbd ^ ps[i];\n                if (nbd == 0) {\n                    for (int i = 0; i <= dep; i++)\n                        cout << "myon";\n                    cout << endl;\n                    goto _exit;\n                }\n                if (close[nbd]) continue;\n                close[nbd] = true;\n                cls[cls_cnt++] = nbd;\n                mm.push(((dep + 1) << 25) | nbd);\n            }\n        }\n    _exit:;\n        for (int i = 0; i < cls_cnt; i++)\n            close[cls[i]] = false;\n        cls_cnt = 0;\n    }\n    return 0;\n}')
