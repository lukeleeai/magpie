ontinue;\n                dp[nx][ny][nup][nsouth][neast] = ncost;\n                q.push({ncost, nx, ny, nup, nsouth, neast});\n            }\n        }\n\n        int best = dp[0][0][0][0][0];\n        for (int i = 1; i <= 6; ++i)\n            for (int j = 1; j <= 6; ++j)\n                for (int k = 1; k <= 6; ++k)\n                    best = min(best, dp[goalX][goalY][i][j][k]);\n                    \n        cout << best << endl;\n    }\n}')"
