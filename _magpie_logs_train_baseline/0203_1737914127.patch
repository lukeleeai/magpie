LineLLMMutation(('source.cpp', 1), '#include <iostream>\n#include <cstdint>\n\nusing namespace std;\n\nuint64_t N;\n\nint8_t L[100000], _L[100000];\n\nint main(void) {\n    cin >> N;\n    for (uint64_t i = 0; i < N; i++) {\n        cin >> L[i];\n    }\n\n    L[N] = -1;\n    bool loop = true;\n    uint64_t itr1 = 0, itr2 = 0;\n    uint64_t result = 0;\n\n    while (loop) {\n        while (L[itr1] != L[itr1 + 1] && itr1 < N - 1) {\n            itr1++;\n        }\n        itr2 = itr1 + 1;\n        while (L[itr2] != L[itr2 + 1] && itr2 < N - 1) {\n            itr2++;\n        }\n\n        for (uint64_t i = 0; i <= N; i++) {\n            _L[i] = L[i];\n        }\n\n        for (uint64_t i = itr1 + 1; i <= itr2; i++) {\n            _L[i] = (L[i] == 0) ? 1 : 0;\n        }\n\n        uint64_t upper = itr1, downer = itr1, count = 1;\n        while (upper > 0 && _L[upper] != _L[upper - 1]) {\n            upper--;\n            count++;\n        }\n        while (downer < N - 1 && _L[downer] != _L[downer + 1]) {\n            downer++;\n            count++;\n        }\n\n        result = max(result, count);\n        itr1++;\n\n        if (itr2 >= N - 1) {\n            loop = false;\n        }\n    }\n\n    cout << result << endl;\n    return 0;\n}')
