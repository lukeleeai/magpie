LineLLMCrossover(('source.cpp', 13), '#include <cstdio>\nusing namespace std;\n\nint main() {\n    int k, c;\n\n    while (scanf("%d", &k), k) {\n        int totalInputs = k * (k - 1) / 2;\n        int inputs[totalInputs]; // Preallocate to hold inputs\n\n        int a = 0; // Initialize sum\n        for (int i = 0; i < totalInputs; i++) {\n            scanf("%d", &inputs[i]);\n            a += inputs[i]; // Accumulate the sum\n        }\n        printf("%d\\n", a / (k - 1)); // Print average\n    }\n}')
