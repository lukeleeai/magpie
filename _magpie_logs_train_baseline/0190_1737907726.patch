LineLLMMutation(('source.cpp', 8), '#include<iostream>\n#include<algorithm>\n#include<vector>\nusing namespace std;\n\nint countMatches(const vector<int>& s, const vector<int>& t, int start) {\n    int p = 0, q = start, cnt = 0;\n    while(p < s.size() && q < t.size()){\n        if(s[p] == t[q]){\n            cnt++;\n            p++;\n            q++;\n        } else {\n            p++;\n        }\n    }\n    return cnt;\n}\n\nint main(){\n    int a, b;\n    cin >> a >> b;\n    vector<int> s(a), t(b);\n\n    for(int i = 0; i < a; i++){\n        cin >> s[i];\n    }\n    for(int i = 0; i < b; i++){\n        cin >> t[i];\n    }\n\n    int ret = 0;\n    for(int i = 0; i < b; i++){\n        ret = max(ret, countMatches(s, t, i));\n    }\n\n    cout << ret << endl;\n}')
