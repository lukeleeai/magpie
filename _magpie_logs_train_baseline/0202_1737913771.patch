LineLLMCrossover(('source.cpp', 10), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\nint n;\nint a[100012]; // Increased size for boundaries\nint dp[100010][3];\n\nint main() {\n    scanf("%d", &n);\n    for (int i = 1; i <= n; i++) {\n        scanf("%d", &a[i]);\n    }\n    a[0] = a[1] ^ 1;\n    a[n + 1] = a[n] ^ 1;\n\n    for (int i = 1; i <= n; i++) {\n        if (a[i - 1] ^ a[i]) {\n            dp[i][0] = dp[i - 1][0] + 1;\n            dp[i][1] = dp[i - 1][1] + 1;\n            dp[i][2] = dp[i - 1][2] + 1;\n        } else {\n            dp[i][0] = 1;\n            dp[i][1] = dp[i - 1][0] + 1;\n            dp[i][2] = dp[i - 1][1] + 1;\n        }\n    }\n\n    printf("%d\\n", *max_element(dp[1], dp[n + 1] + 3));\n}')
