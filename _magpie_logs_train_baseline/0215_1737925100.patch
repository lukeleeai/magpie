LineLLMCrossover(('source.cpp', 12), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\nconst int MAX_SIZE = 1000001;\nint n, key, cnt, ans;\nint t[MAX_SIZE];\n\nint main() {\n    while (scanf("%d", &n), n) {\n        for (int i = 0; i < n; i++) {\n            scanf("%d", &t[i]);\n        }\n\n        sort(t, t + n);\n        key = t[0];\n        cnt = 1;\n        ans = -1;\n\n        for (int i = 1; i < n; i++) {\n            if (key == t[i]) {\n                cnt++;\n            } else {\n                if (cnt > n / 2) {\n                    ans = key;\n                    break; // Exit early if majority found\n                }\n                key = t[i];\n                cnt = 1;\n            }\n        }\n\n        // Final check for last counted key\n        if (cnt > n / 2) ans = key;\n\n        if (ans == -1) printf("NO COLOR\\n");\n        else printf("%d\\n", ans);\n    }\n    return 0;\n}')
