2025-01-26 18:23:39,989	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include <cstdio>\n#include <vector>\n#include <algorithm>\n\nusing namespace std;\n\ntypedef long long ll;\ntypedef pair<int, int> pii;\n\n#define fst first\n#define scd second\n#define PB push_back\n#define rep(i,x) for(int i=0;i<(x);++i)\n\nconst ll inf = 3e18;\n\nstruct edge {\n    int to, cost;\n    edge(int to, int cost) : to(to), cost(cost) {}\n};\n\nint N, M, C;\nll d[100000];\nvector<edge> G[100000];\nbool found[100000];\nbool used[100000][100000];\n\nvoid dijkstra(int s) {\n    priority_queue<pii, vector<pii>, greater<pii>> q;\n    fill(d, d + N, inf);\n    d[s] = 0;\n    q.push(pii(0, s));\n    while (q.size()) {\n        pii p = q.top(); q.pop();\n        int v = p.scd;\n        if (d[v] < p.fst) continue;\n        rep(i, G[v].size()) {\n            edge e = G[v][i];\n            if (d[e.to] > d[v] + e.cost) {\n                d[e.to] = d[v] + e.cost;\n                q.push(pii(d[e.to], e.to));\n            }\n        }\n    }\n}\n\nsigned main() {\n    scanf("%d %d %d", &N, &M, &C);\n    ll sum = 0;\n    rep(i, M) {\n        int A, B, D; scanf("%d %d %d", &A, &B, &D), A--, B--;\n        G[A].PB(edge(B, D));\n        G[B].PB(edge(A, D));\n        sum += D;\n    }\n    dijkstra(0);\n    found[0] = true;\n    ll mi = inf;\n    for (auto &entry : m) {\n        ll X = entry.fst;\n        vector<int> vs = entry.scd;\n        rep(i, vs.size()) found[vs[i]] = true;\n        rep(i, vs.size()) {\n            int v = vs[i];\n            rep(j, G[v].size()) {\n                edge e = G[v][j];\n                if (!found[e.to]) continue;\n                if (used[v][e.to]) continue;\n                used[v][e.to] = used[e.to][v] = true;\n                sum -= e.cost;\n            }\n        }\n        mi = min(mi, sum + C * X);\n    }\n    printf("%lld\\n", mi);\n}')"
