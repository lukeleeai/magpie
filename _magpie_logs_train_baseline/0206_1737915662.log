2025-01-26 18:26:57,149	[DEBUG]	patch(3-5)="LineLLMMutation(('source.cpp', 22), '#include <cstdio>\n#include <vector>\n#include <queue>\n#include <functional>\n#include <algorithm>\n\nusing namespace std;\n\ntypedef long long ll;\ntypedef pair<int, int> pii;\n\nconst ll inf = 3e18;\n\nstruct edge {\n    int to, cost;\n    edge(int to, int cost) : to(to), cost(cost) {}\n};\n\nint N, M, C;\nll d[100000];\nvector<edge> G[100000];\nbool found[100000];\nmap<int, bool> used[100000];\n\nvoid dijkstra(int s) {\n    priority_queue<pii, vector<pii>, greater<pii>> q;\n    fill(d, d + N, inf);\n    d[s] = 0;\n    q.push(pii(0, s));\n    while (q.size()) {\n        pii p = q.top(); q.pop();\n        int v = p.scd;\n        if (d[v] < p.fst) continue;\n        for (const auto& e : G[v]) {\n            if (d[e.to] > d[v] + e.cost) {\n                d[e.to] = d[v] + e.cost;\n                q.push(pii(d[e.to], e.to));\n            }\n        }\n    }\n}\n\nsigned main() {\n    scanf("%d %d %d", &N, &M, &C);\n    ll sum = 0;\n    for (int i = 0; i < M; ++i) {\n        int A, B, D; \n        scanf("%d %d %d", &A, &B, &D), A--, B--;\n        G[A].push_back(edge(B, D));\n        G[B].push_back(edge(A, D));\n        sum += D;\n    }\n    dijkstra(0);\n    found[0] = true;\n    ll mi = inf;\n    for (auto itr = m.begin(); itr != m.end(); ++itr) {\n        ll X = itr->fst;\n        vector<int> vs = itr->scd;\n        for (int v : vs) found[v] = true;\n        for (int v : vs) {\n            for (const auto& e : G[v]) {\n                if (!found[e.to]) continue;\n                if (used[v][e.to]) continue;\n                used[v][e.to] = used[e.to][v] = true;\n                sum -= e.cost;\n            }\n        }\n        mi = min(mi, sum + C * X);\n    }\n    printf("%lld\\n", mi);\n}')"
