2025-01-26 18:25:51,443	[DEBUG]	patch(2-9)="LineLLMMutation(('source.cpp', 20), '#include <cstdio>\n#include <queue>\n#include <utility>\n\nusing namespace std;\n\ntypedef long long ll;\ntypedef pair<int, int> pii;\n\nconst ll inf = 3e18;\nconst int MAXN = 100000;\n\nstruct edge {\n    int to, cost;\n};\n\nint N, M, C;\nll d[MAXN];\nedge G[MAXN][MAXN]; // Use fixed-size array\nint edgeCount[MAXN] = {0}; // To keep track of edges\n\nvoid dijkstra(int s) {\n    priority_queue<pii, vector<pii>, greater<pii>> q;\n    fill(d, d + N, inf);\n    d[s] = 0;\n    q.push(pii(0, s));\n    while (!q.empty()) {\n        pii p = q.top(); q.pop();\n        int v = p.second;\n        if (d[v] < p.first) continue;\n        for (int i = 0; i < edgeCount[v]; i++) {\n            edge e = G[v][i];\n            if (d[e.to] > d[v] + e.cost) {\n                d[e.to] = d[v] + e.cost;\n                q.push(pii(d[e.to], e.to));\n            }\n        }\n    }\n}\n\nsigned main() {\n    scanf("%d %d %d", &N, &M, &C);\n    ll sum = 0;\n    for (int i = 0; i < M; ++i) {\n        int A, B, D; scanf("%d %d %d", &A, &B, &D), A--, B--;\n        G[A][edgeCount[A]++] = edge{B, D};\n        G[B][edgeCount[B]++] = edge{A, D};\n        sum += D;\n    }\n    dijkstra(0);\n    printf("%lld\\n", sum);\n}')"
