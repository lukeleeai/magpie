2025-01-26 18:26:57,794	[DEBUG]	patch(3-8)="LineLLMMutation(('source.cpp', 25), '#include <cstdio>\n#include <queue>\n#include <unordered_map>\n#include <algorithm>\n\nusing namespace std;\n\ntypedef long long ll;\ntypedef pair<int, int> pii;\n\nconst ll inf = 3e18;\nconst int max_n = 100000;\n\nstruct edge {\n    int to, cost;\n    edge(int to, int cost) : to(to), cost(cost) {}\n};\n\nint N, M, C;\nll d[max_n];\nedge G[max_n][max_n]; // Assuming max_n edges per node for simplicity\nint edge_count[max_n] = {0}; // To keep track of number of edges for each node\nbool found[max_n];\nunordered_map<int, bool> used[max_n];\n\nvoid dijkstra(int s) {\n    priority_queue<pii, vector<pii>, greater<pii>> q;\n    fill(d, d + N, inf);\n    d[s] = 0;\n    q.push(pii(0, s));\n    while (q.size()) {\n        pii p = q.top(); q.pop();\n        int v = p.scd;\n        if (d[v] < p.fst) continue;\n        for (int i = 0; i < edge_count[v]; ++i) {\n            edge e = G[v][i];\n            if (d[e.to] > d[v] + e.cost) {\n                d[e.to] = d[v] + e.cost;\n                q.push(pii(d[e.to], e.to));\n            }\n        }\n    }\n}\n\nsigned main() {\n    scanf("%d %d %d", &N, &M, &C);\n    ll sum = 0;\n    for (int i = 0; i < M; ++i) {\n        int A, B, D; \n        scanf("%d %d %d", &A, &B, &D), A--, B--;\n        G[A][edge_count[A]++] = edge(B, D);\n        G[B][edge_count[B]++] = edge(A, D);\n        sum += D;\n    }\n    dijkstra(0);\n    found[0] = true;\n    ll mi = inf;\n    for (auto itr = m.begin(); itr != m.end(); ++itr) {\n        ll X = itr->first;\n        vector<int> vs = itr->second;\n        for (int v : vs) found[v] = true;\n        for (int v : vs) {\n            for (int j = 0; j < edge_count[v]; ++j) {\n                edge e = G[v][j];\n                if (!found[e.to]) continue;\n                if (used[v][e.to]) continue;\n                used[v][e.to] = used[e.to][v] = true;\n                sum -= e.cost;\n            }\n        }\n        mi = min(mi, sum + C * X);\n    }\n    printf("%lld\\n", mi);\n}')"
