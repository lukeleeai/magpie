2025-01-26 18:25:50,189	[DEBUG]	patch(2-5)="LineLLMMutation(('source.cpp', 16), '#include <cstdio>\n#include <vector>\n#include <queue>\n#include <functional>\n#include <utility>\n\nusing namespace std;\n\ntypedef long long ll;\ntypedef pair<int, int> pii;\n\nconst ll inf = 3e18;\n\nstruct edge {\n    int to, cost;\n    edge(int to, int cost) : to(to), cost(cost) {}\n};\n\nint N, M, C;\nll d[100000];\nvector<edge> G[100000];\n\nvoid dijkstra(int s) {\n    priority_queue<pii, vector<pii>, greater<pii>> q;\n    fill(d, d + N, inf);\n    d[s] = 0;\n    q.push(pii(0, s));\n    while (!q.empty()) {\n        pii p = q.top(); q.pop();\n        int v = p.second;\n        if (d[v] < p.first) continue;\n        for (const auto& e : G[v]) {\n            if (d[e.to] > d[v] + e.cost) {\n                d[e.to] = d[v] + e.cost;\n                q.push(pii(d[e.to], e.to));\n            }\n        }\n    }\n}\n\nsigned main() {\n    scanf("%d %d %d", &N, &M, &C);\n    ll sum = 0;\n    for (int i = 0; i < M; ++i) {\n        int A, B, D; scanf("%d %d %d", &A, &B, &D), A--, B--;\n        G[A].push_back(edge(B, D));\n        G[B].push_back(edge(A, D));\n        sum += D;\n    }\n    dijkstra(0);\n    printf("%lld\\n", sum);\n}')"
