2025-01-26 18:28:22,794	[DEBUG]	patch(4-9)="LineLLMMutation(('source.cpp', 32), '#include <cstdio>\n#include <vector>\n#include <algorithm>\n#include <queue>\n\nusing namespace std;\n\ntypedef long long ll;\ntypedef pair<int, int> pii;\n\n#define fst first\n#define scd second\n#define PB push_back\n#define rep(i,x) for(int i=0;i<(x);++i)\n\nconst ll inf = 3e18;\nconst int maxn = 100000;\n\nstruct edge {\n    int to, cost;\n    edge(int to, int cost) : to(to), cost(cost) {}\n};\n\nint N, M, C;\nll d[maxn];\nvector<edge> G[maxn];\nbool found[maxn] = {false};\nbool used[maxn][maxn] = {false};\n\nvoid dijkstra(int s) {\n    priority_queue<pii, vector<pii>, greater<pii> > q;\n    fill(d, d + N, inf);\n    d[s] = 0;\n    q.push(pii(0, s));\n    while (q.size()) {\n        pii p = q.top(); q.pop();\n        int v = p.scd;\n        if (d[v] < p.fst) continue;\n        rep(i, G[v].size()) {\n            edge e = G[v][i];\n            if (d[e.to] > d[v] + e.cost) {\n                d[e.to] = d[v] + e.cost;\n                q.push(pii(d[e.to], e.to));\n            }\n        }\n    }\n}\n\nsigned main() {\n    scanf("%d %d %d", &N, &M, &C);\n    ll sum = 0;\n    rep(i, M) {\n        int A, B, D; scanf("%d %d %d", &A, &B, &D), A--, B--;\n        G[A].PB(edge(B, D));\n        G[B].PB(edge(A, D));\n        sum += D;\n    }\n    dijkstra(0);\n    found[0] = true;\n    ll mi = inf;\n    vector<vector<int>> m(inf + 1);\n    m[0] = vector<int>();\n    for (ll X = 0; X <= inf; X++) {\n        vector<int> vs = m[X];\n        for (int v : vs) {\n            found[v] = true;\n            rep(j, G[v].size()) {\n                edge e = G[v][j];\n                if (found[e.to]) continue;\n                if (used[v][e.to]) continue;\n                used[v][e.to] = used[e.to][v] = true;\n                sum -= e.cost;\n            }\n        }\n        mi = min(mi, sum + C * X);\n    }\n    printf("%lld\\n", mi);\n}')"
