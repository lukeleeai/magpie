+) {\n        all_step += DFS(node1[i].h, node1[i].w, node1[i + 1].h, node1[i + 1].w);\n        memset(vis, 0, sizeof(vis));\n    }\n\n    printf("%d\\n", all_step);\n    return 0;\n}')"
