= \'0\' && s[i][j] <= \'9\') {\n                node1[k].h = i;\n                node1[k].w = j;\n                node1[k].value = s[i][j] - \'0\';\n                k++;\n                s[i][j] = \'.\';\n            } else if (s[i][j] == \'S\') {\n                s_h = i;\n                s_w = j;\n                s[i][j] = \'.\';\n            }\n        }\n    }\n\n    sort(node1 + 1, node1 + N + 1, cmp);\n    node1[0].h = s_h;\n    node1[0].w = s_w;\n\n    for (i = 0; i < N; i++) {\n        e_h = node1[i + 1].h;\n        e_w = node1[i + 1].w;\n        s_h = node1[i].h;\n        s_w = node1[i].w;\n        all_step += DFS(s_h, s_w, e_h, e_w);\n        memset(vis, 0, sizeof(vis));\n    }\n\n    printf("%d\\n", all_step);\n    return 0;\n}')"
