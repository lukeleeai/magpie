2025-01-26 13:47:42,302	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include <cstdio>\n#include <string>\n#include <cstring>\n#include <algorithm>\n#include <iostream>\n#include <queue>\n\nusing namespace std;\n\nint direction[4][2] = { { -1, 0 }, { 1, 0 }, { 0, -1 }, {0,1} };\n\nstruct node {\n    int w, h;\n    int step;\n};\n\nstruct node2 {\n    int h, w, value;\n};\n\nint H, W, N;\nstring s[1005];\nint vis[1005][1005];\n\nint cmp(node2 a, node2 b) {\n    return a.value < b.value;\n}\n\nint DFS(int begin_h, int begin_w, int end_h, int end_w) {\n    int i, j;\n    queue<node> Q;\n    node temp;\n    temp.h = begin_h;\n    temp.w = begin_w;\n    temp.step = 0;\n    Q.push(temp);\n    vis[begin_h][begin_w] = 1;\n\n    while (!Q.empty()) {\n        node temp1 = Q.front();\n        Q.pop();\n        if (temp1.h == end_h && temp1.w == end_w) {\n            return temp1.step;\n        }\n        for (i = 0; i < 4; i++) {\n            if (temp1.h + direction[i][0] >= 0 && temp1.h + direction[i][0] < H &&\n                temp1.w + direction[i][1] >= 0 && temp1.w + direction[i][1] < W &&\n                !vis[temp1.h + direction[i][0]][temp1.w + direction[i][1]] && \n                s[temp1.h + direction[i][0]][temp1.w + direction[i][1]] == \'.\') {\n                \n                node temp2;\n                temp2.h = temp1.h + direction[i][0];\n                temp2.w = temp1.w + direction[i][1];\n                temp2.step = temp1.step + 1;\n                vis[temp1.h + direction[i][0]][temp1.w + direction[i][1]] = 1;\n                Q.push(temp2);\n            }\n        }\n    }\n}\n\nint main(void) {\n    memset(vis, 0, sizeof(vis));\n    int i, j, k = 1;\n    int all_step = 0;\n    int s_h, s_w, e_h, e_w;\n\n    scanf("%d%d%d", &H, &W, &N);\n    node2 node1[20];\n\n    for (i = 0; i < H; i++) {\n        char buffer[1005];\n        scanf("%s", buffer);\n        s[i] = buffer;\n        for (j = 0; j < s[i].length(); j++) {\n            if (s[i][j] >= \'0\' && s[i][j] <= \'9\') {\n                node1[k].h = i;\n                node1[k].w = j;\n                node1[k].value = s[i][j] - \'0\';\n                k++;\n                s[i][j] = \'.\';\n            } else if (s[i][j] == \'S\') {\n                s_h = i;\n                s_w = j;\n                s[i][j] = \'.\';\n            }\n        }\n    }\n\n    sort(node1 + 1, node1 + N + 1, cmp);\n    node1[0].h = s_h;\n    node1[0].w = s_w;\n\n    for (i = 0; i < N; i++) {\n        e_h = node1[i + 1].h;\n        e_w = node1[i + 1].w;\n        s_h = node1[i].h;\n        s_w = node1[i].w;\n        all_step += DFS(s_h, s_w, e_h, e_w);\n        memset(vis, 0, sizeof(vis));\n    }\n\n    printf("%d\\n", all_step);\n    return 0;\n}')"

