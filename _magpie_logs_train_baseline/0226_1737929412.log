2025-01-26 22:13:41,546	[DEBUG]	patch(1-10)="LineLLMMutation(('source.cpp', 13), '#include <cstdio>\n#include <cctype>\n#include <queue>\n#include <algorithm>\n#include <cstring>\nusing namespace std;\n\n#define REP(i, N) for(int i=0; i<(int)(N); ++i)\n\nint unit[20];\nint need[20];\n\nint nextInt() { int r = 0, ch; while (isspace(ch = getchar())); do { r = r * 10 + ch - \'0\'; } while (isdigit(ch = getchar())); return r; }\n\nbool visited[1 << 20];\n\nstruct State {\n  int one, mask, have;\n  bool operator<(const State& t) const {\n    if (one != t.one) return one > t.one;\n    return have < t.have;\n  }\n};\n\nvoid readInputs(int N) {\n  for (int i = 0; i < N; ++i) {\n    scanf("%d", &unit[i]);\n    int K;\n    scanf("%d", &K);\n    for (int k = 0; k < K; ++k) {\n      int x;\n      scanf("%d", &x);\n      need[i] |= (1 << x);\n    }\n  }\n}\n\nint solve(int N, int U) {\n  memset(visited, 0, sizeof(visited));\n  queue<State> up;\n  State s;\n  s.one = 0;\n  s.mask = 0;\n  s.have = 0;\n  visited[s.mask] = 1;\n  up.push(s);\n\n  while (!up.empty()) {\n    s = up.front(); up.pop();\n\n    if (s.have >= U) return s.one;\n\n    for (int i = 0; i < N; i++)\n      if (visited[s.mask | (1 << i)] == 0 && (s.mask | need[i]) == s.mask) {\n        State next;\n        next.mask = s.mask | (1 << i);\n        next.one = s.one + 1;\n        next.have = s.have + unit[i];\n        visited[next.mask] = 1;\n        up.push(next);\n      }\n  }\n  return -1;\n}\n\nint main() {\n  for (;;) {\n    int N, U;\n    N = nextInt();\n    U = nextInt();\n    if (N == 0 && U == 0) break;\n\n    memset(need, 0, sizeof(need));\n    \n    readInputs(N); // Bulk read inputs\n\n    int all = 0;\n    REP(i, N) all += unit[i];\n\n    if (all == U) {\n      printf("%d\\n", N);\n      continue;\n    }\n\n    int best = solve(N, U);\n    printf("%d\\n", best);\n  }\n}')"

