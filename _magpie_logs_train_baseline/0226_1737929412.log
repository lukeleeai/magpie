2025-01-26 22:13:41,059	[DEBUG]	patch(1-9)="LineLLMMutation(('source.cpp', 12), '#include <cstdio>\n#include <cctype>\n#include <queue>\n#include <algorithm>\n#include <cstring>\nusing namespace std;\n\n#define REP(i, N) for(int i=0; i<(int)(N); ++i)\n\nint unit[20];\nint need[20];\n\nint nextInt() { int r = 0, ch; while (isspace(ch = getchar())); do { r = r * 10 + ch - \'0\'; } while (isdigit(ch = getchar())); return r; }\n\nbool visited[1 << 20];\n\nstruct State {\n  int one, mask, have;\n  bool operator<(const State& t) const {\n    if (one != t.one) return one > t.one; // Max-heap based on `one`\n    return have < t.have; // Min-heap based on `have`\n  }\n};\n\nint solve(int N, int U) {\n  memset(visited, 0, sizeof(visited));\n  priority_queue<State> up; // Changed from queue to priority_queue\n  State s;\n  s.one = 0;\n  s.mask = 0;\n  s.have = 0;\n  visited[s.mask] = 1;\n  up.push(s);\n  \n  while (!up.empty()) {\n    s = up.top(); up.pop();\n\n    if (s.have >= U) return s.one;\n\n    for (int i = 0; i < N; i++)\n      if (visited[s.mask | (1 << i)] == 0 && (s.mask | need[i]) == s.mask) {\n        State next;\n        next.mask = s.mask | (1 << i);\n        next.one = s.one + 1;\n        next.have = s.have + unit[i];\n        visited[next.mask] = 1;\n        up.push(next);\n      }\n  }\n  return -1;\n}\n\nint main() {\n  for (;;) {\n    int N, U;\n    N = nextInt();\n    U = nextInt();\n    if (N == 0 && U == 0) break;\n\n    REP(i, N) need[i] = 0;\n\n    int all = 0;\n    REP(i, N) {\n      unit[i] = nextInt();\n      all += unit[i];\n      int K = nextInt();\n      REP(k, K) {\n        int x = nextInt();\n        need[i] |= (1 << x);\n      }\n    }\n\n    if (all == U) {\n      printf("%d\\n", N);\n      continue;\n    }\n\n    int best = solve(N, U);\n    printf("%d\\n", best);\n  }\n}')"
