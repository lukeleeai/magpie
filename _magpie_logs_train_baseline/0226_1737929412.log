2025-01-26 22:17:28,885	[DEBUG]	patch(3-4)="LineLLMCrossover(('source.cpp', 8), '#include <cstdio>\n#include <cctype>\n#include <queue>\n#include <algorithm>\n#include <cstring>\nusing namespace std;\n\n#define REP(i, N) for(int i=0; i<(int)(N); ++i)\n\nint unit[20];\nint need[20];\n\nint nextInt() {\n    int r = 0, ch;\n    while (isspace(ch = getchar()));\n    do { r = r * 10 + ch - \'0\'; } while (isdigit(ch = getchar()));\n    return r;\n}\n\nbool visited[1 << 20];\n\nstruct State {\n    int one, mask, have;\n    bool operator<(const State& t) const {\n        if (one != t.one) return one > t.one;\n        return have < t.have;\n    }\n};\n\nvoid readInputs(int N) {\n    for (int i = 0; i < N; ++i) {\n        unit[i] = nextInt();\n        int K = nextInt();\n        for (int k = 0; k < K; ++k) {\n            int x = nextInt();\n            need[i] |= (1 << x);\n        }\n    }\n}\n\nint solve(int N, int U) {\n    memset(visited, 0, sizeof(visited));\n    priority_queue<State> up;\n    State s = {0, 0, 0};\n    visited[s.mask] = 1;\n    up.push(s);\n    \n    while (!up.empty()) {\n        s = up.top(); up.pop();\n        if (s.have >= U) return s.one;\n\n        for (int i = 0; i < N; ++i) {\n            if (visited[s.mask | (1 << i)] == 0 && (s.mask | need[i]) == s.mask) {\n                State next = {s.one + 1, s.mask | (1 << i), s.have + unit[i]};\n                visited[next.mask] = 1;\n                up.push(next);\n            }\n        }\n    }\n    return -1;\n}\n\nint main() {\n    for (;;) {\n        int N = nextInt(), U = nextInt();\n        if (N == 0 && U == 0) break;\n\n        memset(need, 0, sizeof(need));\n        readInputs(N);\n\n        int all = 0;\n        REP(i, N) all += unit[i];\n\n        if (all == U) {\n            printf("%d\\n", N);\n            continue;\n        }\n\n        int best = solve(N, U);\n        printf("%d\\n", best);\n    }\n}')"
