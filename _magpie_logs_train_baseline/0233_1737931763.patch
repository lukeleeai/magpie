LineLLMCrossover(('source.cpp', 14), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\n#include <vector>\n#include <utility>\n\nusing namespace std;\n\n#define SZ(v) ((int)(v).size())\n\nconst int maxint = -1u >> 1;\nconst int maxn = 130;\n\ntypedef long long ll;\n\nint n, m;\nshort adjacency[maxn][maxn]; // Improved variable name\nint f[maxn], bestf[maxn];\n\nint find(int v) {\n    return v != bestf[v] ? bestf[v] = find(bestf[v]) : v;\n}\n\nll mincut() {\n    ll ans = (-1ull) >> 1;\n    for (int i = 0; i < n; ++i) {\n        f[i] = i;\n    }\n    for (int t = n; t > 1; --t) {\n        bool a[maxn] = {false};\n        ll w[maxn] = {0};\n        a[0] = true;\n        for (int i = 1; i < t; ++i) {\n            a[i] = false;\n            w[i] = adjacency[0][i];\n        }\n        int prev = 0;\n        for (int i = 1; i < t; ++i) {\n            int zj = -1;\n            for (int j = 1; j < t; ++j) {\n                if (!a[j] && (zj == -1 || w[j] > w[zj])) {\n                    zj = j;\n                }\n            }\n            a[zj] = true;\n            if (i == t - 1) {\n                if (w[zj] < ans) {\n                    ans = w[zj];\n                    copy(f, f + n, bestf);\n                }\n                for (int k = 0; k < t; ++k) {\n                    adjacency[k][prev] += adjacency[zj][k];\n                }\n                f[zj] = prev;\n                break;\n            }\n            prev = zj;\n            for (int j = 1; j < t; ++j) {\n                if (!a[j]) {\n                    w[j] += adjacency[zj][j];\n                }\n            }\n        }\n    }\n    return ans;\n}\n\nvoid gao() {\n    ll total = 0;\n    memset(adjacency, 0, sizeof(adjacency)); // Optimized initialization\n    for (int i = 0; i < m; ++i) {\n        int a, b;\n        ll c;\n        scanf("%d%d%lld", &a, &b, &c);\n        total += (c < 0) ? c : 0; // accumulate negative costs\n        if (c >= 0) {\n            adjacency[a][b] += c;\n            adjacency[b][a] += c;\n        }\n    }\n    printf("%lld\\n", total + mincut());\n}\n\nint main() {\n    while (scanf("%d%d", &n, &m) == 2 && (n || m)) {\n        gao();\n    }\n    return 0;\n}')
