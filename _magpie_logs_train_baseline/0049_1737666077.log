2025-01-23 21:06:14,959	[DEBUG]	patch(2-4)="LineLLMCrossover(('source.cpp', 5), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\n#include <array>\n\nusing namespace std;\n\ntypedef long long LL;\n#define N 2010\n#define INF 0x3f3f3f\n\nint n;\narray<array<int, N>, N> maps;\narray<int, N> dist, vis;\n\nvoid Init(int m) {\n    for(int i = 0; i <= m; i++)\n        fill(maps[i].begin(), maps[i].end(), INF);\n    for(int i = 0; i <= m; i++)\n        maps[i][i] = 0; // Set self-distances to 0\n}\n\nvoid dij(int s, int m) {\n    for(int i = 0; i <= m; i++)\n        dist[i] = maps[s][i];\n    fill(vis.begin(), vis.end(), 0);\n    vis[s] = 1;\n\n    for(int i = 0; i <= m; i++) {\n        int Min = INF, index = -1;\n        for(int j = 0; j <= m; j++) {\n            if(!vis[j] && dist[j] < Min) {\n                Min = dist[j];\n                index = j;\n            }\n        }\n        if(index == -1) continue;\n        vis[index] = 1;\n        for(int j = 0; j <= m; j++) {\n            if(!vis[j] && dist[j] > Min + maps[index][j])\n                dist[j] = Min + maps[index][j];\n        }\n    }\n}\n\nint main() {\n    int a, b, c, Max, index, sum;\n    while(scanf("%d", &n), n) {\n        Init(1100);\n        Max = -1;\n        for(int i = 1; i <= n; i++) {\n            scanf("%d%d%d", &a, &b, &c);\n            maps[a][b] = maps[b][a] = min(maps[a][b], c);\n            Max = max(Max, max(a, b));\n        }\n        int s;\n        sum = INF;\n        for(int i = 0; i <= Max; i++) {\n            dij(i, Max);\n            s = 0;\n            for(int j = 0; j <= Max; j++)\n                s += dist[j];\n            if(s < sum) {\n                index = i;\n                sum = s;\n            }\n        }\n        printf("%d %d\\n", index, sum);\n    }\n    return 0;\n}')"
