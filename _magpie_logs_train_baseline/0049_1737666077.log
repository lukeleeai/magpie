f3f3f\n\nint n;\narray<array<int, N>, N> maps;\narray<int, N> dist, vis;\n\nvoid Init(int m) {\n    for(int i = 0; i <= m; i++)\n        fill(maps[i].begin(), maps[i].end(), INF);\n    for(int i = 0; i <= m; i++)\n        maps[i][i] = 0;\n}\n\nvoid dij(int s, int m) {\n    fill(dist.begin(), dist.end(), INF);\n    dist[s] = 0;\n    priority_queue<pair<int, int>, vector<pair<int, int>>, greater<pair<int, int>>> pq;\n    pq.push({0, s}); // {distance, node}\n    \n    while(!pq.empty()) {\n        int Min = pq.top().first;\n        int index = pq.top().second;\n        pq.pop();\n        \n        if (Min > dist[index]) continue; // Skip outdated entry\n        \n        for(int j = 0; j <= m; j++) {\n            if(dist[j] > Min + maps[index][j]) {\n                dist[j] = Min + maps[index][j];\n                pq.push({dist[j], j});\n            }\n        }\n    }\n}\n\nint main() {\n    int a, b, c, Max, index, sum;\n    while(scanf("%d", &n), n) {\n        Init(1100);\n        Max = -1;\n        for(int i = 1; i <= n; i++) {\n            scanf("%d%d%d", &a, &b, &c);\n            maps[a][b] = maps[b][a] = min(maps[a][b], c);\n            Max = max(Max, max(a, b));\n        }\n        int s;\n        sum = INF;\n        for(int i = 0; i <= Max; i++) {\n            dij(i, Max);\n            s = 0;\n            for(int j = 0; j <= Max; j++)\n                s += dist[j];\n            if(s < sum) {\n                index = i;\n                sum = s;\n            }\n        }\n        printf("%d %d\\n", index, sum);\n    }\n    return 0;\n}')"
