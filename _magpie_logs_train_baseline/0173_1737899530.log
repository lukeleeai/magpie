2025-01-26 14:00:39,044	[DEBUG]	patch(4-8)="LineLLMCrossover(('source.cpp', 14), '#include <cstdio>\n#include <cstring>\n#include <deque>\n\n#define MAX_H 1100\n#define MAX_W 1100\n\nstruct status {\n    int x, y, step, n;\n};\n\nint dx[4] = {1, 0, -1, 0};\nint dy[4] = {0, 1, 0, -1};\n\nint H, W, N;\nchar maze[MAX_H][MAX_W];\nint flag[MAX_H][MAX_W] = {0};\nint xs, ys;\nstd::deque<status> Q;\n\nint BFS();\n\nint main() {\n    while (scanf("%d%d%d", &H, &W, &N) == 3) {\n        for (int i = 0; i < H; i++) {\n            for (int j = 0; j < W; j++) {\n                scanf(" %c", &maze[i][j]);\n                if (maze[i][j] == \'S\') {\n                    xs = j;\n                    ys = i;\n                }\n            }\n        }\n        printf("%d\\n", BFS());\n    }\n}\n\nint BFS() {\n    Q.clear();\n    Q.push_back({xs, ys, 0, 1});\n    while (!Q.empty()) {\n        status tmp = Q.front(); Q.pop_front();\n        for (int i = 0; i < 4; i++) {\n            int cx = tmp.x + dx[i], cy = tmp.y + dy[i];\n            if (cx < 0 || cx >= W || cy < 0 || cy >= H || maze[cy][cx] == \'X\') continue;\n\n            int cn = (maze[cy][cx] - \'0\' == tmp.n) ? tmp.n + 1 : tmp.n;\n            if (cn == N + 1) return tmp.step + 1;\n            if (flag[cy][cx] >= cn) continue;\n\n            flag[cy][cx] = cn;\n            Q.push_back({cx, cy, tmp.step + 1, cn});\n        }\n    }\n    return -1;\n}')"
