2025-01-26 13:53:26,188	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include <cstdio>\n#include <cstring>\n#include <queue>\n\n#define MAX_H 1100\n#define MAX_W 1100\n\nstruct status {\n    int x, y, step, n;\n};\n\nint dx[4] = {1, 0, -1, 0};\nint dy[4] = {0, 1, 0, -1};\n\nint H, W, N;\nchar maze[MAX_H][MAX_W];\nint flag[MAX_H][MAX_W];\nint xs, ys;\nstd::queue<status> Q;\n\nint BFS();\n\nint main() {\n    while (scanf("%d%d%d", &H, &W, &N) == 3) {\n        getchar(); // consume newline\n        for (int i = 0; i < H; i++) {\n            fgets(maze[i], MAX_W, stdin);\n        }\n\n        for (int j = 0; j < H; j++) {\n            for (int i = 0; i < W; i++) {\n                if (maze[j][i] == \'S\') {\n                    xs = i;\n                    ys = j;\n                    break;\n                }\n            }\n        }\n        memset(flag, 0, sizeof(flag));\n        printf("%d\\n", BFS());\n    }\n}\n\nint BFS() {\n    while (!Q.empty()) Q.pop();\n    status start = {xs, ys, 0, 1};\n    Q.push(start);\n\n    while (!Q.empty()) {\n        status tmp = Q.front(); Q.pop();\n        for (int i = 0; i < 4; i++) {\n            int cx = tmp.x + dx[i], cy = tmp.y + dy[i], cstep = tmp.step + 1, cn = tmp.n;\n\n            if (cx < 0 || cx >= W || cy < 0 || cy >= H || maze[cy][cx] == \'X\') continue;\n            cn = (maze[cy][cx] - \'0\' == tmp.n) ? tmp.n + 1 : tmp.n;\n\n            if (cn == N + 1) return cstep;\n            if (flag[cy][cx] >= cn) continue;\n\n            flag[cy][cx] = cn;\n            Q.push({cx, cy, cstep, cn});\n        }\n    }\n    return -1;\n}')"
