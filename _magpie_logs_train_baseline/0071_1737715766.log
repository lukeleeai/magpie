2025-01-24 11:14:19,450	[DEBUG]	patch(9-6)="LineLLMCrossover(('source.cpp', 35), '#include <iostream>\n#include <vector>\n#include <map>\n#include <limits>\n#include <unordered_map>\n#include <queue>\n#include <cstdio>\nusing namespace std;\n\n#define MAX 1000\n#define INF (1e9)\n\nstruct Edge {\n    int to, cost, c;\n    Edge(int to, int cost, int c) : to(to), cost(cost), c(c) {}\n};\n\nint main() {\n    int M, D, N, K;\n    while (scanf("%d%d%d%d", &M, &N, &K, &D), M) {\n        unordered_map<int, vector<Edge>> G;\n        vector<int> cake(M);\n        for (int i = 0; i < M; i++) {\n            scanf("%d", &cake[i]);\n        }\n        int idx = 0, c;\n        string a, b;\n        map<string, int> mp;\n        for (int i = 0; i < D; i++) {\n            cin >> a >> b >> c;\n            if (!mp.count(a)) mp[a] = idx++;\n            if (!mp.count(b)) mp[b] = idx++;\n            G[mp[a]].emplace_back(mp[b], c, (a[0] == \'C\') ? a[1] - \'1\' : -1);\n            G[mp[b]].emplace_back(mp[a], c, (b[0] == \'C\') ? b[1] - \'1\' : -1);\n        }\n\n        int s = mp["H"], t = mp["D"];\n        int d[MAX][1 << 6];\n        fill(d[0], d[0] + MAX * (1 << 6), INF);\n        d[s][0] = 0;\n\n        using State = pair<int, pair<int, int>>; // {cost, {node, state}}\n        priority_queue<State, vector<State>, greater<State>> pq;\n        pq.push({0, {s, 0}});\n\n        while (!pq.empty()) {\n            auto [cost, state] = pq.top(); pq.pop();\n            int node = state.first, S = state.second;\n\n            if (cost > d[node][S]) continue;\n\n            for (auto &edge : G[node]) {\n                int ncost = cost + edge.cost * K;\n                if (edge.c == -1) {\n                    if (ncost < d[edge.to][S]) {\n                        d[edge.to][S] = ncost;\n                        pq.push({ncost, {edge.to, S}});\n                    }\n                } else {\n                    if (S >> edge.c & 1) continue;\n                    if (ncost - cake[edge.c] < d[edge.to][S | (1 << edge.c)]) {\n                        d[edge.to][S | (1 << edge.c)] = ncost - cake[edge.c];\n                        pq.push({d[edge.to][S | (1 << edge.c)], {edge.to, S | (1 << edge.c)}});\n                    }\n                }\n            }\n        }\n\n        int res = INF;\n        for (int i = 0; i < (1 << 6); i++) {\n            res = min(res, d[t][i]);\n        }\n\n        printf("%d\\n", res);\n    }\n    return 0;\n}')"
