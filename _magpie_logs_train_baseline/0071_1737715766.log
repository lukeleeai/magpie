 d[edge.to][S | (1 << edge.c)]) {\n                        d[edge.to][S | (1 << edge.c)] = ncost - cake[edge.c];\n                        pq.push({d[edge.to][S | (1 << edge.c)], {edge.to, S | (1 << edge.c)}});\n                    }\n                }\n            }\n        }\n\n        int res = INF;\n        for (int i = 0; i < (1 << 6); i++) {\n            res = min(res, d[t][i]);\n        }\n\n        printf("%d\\n", res);\n    }\n    return 0;\n}')"
