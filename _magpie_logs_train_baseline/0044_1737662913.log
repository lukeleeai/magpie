ation\n}\n\nint func(int kaidan) {\n    if (kaidan == 0) return 1; // Base case\n    if (kaidan == 1) return 1; // Base case\n    if (kaidan == 2) return 2; // Base case\n\n    vector<int> dp(kaidan + 1); // Dynamic programming array\n    dp[0] = 1; dp[1] = 1; dp[2] = 2; // Initialize base cases\n\n    for (int now = 3; now <= kaidan; ++now) {\n        dp[now] = dp[now - 1] + dp[now - 2] + dp[now - 3]; // Calculate current based on previous three\n    }\n\n    return dp[kaidan]; // Return the result for kaidan\n}\n\nint main() {\n    int n, ans;\n    while (cin >> n && n != 0) {\n        ans = func(n);\n        cout << calculate(ans) << endl; // Use inline function\n    }\n    return 0;\n}')"
