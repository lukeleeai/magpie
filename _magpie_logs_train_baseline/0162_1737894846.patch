LineLLMCrossover(('source.cpp', 15), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\n\n#define MAX_N 500000\n#define INF 2000000000\n\nint dp[2][MAX_N][2];\nint n, a[MAX_N];\n\nvoid init_dp() {\n    for (int i = 0; i < 2; i++)\n        for (int j = 0; j < MAX_N; j++)\n            dp[i][j][0] = dp[i][j][1] = INF; // Direct initialization\n    dp[0][0][0] = 0; // Initialize dp\n}\n\nint main() {\n    scanf("%d", &n);\n    for (int i = 1; i < n; i++) { scanf("%d", &a[i]); }\n    init_dp();\n    for (int i = 0; i < n; i++) {\n        for (int j = 0; j < n; j++) {\n            if (dp[0][j][0] < INF) {\n                dp[1][j + 1][0] = min(dp[1][j + 1][0], dp[0][j][0]);\n                dp[1][j + 1][1] = min(dp[1][j + 1][1], dp[0][j][0] + a[i + 1]);\n            }\n            if (dp[0][j][1] < INF) {\n                dp[1][j][1] = min(dp[1][j][1], dp[0][j][1]);\n                dp[1][j][0] = min(dp[1][j][0], dp[0][j][1] + a[i + 1]);\n            }\n        }\n        for (int j = 0; j <= n; j++) {\n            dp[0][j][0] = dp[1][j][0];\n            dp[0][j][1] = dp[1][j][1];\n            dp[1][j][0] = INF;\n            dp[1][j][1] = INF;\n        }\n    }\n    printf("%d\\n", min(dp[0][n / 2][0], dp[0][n / 2][1]));\n    return 0;\n}')
