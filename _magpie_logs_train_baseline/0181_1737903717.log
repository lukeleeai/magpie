< m; ++i) {\n        cin >> a >> b >> l;\n        rd.emplace_back(a, b, l); // Use emplace_back for efficiency\n        town[a].emplace_back(b, l); // Use emplace_back for efficiency\n        town[b].emplace_back(a, l); // Use emplace_back for efficiency\n    }\n\n    for (int i = 0; i < k; ++i) {\n        cin >> s;\n        qu.push(make_pair(0, s));\n        len[s] = 0; // Initialize the starting point directly\n    }\n\n    while (!qu.empty()) {\n        pii pi = qu.top();\n        qu.pop();\n        if (pi.first > len[pi.second]) continue; // Early exit for already processed nodes\n\n        for (const auto& it : town[pi.second]) {\n            int new_length = pi.first + it.second;\n            if (new_length < len[it.first]) {\n                len[it.first] = new_length;\n                qu.push(make_pair(new_length, it.first));\n            }\n        }\n    }\n\n    s = 0;\n    for (const auto& it : rd) {\n        s = max(s, max(len[it.a], len[it.b]) + (len[it.b] - len[it.a] + it.l + 1) / 2);\n    }\n\n    cout << s << endl;\n}')"
