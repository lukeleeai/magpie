2025-01-26 15:10:05,253	[DEBUG]	patch(4-3)="LineLLMCrossover(('source.cpp', 8), '#include <iostream>\n#include <algorithm>\n#include <vector>\n#include <queue>\n#include <unordered_map>\n#include <utility>\n\nusing namespace std;\n\nstruct road {\n    int a, b, l;\n    road(int a_, int b_, int l_) : a(a_), b(b_), l(l_) {}\n};\n\ntypedef pair<int, int> pii;\n\nint main() {\n    int n, m, k, a, b, l, s;\n    vector<road> rd;\n    unordered_map<int, vector<pii>> town; \n    int len[3001];\n    priority_queue<pii, vector<pii>, greater<pii>> qu;\n\n    cin >> n >> m >> k;\n    for (int i = 0; i < m; ++i) {\n        cin >> a >> b >> l;\n        rd.push_back(road(a, b, l));\n        town[a].emplace_back(b, l);\n        town[b].emplace_back(a, l);\n    }\n\n    for (int i = 0; i < k; ++i) {\n        cin >> s;\n        qu.push(make_pair(0, s));\n    }\n\n    fill(len, len + n + 1, -1);\n    while (!qu.empty()) {\n        pii pi = qu.top();\n        qu.pop();\n        if (len[pi.second] == -1) {\n            len[pi.second] = pi.first;\n            for (const auto& neighbor : town[pi.second]) {\n                qu.push(make_pair(pi.first + neighbor.second, neighbor.first));\n            }\n        }\n    }\n\n    s = 0;\n    for (const auto& it : rd) {\n        s = max(max(s, len[it.a]), max(len[it.b], (len[it.b] + it.l - len[it.a] + 1) / 2 + len[it.a]));\n    }\n\n    cout << s << endl;\n}')"

