2025-01-26 15:06:59,709	[DEBUG]	patch(2-10)="LineLLMMutation(('source.cpp', 20), '#include <iostream>\n#include <algorithm>\n#include <vector>\n#include <queue>\n#include <utility>\n\nusing namespace std;\n\nstruct road {\n    int a, b, l;\n    road(int a_, int b_, int l_) : a(a_), b(b_), l(l_) {}\n};\n\ntypedef pair<int, int> pii;\n\nint main() {\n    int n, m, k, a, b, l, s;\n    vector<road> rd;\n    vector<vector<int>> town(3001, vector<int>(3001, 0)); // Adjacency matrix\n    int len[3001];\n    priority_queue<pii, vector<pii>, greater<pii>> qu;\n    int inf = 1e9;\n\n    cin >> n >> m >> k;\n    while (m--) {\n        cin >> a >> b >> l;\n        rd.push_back(road(a, b, l));\n        town[a][b] = l;\n        town[b][a] = l;\n    }\n\n    while (k--) {\n        cin >> s;\n        qu.push(make_pair(0, s));\n    }\n\n    fill(len, len + n + 1, -1);\n    while (!qu.empty()) {\n        pii pi = qu.top();\n        qu.pop();\n        if (len[pi.second] == -1) {\n            len[pi.second] = pi.first;\n            for (int i = 1; i <= n; ++i) {\n                if (town[pi.second][i] > 0) {\n                    qu.push(make_pair(pi.first + town[pi.second][i], i));\n                }\n            }\n        }\n    }\n\n    s = 0;\n    for (auto it = rd.begin(); it != rd.end(); ++it) {\n        s = max(max(s, len[it->a]), max(len[it->b], (len[it->b] + it->l - len[it->a] + 1) / 2 + len[it->a]));\n    }\n\n    cout << s << endl;\n}')"
