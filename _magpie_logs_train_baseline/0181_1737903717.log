d]) continue; // Skip if already visited\n        visited[pi.second] = true;\n        len[pi.second] = pi.first;\n\n        for (const auto& it : town[pi.second]) {\n            if (!visited[it.first] && len[it.first] > pi.first + it.second) { // Relaxation\n                len[it.first] = pi.first + it.second;\n                qu.emplace_back(len[it.first], it.first);\n                sort(qu.begin(), qu.end()); // Re-sort after insertion\n            }\n        }\n    }\n\n    s = 0;\n    for (const auto& r : rd) {\n        if (len[r.a] != numeric_limits<int>::max() && len[r.b] != numeric_limits<int>::max()) {\n            s = max(s, (len[r.b] + r.l - len[r.a] + 1) / 2 + len[r.a]);\n        }\n    }\n\n    printf("%d\\n", s);\n}')"
