2025-01-26 15:03:11,879	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include <iostream>\n#include <algorithm>\n#include <vector>\n#include <queue>\n#include <utility>\n\nusing namespace std;\n\nstruct road {\n    int a, b, l;\n    road(int a_, int b_, int l_) : a(a_), b(b_), l(l_) {}\n};\n\ntypedef pair<int, int> pii;\n\nint main() {\n    int n, m, k, a, b, l, s;\n    vector<road> rd;\n    vector<pii> town[3001];\n    int len[3001];\n    priority_queue<pii, vector<pii>, greater<pii>> qu;\n    int inf = 1e9;\n\n    cin >> n >> m >> k;\n    while (m--) {\n        cin >> a >> b >> l;\n        rd.push_back(road(a, b, l));\n        town[a].push_back(make_pair(b, l));\n        town[b].push_back(make_pair(a, l));\n    }\n\n    while (k--) {\n        cin >> s;\n        qu.push(make_pair(0, s));\n    }\n\n    fill(len, len + n + 1, -1);\n    while (!qu.empty()) {\n        pii pi = qu.top();\n        qu.pop();\n\n        if (len[pi.second] == -1) {\n            len[pi.second] = pi.first;\n            for (auto it = town[pi.second].begin(); it != town[pi.second].end(); ++it) {\n                qu.push(make_pair(pi.first + it->second, it->first));\n            }\n        }\n    }\n\n    s = 0;\n    for (auto it = rd.begin(); it != rd.end(); ++it) {\n        s = max(max(s, len[a]), max(len[b], (len[it->b] + it->l - len[it->a] + 1) / 2 + len[it->a]));\n    }\n\n    cout << s << endl;\n}')"

