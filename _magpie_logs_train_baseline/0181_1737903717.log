) {\n        scanf("%d %d %d", &a, &b, &l);\n        rd.emplace_back(a, b, l);\n        town[a].emplace_back(b, l);\n        town[b].emplace_back(a, l);\n    }\n\n    while (k--) {\n        scanf("%d", &s);\n        qu.push(make_pair(0, s));\n    }\n\n    while (!qu.empty()) {\n        pii pi = qu.top();\n        qu.pop();\n\n        if (len[pi.second] == -1) {\n            len[pi.second] = pi.first;\n            for (const auto& it : town[pi.second]) {\n                if (len[it.first] == -1) { // Only push if not already visited\n                    qu.push(make_pair(pi.first + it.second, it.first));\n                }\n            }\n        }\n    }\n\n    s = 0;\n    for (const auto& r : rd) {\n        if (len[r.a] != -1 && len[r.b] != -1) {\n            s = max(s, (len[r.b] + r.l - len[r.a] + 1) / 2 + len[r.a]);\n        }\n    }\n\n    printf("%d\\n", s);\n}')"
