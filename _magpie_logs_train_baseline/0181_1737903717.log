ons\n    while (m--) {\n        scanf("%d %d %d", &a, &b, &l); // Using scanf for faster input\n        rd.emplace_back(a, b, l); // Constructing road directly in the vector\n        town[a].emplace_back(b, l); // Using emplace_back for efficiency\n        town[b].emplace_back(a, l);\n    }\n\n    while (k--) {\n        scanf("%d", &s); // Using scanf for faster input\n        qu.emplace(0, s); // Using emplace for efficiency\n    }\n\n    fill(len, len + n + 1, -1);\n    while (!qu.empty()) {\n        pii pi = qu.top();\n        qu.pop();\n\n        if (len[pi.second] == -1) {\n            len[pi.second] = pi.first;\n            for (const auto& it : town[pi.second]) {\n                qu.emplace(pi.first + it.second, it.first); // Using emplace for efficiency\n            }\n        }\n    }\n\n    s = 0;\n    for (const auto& it : rd) {\n        s = max({s, len[it.a], len[it.b], (len[it.b] + it.l - len[it.a] + 1) / 2 + len[it.a]});\n    }\n\n    cout << s << endl;\n}')"
