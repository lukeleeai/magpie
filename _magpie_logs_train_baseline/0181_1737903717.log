    cin >> a >> b >> l;\n        rd.emplace_back(a, b, l);\n        town[a].emplace_back(b, l);\n        town[b].emplace_back(a, l);\n    }\n\n    while (k--) {\n        cin >> s;\n        qu.push(make_pair(0, s));\n    }\n\n    fill(len, len + n + 1, inf); // Initialize length array with infinity\n    while (!qu.empty()) {\n        pii pi = qu.top();\n        qu.pop();\n\n        if (len[pi.second] == inf) { // Check for infinity instead of -1\n            len[pi.second] = pi.first;\n            for (const auto& it : town[pi.second]) {\n                qu.push(make_pair(pi.first + it.second, it.first));\n            }\n        }\n    }\n\n    s = 0;\n    for (const auto& r : rd) {\n        int current_length = len[r.a] + r.l + len[r.b];\n        s = max(s, current_length);\n    }\n\n    cout << s << endl;\n}')"
