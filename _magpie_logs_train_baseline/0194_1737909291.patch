LineLLMMutation(('source.cpp', 14), '#include <cstdio>\n#include <vector>\n#include <queue>\n#include <algorithm>\n\n#define to first\n#define cost second\n#define INF 1000000000\n\nusing namespace std;\n\ntypedef pair<int, int> P;\n\nvector<P> e[100000];\nvector<P> ge[100000];\nvector<P> te[100000];\nint d[100000], bfr[100000], depth[100000];\nint par[20][100000], cos[20][100000];\nint n, m, k, q;\n\npriority_queue<P, vector<P>, greater<P>> que;\n\nvoid dykstra() {\n    int i;\n    while (!que.empty()) {\n        P p = que.top();\n        que.pop();\n        int v = p.second;\n        if (p.first > d[v]) continue;\n        for (i = 0; i < e[v].size(); i++) {\n            int u = e[v][i].to;\n            int c = e[v][i].cost;\n            if (d[u] > d[v] + c) {\n                d[u] = d[v] + c;\n                que.push(P(d[u], u));\n            }\n        }\n    }\n}\n\nvoid mt() {\n    for (int i = 0; i < n; i++) {\n        d[i] = INF;\n        bfr[i] = -1;\n    }\n    d[0] = 0;\n    que.push(P(0, 0));\n    while (!que.empty()) {\n        P p = que.top();\n        que.pop();\n        int v = p.second;\n        if (p.first > d[v]) continue;\n        if (bfr[v] != -1) {\n            te[v].push_back(P(bfr[v], -d[v]));\n            te[bfr[v]].push_back(P(v, -d[v]));\n        }\n        for (int i = 0; i < ge[v].size(); i++) {\n            int u = ge[v][i].to;\n            int c = ge[v][i].cost;\n            if (d[u] > c) {\n                d[u] = c;\n                bfr[u] = v;\n                que.push(P(d[u], u));\n            }\n        }\n    }\n}\n\nvoid dfs(int v, int p, int d) {\n    depth[v] = d;\n    for (int i = 0; i < te[v].size(); i++) {\n        if (te[v][i].to == p) continue;\n        par[0][te[v][i].to] = v;\n        cos[0][te[v][i].to] = te[v][i].cost;\n        dfs(te[v][i].to, v, d + 1);\n    }\n}\n\nint lca(int a, int b) {\n    if (depth[a] < depth[b]) swap(a, b);\n    int i, diff = depth[a] - depth[b], ans = INF;\n    for (i = 0; i < 20; i++) {\n        if (diff >> i & 1) {\n            ans = min(ans, cos[i][a]);\n            a = par[i][a];\n        }\n    }\n    if (a == b) return ans;\n    for (i = 19; i >= 0; i--) {\n        if (par[i][a] != par[i][b]) {\n            ans = min(ans, cos[i][a]);\n            ans = min(ans, cos[i][b]);\n            a = par[i][a];\n            b = par[i][b];\n        }\n    }\n    ans = min(ans, cos[0][a]);\n    ans = min(ans, cos[0][b]);\n    return ans;\n}\n\nint main() {\n    scanf("%d %d %d %d", &n, &m, &k, &q);\n    for (int i = 0; i < m; i++) {\n        int a, b, c;\n        scanf("%d %d %d", &a, &b, &c);\n        a--; b--;\n        e[a].push_back(P(b, c));\n        e[b].push_back(P(a, c));\n    }\n    for (int i = 0; i < n; i++) {\n        d[i] = INF;\n    }\n    for (int i = 0; i < k; i++) {\n        int s;\n        scanf("%d", &s);\n        d[s - 1] = 0;\n        que.push(P(0, s - 1));\n    }\n    dykstra();\n    for (int i = 0; i < n; i++) {\n        for (int j = 0; j < e[i].size(); j++) {\n            ge[i].push_back(P(e[i][j].to, -min(d[i], d[e[i][j].to])));\n        }\n    }\n    mt();\n    for (int i = 0; i < n; i++) {\n        for (int j = 0; j < 20; j++) {\n            par[j][i] = -1;\n            cos[j][i] = INF;\n        }\n    }\n    dfs(0, -1, 0);\n    for (int i = 1; i < 20; i++) {\n        for (int j = 0; j < n; j++) {\n            if (par[i - 1][j] != -1) {\n                par[i][j] = par[i - 1][par[i - 1][j]];\n                cos[i][j] = min(cos[i - 1][j], cos[i - 1][par[i - 1][j]]);\n            }\n        }\n    }\n    for (int i = 0; i < q; i++) {\n        int s, t;\n        scanf("%d %d", &s, &t);\n        s--; t--;\n        printf("%d\\n", lca(s, t));\n    }\n    return 0;\n}')
