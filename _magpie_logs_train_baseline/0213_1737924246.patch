LineLLMCrossover(('source.cpp', 4), '#include <iostream>\n#include <vector>\n#include <cstdio>\n#define ll long long int\n\nusing namespace std;\n\nll n, counter;\n\nvoid seive(vector<bool>& ara3) {\n    fill(ara3.begin(), ara3.end(), true);\n    ara3[0] = ara3[1] = false;\n\n    for (ll i = 2; i * i <= 100001; ++i) {\n        if (ara3[i]) {\n            for (ll j = i * i; j <= 100001; j += i) {\n                ara3[j] = false;\n            }\n        }\n    }\n}\n\nint main(void) {\n    vector<bool> ara3(100002);\n    seive(ara3);\n\n    while (cin >> n) {\n        counter = 0;\n        for (ll i = 1; i <= n; ++i) {\n            ll j = n - i + 1;\n            if (ara3[i] && ara3[j]) {\n                counter++;\n            }\n        }\n        printf("%lld\\n", counter);\n    }\n    return 0;\n}')
