LineLLMCrossover(('source.cpp', 33), '#include <iostream>\n#include <vector>\n#include <algorithm>\nusing namespace std;\n\ntypedef long long i64;\n\nstruct ProblemData {\n    vector<i64> capacities, weights, cumulative_sum;\n    vector<i64> dp; // Space optimization\n};\n\nint main() {\n    size_t n;\n    cin >> n;\n    ProblemData data;\n    data.capacities.resize(n);\n    data.weights.resize(n);\n    data.cumulative_sum.resize(n + 1);\n    data.dp.resize(n + 1, 1e9); // Space optimization to 1D array\n\n    for(size_t i = 0; i < n; ++i) {\n        cin >> data.capacities[i] >> data.weights[i];\n        data.cumulative_sum[i + 1] = data.cumulative_sum[i] + data.weights[i];\n    }\n\n    data.dp[0] = 0; // Base case\n\n    for(size_t i = 0; i < n; ++i) {\n        for(size_t j = i + 1; j <= n; ++j) {\n            i64 total_weight = data.cumulative_sum[j] - data.cumulative_sum[i + 1];\n            if(data.capacities[i] >= total_weight) {\n                data.dp[j] = min(data.dp[j], data.dp[i] + 1);\n            }\n            total_weight = data.cumulative_sum[j - 1] - data.cumulative_sum[i];\n            if(data.capacities[j - 1] >= total_weight) {\n                data.dp[j] = min(data.dp[j], data.dp[i] + 1);\n            }\n        }\n    }\n\n    cout << data.dp[n] << endl; // Output the result for the entire array\n}')
