LineLLMCrossover(('source.cpp', 9), '#include <cstdio>\n#include <algorithm>\n#include <cstring>\nusing namespace std;\n\n#define MAX_M 120\n#define MAX_N 60\n\nint x[MAX_N][6];\nint y[MAX_N][6];\nint z[MAX_M][3];\nlong long int a[MAX_M][MAX_M][MAX_M];\nbool b[MAX_M][MAX_M][MAX_M];\n\nint main() {\n    memset(b, false, sizeof(b));\n    int n, m;\n    int MAXX[3] = {0, 0, 0};\n    int SUMX[3] = {0, 0, 0};\n    scanf("%d %d", &n, &m);\n\n    for (int i = 0; i < n; i++) {\n        for (int j = 0; j < 6; j++) {\n            scanf("%d", &x[i][j]);\n            MAXX[j % 3] = max(MAXX[j % 3], x[i][j]);\n        }\n    }\n\n    for (int j = 0; j < 3; j++) {\n        for (int k = 0; k <= MAXX[j]; k++) {\n            for (int i = 0; i < n; i++) {\n                if (x[i][j] == k) {\n                    y[i][j] = SUMX[j];\n                    z[SUMX[j]][j] = k;\n                    SUMX[j]++;\n                }\n                if (x[i][j + 3] == k) {\n                    y[i][j + 3] = SUMX[j];\n                    z[SUMX[j]][j] = k;\n                    SUMX[j]++;\n                }\n            }\n        }\n    }\n\n    long long int sum = 0;\n    for (int i = 0; i < SUMX[0]; i++) {\n        for (int j = 0; j < SUMX[1]; j++) {\n            for (int k = 0; k < SUMX[2]; k++) {\n                a[i][j][k] = (long long)(z[i + 1][0] - z[i][0]) * (z[j + 1][1] - z[j][1]) * (z[k + 1][2] - z[k][2]);\n            }\n        }\n    }\n\n    for (int i = 0; i < SUMX[0]; i++) {\n        for (int j = 0; j < SUMX[1]; j++) {\n            for (int k = 0; k < SUMX[2]; k++) {\n                int p = count_if(y, y+n, [&](int* arr) {\n                    return arr[0] <= i && arr[3] > i && arr[1] <= j && arr[4] > j && arr[2] <= k && arr[5] > k;\n                });\n                if (p >= m) {\n                    sum += a[i][j][k];\n                    b[i][j][k] = true;\n                }\n            }\n        }\n    }\n\n    printf("%lld\\n", sum);\n    return 0;\n}')
