LineLLMCrossover(('source.cpp', 15), '#include <cstdio>\n#include <vector>\n#include <algorithm>\nusing namespace std;\n\nint main() {\n    int r, c, q;\n    while(scanf("%d%d%d", &r, &c, &q), r + c + q) {\n        vector<int> a(q), b(q), o(q);\n        vector<int> status(r + c, -1);\n        for(int i = 0; i < q; ++i) scanf("%d%d%d", &a[i], &b[i], &o[i]);\n\n        int rr = 0, cc = 0, ans = 0;\n        for(int i = q - 1; i >= 0; --i) {\n            int idx = (a[i] == 0) ? b[i] : (r + b[i]);\n            if(status[idx] == -1) {\n                status[idx] = o[i];\n                (a[i] == 0 ? rr : cc)++;\n                ans += (o[i] == 1 ? (a[i] == 0 ? c - cc : r - rr) : 0);\n            }\n        }\n        printf("%d\\n", ans);\n    }\n    return 0;\n}')
