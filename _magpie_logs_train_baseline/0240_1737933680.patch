LineLLMCrossover(('source.cpp', 10), '#include <cstdio>\n#include <vector>\n#include <algorithm>\nusing namespace std;\n\nint a[50000], b[50000], o[50000];\n\nint main() {\n    int H, W, q;\n    while (scanf("%d %d %d", &H, &W, &q) == 3 && H) {\n        int ans = 0;\n        for (int i = 0; i < q; ++i) scanf("%d %d %d", &a[i], &b[i], &o[i]);\n        \n        vector<bool> rowUsed(H, false), colUsed(W, false);\n        \n        for (int i = q - 1; i >= 0; --i) {\n            if (a[i] == 0) {\n                if (!colUsed[b[i]] && o[i]) ans += W - count(rowUsed.begin(), rowUsed.end(), true);\n                colUsed[b[i]] = true;\n            } else {\n                if (!rowUsed[b[i]] && o[i]) ans += H - count(colUsed.begin(), colUsed.end(), true);\n                rowUsed[b[i]] = true;\n            }\n        }\n        printf("%d\\n", ans);\n    }\n}') + LineLLMMutation(('source.cpp', 25), '#include <cstdio>\n#include <vector>\n#include <algorithm>\nusing namespace std;\n\nstruct Query {\n    int a, b, o;\n};\n\nint main() {\n    int H, W, q;\n    while (scanf("%d %d %d", &H, &W, &q) == 3 && H) {\n        int ans = 0;\n        vector<Query> queries(q);\n        \n        for (int i = 0; i < q; ++i) \n            scanf("%d %d %d", &queries[i].a, &queries[i].b, &queries[i].o);\n        \n        vector<bool> rowUsed(H, false), colUsed(W, false);\n        \n        for (int i = q - 1; i >= 0; --i) {\n            if (queries[i].a == 0) {\n                if (!colUsed[queries[i].b] && queries[i].o) \n                    ans += W - count(rowUsed.begin(), rowUsed.end(), true);\n                colUsed[queries[i].b] = true;\n            } else {\n                if (!rowUsed[queries[i].b] && queries[i].o) \n                    ans += H - count(colUsed.begin(), colUsed.end(), true);\n                rowUsed[queries[i].b] = true;\n            }\n        }\n        printf("%d\\n", ans);\n    }\n}')
