2025-01-23 17:26:11,494	[DEBUG]	patch(0-9)="LineLLMMutation(('source.cpp', 8), '#include<iostream>\n#include<vector>\n#include<sstream>\n#include<cmath>\n#include<algorithm>\n#include<unordered_map>\n#include<future>\n\nusing namespace std;\n\nconst int MAX = 13;\nvector<double> Cake;\ndouble box;\nunordered_map<int, double> dp;\n\nvoid init(){\n    Cake.clear();\n    dp.clear();\n}\n\nvoid make(){\n    string s;\n    getline(cin,s);\n    stringstream ss(s);\n    double num;\n    Cake.reserve(MAX);\n    while(ss >> num) Cake.push_back(num);\n}\n\ndouble solve(int mask, int last){\n    if(mask == (1<<Cake.size())-1) return 0;\n    if(dp.count(mask)) return dp[mask];\n    double minVal = 100000000;\n    \n    vector<future<double>> futures; // Vector to store futures for async results\n    for(int k = 0; k < (int)Cake.size(); k++)\n        if(!(mask & (1 << k)) && last != k){\n            futures.push_back(async(launch::async, [=](){\n                return 2.0 * sqrt(Cake[last] * Cake[k]) + solve(mask | (1 << k), k);\n            }));\n        }\n\n    for(auto &f : futures){\n        minVal = min(minVal, f.get()); // Get the result of the futures\n    }\n    return dp[mask] = minVal;\n}\n\nint main(){\n    while(cin >> box){\n        init();\n        make();\n        double minCost = 100000000;\n        for(int i = 0; i < (int)Cake.size(); i++)\n            minCost = min(minCost, solve(1 << i, i) + Cake[i]);\n        if(minCost <= box) cout << "OK" << endl;\n        else cout << "NA" << endl;\n    }\n    return 0;\n}')"
