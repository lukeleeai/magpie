2025-01-23 17:25:57,738	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include<iostream>\n#include<vector>\n#include<sstream>\n#include<cmath>\n#include<algorithm> // Added for std::fill\n\nusing namespace std;\n\nconst int MAX = 13;\nvector<double> Cake;\ndouble box;\ndouble dp[(1<<MAX)][MAX];\n\nvoid init(){\n    Cake.clear();\n    std::fill(&dp[0][0], &dp[0][0] + (1<<MAX)*MAX, 100000000); // Changed to a more readable syntax\n    dp[0][0] = 0;\n}\n\nvoid make(){\n    string s;\n    getline(cin,s);\n    stringstream ss(s);\n    double num;\n    while(ss >> num) Cake.push_back(num);\n}\n\nvoid solve(){\n    for(int i = 0; i < (1<<Cake.size()); i++)\n        for(int j = 0; j < (int)Cake.size(); j++){\n            if(i == 0) {dp[(1<<j)][j] = Cake[j]; continue;}\n            for(int k = 0; k < (int)Cake.size(); k++)\n                if(!(i&(1<<k)) && j != k){\n                    dp[i+(1<<k)][k] = min(dp[i+(1<<k)][k],dp[i][j]+2.0*sqrt(Cake[j]*Cake[k]));\n                }\n        }\n\n    for(int i = 0; i < (int)Cake.size(); i++){\n        if(dp[(1<<Cake.size())-1][i]+Cake[i] <= box) {cout << "OK" << endl;return;}\n    }\n    cout << "NA" << endl;\n}\n\nint main(){\n    while(cin >> box){\n        init();\n        make();\n        solve();\n    }\n    return 0;\n}')"

