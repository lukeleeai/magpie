ngstream ss(s);\n    float num; // Adjusted type accordingly\n    Cake.reserve(MAX);\n    while(ss >> num) Cake.push_back(num);\n}\n\nvoid solve(){\n    // Precompute square roots to avoid repeated calculations\n    vector<float> sqrtCake(Cake.size());\n    for (int i = 0; i < Cake.size(); ++i) {\n        sqrtCake[i] = sqrt(Cake[i]);\n    }\n\n    for(int i = 0; i < (1<<Cake.size()); i++)\n        for(int j = 0; j < (int)Cake.size(); j++){\n            if(i == 0) {\n                dp[(1<<j)][j] = Cake[j];\n                continue;\n            }\n            for(int k = 0; k < (int)Cake.size(); k++)\n                if(!(i&(1<<k)) && j != k){\n                    float newValue = dp[i][j] + 2.0f * (sqrtCake[j] * sqrtCake[k]); // Use precomputed square roots\n                    dp[i+(1<<k)][k] = min(dp[i+(1<<k)][k], newValue);\n                }\n        }\n\n    for(int i = 0; i < (int)Cake.size(); i++){\n        if(dp[(1<<Cake.size())-1][i] + Cake[i] <= box) {cout << "OK" << endl; return;}\n    }\n    cout << "NA" << endl;\n}\n\nint main(){\n    while(cin >> box){\n        init();\n        make();\n        solve();\n    }\n    return 0;\n}')"
