2025-01-23 17:26:09,479	[DEBUG]	patch(0-8)="LineLLMMutation(('source.cpp', 7), '#include<iostream>\n#include<vector>\n#include<sstream>\n#include<cmath>\n#include<algorithm>\n#include<unordered_map>\n\nusing namespace std;\n\nconst int MAX = 13;\nvector<double> Cake;\ndouble box;\nunordered_map<int, double> dp; // Change to unordered_map for dynamic storage\n\nvoid init(){\n    Cake.clear();\n    dp.clear(); // Initialize the map\n}\n\nvoid make(){\n    string s;\n    getline(cin,s);\n    stringstream ss(s);\n    double num;\n    Cake.reserve(MAX);\n    while(ss >> num) Cake.push_back(num);\n}\n\ndouble solve(int mask, int last){\n    if(mask == (1<<Cake.size())-1) return 0; // All cakes taken\n    if(dp.count(mask)) return dp[mask]; // Check if already calculated\n    double minVal = 100000000; // Start with a large value\n    for(int k = 0; k < (int)Cake.size(); k++)\n        if(!(mask & (1 << k)) && last != k){\n            double newValue = 2.0 * sqrt(Cake[last] * Cake[k]) + solve(mask | (1 << k), k);\n            minVal = min(minVal, newValue);\n        }\n    return dp[mask] = minVal; // Store result\n}\n\nint main(){\n    while(cin >> box){\n        init();\n        make();\n        double minCost = 100000000; // Start with a large value\n        for(int i = 0; i < (int)Cake.size(); i++)\n            minCost = min(minCost, solve(1 << i, i) + Cake[i]);\n        if(minCost <= box) cout << "OK" << endl;\n        else cout << "NA" << endl;\n    }\n    return 0;\n}')"
