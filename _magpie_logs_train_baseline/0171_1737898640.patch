op(); // Move pop up to avoid checking empty queue multiple times\n        if (cur.n == n) {\n            ans = cur.deep;\n            break;\n        }\n\n        for (int i = 0; i < 4; i++) {\n            int tx = cur.x + dx[i];\n            int ty = cur.y + dy[i];\n            if (tx >= 1 && tx <= h && ty >= 1 && ty <= w && map[tx][ty] != \'X\' && !vis[tx][ty]) {\n                node next = {tx, ty, cur.deep + 1, cur.n};\n                if (map[tx][ty] == \'1\' + next.n) {\n                    next.n++;\n                }\n                vis[tx][ty] = true; // Optimized to 2D array\n                q.push(next);\n            }\n        }\n    }\n\n    printf("%d\\n", ans); // Changed cout to printf for faster output\n    return 0;\n}')
