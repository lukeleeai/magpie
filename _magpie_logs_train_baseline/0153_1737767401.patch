LineLLMCrossover(('source.cpp', 11), '#include <algorithm>\n#include <cstdio>\nusing namespace std;\n\nconst int max_size = 100005;\n\nint main() {\n    int d, m, n, p;\n    int sm;\n    int a[max_size];\n\n    while (scanf("%d", &d) && d) {\n        scanf("%d %d", &m, &n);\n        a[0] = 0;\n\n        for (int i = 1; i < m; i++) {\n            scanf("%d", &a[i]);\n        }\n\n        a[m] = d;\n        sort(a, a + m + 1);\n        sm = 0;\n\n        for (int i = 0; i < n; i++) {\n            scanf("%d", &p);\n            int j = lower_bound(a, a + m + 1, p) - a;\n            sm += (j > 0) ? min(p - a[j - 1], a[j] - p) : a[j] - p; // Ensure j is within bounds\n        }\n\n        printf("%d\\n", sm);\n    }\n\n    return 0;\n}') + LineLLMMutation(('source.cpp', 22), '#include <algorithm>\n#include <cstdio>\nusing namespace std;\n\nconst int max_size = 100005;\n\nint main() {\n    int d, m, n, p;\n    long long sm; // Changed to long long to avoid potential overflow\n    int a[max_size];\n\n    while (scanf("%d", &d) && d) {\n        scanf("%d %d", &m, &n);\n        a[0] = 0;\n\n        for (int i = 1; i < m; i++) {\n            scanf("%d", &a[i]);\n        }\n\n        a[m] = d;\n        sort(a, a + m + 1);\n        sm = 0;\n\n        for (int i = 0; i < n; i++) {\n            scanf("%d", &p);\n            int j = lower_bound(a, a + m + 1, p) - a;\n            // Simplified distance calculation\n            if (j == 0) {\n                sm += a[j] - p; // If p is less than or equal to the smallest element\n            } else if (j == m + 1) {\n                sm += p - a[m]; // If p is greater than or equal to the largest element\n            } else {\n                sm += min(p - a[j - 1], a[j] - p); // Min distance to the nearest bounds\n            }\n        }\n\n        printf("%lld\\n", sm); // Use long long for output\n    }\n\n    return 0;\n}') + LineLLMMutation(('source.cpp', 37), '#include <algorithm>\n#include <cstdio>\nusing namespace std;\n\nconst int max_size = 100005;\n\nint main() {\n    int d, m, n, p;\n    long long sm; // Changed to long long to avoid potential overflow\n    int a[max_size];\n\n    while (scanf("%d", &d) && d) {\n        scanf("%d %d", &m, &n);\n        a[0] = 0;\n\n        for (int i = 1; i < m; i++) {\n            scanf("%d", &a[i]);\n        }\n\n        a[m] = d;\n        sort(a, a + m + 1);\n        sm = 0;\n\n        for (int i = 0; i < n; i++) {\n            scanf("%d", &p);\n            int j = lower_bound(a, a + m + 1, p) - a;\n\n            // Optimized distance calculation\n            long long dist = (j == 0) ? (a[j] - p) : \n                             (j == m + 1) ? (p - a[m]) : \n                             min(p - a[j - 1], a[j] - p);\n            sm += dist;\n        }\n\n        printf("%lld\\n", sm); // Use long long for output\n    }\n\n    return 0;\n}') + LineLLMMutation(('source.cpp', 39), '#include <algorithm>\n#include <cstdio>\nusing namespace std;\n\nconst int max_size = 100005;\n\nint main() {\n    int d, m, n, p;\n    long long sm;\n    int a[max_size];\n\n    while (scanf("%d", &d) && d) {\n        scanf("%d %d", &m, &n);\n        a[0] = 0;\n\n        for (int i = 1; i < m; i++) {\n            scanf("%d", &a[i]);\n        }\n\n        a[m] = d;\n        sort(a, a + m + 1);\n        sm = 0;\n\n        for (int i = 0; i < n; i++) {\n            scanf("%d", &p);\n            int j = lower_bound(a, a + m + 1, p) - a;\n\n            // Optimized distance calculation using a single expression\n            long long dist = (j == 0) ? (a[0] - p) : \n                             (j == m + 1) ? (p - a[m]) : \n                             min(p - a[j - 1], a[j] - p);\n            sm += dist;\n        }\n\n        printf("%lld\\n", sm);\n    }\n\n    return 0;\n}')
