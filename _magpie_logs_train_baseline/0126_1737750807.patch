LineLLMCrossover(('source.cpp', 35), '#include <cstdio>\n#include <array>\n#include <algorithm>\n\nusing namespace std;\n\nint calculateMax(int n, bool f, const array<bool, 100001>& a, const array<int, 100001>& memo, const array<int, 100001>& start) {\n    int ma = 0;\n    for (int i = 1; i <= n; i++) {\n        if (a[i]) {\n            ma = max(ma, memo[start[i]]);\n        } else if (f) {\n            int v = (a[i - 1] ? memo[start[i - 1]] + 1 : 0) + (i < n && a[i + 1] ? memo[start[i + 1]] : 0);\n            ma = max(ma, v);\n        }\n    }\n    return ma;\n}\n\nint main() {\n    int n, k;\n    while (scanf("%d %d", &n, &k), n || k) {\n        array<bool, 100001> a = {};\n        array<int, 100001> memo = {};\n        array<int, 100001> start = {};\n        bool f = false;\n\n        for (int i = 1; i <= k; ++i) {\n            int tmp; \n            scanf("%d", &tmp);\n            f = (tmp == 0) ? true : f;\n            a[tmp] = (tmp != 0);\n        }\n\n        for (int i = 1; i <= n; ++i) {\n            if (a[i]) {\n                start[i] = (i > 1 && a[i - 1]) ? start[i - 1] : i;\n                memo[start[i]]++;\n            }\n        }\n\n        int ma = calculateMax(n, f, a, memo, start);\n        printf("%d\\n", ma);\n    }\n}')
