2025-01-24 21:15:21,487	[DEBUG]	patch(9-9)="LineLLMCrossover(('source.cpp', 29), '#include <cstdio>\n#include <algorithm>\n#include <queue>\n#include <unordered_map>\n#include <vector>\n\n#define MAX_N 5000\n\nusing namespace std;\n\nint N;\nint E;\nunordered_map<int, vector<int>> in;\nunordered_map<int, vector<int>> out;\nqueue<int> S;\nvector<int> L;\n\nbool multi_flag;\n\n// Combined existence check\nbool in_exist(int v) {\n    return in.count(v) > 0 && !in[v].empty(); // Using count() for existence check\n}\n\nvoid solve() {\n    for (int i = 1; i <= N; i++) {\n        if (!in_exist(i)) S.push(i);\n    }\n\n    while (!S.empty()) {\n        int u = S.front(); S.pop();\n        L.push_back(u);\n        int entered = 0;\n\n        for (int to : out[u]) {\n            auto& vec = in[to];\n            vec.erase(remove(vec.begin(), vec.end(), u), vec.end());\n            if (vec.empty()) {\n                S.push(to);\n                entered++;\n            }\n        }\n        if (entered >= 2) multi_flag = true; // Maintain multi_flag logic\n    }\n}\n\nint main() {\n    scanf("%d%d", &N, &E);\n    int _u, _v;\n    for (int i = 0; i < E; i++) {\n        scanf("%d%d", &_u, &_v);\n        in[_v].push_back(_u);\n        out[_u].push_back(_v);\n    }\n    solve();\n    for (int team : L) {\n        printf("%d\\n", team);\n    }\n    puts(multi_flag ? "1" : "0");\n    return 0;\n}') | LineLLMMutation(('source.cpp', 44), '#include <cstdio>\n#include <algorithm>\n#include <queue>\n#include <unordered_map>\n#include <vector>\n\n#define MAX_N 5000\n\nusing namespace std;\n\nint N;\nint E;\nunordered_map<int, vector<int>> in;\nunordered_map<int, vector<int>> out;\nqueue<int> S;\nvector<int> L;\n\nbool multi_flag;\n\n// Combined existence check\nbool in_exist(int v) {\n    return !in[v].empty(); // Directly access the vector to check for emptiness\n}\n\nvoid solve() {\n    for (int i = 1; i <= N; i++) {\n        if (!in_exist(i)) S.push(i);\n    }\n\n    while (!S.empty()) 