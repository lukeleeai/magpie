2025-01-24 21:02:16,966	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include <cstdio>\n#include <cmath>\n#include <algorithm>\n#include <queue>\n\n#define MAX_N 5000\n\nusing namespace std;\n\nint N;\nint E;\nvector<int> in[MAX_N + 1];\nvector<int> out[MAX_N + 1];\nqueue<int> S;\nqueue<int> L;\n\nbool multi_flag;\n\nbool in_exist(int v) {\n    return !in[v].empty() && find(in[v].begin(), in[v].end(), -1) == in[v].end();\n}\n\nvoid solve() {\n    for (int i = 1; i <= N; i++) {\n        if (!in_exist(i)) S.push(i);\n    }\n\n    while (!S.empty()) {\n        int u = S.front(); S.pop();\n        L.push(u);\n        int entered = 0;\n\n        for (int to : out[u]) {\n            in[to].erase(remove(in[to].begin(), in[to].end(), u), in[to].end());\n            if (in_exist(to) == false) {\n                S.push(to);\n                entered++;\n            }\n        }\n        if (entered >= 2) multi_flag = true;\n    }\n}\n\nint main() {\n    scanf("%d", &N);\n    scanf("%d", &E);\n    int _u, _v;\n    for (int i = 0; i < E; i++) {\n        scanf("%d%d", &_u, &_v);\n        in[_v].push_back(_u);\n        out[_u].push_back(_v);\n    }\n    solve();\n    while (!L.empty()) {\n        printf("%d\\n", L.front()); L.pop();\n    }\n    puts(multi_flag ? "1" : "0");\n    return 0;\n}')"
