2025-01-26 22:05:18,073	[DEBUG]	patch(1-6)="LineLLMMutation(('source.cpp', 11), '#include <iostream>\n#include <string>\n#include <algorithm>\n#include <set>\n#include <vector>\n#include <cstring>\n#include <climits>\n#include <queue>\n#include <map>\n#include <sstream>\n\nusing namespace std;\n\n#define REP(i,a,n) for(int i=(a); i<(int)(n); i++)\n#define rep(i,n) REP(i,0,n)\n#define EPS 1e-9\n\nconst int coin[] = {1,5,10,50,100,500};\nconst int inf = 999999999;\nint c[6], p;\n\nint oturi(int x) {\n    int ret = 0;\n    for(int i=5; i>=0 && x>0; i--) {\n        ret += (x / coin[i]);\n        x -= (x / coin[i]) * coin[i];\n    }\n    return ret;\n}\n\nint pay(int x) {\n    int ret = 0;\n    for(int i=5; i>=0; i--) {\n        int use = min(x / coin[i], c[i]);\n        ret += use;\n        x -= use * coin[i];\n        if (x == 0) break; // Early exit if exact change found\n    }\n    return x == 0 ? ret : -1;\n}\n\nint main() {\n    while (scanf("%d", &p), p) {\n        scanf("%d%d%d%d%d%d", c, c + 1, c + 2, c + 3, c + 4, c + 5);\n\n        int sum = 0;\n        int ret = INT_MAX;\n\n        rep(i, 6) sum += coin[i] * c[i];\n\n        for (int i = p; i <= sum; i++) {\n            int t = pay(i);\n            if (t != -1) {\n                ret = min(ret, t + oturi(i - p));\n            }\n        }\n        printf("%d\\n", ret);\n    }\n    return 0;\n}')"
