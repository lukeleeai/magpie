LineLLMCrossover(('source.cpp', 6), '#include <cstdio>\n#include <algorithm>\n\n#define DIV 100000\n\nusing namespace std;\n\nlong long S[100010];\n\nlong long calculateAns(long long t, long long k) {\n    return abs(S[t] - S[t + k]) % DIV;\n}\n\nint main() {\n    long long n, m, k, t = 0;\n    long long ans = 0;\n    scanf("%lld%lld", &n, &m); S[0] = 0;\n\n    for (int i = 1; i < n; i++) {\n        long long d; scanf("%lld", &d); S[i] = S[i - 1] + d;\n    }\n    \n    while (m--) {\n        scanf("%lld", &k);\n        ans += calculateAns(t, k);\n        t += k;\n    }\n    \n    printf("%lld\\n", ans);\n}')
