LineLLMCrossover(('source.cpp', 10), '#include <cstdio>\n#include <cstring>\n#include <cstdlib>\n#include <ctime>\n#include <algorithm>\n\nusing namespace std;\n\ntypedef long long ll;\n\nint cut[10005];\nint dp[2][5005][2];\n\nint main() {\n    srand((unsigned int)time(NULL));\n    int n; scanf("%d",&n);\n\n    for(int i=1;i<n;i++) scanf("%d",&cut[i]);\n\n    // Initialize dp array to INF in a single pass\n    for(int i=0;i<2;i++)\n        memset(dp[i], 0x3f, sizeof(dp[i])); // Set all to a large value\n\n    dp[0][1][0] = 0; \n    int cur = 0, nxt = 1;\n\n    for(int i=1;i<n;i++) {\n        memset(dp[nxt], 0x3f, sizeof(dp[nxt])); // Set all to a large value\n        for(int j=0;j<=n/2;j++) {\n            dp[nxt][j+1][0] = min(dp[nxt][j+1][0], dp[cur][j][0]);\n            dp[nxt][j][1] = min(dp[nxt][j][1], dp[cur][j][0] + cut[i]);\n            dp[nxt][j][1] = min(dp[nxt][j][1], dp[cur][j][1]);\n            dp[nxt][j+1][0] = min(dp[nxt][j+1][0], dp[cur][j][1] + cut[i]);\n        }\n        swap(cur, nxt);\n    }\n\n    printf("%d\\n", min(dp[cur][n/2][0], dp[cur][n/2][1]));\n}')
