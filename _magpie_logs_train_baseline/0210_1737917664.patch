LineLLMCrossover(('source.cpp', 13), '#include <iostream>\n#include <vector>\n#include <queue>\n#include <cstring>\nusing namespace std;\n\ntypedef long long ll;\n\nconst ll INF = 0xffffffffffffff;\nll N, M, Q;\nll D[100000], d[100000];\nll U[200000], V[200000], R[200000];\nbool ansin[100000];\nll anum[200000];\nvector<ll> G[100000];\nvector<ll> G2[100000];\npriority_queue<ll, vector<ll>, greater<ll>> q;\n\nbool mov[200000];\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> N >> M >> Q;\n    for (ll i = 0; i < M; ++i) {\n        cin >> U[i] >> V[i];\n        U[i]--;\n        V[i]--;\n        G[U[i]].reserve(M);\n        G[V[i]].reserve(M);\n        G[U[i]].push_back(V[i]);\n        G[V[i]].push_back(U[i]);\n    }\n\n    for (ll i = 0; i < Q; ++i) {\n        cin >> R[i];\n        R[i]--;\n        mov[R[i]] = 1;\n    }\n\n    fill(D, D + N, INF);\n    D[0] = 0;\n    q.push(0);\n\n    while (!q.empty()) {\n        ll x = q.top();\n        q.pop();\n        for (ll neighbor : G[x]) {\n            if (D[neighbor] > D[x] + 1) {\n                D[neighbor] = D[x] + 1;\n                q.push(neighbor);\n            }\n        }\n    }\n\n    ll cnt = 1;\n    fill(d, d + N, INF);\n    d[0] = 0;\n    ansin[0] = 1;\n\n    for (ll i = 0; i < M; ++i) {\n        if (!mov[i]) {\n            G2[U[i]].reserve(M);\n            G2[V[i]].reserve(M);\n            G2[U[i]].push_back(V[i]);\n            G2[V[i]].push_back(U[i]);\n        }\n    }\n\n    q.push(0);\n    while (!q.empty()) {\n        ll x = q.top();\n        q.pop();\n        for (ll neighbor : G2[x]) {\n            if (d[neighbor] > d[x] + 1) {\n                d[neighbor] = d[x] + 1;\n                if (d[neighbor] == D[neighbor] && !ansin[neighbor]) {\n                    ansin[neighbor] = 1;\n                    cnt++;\n                }\n                q.push(neighbor);\n            }\n        }\n    }\n\n    anum[Q - 1] = cnt;\n    for (ll i = Q - 1; i > 0; --i) {\n        ll a = U[R[i]];\n        ll b = V[R[i]];\n        G2[a].reserve(M);\n        G2[b].reserve(M);\n        G2[a].push_back(b);\n        G2[b].push_back(a);\n        if (d[a] + 1 < d[b]) {\n            d[b] = d[a] + 1;\n            if (d[b] == D[b] && !ansin[b]) {\n                ansin[b] = 1;\n                cnt++;\n            }\n            q.push(b);\n        } else if (d[b] + 1 < d[a]) {\n            d[a] = d[b] + 1;\n            if (d[a] == D[a] && !ansin[a]) {\n                ansin[a] = 1;\n                cnt++;\n            }\n            q.push(a);\n        }\n        while (!q.empty()) {\n            ll x = q.top();\n            q.pop();\n            for (ll neighbor : G2[x]) {\n                if (d[neighbor] > d[x] + 1) {\n                    d[neighbor] = d[x] + 1;\n                    if (d[neighbor] == D[neighbor] && !ansin[neighbor]) {\n                        ansin[neighbor] = 1;\n                        cnt++;\n                    }\n                    q.push(neighbor);\n                }\n            }\n        }\n        anum[i - 1] = cnt;\n    }\n\n    for (ll i = 0; i < Q; ++i) cout << N - anum[i] << endl;\n}')
