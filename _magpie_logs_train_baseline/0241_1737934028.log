2025-01-26 23:30:51,801	[DEBUG]	patch(1-4)="LineLLMCrossover(('source.cpp', 2), '#include <cstdio>\n#include <vector>\n#include <map>\nusing namespace std;\n\ntypedef vector<int> vi;\n\nstruct SegmentTree {\n    vi treeData;\n    int treeSize;\n\n    SegmentTree(int inputSize) {\n        treeSize = 1;\n        while (treeSize < inputSize) treeSize *= 2;\n        treeData.assign(treeSize * 2, 0);\n    }\n\n    void update(int index, int value) {\n        for (int j = treeSize + index; j; j /= 2)\n            treeData[j] += value;\n    }\n\n    int query(int i) {\n        int j = 1;\n        while (j < treeSize) {\n            if (treeData[j * 2] > i)\n                j = j * 2;\n            else {\n                i -= treeData[j * 2];\n                j = j * 2 + 1;\n            }\n        }\n        return j - treeSize;\n    }\n};\n\nint main() {\n    int queryCount, limit;\n    while (scanf("%d%d", &queryCount, &limit), queryCount || limit) {\n        SegmentTree segTree(queryCount);\n        vi girlList;\n        map<int, int> girlMap;\n\n        for (int i = 0; i < queryCount; ++i) {\n            int queryType, x;\n            scanf("%d%d", &queryType, &x);\n            if (queryType == 0) {\n                segTree.update(girlList.size(), 1);\n                girlMap[x] = girlList.size();\n                girlList.push_back(x);\n                if (segTree.treeData[1] > limit) {\n                    int j = segTree.query(0);\n                    segTree.update(j, -1);\n                }\n            } else if (queryType == 1) {\n                int j = segTree.query(x - 1);\n                segTree.update(j, -1);\n            } else if (queryType == 2) {\n                int j = segTree.query(x - 1);\n                printf("%d\\n", girlList[j]);\n            } else if (queryType == 3) {\n                auto it = girlMap.find(x);\n                if (it != girlMap.end()) {\n                    int j = it->second;\n                    segTree.update(j, -1);\n                }\n            }\n        }\n        puts("end");\n    }\n    return 0;\n}')"

