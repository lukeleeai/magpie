2025-01-26 23:28:28,492	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include <cstdio>\n#include <vector>\n#include <map>\nusing namespace std;\n\ntypedef vector<int> vi;\n\nstruct SegTree {\n    vi data;\n    int size;\n\n    SegTree(int _size) {\n        for (int i = 1;; i *= 2)\n            if (i >= _size) {\n                size = i;\n                break;\n            }\n        data.assign(size * 2, 0);\n    }\n\n    void add(int i, int x) {\n        for (int j = size + i; j; j /= 2)\n            data[j] += x;\n    }\n\n    int sum(int a, int b, int i, int l, int r) {\n        if (r <= a || b <= l) return 0;\n        if (a <= l && r <= b) return data[i];\n        int m = (a + b) / 2, res = 0;\n        if (a < m) res += sum(a, b, i * 2 + 0, l, m);\n        if (m < b) res += sum(a, b, i * 2 + 1, m, r);\n        return res;\n    }\n\n    int ith(int i) {\n        int j = 1;\n        while (j < size) {\n            if (data[j * 2 + 0] > i)\n                j = j * 2 + 0;\n            else {\n                i -= data[j * 2 + 0];\n                j = j * 2 + 1;\n            }\n        }\n        return j - size;\n    }\n};\n\nint main() {\n    vi girls(400000);\n    for (int q, l; scanf("%d%d", &q, &l), q | l;) {\n        SegTree st(q);\n        int gsize = 0;\n        map<int, int> m;\n\n        for (int i = 0; i < q; ++i) {\n            int qu, x;\n            scanf("%d%d", &qu, &x);\n            switch (qu) {\n                case 0:\n                    st.add(gsize, 1);\n                    m[x] = gsize;\n                    girls[gsize++] = x;\n                    if (st.data[1] > l) {\n                        int j = st.ith(0);\n                        st.add(j, -1);\n                    }\n                    break;\n                case 1:\n                    int j = st.ith(x - 1);\n                    st.add(j, -1);\n                    break;\n                case 2:\n                    j = st.ith(x - 1);\n                    printf("%d\\n", girls[j]);\n                    break;\n                case 3:\n                    j = m[x];\n                    st.add(j, -1);\n                    break;\n            }\n        }\n        puts("end");\n    }\n    return 0;\n}')"
