LineLLMCrossover(('source.cpp', 1), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\ntypedef pair<int, int> P;\ntypedef long long ll;\n\nconstexpr int INF = 2000000000;\n\nP za[100005];\n\nint main() {\n    int n, x, y;  \n    scanf("%d", &n);\n    int lx = INF, ly = INF, rx = -INF, ry = -INF;\n\n    for(int i = 0; i < n; i++) {\n        scanf("%d%d", &x, &y);\n        za[i] = {x + y, x - y};\n        lx = min(lx, za[i].first);\n        rx = max(rx, za[i].first);\n        ly = min(ly, za[i].second);\n        ry = max(ry, za[i].second);\n    }\n\n    int ret1 = 0, ret2 = 0;\n    for(int i = 0; i < n; i++) {\n        int f = za[i].first, s = za[i].second; // caching\n        ret1 = max(ret1, min(max(f - lx, s - ly), max(rx - f, ry - s)));\n        ret2 = max(ret2, min(max(f - lx, ry - s), max(rx - f, s - ly)));\n    }\n\n    printf("%d\\n", min(ret1, ret2));\n}') + LineLLMMutation(('source.cpp', 15), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\ntypedef pair<int, int> P;\ntypedef long long ll;\n\nconstexpr int INF = 2000000000;\n\nP za[100005];\n\nint main() {\n    int n, x, y;  \n    scanf("%d", &n);\n    int lx = INF, ly = INF, rx = -INF, ry = -INF;\n\n    for(int i = 0; i < n; i++) {\n        scanf("%d%d", &x, &y);\n        za[i] = {x + y, x - y};\n        lx = min(lx, za[i].first);\n        rx = max(rx, za[i].first);\n        ly = min(ly, za[i].second);\n        ry = max(ry, za[i].second);\n    }\n\n    int ret1 = 0, ret2 = 0;\n    for(int i = 0; i < n; i++) {\n        const int& f = za[i].first; // use reference to avoid copy\n        const int& s = za[i].second; // use reference to avoid copy\n        ret1 = max(ret1, min(max(f - lx, s - ly), max(rx - f, ry - s)));\n        ret2 = max(ret2, min(max(f - lx, ry - s), max(rx - f, s - ly)));\n    }\n\n    printf("%d\\n", min(ret1, ret2));\n}') + LineLLMMutation(('source.cpp', 24), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\ntypedef pair<int, int> P;\ntypedef