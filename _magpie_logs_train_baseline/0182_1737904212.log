, l;\n        scanf("%d %d %d", &a, &b, &l);\n        a--; b--;\n        edges[i] = P(a, b); // Store edges in the vector\n        g[a].push_back(P(l, b));\n        g[b].push_back(P(l, a));\n    }\n    \n    for(int i = 0; i < k; i++) {\n        scanf("%d", &s[i]);\n        s[i]--;\n    }\n    \n    priority_queue<P, vector<P>, greater<P>> q;\n    for(int i = 0; i < k; i++) {\n        d[s[i]] = 0;\n        q.push(P(0, s[i]));\n    }\n    \n    double ans = 0.0;\n    while(!q.empty()) {\n        P p = q.top(); q.pop();\n        int cost = p.first, pos = p.second;\n        for(const auto& edge : g[pos]) {\n            int dis = cost + edge.first;\n            int next = edge.second;\n            if(dis < d[next]) {\n                d[next] = dis;\n                q.push(P(dis, next));\n            }\n        }\n    }\n    \n    for(const auto& edge : edges) { // Use stored edges for final computation\n        int a = edge.first, b = edge.second;\n        double diff = fabs(d[a] - d[b]);\n        if(diff >= l) {\n            ans = max(ans, (double)max(d[a], d[b]));\n        } else {\n            ans = max(ans, (double)(l + d[a] + d[b]) / 2);\n        }\n    }\n    printf("%d\\n", (int)(ans + 1e-9 + 0.5));\n}')"
