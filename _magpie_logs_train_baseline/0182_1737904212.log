2025-01-26 15:12:26,312	[DEBUG]	patch(0-9)="LineLLMMutation(('source.cpp', 8), '#include <cstdio>\n#include <queue>\n#include <vector>\n#include <cmath>\n#define INF 500000000\nusing namespace std;\n\ntypedef pair<int,int> P;\n\nint main() {\n    int n, m, k;\n    scanf("%d %d %d", &n, &m, &k); // Read number of nodes, edges, and sources\n    vector<int> l(m), a(m), b(m); // Edge lengths and endpoints\n    vector<vector<P>> g(n); // Graph representation\n    vector<int> d(n, INF), s(k); // Distances and sources\n    \n    for(int i=0; i<m; i++) {\n        scanf("%d %d %d", &a[i], &b[i], &l[i]); // Input edges\n        a[i]--; b[i]--; // Convert to 0-based indexing\n        g[a[i]].push_back(P(l[i], b[i])); // Add edge to graph\n        g[b[i]].push_back(P(l[i], a[i])); // Add reverse edge\n    }\n    \n    for(int i=0; i<k; i++) {\n        scanf("%d", &s[i]); // Input sources\n        s[i]--; // Convert to 0-based indexing\n    }\n    \n    priority_queue<P, vector<P>, greater<P>> q; // Min-heap for Dijkstra\'s algorithm\n    for(int i=0; i<k; i++) {\n        d[s[i]] = 0; // Initialize distances for sources\n        q.push(P(0, s[i])); // Push sources into priority queue\n    }\n    \n    double ans = 0.0; // Result variable\n    while(!q.empty()) {\n        P p = q.top(); q.pop(); // Get the minimum distance node\n        int cost = p.first, pos = p.second;\n        for(const auto& edge : g[pos]) {\n            int dis = cost + edge.first; // Calculate distance to next node\n            int next = edge.second;\n            if(dis < d[next]) {\n                d[next] = dis; // Update distance if smaller\n                q.push(P(dis, next)); // Push new distance to queue\n            }\n        }\n    }\n    \n    for(int i=0; i<m; i++) {\n        if(fabs(d[a[i]] - d[b[i]]) >= l[i]) {\n            ans = max(ans, (double)max(d[a[i]], d[b[i]])); // Update answer\n        } else {\n            ans = max(ans, (double)(l[i] + d[a[i]] + d[b[i]]) / 2); // Calculate averag