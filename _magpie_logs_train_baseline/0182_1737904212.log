[i]--; b[i]--;\n        g[a[i]].push_back(P(l[i], b[i]));\n        g[b[i]].push_back(P(l[i], a[i]));\n    }\n    \n    for(int i=0; i<k; i++) {\n        scanf("%d", &s[i]);\n        s[i]--;\n    }\n    \n    // Using an array instead of priority_queue to find the min distance\n    d[s[0]] = 0;\n    bool visited[n] = {false};\n    \n    for(int i = 0; i < k; i++) {\n        int min_dist = INF;\n        int pos = -1;\n        for(int j = 0; j < n; j++) {\n            if (!visited[j] && d[j] < min_dist) {\n                min_dist = d[j];\n                pos = j;\n            }\n        }\n        if (pos == -1) break; // All reachable nodes have been visited\n        visited[pos] = true;\n\n        for(const auto& edge : g[pos]) {\n            int dis = min_dist + edge.first;\n            int next = edge.second;\n            if(dis < d[next]) {\n                d[next] = dis;\n            }\n        }\n    }\n    \n    double ans = 0.0;\n    for(int i=0; i<m; i++) {\n        double diff = fabs(d[a[i]] - d[b[i]]);\n        if(diff >= l[i]) {\n            ans = max(ans, (double)max(d[a[i]], d[b[i]]));\n        } else {\n            ans = max(ans, (double)(l[i] + d[a[i]] + d[b[i]]) / 2);\n        }\n    }\n    printf("%d\\n", (int)(ans + 1e-9 + 0.5));\n}')"
