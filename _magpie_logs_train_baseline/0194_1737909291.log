) {\n    if (depth[a] < depth[b]) swap(a, b);\n    int i, diff = depth[a] - depth[b], ans = INF;\n    for (i = 0; i < 20; i++) {\n        if (diff >> i & 1) {\n            ans = min(ans, cos[i][a]);\n            a = par[i][a];\n        }\n    }\n    if (a == b) return ans;\n    for (i = 19; i >= 0; i--) {\n        if (par[i][a] != par[i][b]) {\n            ans = min(ans, cos[i][a]);\n            ans = min(ans, cos[i][b]);\n            a = par[i][a];\n            b = par[i][b];\n        }\n    }\n    ans = min(ans, cos[0][a]);\n    ans = min(ans, cos[0][b]);\n    return ans;\n}\n\nvoid swap(int& a, int& b) {\n    a ^= b;\n    b ^= a;\n    a ^= b;\n}\n\nint main() {\n    scanf("%d %d %d %d", &n, &m, &k, &q);\n    for (int i = 0; i < m; i++) {\n        int a, b, c;\n        scanf("%d %d %d", &a, &b, &c);\n        a--; b--;\n        e[a].push_back(P(b, c));\n        e[b].push_back(P(a, c));\n    }\n    for (int i = 0; i < n; i++) d[i] = INF;\n    for (int i = 0; i < k; i++) {\n        int s;\n        scanf("%d", &s);\n        d[s - 1] = 0;\n        que.push(P(0, s - 1));\n    }\n    dykstra();\n    for (int i = 0; i < n; i++) {\n        for (int j = 0; j < e[i].size(); j++) {\n            ge[i].push_back(P(e[i][j].to, -min(d[i], d[e[i][j].to])));\n        }\n    }\n    mt();\n    for (int i = 0; i < n; i++) {\n        for (int j = 0; j < 20; j++) {\n            par[j][i] = -1;\n            cos[j][i] = INF;\n        }\n    }\n    dfs(0, -1, 0);\n    for (int i = 1; i < 20; i++) {\n        for (int j = 0; j < n; j++) {\n            if (par[i - 1][j] != -1) {\n                par[i][j] = par[i - 1][par[i - 1][j]];\n                cos[i][j] = min(cos[i - 1][j], cos[i - 1][par[i - 1][j]]);\n            }\n        }\n    }\n    for (int i = 0; i < q; i++) {\n        int s, t;\n        scanf("%d %d", &s, &t);\n        s--; t--;\n        printf("%d\\n", lca(s, t));\n    }\n    return 0;\n}')"
