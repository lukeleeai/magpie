ar[i][a];\n\t\t}\n\t}\n\tif(a==b)return ans;\n\tfor(i=19;i>=0;i--){\n\t\tif(par[i][a]!=par[i][b]){\n\t\t\tans=min(ans,cos[i][a]);\n\t\t\tans=min(ans,cos[i][b]);\n\t\t\ta=par[i][a];\n\t\t\tb=par[i][b];\n\t\t}\n\t}\n\tans=min(ans,cos[0][a]);\n\tans=min(ans,cos[0][b]);\n\treturn ans;\n}\n\nint main(){\n\tscanf("%d %d %d %d",&n,&m,&k,&q);\n\tint i,j;\n\tfor(i=0;i<m;i++){\n\t\tint a,b,c;\n\t\tscanf("%d %d %d",&a,&b,&c);\n\t\ta--;b--;\n\t\te[a].push_back(P(b,c));\n\t\te[b].push_back(P(a,c));\n\t}\n\tfor(i=0;i<n;i++)d[i]=INF;\n\tfor(i=0;i<k;i++){\n\t\tint s;\n\t\tscanf("%d",&s);\n\t\td[s-1]=0;\n\t\tque.push(P(0,s-1));\n\t}\n\tdykstra();\n\tfor(i=0;i<n;i++){\n\t\tfor(j=0;j<e[i].size();j++){\n\t\t\tge[i].push_back(P(e[i][j].to,-min(d[i],d[e[i][j].to])));\n\t\t}\n\t}\n\tmt();\n\tfor(i=0;i<n;i++){\n\t\tfor(j=0;j<20;j++){\n\t\t\tpar[j][i]=-1;\n\t\t\tcos[j][i]=INF;\n\t\t}\n\t}\n\tdfs(0,-1,0);\n\tfor(i=1;i<20;i++){\n\t\tfor(j=0;j<n;j++){\n\t\t\tif(par[i-1][j]!=-1){\n\t\t\t\tpar[i][j]=par[i-1][par[i-1][j]];\n\t\t\t\tcos[i][j]=min(cos[i-1][j],cos[i-1][par[i-1][j]]);\n\t\t\t}\n\t\t}\n\t}\n\tfor(i=0;i<q;i++){\n\t\tint s,t;\n\t\tscanf("%d %d",&s,&t);\n\t\ts--;t--;\n\t\tprintf("%d\\n",lca(s,t));\n\t}\n\treturn 0;\n}') | LineLLMMutation(('source.cpp', 30), '#include <cstdio>\n#include <queue>\n#include <algorithm>\n\n#define to first\n#define cost second\n#define INF 1000000000\n#define MAXN 100000\n\nusing namespace std;\n\ntypedef pair<int,int> P;\n\nP e[MAXN][MAXN]; // Changed to a fixed-size array for edges\nint edgeCount[MAXN]; // To keep track of the number of edges for each vertex\nint d[MAXN];\nbool used[MAXN];\nint bfr[MAXN];\nint depth[MAXN];\nint par[20][MAXN];\nint cos[20][MAXN];\nint n,m,k,q;\n\npriority_queue< P,vector<P>,greater<P> > que;\n\nint max(int a,int b){return a>b?a:b;}\nint min(int a,int b){return a<b?a:b;}\nvoid swap(int& a,int& b){int p=a;a=b;b=p;}\n\nvoid dykstra(){\n    while(!que.empty()){\n        P p=que.top();\n        que.pop();\n        int v=p.second;\n        if(p.first>d[v])continue;\n        for(int i=0; i<edgeCount[v]; i++){\n            int u = e[v][i].to;\n            int c = e[v][i].cost;\n            if(d[u] > d[v] + c){\n                d[u] = d[v] + c;\n                que.push(P(d[u],u));\n            }\n        }\n    }\n}\n\nvoid mt(){\n    for(int i = 0; i < n; i++){\n        d[i] = INF;\n        used[i] = false;\n        bfr[i] = -1;\n    }\n    d[0] = 0;\n    que.push(P(0,0));\n    while(!que.empty()){\n        P p = que.top();\n        que.pop();\n        int v = p.second;\n        if(p.first > d[v]) continue;\n        used[v] = true;\n        if(bfr[v] != -1){\n            // Using a fixed edge structure\n            e[v][edgeCount[v]++] = P(bfr[v], -d[v]);\n            e[bfr[v]][edgeCount[bfr[v]]++] = P(v, -d[v]);\n        }\n        for(int i = 0; i < edgeCount[v]; i++){\n            int u = e[v][i].to;\n            int c = e[v][i].cost;\n            if(!used[u] && d[u] > c){\n                d[u] = c;\n                bfr[u] = v;\n                que.push(P(d[u],u));\n            }\n        }\n    }\n}\n\nvoid dfs(int v, int p, int d){\n    depth[v] = d;\n    for(int i = 0; i < edgeCount[v]; i++){\n        if(e[v][i].to == p) continue;\n        par[0][e[v][i].to] = v;\n        cos[0][e[v][i].to] = e[v][i].cost;\n        dfs(e[v][i].to, v, d + 1);\n    }\n}\n\nint lca(int a, int b){\n    if(depth[a] < depth[b]) swap(a, b);\n    int ans = INF;\n    for(int i = 0; i < 20; i++){\n        if(depth[a] - depth[b] >> i & 1){\n            ans = min(ans, cos[i][a]);\n            a = par[i][a];\n        }\n    }\n    if(a == b) return ans;\n    for(int i = 19; i >= 0; i--){\n        if(par[i][a] != par[i][b]){\n            ans = min(ans, cos[i][a]);\n            ans = min(ans, cos[i][b]);\n            a = par[i][a];\n            b = par[i][b];\n        }\n    }\n    ans = min(ans, cos[0][a]);\n    ans = min(ans, cos[0][b]);\n    return ans;\n}\n\nint main(){\n    scanf("%d %d %d %d", &n, &m, &k, &q);\n    for(int i = 0; i < m; i++){\n        int a, b, c;\n        scanf("%d %d %d", &a, &b, &c);\n        a--; b--;\n        e[a][edgeCount[a]++] = P(b, c);\n        e[b][edgeCount[b]++] = P(a, c);\n    }\n    fill(d, d + n, INF);\n    for(int i = 0; i < k; i++){\n        int s;\n        scanf("%d", &s);\n        d[s - 1] = 0;\n        que.push(P(0, s - 1));\n    }\n    dykstra();\n    for(int i = 0; i < n; i++){\n        for(int j = 0; j < edgeCount[i]; j++){\n            ge[i].push_back(P(e[i][j].to, -min(d[i], d[e[i][j].to])));\n        }\n    }\n    mt();\n    fill(&par[0][0], &par[0][0] + sizeof(par) / sizeof(par[0][0]), -1);\n    fill(&cos[0][0], &cos[0][0] + sizeof(cos) / sizeof(cos[0][0]), INF);\n    dfs(0, -1, 0);\n    for(int i = 1; i < 20; i++){\n        for(int j = 0; j < n; j++){\n            if(par[i - 1][j] != -1){\n                par[i][j] = par[i - 1][par[i - 1][j]];\n                cos[i][j] = min(cos[i - 1][j], cos[i - 1][par[i - 1][j]]);\n            }\n        }\n    }\n    for(int i = 0; i < q; i++){\n        int s, t;\n        scanf("%d %d", &s, &t);\n        s--; t--;\n        printf("%d\\n", lca(s, t));\n    }\n    return 0;\n}')"
