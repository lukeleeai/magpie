lude <cmath>\n#include <cstdio>\nusing namespace std;\n\n#define MAX_N 1000000\n#define INF 1145141145141919810LL\n\nlong long x[MAX_N], y[MAX_N], n, h, w, sx, sy, c, mx, my, sum, minx, dx, dy;\nvector<long long> BX, BY;\n\nint main() {\n    scanf("%lld %lld %lld", &h, &w, &n);\n    for(int i = 0; i < n; i++) {\n        scanf("%lld %lld", &x[i], &y[i]);\n        sx += x[i];\n        sy += y[i];\n    }\n\n    sort(x, x + n);\n    sort(y, y + n);\n\n    mx = INF; my = INF; minx = INF;\n\n    for(int i = 0; i < n; i++) {\n        c = (i == 0) ? x[0] : x[i] - x[i - 1];\n        sx += (-n + i * 2) * c;\n        if(mx > sx) {\n            mx = sx;\n            BX.clear();\n            BX.push_back(x[i]);\n        } else if(mx == sx) {\n            BX.push_back(x[i]);\n        }\n    }\n\n    for(int i = 0; i < n; i++) {\n        c = (i == 0) ? y[0] : y[i] - y[i - 1];\n        sy += (-n + i * 2) * c;\n        if(my > sy) {\n            my = sy;\n            BY.clear();\n            BY.push_back(y[i]);\n        } else if(my == sy) {\n            BY.push_back(y[i]);\n        }\n    }\n\n    // Replacing the nested loop with a more efficient calculation\n    long long total_distance = 0;\n    for(int i = 0; i < n; i++) {\n        total_distance += abs(BX[0] - x[i]) + abs(BY[0] - y[i]);\n    }\n    minx = total_distance * 2; // Initialize minx with the total distance\n\n    for(int i = 0; i < BX.size(); i++) {\n        for(int j = 0; j < BY.size(); j++) {\n            long long current_distance = 0;\n            for(int k = 0; k < n; k++) {\n                current_distance += abs(BX[i] - x[k]) + abs(BY[j] - y[k]);\n            }\n            long long total_sum = current_distance * 2;\n            if(minx > total_sum) {\n                minx = total_sum;\n                dx = BX[i];\n                dy = BY[j];\n            }\n        }\n    }\n\n    printf("%lld\\n%lld %lld\\n", minx, dx, dy);\n    return 0;\n}')"
