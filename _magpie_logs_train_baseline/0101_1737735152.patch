LineLLMCrossover(('source.cpp', 30), '#include <cstdio>\n#include <vector>\nusing namespace std;\n\nstruct Node {\n    int val;\n    Node *prev, *next;\n    Node(int v) : val(v), prev(nullptr), next(nullptr) {}\n};\n\nNode *head = nullptr, *tail = nullptr;\n\nvoid add(int val) {\n    Node *New = new Node(val); // Use raw pointers directly\n    if (!head) {\n        head = tail = New;\n    } else {\n        tail->next = New;\n        New->prev = tail;\n        tail = New;\n    }\n}\n\nvoid del(Node *node) {\n    if (node->prev) {\n        node->prev->next = node->next;\n    } else {\n        head = node->next;\n    }\n    if (node->next) {\n        node->next->prev = node->prev;\n    } else {\n        tail = node->prev;\n    }\n    delete node; // Deleting the node remains unchanged\n}\n\nint main() {\n    int N, M, Q;\n    scanf("%d %d %d", &N, &M, &Q);\n    vector<int> OK(N, 0);\n    for (int i = 0; i < N; ++i) add(i);\n\n    Node *cur = head;\n    while (M--) {\n        int a;\n        scanf("%d", &a);\n        for (int j = 0; j < a; ++j) {\n            cur = (a & 1) ? (cur->prev ? cur->prev : tail) : (cur->next ? cur->next : head);\n        }\n        Node *tmp = cur;\n        cur = cur->next ? cur->next : head;\n        del(tmp);\n    }\n\n    for (Node *cur = head; cur; cur = cur->next) {\n        OK[cur->val] = 1;\n    }\n\n    while (Q--) {\n        int q;\n        scanf("%d", &q);\n        printf("%d\\n", OK[q]);\n    }\n}') + LineLLMMutation(('source.cpp', 39), '#include <cstdio>\n#include <vector>\n#include <memory>\nusing namespace std;\n\nstruct Node {\n    int val;\n    shared_ptr<Node> prev, next;\n    Node(int v) : val(v), prev(nullptr), next(nullptr) {}\n};\n\nshared_ptr<Node> head = nullptr, tail = nullptr;\n\nvoid add(int val) {\n    auto New = make_shared<Node>(val); // Using smart pointers for automatic memory management\n    if (!head) {\n        head = tail = New;\n    } else {\n        tail->next = New;\n        New->prev = tail;\n        tail