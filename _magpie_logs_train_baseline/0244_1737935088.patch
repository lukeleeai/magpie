LineLLMMutation(('source.cpp', 1), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\nint main() {\n    int n, s, r[20200];\n    while (scanf("%d %d", &n, &s) == 2 && n) {\n        for (int i = 0; i < n; i++) scanf("%d", &r[i]);\n        sort(r, r + n);\n        int ans = 0, upperIndex;\n        for (int i = 0; i < n; i++) {\n            upperIndex = upper_bound(r + i + 1, r + n, s - r[i]) - r;\n            ans += n - upperIndex;\n        }\n        printf("%d\\n", ans);\n    }\n}')
