LineLLMCrossover(('source.cpp', 8), '#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <utility>\n#include <cstdio>\nusing namespace std;\n\n#define int long long\n#define PB push_back\n#define INF (1LL<<61LL)\n\ntypedef pair<int, int> pii;\n\nint N, L, a[100005], dx[] = {-1, 1};\nvector<int> g[100005];\n\nint cal(int x) {\n    int res = L - a[x], temp = 0;\n    for (int i = 0; i < g[x].size(); ++i) {\n        temp = max(temp, cal(g[x][i]));\n    }\n    return res + temp;\n}\n\nsigned main() {\n    scanf("%lld %lld", &N, &L);\n    for (int i = 1; i <= N; ++i)\n        scanf("%lld", &a[i]);\n\n    int maxt = 0;\n    for (int i = 1; i <= N; ++i) {\n        int count = 0;\n        for (int j = 0; j < 2; ++j) {\n            if (a[i + dx[j]] < a[i]) {\n                g[i].PB(i + dx[j]);\n                count++;\n            }\n        }\n        if ((count == 2) || (((i == 1) || (i == N)) && (count == 1))) {\n            maxt = max(maxt, cal(i));\n        }\n    }\n    printf("%lld\\n", maxt);\n    return 0;\n}')
