LineLLMCrossover(('source.cpp', 31), '#include <cstdio>\n#include <cmath>\n#include <vector>\nusing namespace std;\n\nint r, c;\nbool state[10][10000];\nbool linemap[10][10000];\nint mapcount;\n\nint getnum(bool status[10][10000]) {\n    int count = 0;\n    for (int i = 0; i < r * c; i++) {\n        count += status[i / c][i % c];\n    }\n    return count;\n}\n\nvoid adjust() {\n    for (int j = 0; j < c; j++) {\n        int num0 = 0, num1 = 0;\n        for (int k = 0; k < r; k++) {\n            num1 += linemap[k][j];\n            num0 += !linemap[k][j];\n        }\n        if (num0 > num1) {\n            for (int k = 0; k < r; k++) {\n                linemap[k][j] = !linemap[k][j]; // Using NOT for toggling\n            }\n        }\n    }\n}\n\nint creatlinemap() {\n    int max = 0;\n    for (int i = 0; i < mapcount; i++) {\n        for (int j = 0; j < r; j++) {\n            for (int k = 0; k < c; k++) {\n                linemap[j][k] = (i & (1 << j)) ? state[j][k] : !state[j][k];\n            }\n        }\n        adjust();\n        max = std::max(max, getnum(linemap)); // Using std::max for clarity\n    }\n    return max;\n}\n\nint main() {\n    while (scanf("%d %d", &r, &c) == 2) {\n        if (r * c == 0) return 0;\n        mapcount = 1 << r; \n        for (int i = 0; i < r; i++) {\n            for (int j = 0; j < c; j++) {\n                scanf("%d", &state[i][j]);\n            }\n        }\n        printf("%d\\n", creatlinemap());\n    }\n}') + LineLLMMutation(('source.cpp', 44), '#include <cstdio>\n#include <cmath>\n#include <vector>\nusing namespace std;\n\nint r, c;\nbool state[10][10000];\nbool linemap[10][10000];\nint mapcount;\n\nint getnum(bool status[10][10000]) {\n    int count = 0;\n    for (int i = 0; i < r; i++) {\n        for (int j = 0; j < c; j++) {\n            count += status[i][j];\n        }\n    }\n    return count;\n}\n\nvoid adjust() {\n    for (int j = 0; j < c; j++) {\n        int num0 = 0, num1 = 0;\n        for (int k = 0; k < r; k+