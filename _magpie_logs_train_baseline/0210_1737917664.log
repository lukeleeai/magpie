2025-01-26 18:57:53,534	[DEBUG]	patch(1-10)="LineLLMMutation(('source.cpp', 15), '#include <cstdio>\n#include <vector>\n#include <algorithm>\n\nusing namespace std;\n\ntypedef long long ll;\n\nconst ll INF = 0xffffffffffffff;\nll N, M, Q;\nll D[100000];\nll d[100000];\nll U[200000], V[200000];\nll R[200000];\nbool ansin[100000];\nll anum[200000];\nvector<ll> G[100000];\nvector<ll> G2[100000];\n\nbool mov[200000];\n\nstruct Node {\n    ll id, dist;\n    bool operator>(const Node& other) const {\n        return dist > other.dist; // For custom sorting\n    }\n};\n\nint main() {\n    scanf("%lld%lld%lld", &N, &M, &Q);\n    for (ll i = 0; i < M; i++) {\n        scanf("%lld%lld", &U[i], &V[i]);\n        U[i]--; V[i]--;\n        G[V[i]].push_back(U[i]);\n        G[U[i]].push_back(V[i]);\n    }\n    for (ll i = 0; i < Q; i++) {\n        scanf("%lld", &R[i]);\n        R[i]--;\n        mov[R[i]] = 1;\n    }\n    fill(D, D + N, INF);\n    D[0] = 0;\n\n    vector<Node> pq;\n    pq.push_back({0, 0});\n    while (!pq.empty()) {\n        sort(pq.begin(), pq.end(), greater<Node>());\n        Node x = pq.back(); pq.pop_back(); // Get the minimum\n        for (auto &neighbor : G[x.id]) {\n            if (D[neighbor] > D[x.id] + 1) {\n                D[neighbor] = D[x.id] + 1;\n                pq.push_back({neighbor, D[neighbor]});\n            }\n        }\n    }\n    // Remaining code...\n}')"
