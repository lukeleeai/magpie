2025-01-23 19:19:33,345	[DEBUG]	patch(0-9)="LineLLMMutation(('source.cpp', 8), '#include <cstdio>\n#include <map>\n#include <algorithm>\n#include <vector>\n#include <set>\nusing namespace std;\n\nint main() {\n    int n, m;\n\n    while (scanf("%d", &n), n) {\n        vector<pair<int,int>> mt;\n        mt.reserve(n + m);\n        for (int i = 0; i < n; i++) {\n            int a, b;\n            scanf("%d %d", &a, &b);\n            mt.emplace_back(a, b);\n        }\n\n        scanf("%d", &m);\n        for (int i = 0; i < m; i++) {\n            int a, b;\n            scanf("%d %d", &a, &b);\n            mt.emplace_back(a, b);\n        }\n\n        sort(mt.begin(), mt.end());\n        int dp[1000][201];\n        fill(&dp[0][0], &dp[0][0] + sizeof(dp) / sizeof(int), 1000);\n        set<int> unique_heights;\n\n        int ans = 0;\n        for (int i = 0; i < n + m; i++) {\n            int h = mt[i].first;\n            int r = mt[i].second;\n            if (unique_heights.find(h) == unique_heights.end()) {\n                dp[h][1] = min(dp[h][1], r);\n                unique_heights.insert(h);\n            }\n            for (int j = 0; j < h; j++) {\n                for (int k = 0; k < n + m; k++) {\n                    if (r > dp[j][k]) {\n                        dp[h][k + 1] = min(dp[h][k + 1], r);\n                    }\n                }\n            }\n        }\n\n        for (int i = 0; i < 1000; i++) {\n            for (int j = 0; j <= n + m; j++) {\n                if (dp[i][j] != 1000) {\n                    ans = max(ans, j);\n                }\n            }\n        }\n\n        printf("%d\\n", ans);\n    }\n}')"
