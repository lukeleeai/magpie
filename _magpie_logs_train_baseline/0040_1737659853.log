         scanf("%d %d", &a, &b);\n            mt[n + i] = P(a, b);\n        }\n\n        sort(mt.begin(), mt.end());\n        \n        int ans = 0;\n        for (const auto& p : mt) {\n            int h = p.first;\n            int r = p.second;\n            if (dp[h].empty() || r < dp[h][0]) {\n                dp[h].insert(dp[h].begin(), r); // Insert in sorted order\n            }\n            for (int j = 0; j < h; j++) {\n                for (int k = 0; k < dp[j].size(); k++) {\n                    if (r > dp[j][k]) {\n                        dp[h].push_back(r); // Store only if it\'s a new relevant state\n                    }\n                }\n            }\n        }\n\n        for (const auto& entry : dp) {\n            ans = max(ans, (int)entry.second.size());\n        }\n\n        printf("%d\\n", ans);\n    }\n}')"
