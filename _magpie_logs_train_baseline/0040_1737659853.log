2025-01-23 19:19:34,841	[DEBUG]	patch(0-10)="LineLLMMutation(('source.cpp', 9), '#include <cstdio>\n#include <map>\n#include <algorithm>\nusing namespace std;\n\npair<int,int> mt[200];\n\ninline int my_min(int a, int b) { return a < b ? a : b; }\ninline int my_max(int a, int b) { return a > b ? a : b; }\n\nint main() {\n    int n, m;\n\n    while (scanf("%d", &n), n) {\n        for (int i = 0; i < n; i++) {\n            int a, b;\n            scanf("%d %d", &a, &b);\n            mt[i] = make_pair(a, b);\n        }\n\n        scanf("%d", &m);\n        for (int i = 0; i < m; i++) {\n            int a, b;\n            scanf("%d %d", &a, &b);\n            mt[n + i] = make_pair(a, b);\n        }\n\n        sort(mt, mt + m + n);\n        int dp[1000][201];\n        fill(&dp[0][0], &dp[0][0] + sizeof(dp) / sizeof(int), 1000);\n\n        int ans = 0;\n        for (int i = 0; i < m + n; i++) {\n            int h = mt[i].first;\n            int r = mt[i].second;\n            dp[h][1] = my_min(dp[h][1], r);\n            for (int j = 0; j < h; j++) {\n                for (int k = 0; k < m + n; k++) {\n                    if (r > dp[j][k]) {\n                        dp[h][k + 1] = my_min(dp[h][k + 1], r);\n                    }\n                }\n            }\n        }\n\n        for (int i = 0; i < 1000; i++) {\n            for (int j = 0; j <= m + n; j++) {\n                if (dp[i][j] != 1000) {\n                    ans = my_max(ans, j);\n                }\n            }\n        }\n\n        printf("%d\\n", ans);\n    }\n}')"
