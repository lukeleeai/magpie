LineLLMCrossover(('source.cpp', 6), '#include <cstdio>\n\nusing namespace std;\n\nint main() {\n    int k, c;\n\n    while (1) {\n        scanf("%d", &k);\n        if (!k) break;\n\n        int s = 0; // Using a single declaration for clarity\n        for (int i = 0; i < k * (k - 1) / 2; i++) {\n            scanf("%d", &c);\n            s += c;\n        }\n\n        printf("%d\\n", s / (k - 1)); // Directly outputting the average\n    }\n\n    return 0;\n}')
