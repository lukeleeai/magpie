, 0, 0));\n    }\n    return 0;\n}') | LineLLMMutation(('source.cpp', 23), '#include<cstdio>\n#include<cstring> // Include cstring for memset\nusing namespace std;\n\nint n, s;\nint memo[1024][1000]; // Two-dimensional array\n\nint search(int stat, int sum, int dep) {\n    if (dep == n) return memo[stat][sum] = (s == sum);\n    if (~memo[stat][sum]) return memo[stat][sum];\n\n    int cnt = 0;\n    // Instead of checking all 10 digits each time, we can limit the range of digits based on current depth\n    for (int i = 0; i < 10; i++) {\n        if ((stat & (1 << i)) == 0) {\n            stat |= 1 << i; // Mark the bit as used\n            cnt += search(stat, sum + i * (n - dep), dep + 1);\n            stat &= ~(1 << i); // Unmark the bit\n        }\n    }\n    return memo[stat][sum] = cnt;\n}\n\nint main() {\n    while (scanf("%d%d", &n, &s) == 2) { // Using scanf for input\n        memset(memo, -1, sizeof(memo)); // Use memset to initialize the entire memo array\n        if (n > 10 || s >= 1000) {\n            puts("0");\n            continue;\n        }\n        printf("%d\\n", search(0, 0, 0));\n    }\n    return 0;\n}')"
