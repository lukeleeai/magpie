LineLLMCrossover(('source.cpp', 17), '#include <iostream>\n#include <cstdio>\n#include <vector>\n#include <cstring>\n#include <algorithm>\n\n#define pb push_back\n\nusing namespace std;\n\ntypedef pair<int, int> P;\ntypedef long long int ll;\n\nint w, n;\nint t = 0;\nshort dp[1001][1001];\nvector<P> vec;\n\nint rec(int i, int j) {\n    if(dp[i][j] >= 0) return dp[i][j];\n    int res;\n    if(i == n) res = 0;\n    else if(j < vec[i].second) res = rec(i + 1, j);\n    else res = max(rec(i + 1, j), rec(i + 1, j - vec[i].second) + vec[i].first);\n    return dp[i][j] = res;\n}\n\nint main() {\n    while(scanf("%d", &w)) {\n        t++;\n        if(w == 0) break;\n        for(int i = 0; i <= 1000; i++) {\n            for(int j = 0; j <= 1000; j++) {\n                dp[i][j] = -1;\n            }\n        }\n        scanf("%d", &n);\n        for(int i = 0; i < n; i++) {\n            int temp1, temp2;\n            char trash;\n            scanf("%d%c%d", &temp1, &trash, &temp2);\n            vec.pb(P(temp1, temp2));\n        }\n        printf("Case %d:\\n", t);\n        printf("%d\\n", rec(0, w));\n        for(int i = 1; i <= w; i++) {\n            if(rec(0, w - i) != rec(0, w)) {\n                printf("%d\\n", w - i + 1);\n                break;\n            }\n        }\n        vec.clear();\n    }\n}') + LineLLMMutation(('source.cpp', 34), '#include <iostream>\n#include <cstdio>\n#include <vector>\n#include <cstring>\n#include <algorithm>\n\n#define pb push_back\n\nusing namespace std;\n\ntypedef pair<int, int> P;\ntypedef long long int ll;\n\nint w, n;\nint t = 0;\nvector<vector<short>> dp(1001, vector<short>(1001, -1)); // Use vector for dynamic sizing\nvector<P> vec;\n\nint rec(int i, int j) {\n    if(dp[i][j] >= 0) return dp[i][j];\n    int res;\n    if(i == n) res = 0;\n    else if(j < vec[i].second) res = rec(i + 1, j);\n    else res = max(rec(i + 1, j), rec(i + 1, j - vec[i].second) + vec[i].first);\n    return dp[i][j] = res;\n}\n\nint main() {\n    while(scanf("%d", &w)) {\n        t++;\n        if(w == 0) break;\n        // No need to initialize dp here, it is already initialized\n        scanf("%d", &n);\n        for(int i = 0; i < n; i++) {\n            int temp1, temp2;\n            char trash;\n            scanf("%d%c%d", &temp1, &trash, &temp2);\n            vec.pb(P(temp1, temp2));\n        }\n        printf("Case %d:\\n", t);\n        printf("%d\\n", rec(0, w));\n        for(int i = 1; i <= w; i++) {\n            if(rec(0, w - i) != rec(0, w)) {\n                printf("%d\\n", w - i + 1);\n                break;\n            }\n        }\n        vec.clear();\n    }\n}') + LineLLMMutation(('source.cpp', 45), '#include <iostream>\n#include <cstdio>\n#include <vector>\n#include <cstring>\n#include <algorithm>\n\nusing namespace std;\n\ntypedef pair<int, int> P;\ntypedef long long int ll;\n\nint w, n;\nint t = 0;\nvector<P> vec;\n\nint rec(int j, int* dp) {\n    if (j < 0) return 0;\n    return dp[j];\n}\n\nint main() {\n    while(scanf("%d", &w)) {\n        t++;\n        if(w == 0) break;\n\n        scanf("%d", &n);\n        vec.resize(n);\n        for(int i = 0; i < n; i++) {\n            int temp1, temp2;\n            char trash;\n            scanf("%d%c%d", &temp1, &trash, &temp2);\n            vec[i] = P(temp1, temp2);\n        }\n\n        int* dp = new int[w + 1](); // Using a 1D array for dp\n        for (int i = 0; i < n; i++) {\n            for (int j = w; j >= vec[i].second; j--) {\n                dp[j] = max(dp[j], dp[j - vec[i].second] + vec[i].first);\n            }\n        }\n\n        printf("Case %d:\\n", t);\n        printf("%d\\n", dp[w]);\n        for(int i = 1; i <= w; i++) {\n            if(rec(w - i, dp) != rec(w, dp)) {\n                printf("%d\\n", w - i + 1);\n                break;\n            }\n        }\n        delete[] dp; // Clean up dynamically allocated memory\n    }\n}')
