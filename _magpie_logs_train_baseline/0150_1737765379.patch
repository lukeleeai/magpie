LineLLMCrossover(('source.cpp', 29), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\nconst int MAXN = 100005;\nint S[MAXN], T[MAXN];\n\nint main() {\n    int D, N, M;\n    while (true) {\n        if (scanf("%d", &D) != 1 || D == 0) { break; }\n        scanf("%d %d", &N, &M);\n\n        S[0] = 0;\n        S[N] = D;\n\n        for (int i = 1; i < N; i++) { \n            scanf("%d", &S[i]); \n        }\n        for (int i = 0; i < M; i++) { \n            scanf("%d", &T[i]); \n        }\n\n        sort(S, S + N + 1);\n\n        long long distance_ = 0;\n        for (int i = 0; i < M; i++) {\n            int ti = T[i];\n            int l = *(upper_bound(S, S + N + 1, ti) - 1);\n            int r = *lower_bound(S, S + N + 1, ti);\n            distance_ += min(ti - l, r - ti);\n        }\n\n        printf("%lld\\n", distance_);\n    }\n    return 0;\n}')
