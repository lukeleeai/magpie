2025-01-26 18:40:33,030	[DEBUG]	patch(1-8)="LineLLMMutation(('source.cpp', 12), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\n#include <vector>\n\nusing namespace std;\n\n#define int long long\n#define PB push_back\n#define all(a) a.begin(), a.end()\n#define omajinai ios::sync_with_stdio(false); cin.tie(0)\n\nconst int inf = 3e18;\nconst int maxN = 20005;\n\nint A[maxN];\nint memo[maxN];\n\ninline int rec(int now) {\n    if (now >= maxN) return 0; // Boundary check for safety\n    if (~memo[now]) return memo[now];\n\n    int res = inf;\n    int mi = inf, ma = -inf;\n\n    for (int i = 0; i < 20005; ++i) { // Loop through a fixed range\n        if (now + i >= maxN) break; // Prevent out-of-bounds\n        mi = min(mi, A[now + i]);\n        ma = max(ma, A[now + i]);\n        res = min(res, K + (ma - mi) * (i + 1) + rec(now + i + 1));\n    }\n\n    return memo[now] = (res == inf) ? 0 : res; // Return 0 if inf\n}\n\nsigned main() {\n    omajinai;\n    cin >> N >> M >> K;\n    for (int i = 0; i < N; ++i) {\n        cin >> A[i];\n    }\n    memset(memo, -1, sizeof(memo));\n    cout << rec(0) << endl;\n}')"
