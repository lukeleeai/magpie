LineLLMCrossover(('source.cpp', 6), '#include <cstdio>\nusing namespace std;\n\nint main() {\n    int n, s;\n    while (scanf("%d %d", &n, &s) == 2 && n) {\n        int r[101] = {0};\n        for (int i = 0; i < n; i++) {\n            int tmp;\n            scanf("%d", &tmp);\n            r[tmp]++;\n        }\n\n        int ans = 0;\n        // Count pairs of different elements\n        for (int i = 0; i <= 100; i++) {\n            if (r[i] == 0) continue; // Skip if no elements of this kind\n            for (int j = i + 1; j <= 100; j++) {\n                if (r[j] > 0 && (i + j > s)) {\n                    ans += r[i] * r[j];\n                }\n            }\n        }\n        // Count pairs of the same element\n        for (int i = 0; i <= 100; i++) {\n            if (i + i > s) ans += (r[i] * (r[i] - 1)) / 2;\n        }\n        printf("%d\\n", ans);\n    }\n    return 0;\n}')
