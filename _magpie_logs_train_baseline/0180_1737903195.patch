LineLLMMutation(('source.cpp', 14), '#include<iostream>\n#include<cstdio>\n#include<string>\n#include<vector>\n#include<algorithm>\n#include<cstdlib>\n#include<math.h>\n#include<set>\n#include<map>\n#include<queue>\n\nusing namespace std;\n\ntypedef long long int ll;\n\nint main()\n{\n    int N,K;\n    int C[2000],G[2000];\n    vector<int>X[10];\n\n    scanf("%d%d",&N,&K);\n\n    for(int i=0;i<N;i++){\n        scanf("%d%d",&C[i],&G[i]);\n        X[G[i]-1].push_back(C[i]);\n    }\n\n    for(int i=0;i<10;i++){\n        sort(X[i].begin(),X[i].end());\n        reverse(X[i].begin(),X[i].end());\n    }\n\n    int sum[10][2001];\n    for(int i=0;i<10;i++){\n        sum[i][0]=0;\n        for(int j=1;j<=X[i].size();j++){\n            sum[i][j]=sum[i][j-1]+X[i][j-1]+2*(j-1);\n        }\n    }\n\n    int dp[2001];\n    fill(dp,dp+N+1,0);\n\n    for(int i=0;i<10;i++){\n        for(int j=2000-X[i].size();j>=0;j--){\n            for(int k=0;k<=X[i].size();k++){\n                dp[j+k]=max(dp[j+k],dp[j]+sum[i][k]);\n            }\n        }\n    }\n\n    printf("%d\\n",dp[K]);\n    return 0;\n}') + LineLLMMutation(('source.cpp', 16), '#include<iostream>\n#include<cstdio>\n#include<string>\n#include<vector>\n#include<algorithm>\n#include<cstdlib>\n#include<math.h>\n#include<set>\n#include<map>\n#include<queue>\n\nusing namespace std;\n\ntypedef long long int ll;\n\nint main()\n{\n    int N,K;\n    int C[2000],G[2000];\n    vector<int>X[10];\n\n    scanf("%d%d",&N,&K);\n\n    for(int i=0;i<N;i++){\n        scanf("%d%d",&C[i],&G[i]);\n        X[G[i]-1].push_back(C[i]);\n    }\n\n    for(int i=0;i<10;i++){\n        sort(X[i].begin(),X[i].end(),greater<int>());\n    }\n\n    int dp[2001] = {0};\n\n    for(int i=0;i<10;i++){\n        int currentSum = 0;\n        for(int j=0;j<X[i].size();j++){\n            currentSum += X[i][j] + 2 * j;\n            for(int k=2000-j; k >= 0; k--){\n                dp[k + j + 1] = max(dp[k + j + 1], dp[k] + currentSum);\n            }\n        }\n    }\n\n    printf("%d\\n",dp[K]);\n    return 0;\n}')
