2025-01-24 19:51:13,941	[DEBUG]	patch(8-5)="LineLLMCrossover(('source.cpp', 27), '#include <iostream>\n#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\nconst int MAX_SIZE = 3000; // Define maximum size for static array\nint f[MAX_SIZE]; // Static array for performance\n\nint main() {\n    int a, b, c, n;\n    while (scanf("%d %d %d", &a, &b, &c), a || b || c) {\n        scanf("%d", &n);\n        fill(f, f + a + b + c + 1, 2); // Initialize static array\n\n        int m = a + b + c;\n        int x[1000], y[1000], z[1000];\n        bool r[1000];\n\n        for (int i = 0; i < n; i++) {\n            scanf("%d %d %d %d", &x[i], &y[i], &z[i], &r[i]);\n            x[i]--; y[i]--; z[i]--; // Adjust for zero indexing\n        }\n\n        bool changed;\n        do {\n            changed = false; // Reset change flag for this iteration\n            for (int i = 0; i < n; i++) {\n                int a = x[i], b = y[i], c = z[i];\n                bool Flag = r[i];\n                if (Flag) {\n                    if (f[a] > 1) {\n                        f[a] = f[b] = f[c] = 1;\n                        changed = true;\n                    }\n                } else {\n                    if (f[b] == 1 && f[c] == 1 && f[a] > 0) {\n                        f[a] = 0;\n                        changed = true;\n                    }\n                    if (f[a] == 1 && f[c] == 1 && f[b] > 0) {\n                        f[b] = 0;\n                        changed = true;\n                    }\n                    if (f[a] == 1 && f[b] == 1 && f[c] > 0) {\n                        f[c] = 0;\n                        changed = true;\n                    }\n                }\n            }\n        } while (changed); // Repeat until no changes occur\n\n        for (int i = 0; i < m; i++) printf("%d\\n", f[i]);\n    }\n}')"

