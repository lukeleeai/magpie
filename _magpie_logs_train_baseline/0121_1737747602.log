), '#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <algorithm>\n#include <array>\nusing namespace std;\n\nstruct Node {\n    int x, y, z;\n    bool r;\n};\n\nint main() {\n    int a, b, c, n;\n    while (scanf("%d %d %d", &a, &b, &c), a || b || c) {\n        scanf("%d", &n);\n\n        array<int, 300> f;\n        f.fill(2);\n        int m = a + b + c;\n        vector<Node> nodes(n); // Use a vector of structures to store related data\n\n        for (int i = 0; i < n; i++) {\n            scanf("%d %d %d %d", &nodes[i].x, &nodes[i].y, &nodes[i].z, &nodes[i].r);\n            nodes[i].x--; nodes[i].y--; nodes[i].z--; // Adjust for zero indexing\n        }\n\n        bool changed;\n        do {\n            changed = false;\n            for (const auto& node : nodes) { // Use structured binding\n                int a = node.x, b = node.y, c = node.z;\n                bool Flag = node.r;\n                if (Flag) {\n                    if (f[a] > 1) {\n                        f[a] = f[b] = f[c] = 1;\n                        changed = true;\n                    }\n                } else {\n                    if (f[b] == 1 && f[c] == 1 && f[a] > 0) {\n                        f[a] = 0;\n                        changed = true;\n                    }\n                    if (f[a] == 1 && f[c] == 1 && f[b] > 0) {\n                        f[b] = 0;\n                        changed = true;\n                    }\n                    if (f[a] == 1 && f[b] == 1 && f[c] > 0) {\n                        f[c] = 0;\n                        changed = true;\n                    }\n                }\n            }\n        } while (changed);\n\n        for (int i = 0; i < m; i++) printf("%d\\n", f[i]);\n    }\n}')"
