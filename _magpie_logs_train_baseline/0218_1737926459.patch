LineLLMCrossover(('source.cpp', 9), '#include <cstdio>\n#include <array>\n#include <algorithm>\nusing namespace std;\n\nint main() {\n    int m, n;\n\n    auto check_possible = [](int s[], int m) {\n        for (int i = 0; i < m; ++i)\n            if (s[i] < 0) return false;\n        return true;\n    };\n\n    while (scanf("%d %d", &n, &m) == 2 && (n + m)) {\n        array<int, 100> s = {0}; // Initialize the array to zero\n\n        for (int i = 0; i < m; i++)\n            scanf("%d", &s[i]);\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < m; j++) {\n                int b;\n                scanf("%d", &b);\n                s[j] -= b;\n            }\n        }\n\n        printf("%s\\n", check_possible(s.data(), m) ? "Yes" : "No");\n    }\n\n    return 0;\n}')
