LineLLMMutation(('source.cpp', 25), '#include <cstdio>\n\nusing namespace std;\n\nint H, W, K;\n\nchar t[1001][1001];\n\nint J[1001][1001] = {0};\nint O[1001][1001] = {0};\nint I[1001][1001] = {0};\n\nint main() {\n    while (scanf("%d %d %d", &H, &W, &K) == 3) {\n        for (int i = 1; i <= H; i++) {\n            for (int j = 1; j <= W; j++) {\n                scanf(" %c", &t[i][j]);\n                int isJ = (t[i][j] == \'J\') ? 1 : 0;\n                int isO = (t[i][j] == \'O\') ? 1 : 0;\n                int isI = (t[i][j] == \'I\') ? 1 : 0;\n                J[i][j] = isJ + J[i - 1][j] + J[i][j - 1] - J[i - 1][j - 1];\n                O[i][j] = isO + O[i - 1][j] + O[i][j - 1] - O[i - 1][j - 1];\n                I[i][j] = isI + I[i - 1][j] + I[i][j - 1] - I[i - 1][j - 1];\n            }\n        }\n\n        for (int i = 0; i < K; i++) {\n            int ay, ax, by, bx;\n            scanf("%d %d %d %d", &ay, &ax, &by, &bx);\n            printf("%d %d %d\\n",\n                J[by][bx] - J[ay - 1][bx] - J[by][ax - 1] + J[ay - 1][ax - 1],\n                O[by][bx] - O[ay - 1][bx] - O[by][ax - 1] + O[ay - 1][ax - 1],\n                I[by][bx] - I[ay - 1][bx] - I[by][ax - 1] + I[ay - 1][ax - 1]\n            );\n        }\n    }\n\n    return 0;\n}')
