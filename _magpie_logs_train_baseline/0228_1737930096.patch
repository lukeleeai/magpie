LineLLMCrossover(('source.cpp', 8), '#include <cstdio>\n#include <algorithm>\n#include <numeric>\n\nusing namespace std;\n\nconst int inf = 1000001;\n\nint main() {\n    int n, total;\n\n    while(scanf("%d", &n) && n) {\n        int a[21];\n        total = 0;\n\n        for(int i = 0; i < n; ++i) {\n            scanf("%d", &a[i]);\n            total += a[i];\n        }\n\n        int mn = inf;\n        // Use prefix sums to avoid recalculating sums for every mask\n        int prefix_sum[21] = {0};\n        for(int i = 0; i < n; ++i) {\n            prefix_sum[i] = (i > 0 ? prefix_sum[i - 1] : 0) + a[i];\n        }\n\n        // Iterate only over half of the masks to avoid duplicate calculations\n        for(int mask = 0; mask < (1 << (n - 1)); mask++) {\n            int s = 0;\n            // Calculate the sum using the prefix sums\n            for(int j = 0; j < n; j++) {\n                if(mask & (1 << j)) {\n                    s += a[j];\n                }\n            }\n            mn = min(mn, abs(2 * s - total));\n        }\n\n        printf("%d\\n", mn);\n    }\n\n    return 0;\n}')
