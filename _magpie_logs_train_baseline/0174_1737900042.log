2025-01-26 14:08:53,189	[DEBUG]	patch(4-5)="LineLLMCrossover(('source.cpp', 12), '#include <cstdio>\n#include <queue>\n#include <cstring>\nusing namespace std;\n\nstruct mouse {\n    int x, y, cost, ch;\n};\n\nint dx[] = {0, 1, 0, -1}, dy[] = {1, 0, -1, 0};\nint maxch[1000][1000];\n\nint main() {\n    int h, w, n;\n    scanf("%d %d %d", &h, &w, &n);\n    char ku[100][100];\n    for (int i = 0; i < h; i++) scanf("%s", ku[i]);\n\n    int sx, sy;\n    for (int i = 0; i < h * w; i++) {\n        if (ku[i / w][i % w] == \'S\') {\n            sx = i / w;\n            sy = i % w;\n            break;\n        }\n    }\n\n    queue<mouse> Q;\n    memset(maxch, -1, sizeof(maxch));\n    Q.push({sx, sy, 0, 0});\n    maxch[sx][sy] = 0;\n\n    int ans = 0;\n    while (!Q.empty()) {\n        mouse t = Q.front(); Q.pop();\n        int cx = t.x, cy = t.y, cost = t.cost, ch = t.ch;\n\n        if (ch == n) {\n            ans = cost;\n            break;\n        }\n\n        for (int i = 0; i < 4; i++) {\n            int nx = cx + dx[i], ny = cy + dy[i];\n            if (nx < 0 || nx >= h || ny < 0 || ny >= w || ku[nx][ny] == \'X\') continue;\n            int nch = ch;\n            if (ku[nx][ny] >= \'1\' && ku[nx][ny] <= \'9\') {\n                int num = ku[nx][ny] - \'0\';\n                if (num == ch + 1) nch++;\n            }\n            if (maxch[nx][ny] < nch) {\n                maxch[nx][ny] = nch;\n                Q.push({nx, ny, cost + 1, nch});\n            }\n        }\n    }\n    printf("%d\\n", ans);\n}')"
