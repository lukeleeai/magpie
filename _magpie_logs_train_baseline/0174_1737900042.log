2025-01-26 14:02:23,548	[DEBUG]	patch(0-10)="LineLLMMutation(('source.cpp', 9), '#include <cstdio>\n#include <cstring>\n#include <queue>\nusing namespace std;\n\nstatic const double EPS = 1e-10;\n\ntypedef long long ll;\n\nstruct Mouse {\n    int x, y;\n    int cost;\n    int collected;\n};\n\nint maxCh[1000][1000];\n\nint main() {\n    int height, width, targetCount;\n    scanf("%d %d %d", &height, &width, &targetCount);\n    char grid[height][width];\n    for (int i = 0; i < height; ++i) scanf("%s", grid[i]);\n\n    int startX, startY;\n    for (int i = 0; i < height; ++i)\n        for (int j = 0; j < width; ++j)\n            if (grid[i][j] == \'S\') startX = i, startY = j;\n\n    queue<Mouse> Q;\n    memset(maxCh, -1, sizeof(maxCh));\n    Q.push((Mouse){startX, startY, 0, 0});\n    maxCh[startX][startY] = 0;\n\n    int result = 0;\n    while (!Q.empty()) {\n        Mouse current = Q.front(); Q.pop();\n        int cx = current.x, cy = current.y, cost = current.cost, collected = current.collected;\n        if (collected == targetCount) {\n            result = cost;\n            break;\n        }\n\n        for (int i = 0; i < 4; ++i) {\n            int nx = cx + dx[i], ny = cy + dy[i];\n            if (nx < 0 || nx >= height || ny < 0 || ny >= width) continue;\n            if (grid[nx][ny] == \'X\') continue;\n            int newCollected = collected;\n            if (grid[nx][ny] <= \'9\' && grid[nx][ny] >= \'1\') {\n                int num = grid[nx][ny] - \'0\';\n                if (num == collected + 1) newCollected = collected + 1;\n            }\n            if (maxCh[nx][ny] >= newCollected) continue;\n            maxCh[nx][ny] = newCollected;\n            Q.push((Mouse){nx, ny, cost + 1, newCollected});\n        }\n    }\n    printf("%d\\n", result);\n}')"
