), '#include <cstdio>\n#include <cstring>\n#include <queue>\n\nusing namespace std;\n\ntypedef struct {\n    int x, y;\n    int cost;\n    int ch;\n} mouse;\n\nint dx[] = {0, 1, 0, -1}, dy[] = {1, 0, -1, 0};\n\nint main() {\n    int h, w, n;\n    scanf("%d%d%d", &h, &w, &n);\n    char ku[h][w];\n\n    for (int i = 0; i < h; ++i) {\n        scanf("%s", ku[i]);\n    }\n\n    int sx, sy;\n    for (int i = 0; i < h; ++i) {\n        for (int j = 0; j < w; ++j) {\n            if (ku[i][j] == \'S\') {\n                sx = i;\n                sy = j;\n            }\n        }\n    }\n\n    queue<mouse> Q;\n    int maxch[1000][1000];\n    memset(maxch, -1, sizeof(maxch));\n\n    Q.push((mouse){sx, sy, 0, 0});\n    maxch[sx][sy] = 0;\n\n    int ans = 0;\n\n    while (!Q.empty()) {\n        mouse t = Q.front();\n        Q.pop();\n\n        int cx = t.x, cy = t.y, cost = t.cost;\n        int ch = t.ch;\n\n        if (ch == n) {\n            ans = cost;\n            break;\n        }\n\n        for (int i = 0; i < 4; ++i) {\n            int nx = cx + dx[i], ny = cy + dy[i];\n            if (nx < 0 || nx >= h || ny < 0 || ny >= w) continue;\n            if (ku[nx][ny] == \'X\') continue;\n\n            int nch = ch;\n            if (ku[nx][ny] >= \'1\' && ku[nx][ny] <= \'9\') {\n                int num = ku[nx][ny] - \'0\';\n                if (num == t.ch + 1) {\n                    nch = ch + 1;\n                }\n            }\n\n            if (maxch[nx][ny] >= nch) continue;\n            maxch[nx][ny] = nch;\n\n            Q.push((mouse){nx, ny, cost + 1, nch});\n        }\n    }\n\n    printf("%d\\n", ans);\n    return 0;\n}')"
