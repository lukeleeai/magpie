2025-01-26 14:02:13,274	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include <cstdio>\n#include <queue>\n#include <cstring>\nusing namespace std;\n\nstatic const double EPS = 1e-10;\n\ntypedef long long ll;\n\ntypedef struct {\n    int x, y;\n    int cost;\n    int ch;\n} mouse;\n\nint maxch[1000][1000];\n\nint main() {\n    int h, w, n;\n    scanf("%d %d %d", &h, &w, &n);\n    char ku[h][w];\n    for (int i = 0; i < h; ++i) scanf("%s", ku[i]);\n\n    int sx, sy;\n    for (int i = 0; i < h; ++i)\n        for (int j = 0; j < w; ++j)\n            if (ku[i][j] == \'S\') sx = i, sy = j;\n\n    queue<mouse> Q;\n    memset(maxch, -1, sizeof(maxch));\n    Q.push((mouse){sx, sy, 0, 0});\n    maxch[sx][sy] = 0;\n\n    int ans = 0;\n    while (!Q.empty()) {\n        mouse t = Q.front(); Q.pop();\n        int cx = t.x, cy = t.y, cost = t.cost, ch = t.ch;\n        if (ch == n) {\n            ans = cost;\n            break;\n        }\n\n        for (int i = 0; i < 4; ++i) {\n            int nx = cx + dx[i], ny = cy + dy[i];\n            if (nx < 0 || nx >= h || ny < 0 || ny >= w) continue;\n            if (ku[nx][ny] == \'X\') continue;\n            int nch = ch;\n            if (ku[nx][ny] <= \'9\' && ku[nx][ny] >= \'1\') {\n                int num = ku[nx][ny] - \'0\';\n                if (num == t.ch + 1) nch = ch + 1;\n            }\n            if (maxch[nx][ny] >= nch) continue;\n            maxch[nx][ny] = nch;\n            Q.push((mouse){nx, ny, cost + 1, nch});\n        }\n    }\n    printf("%d\\n", ans);\n}')"
