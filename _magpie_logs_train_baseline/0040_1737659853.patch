LineLLMCrossover(('source.cpp', 28), '#include <cstdio>\n#include <map>\n#include <algorithm>\n#include <limits>\nusing namespace std;\n\ntypedef pair<int,int> P;\nP mt[200];\nint dp[1000][201];\n\nint main() {\n    int n, m;\n    \n    while (scanf("%d", &n), n) {\n        for (int i = 0; i < n; i++) {\n            int a, b;\n            scanf("%d %d", &a, &b);\n            mt[i] = P(a, b);\n        }\n\n        scanf("%d", &m);\n        for (int i = 0; i < m; i++) {\n            int a, b;\n            scanf("%d %d", &a, &b);\n            mt[n + i] = P(a, b);\n        }\n\n        sort(mt, mt + m + n);\n        fill(&dp[0][0], &dp[0][0] + sizeof(dp) / sizeof(int), numeric_limits<int>::max());\n\n        int ans = 0;\n        for (int i = 0; i < m + n; i++) {\n            int height = mt[i].first;\n            int range = mt[i].second;\n            dp[height][1] = min(dp[height][1], range);\n            for (int k = 1; k <= m + n; k++) {\n                for (int j = 0; j < height; j++) {\n                    if (range > dp[j][k - 1]) {\n                        dp[height][k] = min(dp[height][k], range);\n                    }\n                }\n            }\n        }\n\n        for (int i = 0; i < 1000; i++) {\n            for (int j = 0; j <= m + n; j++) {\n                if (dp[i][j] != numeric_limits<int>::max()) {\n                    ans = max(ans, j);\n                }\n            }\n        }\n\n        printf("%d\\n", ans);\n    }\n}') + LineLLMMutation(('source.cpp', 44), '#include <cstdio>\n#include <map>\n#include <algorithm>\n#include <limits>\nusing namespace std;\n\ntypedef pair<int,int> P;\nP mt[200];\nint dp[1000][201];\n\nint main() {\n    int n, m;\n    \n    while (scanf("%d", &n), n) {\n        for (int i = 0; i < n; i++) {\n            int a, b;\n            scanf("%d %d", &a, &b);\n            mt[i] = P(a, b);\n        }\n\n        scanf("%d", &m);\n        for (int i = 0; i < m; i++) {\n            int a, b;\n            scanf("%d %d", &a, &b);\n            mt[n + i] = P(a, b);\n        }\n\n        sort(mt, mt + m + n);\n        fill(&dp[0][0], &dp[0][0] + sizeof(dp) / sizeof(int), numeric_limits<int>::max());\n\n        int ans = 0;\n        for (int i = 0; i < m + n; i++) {\n            int height = mt[i].first;\n            int range = mt[i].second;\n            dp[height][1] = min(dp[height][1], range);\n            for (int k = 1; k <= m + n; k++) {\n                for (int j = 0; j < height; j++) {\n                    if (range > dp[j][k - 1]) {\n                        dp[height][k] = min(dp[height][k], range);\n                        // Early break if we find a valid case, reducing unnecessary iterations\n                        break; \n                    }\n                }\n            }\n        }\n\n        for (int i = 0; i < 1000; i++) {\n            for (int j = 0; j <= m + n; j++) {\n                if (dp[i][j] != numeric_limits<int>::max()) {\n                    ans = max(ans, j);\n                }\n            }\n        }\n\n        printf("%d\\n", ans);\n    }\n}')
