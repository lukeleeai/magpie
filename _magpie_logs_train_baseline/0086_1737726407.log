2025-01-24 13:50:11,398	[DEBUG]	patch(1-1)="LineLLMMutation(('source.cpp', 5), '#include "stdc++.h"\nusing namespace std;\n\ntypedef long long ll;\n\n#define MAX_N 100005\n\nll mod = 1e9 + 7;\n\nll mul(ll a, ll b) {\n    return (a * b) % mod;\n}\n\narray<int, MAX_N> bit;\n\nvoid add(int i, int x) {\n    i++;\n    while (i < MAX_N) {\n        bit[i] += x;\n        i += (i & -i);\n    }\n}\n\nint sum(int i) {\n    i++;\n    int res = 0;\n    while (i) {\n        res += bit[i];\n        i -= (i & -i);\n    }\n    return res;\n}\n\nll N, R, a, b;\nll fact[MAX_N];\narray<int, MAX_N> t;\n\nint main() {\n    fact[0] = 1;\n    for (int i = 1; i < MAX_N; i++)\n        fact[i] = mul(fact[i - 1], i);\n\n    while (1) {\n        scanf("%lld", &N);\n        if (N == 0) break;\n        scanf("%lld", &R);\n        \n        fill(bit.begin(), bit.end(), 0);\n        iota(t.begin(), t.begin() + N, 0);\n\n        for (int i = 0; i < R; i++) {\n            scanf("%lld %lld", &a, &b);\n            a--, b--;\n            swap(t[a], t[b]);\n        }\n\n        ll ans = 0;\n        for (int i = 0; i < N; i++) {\n            ll num = t[i];\n            ll cnt = num - sum(num);\n            ans += mul(fact[N - 1 - i], cnt);\n            ans %= mod;\n            add(t[i], 1);\n        }\n\n        printf("%lld\\n", ans);\n    }\n    return 0;\n}')"
