LineLLMCrossover(('source.cpp', 16), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\n#include <array>\n#include <numeric>\nusing namespace std;\n\ntypedef long long ll;\n\n#define MAX_N 100005\n\nconstexpr ll mod = 1e9 + 7;\n\ninline ll mul(ll a, ll b) {\n    return (a * b) % mod;\n}\n\narray<int, MAX_N> bit;\n\nvoid add(int i, int x) {\n    for (++i; i < MAX_N; i += (i & -i)) {\n        bit[i] += x;\n    }\n}\n\nint sum(int i) {\n    int res = 0;\n    for (++i; i; i -= (i & -i)) {\n        res += bit[i];\n    }\n    return res;\n}\n\nll N, R, a, b;\nll fact[MAX_N];\narray<int, MAX_N> t;\n\nvoid precomputeFactorials() {\n    fact[0] = 1;\n    for (int i = 1; i < MAX_N; i++)\n        fact[i] = mul(fact[i - 1], i);\n}\n\nint main() {\n    precomputeFactorials();\n    while (true) {\n        scanf("%lld", &N);\n        if (N == 0) break;\n        scanf("%lld", &R);\n        \n        fill(bit.begin(), bit.begin() + N + 1, 0);\n        iota(t.begin(), t.begin() + N, 0);\n\n        for (int i = 0; i < R; i++) {\n            scanf("%lld %lld", &a, &b);\n            a--, b--;\n            swap(t[a], t[b]);\n        }\n\n        ll ans = 0;\n        for (int i = 0; i < N; i++) {\n            ll num = t[i];\n            ll cnt = num - sum(num);\n            ans = (ans + mul(fact[N - 1 - i], cnt)) % mod;\n            add(t[i], 1);\n        }\n\n        printf("%lld\\n", ans);\n    }\n    return 0;\n}') + LineLLMMutation(('source.cpp', 30), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\n#include <array>\n#include <numeric>\nusing namespace std;\n\ntypedef long long ll;\n\n#define MAX_N 100005\n\nconstexpr ll mod = 1e9 + 7;\n\ninline ll mul(ll a, ll b) {\n    return (a * b) % mod;\n}\n\narray<int, MAX_N> bit;\n\nvoid add(int i, int x) {\n    for (++i; i < MAX_N; i += (i & -i)) {\n        bit[i] += x;\n    }\n}\n\nint sum(int i) {\n    int res = 0;\n    for (++i; i; i -= (i & -i)) {\n        res += bit[i];\n    }\n    return res;\n}\n\nll N, R, a, b;\nll fact[MAX_N];\n\nll factorial(int n) {\n    ll result = 1;\n    for (int i = 2; i <= n; ++i) {\n        result = mul(result, i);\n    }\n    return result;\n}\n\narray<int, MAX_N> t;\n\nint main() {\n    while (true) {\n        scanf("%lld", &N);\n        if (N == 0) break;\n        scanf("%lld", &R);\n        \n        fill(bit.begin(), bit.begin() + N + 1, 0);\n        iota(t.begin(), t.begin() + N, 0);\n\n        for (int i = 0; i < R; i++) {\n            scanf("%lld %lld", &a, &b);\n            a--, b--;\n            swap(t[a], t[b]);\n        }\n\n        ll ans = 0;\n        for (int i = 0; i < N; i++) {\n            ll num = t[i];\n            ll cnt = num - sum(num);\n            ans = (ans + mul(factorial(N - 1 - i), cnt)) % mod;\n            add(t[i], 1);\n        }\n\n        printf("%lld\\n", ans);\n    }\n    return 0;\n}')
