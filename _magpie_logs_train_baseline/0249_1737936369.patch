LineLLMCrossover(('source.cpp', 12), '#include <cstdio>\n#include <algorithm>\n\nusing namespace std;\n\nint dp[330];\nint s, d, m;\nint k[110], w[110][55], p[110][55], f[110];\n\nint main() {\n    while (scanf("%d %d %d", &s, &d, &m) == 3) {\n        for (int i = 0; i < s; i++) {\n            scanf("%d", &k[i]);\n            for (int j = 0; j < k[i]; j++) {\n                scanf("%d %d", &w[i][j], &p[i][j]);\n            }\n        }\n        for (int i = 0; i < d; i++) {\n            scanf("%d", &f[i]);\n        }\n\n        fill(dp, dp + m + 1, -1);\n        dp[0] = 0;\n\n        for (int i = 0; i < d; i++) {\n            int curr_f = f[i];\n            for (int x = 0; x < k[curr_f]; x++) {\n                int v = p[curr_f][x], c = w[curr_f][x];\n                if (v > m) continue; // Skip if weight exceeds max capacity\n                for (int j = m - v; j >= 0; j--) {\n                    if (dp[j] >= 0) dp[j + v] = max(dp[j + v], dp[j] + c);\n                }\n            }\n        }\n\n        int ans = max_element(dp + 1, dp + m + 1) - dp;\n        printf("%d %d\\n", dp[ans], ans);\n    }\n}')
