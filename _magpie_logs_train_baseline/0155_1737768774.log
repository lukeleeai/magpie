Score, false, nullptr, nullptr}));\n\n            left.back()->parallel = move(right.back());\n            right.back()->parallel = move(left.back());\n        }\n\n        for (int i = 1; i <= K; i++) if (!vertSticks[i].empty()) search(*vertSticks[i].back());\n\n        int sum = 0;\n        for (int i = 1; i <= K; i++) sum += vertSticks[i].empty() ? scores[i] : vertSticks[i].back()->score;\n\n        int diff = 0;\n        for (int i = 1; i <= N; i++) {\n            auto &curCol = vertSticks[i];\n            for (auto &a : curCol) {\n                auto &fst = *a, &snd = *fst.parallel;\n                int fstCandidate = fst.next ? fst.next->score : scores[fst.col];\n                int sndCandidate = snd.next ? snd.next->score : scores[snd.col];\n                diff = min(diff, fst.turned * (fstCandidate - fst.score) + snd.turned * (sndCandidate - snd.score));\n            }\n        }\n\n        printf("%d\\n", sum + diff);\n    }\n    return 0;\n}')"
