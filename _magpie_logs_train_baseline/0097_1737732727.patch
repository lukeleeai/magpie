LineLLMCrossover(('source.cpp', 21), '#define _CRT_SECURE_NO_WARNINGS\n#include <cstdio>\nusing namespace std;\n\ntypedef long long ll;\n\nint solve(ll source, ll destination) {\n    if (source <= 0 && destination >= 0) return __builtin_popcountll(-source) + __builtin_popcountll(destination);\n    else if (source >= 0 && destination >= 0) {\n        int steps = 0;\n        while (source < destination) {\n            int shift = __builtin_ctzll(destination - source);\n            ll bit_source = (source >> shift) & 1;\n            ll bit_destination = (destination >> shift) & 1;\n\n            if (bit_source && bit_destination) {\n                source += 1LL << shift;\n                destination -= 1LL << shift;\n                steps += 2;\n            } else if (bit_source ^ bit_destination) {\n                source += 1LL << shift;\n                steps++;\n            } else {\n                source += 1LL << (shift + 1);\n                steps++;\n            }\n        }\n        return steps;\n    } \n    return solve(-destination, -source);\n}\n\nint main() {\n    int N;\n    scanf("%d", &N);\n    for (int i = 0; i < N; ++i) {\n        ll source, destination;\n        scanf("%lld %lld", &source, &destination);\n        printf("%d\\n", solve(source, destination));\n    }\n}')
