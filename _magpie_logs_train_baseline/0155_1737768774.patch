LineLLMCrossover(('source.cpp', 29), '#include <cstdio>\n#include <algorithm>\n#include <vector>\n#include <utility>\n\nusing namespace std;\n\nint N, M, H, K;\ntypedef pair<int, int> cor_t; // height, vertStick index\n\nstruct knot_t {\n    int col;\n    int score;\n    bool turned; // corresponding horizontal stick turning score\n    knot_t* parallel;\n    knot_t* next;\n};\n\nint scores[1005];\ncor_t horizontalSticks[100007];\nvector<knot_t> vertSticks[1005];\n\nvoid init() {\n    for (int i = 1; i <= N; i++) {\n        scanf("%d", scores + i); // Using pointer arithmetic for efficiency\n    }\n    for (int i = 1; i <= M; i++) {\n        int h, v;\n        scanf("%d %d", &v, &h);\n        horizontalSticks[i] = make_pair(H - h, v);\n    }\n    for (int i = 1; i <= N; i++) {\n        vertSticks[i].clear();\n        vertSticks[i].reserve(20); // Better estimate for expected usage\n    }\n}\n\nvoid search(knot_t& a) {\n    a.turned = true;\n    auto nextptr = a.parallel->next;\n    if (nextptr && !nextptr->turned) search(*nextptr);\n}\n\nint main() {\n    while (scanf("%d%d%d%d", &N, &M, &H, &K) && N && M && H && K) {\n        init();\n        sort(horizontalSticks + 1, horizontalSticks + M + 1);\n        \n        for (int i = 1; i <= M; i++) {\n            auto &cur = horizontalSticks[i];\n            int leftIndex = cur.second, rightIndex = leftIndex + 1;\n            auto &left = vertSticks[leftIndex], &right = vertSticks[rightIndex];\n            int leftScore = left.empty() ? scores[leftIndex] : left.back().score,\n                rightScore = right.empty() ? scores[rightIndex] : right.back().score;\n\n            left.push_back({cur.second, rightScore, false, nullptr, left.empty() ? nullptr : &left.back()});\n            right.push_back({cur.second + 1, leftScore, false, nullptr, right.empty() ? nullptr : &right.back()});\n            \n            left.back().parallel = &right.back();\n            right.back().parallel = &left.back();\n        }\n\n        for (int i = 1; i <= K; i++) if (!vertSticks[i].empty()) search(vertSticks[i].back());\n\n        int sum = 0;\n        for (int i = 1; i <= K; i++) sum += vertSticks[i].empty() ? scores[i] : vertSticks[i].back().score;\n\n        int diff = 0;\n        for (int i = 1; i <= N; i++) {\n            auto &curCol = vertSticks[i];\n            for (auto &a : curCol) {\n                auto &fst = a, &snd = *a.parallel;\n                int fstCandidate = fst.next ? fst.next->score : scores[fst.col];\n                int sndCandidate = snd.next ? snd.next->score : scores[snd.col];\n                diff = min(diff, fst.turned * (fstCandidate - fst.score) + snd.turned * (sndCandidate - snd.score));\n            }\n        }\n\n        printf("%d\\n", sum + diff);\n    }\n    return 0;\n}')
