LineLLMCrossover(('source.cpp', 28), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\n#define fr first\n#define sc second\n\ntypedef pair<int, int> P;\n\nint main() {\n    int X, Y, Z, N, E, A;\n    while (scanf("%d %d %d", &X, &Y, &Z), X) {\n        int jump[X];\n        P ivent[Y + 1];\n        for (int i = 0; i <= Y; i++) ivent[i] = P(0, 0);\n        float dp[51][1000] = {}; // Optimized size\n        dp[0][0] = 1.0f;\n\n        for (int i = 0; i < X; i++) {\n            scanf("%d", &jump[i]);\n        }\n\n        for (int i = 0; i < Z; i++) {\n            scanf("%d %d %d", &N, &E, &A);\n            ivent[N] = (E == 1) ? P(A, ivent[N].sc) : (E == 2) ? P(ivent[N].fr, A) : P(ivent[N].fr, -A);\n        }\n\n        for (int i = 0, limit = 0; i < Y; i++, limit += 100) {\n            for (int j = 0; j <= limit; j++) {\n                if (dp[i][j]) {\n                    for (int k = 0; k < X; k++) {\n                        int p_mas = min(i + jump[k], Y);\n                        int p_money = max(0, ivent[p_mas].sc + j);\n                        p_mas = min(p_mas + ivent[p_mas].fr, Y);\n                        dp[p_mas][p_money] += dp[i][j] / X;\n                    }\n                }\n            }\n        }\n\n        float ans = 0.0f;\n        for (int i = 0; i < 1000; i++) {\n            ans += dp[Y][i] * i;\n        }\n\n        printf("%d\\n", (int)ans);\n    }\n}')
