2025-01-26 23:37:57,025	[DEBUG]	patch(1-5)="LineLLMCrossover(('source.cpp', 2), '#include <iostream>\n#include <deque>\n#include <algorithm>\nusing namespace std;\n\nint main() {\n    int q, lim, query, x;\n\n    while (1) {\n        scanf("%d %d", &q, &lim);\n        if (!q && !lim) break;\n\n        deque<int> l;\n\n        for (int i = 0; i < q; i++) {\n            scanf("%d %d", &query, &x);\n            if (query == 0) {\n                l.push_back(x);\n                if (l.size() > lim) l.pop_front();\n            } else if (query == 1) {\n                if (x - 1 >= 0 && x - 1 < l.size()) l.erase(l.begin() + x - 1);\n            } else if (query == 2) {\n                if (x - 1 >= 0 && x - 1 < l.size()) printf("%d\\n", *(l.begin() + x - 1));\n                else printf("Error: Index out of bounds\\n");\n            } else if (query == 3) {\n                auto it = find(l.begin(), l.end(), x);\n                if (it != l.end()) l.erase(it);\n            } else {\n                printf("Error: Invalid query\\n");\n            }\n        }\n        printf("end\\n");\n    }\n}')"
