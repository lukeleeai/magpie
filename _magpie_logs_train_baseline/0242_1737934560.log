2025-01-26 23:36:57,564	[DEBUG]	patch(0-4)="LineLLMMutation(('source.cpp', 3), '#include <iostream>\n#include <vector>\nusing namespace std;\n\nclass CircularBuffer {\n    vector<int> buffer;\n    int start, end, size, maxSize;\npublic:\n    CircularBuffer(int maxSize) : maxSize(maxSize), start(0), end(0), size(0) {\n        buffer.resize(maxSize);\n    }\n    \n    void push(int value) {\n        buffer[end] = value;\n        end = (end + 1) % maxSize;\n        if (size < maxSize) size++;\n        else start = (start + 1) % maxSize; // Overwrite oldest\n    }\n\n    void erase(int index) {\n        if (index < 0 || index >= size) return;\n        int realIndex = (start + index) % maxSize;\n        for (int i = index; i < size - 1; i++) {\n            buffer[(start + i) % maxSize] = buffer[(start + i + 1) % maxSize];\n        }\n        end = (end - 1 + maxSize) % maxSize;\n        size--;\n    }\n\n    int get(int index) {\n        if (index < 0 || index >= size) return -1;\n        return buffer[(start + index) % maxSize];\n    }\n    \n    int currentSize() {\n        return size;\n    }\n};\n\nint main() {\n    int q, lim, query, x;\n\n    while (1) {\n        scanf("%d %d", &q, &lim);\n        if (!q && !lim) break;\n        CircularBuffer cb(lim);\n\n        for (int i = 0; i < q; i++) {\n            scanf("%d %d", &query, &x);\n            if (query == 0) cb.push(x);\n            if (query == 1) cb.erase(x - 1);\n            if (query == 2) printf("%d\\n", cb.get(x - 1));\n            if (query == 3) cb.erase(find(cb.begin(), cb.end(), x) - cb.begin());\n        }\n        printf("end\\n");\n    }\n}')"
