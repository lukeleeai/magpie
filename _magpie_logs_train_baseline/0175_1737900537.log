][0][1] + mod) % mod;\n                } else {\n                    dp[(i ^ 1) & 1][nxt][1][0] += sum0;\n                    dp[(i ^ 1) & 1][nxt][1][1] += sum1;\n                }\n            }\n\n            if (c == \'I\' || c == \'?\') {\n                if (j & (1 << (W - 2))) {\n                    dp[(i ^ 1) & 1][nxt][1][1] += sum0;\n                } else {\n                    dp[(i ^ 1) & 1][nxt][1][0] += sum0;\n                }\n                dp[(i ^ 1) & 1][nxt][1][1] += sum1;\n            }\n\n            dp[(i ^ 1) & 1][nxt][1][0] %= mod;\n            dp[(i ^ 1) & 1][nxt][1][1] %= mod;\n        }\n    }\n\n    int ret = 0;\n    for (int i = 0; i < maxbits; i++) {\n        ret += dp[(H * W - 1) % 2][i][0][1];\n        ret += dp[(H * W - 1) % 2][i][1][1];\n        ret %= mod;\n    }\n\n    printf("%d\\n", ret);\n    return 0;\n}')"
