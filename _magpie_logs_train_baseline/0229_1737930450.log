= s) {\n                    ans = (ans * (num + 1)) % 10007; // Update answer\n                    continue; // Exit the loop as we found the source\n                }\n                stk.push({b[i][now], {maxi, num}}); // Push the next node onto the stack\n            }\n        }\n    }\n    return ans;\n}\n\nint main() {\n    while (scanf("%d", &n), n) {\n        for (int i = 0; i < n; i++) {\n            scanf("%d %d %d %d", &b[0][i], &f[0][i], &b[1][i], &f[1][i]);\n            v[i] = false;\n        }\n\n        int ans = 1;\n        for (int i = 0; i < n; i++) {\n            if (!v[i]) {\n                ans = (ans * iterative_dfs(i)) % 10007; // Call the iterative DFS\n            }\n        }\n        printf("%d\\n", ans);\n    }\n}')"
