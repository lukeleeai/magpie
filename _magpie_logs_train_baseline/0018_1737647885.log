 Mark as visited\n            queue.push_back({x, y - 1});\n        }\n    }\n}\n\nint main() {\n    while (1) {\n        for (int i = 0; i < SIZE; i++) {\n            fill(masu[i], masu[i] + SIZE, 0);\n        }\n        for (int i = 1; i <= 12; i++) {\n            string st;\n            if (!(cin >> st)) {\n                goto A;\n            }\n            for (int j = 0; j < 12; j++) {\n                masu[i][j + 1] = (st[j] == '0') ? 0 : 1;\n            }\n        }\n        cont = 0;\n        for (int i = 1; i <= 12; i++) {\n            for (int j = 1; j <= 12; j++) {\n                if (masu[i][j] == 1) {\n                    cont++;\n                    saiki(i, j);\n                }\n            }\n        }\n        cout << cont << endl;\n    }\nA:;\n}")"
