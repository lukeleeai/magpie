2025-01-23 15:36:20,887	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include <iostream>\n#include <cstdio>\n#include <cmath>\n#include <cstdlib>\n#include <map>\n#include <set>\n#include <queue>\n#include <algorithm>\n#include <cstring>\n#include <sstream>\n#include <vector>\n#include <string>\n#include <iomanip>\n#include <bitset>\n\n#define INF 100000000\n#define pb push_back\n#define fi first\n#define sec second\n#define SS stringstream\n\nusing namespace std;\n\ntypedef pair<int, int> P;\ntypedef long long int ll;\n\nint w, n;\nint t = 0;\nint dp[1001][1001];\nvector<P> vec;\n\nvoid init_dp() {\n    for(int i = 0; i <= 1000; ++i)\n        fill(dp[i], dp[i] + 1001, -1);\n}\n\nint rec(int i, int j) {\n    if(dp[i][j] >= 0) return dp[i][j];\n    int res;\n    if(i == n) res = 0;\n    else if(j < vec[i].sec) res = rec(i + 1, j);\n    else res = max(rec(i + 1, j), rec(i + 1, j - vec[i].sec) + vec[i].fi);\n    return dp[i][j] = res;\n}\n\nint main() {\n    while(scanf("%d", &w)) {\n        t++;\n        if(w == 0) break;\n        init_dp();  // Initialize dp array once\n        scanf("%d", &n);\n        for(int i = 0; i < n; i++) {\n            int temp1, temp2;\n            char trash;\n            scanf("%d%c%d", &temp1, &trash, &temp2);\n            vec.pb(P(temp1, temp2));\n        }\n        printf("Case %d:\\n", t);\n        printf("%d\\n", rec(0, w));\n        for(int i = 1; i <= w; i++) {\n            if(rec(0, w - i) != rec(0, w)) {\n                printf("%d\\n", w - i + 1);\n                break;\n            }\n        }\n        vec.clear();\n    }\n}')"
