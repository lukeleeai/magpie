LineLLMCrossover(('source.cpp', 31), '#include <iostream>\n#include <algorithm>\nusing namespace std;\n\nint main(void) {\n    int n, m, s;\n\n    while (1) {\n        cin >> n >> m >> s;\n        if (!n && !m && !s) break;  // Clear termination condition\n\n        n *= n;\n        int dp[55 * 3005] = {0};  // Use a single array instead of a 2D array\n        dp[0] = 1;\n\n        for (int i = 1; i <= m; i++) {\n            for (int k = s; k >= i; k--) {\n                for (int j = 1; j <= n; j++) {\n                    if (k - i >= 0) {\n                        dp[j * 3005 + k] = (dp[j * 3005 + k] + dp[(j - 1) * 3005 + (k - i)]) % 100000;\n                    }\n                }\n            }\n        }\n        cout << dp[n * 3005 + s] << endl;\n    }\n}')
