LineLLMCrossover(('source.cpp', 16), '#include <cstdio>\nusing namespace std;\n\nint main() {\n    int A, B;\n    scanf("%d %d", &A, &B); // Using scanf for input\n\n    int P[A], Q[B];\n    for (int i = 0; i < A; i++) { scanf("%d", &P[i]); } // Using scanf for input\n    for (int i = 0; i < B; i++) { scanf("%d", &Q[i]); } // Using scanf for input\n\n    int l = 1;\n    int r = B;\n    int m;\n\n    while (r - l > 1) {\n        m = (l + r) / 2;\n        bool ok = false;\n\n        for (int j = 0; j < B - m; j++) { // Optimized iteration\n            int ptr = j;\n            for (int k = 0; k < A && ptr < j + m; k++) {\n                if (P[k] == Q[ptr]) {\n                    ptr++;\n                }\n            }\n            if (ptr == j + m) {\n                ok = true;\n                break; // Break early if found\n            }\n        }\n\n        if (ok) {\n            l = m;\n        } else {\n            r = m;\n        }\n    }\n\n    printf("%d\\n", l); // Using printf for output\n    return 0;\n}')
