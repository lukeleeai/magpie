LineLLMMutation(('source.cpp', 1), '#include <cstdio>\n#include <algorithm>\n\n#define REP(i,j) for(int i=0;i<j;i++)\n\nint main() {\n    int n, S;\n    int r[10000];\n    while(scanf("%d %d", &n, &S), n) {\n        REP(i, n) {\n            scanf("%d", &r[i]);\n        }\n        std::sort(r, r+n);\n        int res = 0;\n        for(int i=0; i+1<n; i++) {\n            auto it = std::upper_bound(r+i+1, r+n, S-r[i]);\n            res += std::distance(it, r+n);\n        }\n        printf("%d\\n", res);\n    }\n}')
