n    if (memo.find(key) != memo.end() && memo[key] <= g) {\n        return; // Skip if we already have a better solution\n    }\n\n    memo[key] = g; // Store the current solution\n\n    for (int i = 0; i < n; ++i) {\n        if (used[i]) continue;\n        used[i] = true;\n        if (items[i].second >= sumW) {\n            index[k] = i;\n            solve(k + 1, index, g + (n - k) * items[i].first, sumW + items[i].first);\n        }\n        used[i] = false;\n    }\n}\n\nint main() {\n    for (;;) {\n        cin >> n;\n        if (n == 0) return 0;\n\n        items.resize(n);\n        vector<string> name(n);\n        for (int i = 0; i < n; ++i)\n            cin >> name[i] >> items[i].first >> items[i].second;\n\n        bestG = numeric_limits<int>::max();\n        used.assign(n, false);\n        vector<int> index(n);\n        solve(0, index, 0, 0);\n        for (int i = n - 1; i >= 0; --i)\n            cout << name[bestIndex[i]] << endl;\n    }\n}')"
