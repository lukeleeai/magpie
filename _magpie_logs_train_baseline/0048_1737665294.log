k] = -1; // Reset index for backtracking\n        }\n    }\n\n    dp[k][sumW] = 0; // Mark this state as computed\n}\n\nint main() {\n    for (;;) {\n        cin >> n;\n        if (n == 0) return 0;\n\n        vector<string> name(n);\n        w.resize(n);\n        s.resize(n);\n        for (int i = 0; i < n; ++i)\n            cin >> name[i] >> w[i] >> s[i];\n\n        bestG = numeric_limits<int>::max();\n        vector<int> index(n, -1);\n        vector<vector<int>> dp(n + 1, vector<int>(10000, -1)); // Initialize DP table\n        solve(0, 0, 0, index, dp);\n        for (int i = n - 1; i >= 0; --i)\n            cout << name[bestIndex[i]] << endl;\n    }\n}')"
