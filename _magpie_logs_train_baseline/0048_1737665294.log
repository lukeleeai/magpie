) continue; // Instead of used[], we use index to track selections\n            if (items[i].second >= sumW) {\n                index[k] = i;\n                stk.push(make_tuple(k + 1, index, g + (n - k) * items[i].first, sumW + items[i].first));\n                index[k] = -1; // backtrack for the next iteration\n            }\n        }\n    }\n}\n\nint main() {\n    for (;;) {\n        cin >> n;\n        if (n == 0) return 0;\n\n        items.resize(n);\n        vector<string> name(n);\n        for (int i = 0; i < n; ++i)\n            cin >> name[i] >> items[i].first >> items[i].second;\n\n        bestG = numeric_limits<int>::max();\n        vector<int> index(n, -1);\n        solve();\n        for (int i = n - 1; i >= 0; --i)\n            cout << name[bestIndex[i]] << endl;\n    }\n}')"
