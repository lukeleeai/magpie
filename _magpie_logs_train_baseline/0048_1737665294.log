2025-01-23 20:50:15,832	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include <iostream>\n#include <vector>\n#include <limits>\n\nusing namespace std;\n\nint n;\nvector<int> w, s;\nvector<bool> used;\nvector<int> bestIndex;\nint bestG;\n\nvoid solve(int k, vector<int>& index, int g, int sumW) {\n    if(k == n) {\n        if(g < bestG) {\n            bestG = g;\n            bestIndex = index;\n        }\n        return;\n    }\n    for(int i = 0; i < n; ++i) {\n        if(used[i]) continue;\n        used[i] = true;\n        if(s[i] >= sumW) {\n            index[k] = i;\n            solve(k + 1, index, g + (n - k) * w[i], sumW + w[i]);\n        }\n        used[i] = false;\n    }\n}\n\nint main() {\n    for(;;) {\n        cin >> n;\n        if(n == 0) return 0;\n\n        vector<string> name(n);\n        w.resize(n);\n        s.resize(n);\n        for(int i = 0; i < n; ++i)\n            cin >> name[i] >> w[i] >> s[i];\n\n        bestG = numeric_limits<int>::max();\n        used.assign(n, false);\n        vector<int> index(n);\n        solve(0, index, 0, 0);\n        for(int i = n - 1; i >= 0; --i)\n            cout << name[bestIndex[i]] << endl;\n    }\n}')"
