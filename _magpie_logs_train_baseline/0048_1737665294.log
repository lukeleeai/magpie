i].first;\n        solve(k + 1, newG, sumW + items[i].first);\n    }\n}\n\nint main() {\n    for (;;) {\n        cin >> n;\n        if (n == 0) return 0;\n\n        items.resize(n);\n        vector<string> name(n);\n        for (int i = 0; i < n; ++i)\n            cin >> name[i] >> items[i].first >> items[i].second;\n\n        bestG = numeric_limits<int>::max(); // Using numeric_limits for clarity\n        sort(items.begin(), items.end(), [](const pair<int, int>& a, const pair<int, int>& b) {\n            return a.second < b.second; // Sort by strength for better item selection\n        });\n        vector<int> index(n);\n        solve(0, 0, 0);\n        for (int i = n - 1; i >= 0; --i)\n            cout << name[bestIndex[i]] << endl;\n    }\n}')"
