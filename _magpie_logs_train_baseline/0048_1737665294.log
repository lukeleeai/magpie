2025-01-23 20:50:28,482	[DEBUG]	patch(0-9)="LineLLMMutation(('source.cpp', 8), '#include <iostream>\n#include <vector>\n#include <limits>\n#include <stack>\n\nusing namespace std;\n\nint n;\nvector<pair<int, int>> items;\nvector<bool> used;\nvector<int> bestIndex;\nint bestG;\n\nvoid solve() {\n    stack<tuple<int, vector<int>, int, int>> stk; // (k, index, g, sumW)\n    vector<int> index(n);\n    stk.push(make_tuple(0, index, 0, 0));\n\n    while(!stk.empty()) {\n        auto [k, index, g, sumW] = stk.top();\n        stk.pop();\n\n        if(k == n) {\n            if(g < bestG) {\n                bestG = g;\n                bestIndex = index;\n            }\n            continue;\n        }\n\n        for(int i = 0; i < n; ++i) {\n            if(used[i]) continue;\n            used[i] = true;\n            if(items[i].second >= sumW) {\n                index[k] = i;\n                stk.push(make_tuple(k + 1, index, g + (n - k) * items[i].first, sumW + items[i].first));\n            }\n            used[i] = false;\n        }\n    }\n}\n\nint main() {\n    for(;;) {\n        cin >> n;\n        if(n == 0) return 0;\n\n        items.resize(n);\n        vector<string> name(n);\n        for(int i = 0; i < n; ++i)\n            cin >> name[i] >> items[i].first >> items[i].second;\n\n        bestG = numeric_limits<int>::max();\n        used.assign(n, false);\n        solve();\n        for(auto i : bestIndex)\n            cout << name[i] << endl;\n    }\n}')"
