ristics\n    sort(available.begin(), available.end(), [&](int a, int b) {\n        return w[a] > w[b];\n    });\n\n    for (int i : available) {\n        used[i] = true;\n        index[k] = i;\n        solve(k + 1, index, g + (n - k) * w[i], sumW + w[i]);\n        used[i] = false;\n    }\n}\n\nint main() {\n    for (;;) {\n        cin >> n;\n        if (n == 0) return 0;\n\n        vector<string> name(n);\n        w.resize(n);\n        s.resize(n);\n        used.resize(n, false);\n        vector<int> index(n);\n\n        for (int i = 0; i < n; ++i)\n            cin >> name[i] >> w[i] >> s[i];\n\n        bestG = numeric_limits<int>::max();\n        solve(0, index, 0, 0);\n        for (int i = n - 1; i >= 0; --i)\n            cout << name[bestIndex[i]] << endl;\n    }\n}')"
