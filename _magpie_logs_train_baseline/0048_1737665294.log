, usedMask | (1 << i), index, g + (n - k) * items[i].first, sumW + items[i].first);\n        }\n    }\n}\n\nint main() {\n    for (;;) {\n        cin >> n;\n        if (n == 0) return 0;\n\n        items.resize(n);\n        vector<string> name(n);\n        for (int i = 0; i < n; ++i)\n            cin >> name[i] >> items[i].first >> items[i].second;\n\n        bestG = numeric_limits<int>::max(); // Using numeric_limits for clarity\n        vector<int> index(n);\n        solve(0, 0, index, 0, 0);\n        for (int i = n - 1; i >= 0; --i)\n            cout << name[bestIndex[i]] << endl;\n    }\n}') | LineLLMMutation(('source.cpp', 26), '#include <iostream>\n#include <vector>\n#include <limits>\n#include <unordered_map>\n#include <tuple>\n\nusing namespace std;\n\nint n;\nvector<pair<int, int>> items; // Using a pair for weight and strength\nvector<int> bestIndex;\nint bestG;\nunordered_map<tuple<int, int, int>, int> memo; // Memoization map\n\nint solve(int k, int usedMask, int g, int sumW) {\n    if (k == n) {\n        return g; // Return the current g value\n    }\n    \n    auto state = make_tuple(k, usedMask, sumW);\n    if (memo.find(state) != memo.end()) {\n        return memo[state]; // Return already computed result\n    }\n\n    int minG = numeric_limits<int>::max();\n    for (int i = 0; i < n; ++i) {\n        if (usedMask & (1 << i)) continue; // Check if the item is already used\n        if (items[i].second >= sumW) {\n            int currentG = solve(k + 1, usedMask | (1 << i), g + (n - k) * items[i].first, sumW + items[i].first);\n            minG = min(minG, currentG);\n        }\n    }\n    \n    memo[state] = minG; // Store the result in the memoization map\n    return minG;\n}\n\nint main() {\n    for (;;) {\n        cin >> n;\n        if (n == 0) return 0;\n\n        items.resize(n);\n        vector<string> name(n);\n        for (int i = 0; i < n; ++i)\n            cin >> name[i] >> items[i].first >> items[i].second;\n\n        bestG = numeric_limits<int>::max(); // Using numeric_limits for clarity\n        vector<int> index(n);\n        solve(0, 0, 0, 0); // Call the solve function\n        for (int i = n - 1; i >= 0; --i)\n            cout << name[bestIndex[i]] << endl;\n    }\n}')"
