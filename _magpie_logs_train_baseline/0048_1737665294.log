tter or equal solution for this state\n    }\n    memo[memoKey] = g;\n\n    for (int i = 0; i < n; ++i) {\n        if (used[i]) continue;\n        used[i] = true;\n        if (s[i] >= sumW) {\n            index[k] = i;\n            solve(k + 1, index, g + (n - k) * w[i], sumW + w[i]);\n        }\n        used[i] = false;\n    }\n}\n\nint main() {\n    for (;;) {\n        cin >> n;\n        if (n == 0) return 0;\n\n        vector<string> name(n);\n        w.resize(n);\n        s.resize(n);\n        for (int i = 0; i < n; ++i)\n            cin >> name[i] >> w[i] >> s[i];\n\n        bestG = numeric_limits<int>::max();\n        used.assign(n, false);\n        vector<int> index(n);\n        solve(0, index, 0, 0);\n        for (int i = n - 1; i >= 0; --i)\n            cout << name[bestIndex[i]] << endl;\n    }\n}')"
