imits>\n\nusing namespace std;\n\nint n;\nvector<int> w, s;\nvector<pair<int, int>> items;\nvector<int> bestIndex;\nint bestG;\n\nvoid solve(int k, int usedMask, vector<int>& index, int g, int sumW) {\n    if (k == n) {\n        if (g < bestG) {\n            bestG = g;\n            bestIndex = index;\n        }\n        return;\n    }\n    for (int i = 0; i < n; ++i) {\n        if (usedMask & (1 << i)) continue; // Check if the item is already used\n        auto& item = items[i]; // Use reference to avoid copying\n        if (item.second >= sumW) {\n            index[k] = i;\n            // Optimize the calculation of g and sumW directly in the recursive call\n            solve(k + 1, usedMask | (1 << i), index, g + (n - k) * item.first, sumW + item.first);\n        }\n    }\n}\n\nint main() {\n    for (;;) {\n        cin >> n;\n        if (n == 0) return 0;\n\n        items.resize(n);\n        vector<string> name(n);\n        for (int i = 0; i < n; ++i)\n            cin >> name[i] >> items[i].first >> items[i].second;\n\n        bestG = INT_MAX;\n        vector<int> index(n);\n        solve(0, 0, index, 0, 0);\n        for (int i = n - 1; i >= 0; --i)\n            cout << name[bestIndex[i]] << endl;\n    }\n}')"

