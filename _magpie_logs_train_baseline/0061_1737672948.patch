LineLLMCrossover(('source.cpp', 30), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\ntypedef long long ll;\n\nll count_rooms_lesseq_than(ll newRoomNo) {\n    int t[10] = {0}; // Initialize array to 0\n    int d = 0;\n    while (newRoomNo) {\n        t[d++] = newRoomNo % 10;\n        newRoomNo /= 10;\n    }\n\n    for (int i = d - 1; i > 0; --i) {\n        if (t[i] == 4 || t[i] == 6) {\n            --t[i];\n            fill(t, t + i, 9); // Use fill for better readability\n            break;\n        }\n    }\n\n    ll res = 0;\n    ll a = 1;\n    for (int i = 0; i < d; ++i) {\n        if (i > 0) a *= 8;\n        res += (t[i] - (t[i] >= 6 ? 2 : t[i] >= 4 ? 1 : 0)) * a;\n    }\n    return res;\n}\n\nint main() {\n    int n;\n    while (scanf("%d", &n), n) {\n        ll l = 1, u = n * 10LL;\n        while (l < u) {\n            ll m = (l + u) / 2;\n            ll t = count_rooms_lesseq_than(m);\n            if (t < n)\n                l = m + 1;\n            else\n                u = m;\n        }\n        printf("%lld\\n", l);\n    }\n    return 0;\n}')
