LineLLMCrossover(('source.cpp', 35), '#include <cstdio>\n#include <numeric> // For std::gcd\nusing namespace std;\n\ntypedef long long ll;\n\nint main() {\n    int n;\n    ll d[10], v[10], results[10];\n\n    for (;;) {\n        scanf("%d", &n);\n        if (!n) break;\n\n        for (int i = 0; i < n; i++) scanf("%lld%lld", &d[i], &v[i]);\n        results[0] = 1;\n\n        for (int i = 1; i < n; i++) {\n            results[i] = results[i - 1] * d[i - 1] * v[i];\n            for (int j = 0; j < i; j++) {\n                results[j] *= d[i] * v[i - 1];\n            }\n            ll T = results[0];\n            for (int j = 1; j <= i; j++) T = std::gcd(T, results[j]);\n            for (int j = 0; j <= i; j++) results[j] /= T;\n        }\n\n        for (int i = 0; i < n; i++) printf("%lld\\n", results[i]);\n    }\n}')
