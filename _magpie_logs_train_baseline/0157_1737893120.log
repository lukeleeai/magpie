] = {};\nunordered_set<string> complete_integer; // Using unordered_set for faster lookups\nstring answer;\nint integer_count = 0;\n\nvoid operation() {\n    if (num.size() == k) {\n        string curr_answer;\n        for (const auto& str : num) {\n            curr_answer += str;\n        }\n        if (complete_integer.find(curr_answer) == complete_integer.end()) {\n            complete_integer.insert(curr_answer);\n            integer_count++;\n        }\n        return; // Return early if we reached the desired size\n    }\n\n    for (int i = 1; i <= n; i++) {\n        if (chousen[i] == 0) {\n            chousen[i] = 1;\n            num.push_back(integer[i]);\n            operation();\n            num.pop_back();\n            chousen[i] = 0;\n        }\n    }\n}\n\nint main() {\n    while (true) {\n        cin >> n >> k;\n        if (n == 0 && k == 0) break;\n\n        for (int i = 1; i <= n; i++) {\n            cin >> integer[i];\n        }\n\n        operation();\n        cout << integer_count << endl;\n\n        n = {};\n        k = {};\n        for (int i = 0; i <= 10; i++) {\n            integer[i] = {};\n            chousen[i] = {};\n        }\n        num.clear();\n        complete_integer.clear(); // Clear the unordered_set\n        answer.clear();\n        integer_count = 0;\n    }\n    return 0;\n}')"
