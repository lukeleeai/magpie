.empty()) {\n        auto [i, current_num] = stk.top();\n        stk.pop();\n\n        if (i > n) {\n            if (current_num.size() == k) {\n                string answer = "";\n                for (const auto& str : current_num) {\n                    answer += str;\n                }\n                if (complete_integer.find(answer) == complete_integer.end()) {\n                    complete_integer.insert(answer);\n                    integer_count++;\n                }\n            }\n            continue;\n        }\n\n        // Include current integer\n        current_num.push_back(integer[i]);\n        stk.emplace(i + 1, current_num);  // Move to the next integer with current included\n        \n        // Exclude current integer\n        current_num.pop_back();\n        stk.emplace(i + 1, current_num);  // Move to the next integer without current included\n    }\n}\n\nint main() {\n    while (true) {\n        cin >> n >> k;\n        if (n == 0 && k == 0) break;\n\n        for (int i = 1; i <= n; i++) {\n            cin >> integer[i];\n        }\n\n        operation();\n        cout << integer_count << endl;\n\n        n = {};\n        k = {};\n        integer.fill({});\n        complete_integer.clear();\n        answer.clear();\n        integer_count = 0;\n    }\n    return 0;\n}')"
