LineLLMCrossover(('source.cpp', 4), '#include <iostream>\n#include <deque>\n#include <algorithm>\nusing namespace std;\n\nint main() {\n    int q, lim, query, x;\n\n    while (1) {\n        scanf("%d %d", &q, &lim);\n        if (!q && !lim) break;\n\n        deque<int> l;\n\n        for (int i = 0; i < q; i++) {\n            scanf("%d %d", &query, &x);\n            if (query == 0) {\n                l.push_back(x);\n                if ((int)l.size() > lim) l.pop_front();\n            } else if (query == 1 && x - 1 >= 0 && x - 1 < l.size()) {\n                l.erase(l.begin() + x - 1);\n            } else if (query == 2 && x - 1 >= 0 && x - 1 < l.size()) {\n                printf("%d\\n", *(l.begin() + x - 1));\n            } else if (query == 3) {\n                auto it = find(l.begin(), l.end(), x);\n                if (it != l.end()) l.erase(it);\n            } else {\n                printf("Error: Invalid query\\n");\n            }\n        }\n        printf("end\\n");\n    }\n}')
