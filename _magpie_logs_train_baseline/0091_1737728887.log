LineLLMCrossover(('source.cpp', 32), '#include <cstdio>\n#include <algorithm>\n#include <vector>\n#include <set>\n\nusing namespace std;\n\n#define INF (1 << 30)\n\nint main() {\n    int N, Q;\n    scanf("%d %d", &N, &Q);\n    \n    vector<int> stmp(N);\n    vector<int> comp(N);\n    multiset<int> sym; // Using multiset for efficient management\n    int a;\n    char buff[16];\n\n    for(int i = 0; i < N; i++) {\n        scanf("%d", &stmp[i]);\n        comp[i] = stmp[i];\n    }\n\n    sort(comp.begin(), comp.end());\n    \n    while(Q--) {\n        scanf("%s %d", buff, &a);\n        if(*buff == \'A\') {\n            sym.insert(stmp[a - 1]); // Efficient insertion\n        } else if(*buff == \'R\') {\n            sym.erase(stmp[a - 1]); // Efficient removal\n        } else {\n            int left = 0, right = INF;\n            while(left != right) {\n                int center = (left + right) / 2;\n                int pre = 0, BAN = 0;\n                for(auto it : sym) {\n                    int p = distance(comp.begin(), lower_bound(comp.begin(), comp.end(), it - center));\n                    BAN += max(p - pre, 0);\n                    pre = distance(comp.begin(), upper_bound(comp.begin(), comp.end(), it));\n                }\n                BAN += max(N - pre, 0);\n                if(BAN <= a) right = center;\n                else left = center + 1;\n            }\n            if(left != INF) printf("%d\\n", left);\n            else puts("NA");\n        }\n    }\n    return 0;\n}')
