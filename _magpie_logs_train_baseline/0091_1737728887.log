set for better performance in insertion/deletion\n    vector<int> sym;\n    \n    while(Q--) {\n        scanf("%s %d", buff, &a);\n        if(*buff == \'A\') {\n            sym.push_back(stmp[a - 1]);\n            sort(sym.begin(), sym.end()); // Maintain sorted order\n        } else if(*buff == \'R\') {\n            auto it = lower_bound(sym.begin(), sym.end(), stmp[a - 1]);\n            if (it != sym.end() && *it == stmp[a - 1]) {\n                sym.erase(it);\n            }\n        } else {\n            int left = 0, right = INF;\n            while(left != right) {\n                int center = (left + right) / 2;\n                int pre = 0, BAN = 0;\n                for(auto it = sym.begin(); it != sym.end(); it++) {\n                    int p = distance(comp, lower_bound(comp, comp + N, *it - center));\n                    BAN += max(p - pre, 0);\n                    pre = distance(comp, upper_bound(comp, comp + N, *it));\n                }\n                BAN += max(N - pre, 0);\n                if(BAN <= a) right = center;\n                else left = center + 1;\n            }\n            if(left != INF) printf("%d\\n", left);\n            else puts("NA");\n        }\n    }\n    return 0;\n}')"
