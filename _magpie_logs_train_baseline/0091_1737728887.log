2025-01-24 14:39:44,869	[DEBUG]	patch(7-4)="LineLLMCrossover(('source.cpp', 25), '#include <cstdio>\n#include <algorithm>\n#include <vector>\n\nusing namespace std;\n\n#define INF (1 << 30)\n\nint main() {\n    int N, Q;\n    scanf("%d %d", &N, &Q);\n    \n    vector<int> stmp(N);\n    vector<int> comp(N);\n    vector<int> sym; // Using vector for dynamic storage\n    int a;\n    char buff[16];\n\n    for(int i = 0; i < N; i++) {\n        scanf("%d", &stmp[i]);\n        comp[i] = stmp[i];\n    }\n\n    sort(comp.begin(), comp.end());\n    \n    while(Q--) {\n        scanf("%s %d", buff, &a);\n        if(*buff == \'A\') {\n            sym.push_back(stmp[a - 1]);\n            sort(sym.begin(), sym.end()); // Sort after insertion\n        } else if(*buff == \'R\') {\n            auto it = find(sym.begin(), sym.end(), stmp[a - 1]);\n            if (it != sym.end()) {\n                sym.erase(it); // Remove from vector\n            }\n        } else {\n            int left = 0, right = INF;\n            while(left != right) {\n                int center = (left + right) / 2;\n                int pre = 0, BAN = 0;\n                for(auto it : sym) {\n                    int p = distance(comp.begin(), lower_bound(comp.begin(), comp.end(), it - center));\n                    BAN += max(p - pre, 0);\n                    pre = distance(comp.begin(), upper_bound(comp.begin(), comp.end(), it));\n                }\n                BAN += max(N - pre, 0);\n                if(BAN <= a) right = center;\n                else left = center + 1;\n            }\n            if(left != INF) printf("%d\\n", left);\n            else puts("NA");\n        }\n    }\n    return 0;\n}')"
