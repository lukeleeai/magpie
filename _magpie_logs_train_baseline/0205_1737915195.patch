LineLLMCrossover(('source.cpp', 13), '#include<cstdio>\n#include<algorithm>\nusing namespace std;\n\ntypedef long long int ll;\n\nstatic const int MAX_N = 2000;\n\nint N;\nll A[MAX_N];\nll memo[MAX_N][2 * MAX_N];\n\nll memoize(int i, int j) {\n    if (memo[i][j] != -1) return memo[i][j];\n\n    int i2 = (i == N - 1 ? 0 : i + 1);\n    int j2 = (j == 0 ? N - 1 : j - 1);\n    int itv = (i > j ? N + j - i : j - i);\n\n    if ((N - itv) % 2 == 1) {\n        return memo[i][j] = (i == j) ? A[i] : max(memoize(i2, j) + A[i], memoize(i, j2) + A[j]);\n    } else {\n        return memo[i][j] = (i == j) ? 0LL : (A[i] > A[j] ? memoize(i2, j) : memoize(i, j2));\n    }\n}\n\nint main() {\n    scanf("%d", &N);\n    for (int i = 0; i < N; i++) scanf("%lld", &A[i]);\n    fill(memo[0], memo[N], -1);\n    \n    ll res = 0LL;\n    for (int i = 0; i < N; i++) {\n        for (int j = 0; j < N; j++) {\n            res = max(res, memoize(i, j));\n        }\n    }\n    printf("%lld\\n", res);\n    return 0;\n}')
