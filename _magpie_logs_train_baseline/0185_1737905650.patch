LineLLMCrossover(('source.cpp', 0), '#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cstring>\n#include <numeric>\n#define int long long\n#define PB push_back\n#define MP make_pair\n#define FI first\n#define SE second\nusing namespace std;\n\nstatic const int INF = 1ll << 60;\ntypedef pair<int, int> pii;\n\nint W, H, N, dis[100010];\nvector<int> posx, posy;\nvector<pii> pos;\n\nint dist(int x, int y) {\n    memset(dis, 0, sizeof(dis));\n    for (int i = 0; i < N; ++i) {\n        dis[i] = abs(x - pos[i].FI) + abs(y - pos[i].SE);\n    }\n    sort(dis, dis + N);\n    return dis[N - 1] + 2 * accumulate(dis, dis + N - 1, 0LL);\n}\n\nsigned main() {\n    cin >> W >> H >> N;\n    for (int i = 0; i < N; ++i) {\n        int x, y;\n        cin >> x >> y;\n        posx.PB(x);\n        posy.PB(y);\n        pos.PB(pii(x, y));\n    }\n    sort(posx.begin(), posx.end());\n    sort(posy.begin(), posy.end());\n    int x, y, ans = INF;\n\n    if (N % 2 != 0) {\n        x = posx[N / 2];\n        y = posy[N / 2];\n    } else {\n        int d1 = dist(posx[N / 2 - 1], posy[N / 2 - 1]);\n        int d2 = dist(posx[N / 2 - 1], posy[N / 2]);\n        int d3 = dist(posx[N / 2], posy[N / 2 - 1]);\n        int d4 = dist(posx[N / 2], posy[N / 2]);\n        ans = min({d1, d2, d3, d4});\n        if (ans == d1) { x = posx[N / 2 - 1]; y = posy[N / 2 - 1]; }\n        else if (ans == d2) { x = posx[N / 2 - 1]; y = posy[N / 2]; }\n        else if (ans == d3) { x = posx[N / 2]; y = posy[N / 2 - 1]; }\n        else { x = posx[N / 2]; y = posy[N / 2]; }\n    }\n    cout << dist(x, y) << endl << x << " " << y << endl;\n}') + LineLLMMutation(('source.cpp', 16), '#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <numeric>\n#define int long long\n#define PB push_back\n#define MP make_pair\n#define FI first\n#define SE second\nusing namespace std;\n\nstatic const int INF = 1ll << 60;\ntypedef pair<int, int> pii;\n\nint W, H, N;\nvector<int> posx, posy;\nvector<pii> pos;\n\nint dist(int x, int y) {\n    int max_dist = 0;\n    int total_distance = 0;\n    for (int i = 0; i < N; ++i) {\n        int d = abs(x - pos[i].FI) + abs(y - pos[i].SE);\n        max_dist = max(max_dist, d);\n        total_distance += d;\n    }\n    return max_dist + 2 * (total_distance - max_dist);\n}\n\nsigned main() {\n    cin >> W >> H >> N;\n    for (int i = 0; i < N; ++i) {\n        int x, y;\n        cin >> x >> y;\n        posx.PB(x);\n        posy.PB(y);\n        pos.PB(pii(x, y));\n    }\n    sort(posx.begin(), posx.end());\n    sort(posy.begin(), posy.end());\n    int x, y, ans = INF;\n\n    if (N % 2 != 0) {\n        x = posx[N / 2];\n        y = posy[N / 2];\n    } else {\n        int d1 = dist(posx[N / 2 - 1], posy[N / 2 - 1]);\n        int d2 = dist(posx[N / 2 - 1], posy[N / 2]);\n        int d3 = dist(posx[N / 2], posy[N / 2 - 1]);\n        int d4 = dist(posx[N / 2], posy[N / 2]);\n        ans = min({d1, d2, d3, d4});\n        if (ans == d1) { x = posx[N / 2 - 1]; y = posy[N / 2 - 1]; }\n        else if (ans == d2) { x = posx[N / 2 - 1]; y = posy[N / 2]; }\n        else if (ans == d3) { x = posx[N / 2]; y = posy[N / 2 - 1]; }\n        else { x = posx[N / 2]; y = posy[N / 2]; }\n    }\n    cout << dist(x, y) << endl << x << " " << y << endl;\n}')
