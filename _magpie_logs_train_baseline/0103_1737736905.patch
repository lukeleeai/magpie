LineLLMCrossover(('source.cpp', 9), '#include <iostream>\n#include <vector>\n#include <algorithm>\nusing namespace std;\n\nint dp[1001];\nint w[100010], c[100010];\n\nint main() {\n    int n;\n    cin >> n;\n    int totalWeight = 0;\n    for(int i = 0; i < n; i++) {\n        cin >> c[i] >> w[i];\n        totalWeight += w[i];\n    }\n\n    fill(dp, dp + 1001, 1001); // Initialize dp with a high value\n\n    for(int i = 0; i < n - 1; i++)\n        if (c[i] >= w[i + 1] || c[i + 1] >= w[i]) dp[i] = 1;\n\n    for (int k = 2; k < n; k++) {\n        for (int i = 0; i + k < n; i++) {\n            if ((dp[i + 1] == 1 && c[i] >= totalWeight - w[i]) || \n                (dp[i] == 1 && c[i + k] >= totalWeight - w[i + k]))\n                dp[i] = 1;\n            else \n                dp[i] = min(dp[i + 1], dp[i]) + 1;\n        }\n    }\n    cout << dp[0] << endl;\n    return 0;\n}') + LineLLMMutation(('source.cpp', 22), '#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <limits> // Include limits for numeric limits\nusing namespace std;\n\nint dp[1001];\nint w[100010], c[100010];\n\nint main() {\n    int n;\n    cin >> n;\n    int totalWeight = 0;\n    for(int i = 0; i < n; i++) {\n        cin >> c[i] >> w[i];\n        totalWeight += w[i];\n    }\n\n    fill(dp, dp + 1001, numeric_limits<int>::max()); // Use numeric_limits for clarity\n\n    for(int i = 0; i < n - 1; i++)\n        if (c[i] >= w[i + 1] || c[i + 1] >= w[i]) dp[i] = 1;\n\n    for (int k = 2; k < n; k++) {\n        for (int i = 0; i + k < n; i++) {\n            if ((dp[i + 1] == 1 && c[i] >= totalWeight - w[i]) || \n                (dp[i] == 1 && c[i + k] >= totalWeight - w[i + k]))\n                dp[i] = 1;\n            else \n                dp[i] = min(dp[i + 1], dp[i]) + 1;\n        }\n    }\n    cout << dp[0] << endl;\n    return 0;\n}')
