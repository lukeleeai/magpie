LineLLMMutation(('source.cpp', 27), '#include <cstdio>\n#include <vector>\n#include <cstring>\n\nusing namespace std;\n\ntypedef unsigned short ushort;\n\nushort dfs(int idx, int n, int l, vector<ushort>& arr, vector<ushort>& memo) {\n    if (memo[idx] != 0xFFFF) return memo[idx]; // 0xFFFF represents uncomputed\n\n    ushort lt = 0, rt = 0;\n    if (arr[idx] < arr[idx - 1])\n        lt = dfs(idx - 1, n, l, arr, memo);\n    if (arr[idx] < arr[idx + 1])\n        rt = dfs(idx + 1, n, l, arr, memo);\n\n    return memo[idx] = max(lt, rt) + (l - arr[idx]);\n}\n\nint main(void) {\n    int n, l;\n    while (scanf("%d %d", &n, &l) == 2 && n) {\n        vector<ushort> memo(n + 2, 0xFFFF);\n        vector<ushort> arr(n + 2);\n        memo[0] = 0;\n        memo[n + 1] = 0;\n\n        for (int i = 1; i <= n; i++) {\n            scanf("%hu", &arr[i]);\n        }\n        arr[n + 1] = 0;\n\n        ushort ans = 0;\n        for (int i = 1; i <= n; i++) {\n            ans = max(ans, dfs(i, n, l, arr, memo));\n        }\n        printf("%hu\\n", ans);\n    }\n    return 0;\n}')
