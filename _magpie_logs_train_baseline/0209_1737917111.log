nt> E[100000], r[200000];\nint u[200000], v[200000], ans[200000], d[100000];\nbool b[200000], ok[100000];\n\nvoid bfs(int start, int& count) {\n    queue<int> que;\n    que.push(start);\n    ok[start] = true; // Mark the starting node as visited\n    count = 1; // Initialize count of connected nodes\n\n    while (!que.empty()) {\n        int p = que.front(); que.pop();\n        for (int neighbor : E[p]) {\n            if (!ok[neighbor]) {\n                ok[neighbor] = true; \n                count++; \n                que.push(neighbor);\n            }\n        }\n    }\n}\n\nint main() {\n    int n, m, q; \n    scanf("%d%d%d", &n, &m, &q);\n    rep(i, m) {\n        scanf("%d%d", &u[i], &v[i]);\n        u[i]--; v[i]--;\n        E[u[i]].push_back(v[i]); \n        E[v[i]].push_back(u[i]);\n    }\n\n    queue<int> que;\n    memset(d, -1, sizeof(d));\n    d[0] = 0; \n    que.push(0);\n\n    while (!que.empty()) {\n        int p = que.front(); que.pop();\n        for (int i : E[p]) {\n            if (d[i] == -1) {\n                d[i] = d[p] + 1; \n                que.push(i);\n            }\n        }\n    }\n\n    rep(i, m) {\n        if (d[u[i]] > d[v[i]]) swap(u[i], v[i]);\n    }\n    \n    rep(i, n) E[i].clear();\n    \n    rep(i, q) {\n        scanf("%d", &r[i]); r[i]--;\n        b[r[i]] = true;\n    }\n\n    int cnt = 0;\n    bfs(0, cnt); // Start BFS from node 0\n\n    rep(i, m) {\n        if (!b[i]) {\n            if (d[v[i]] - d[u[i]] == 1) {\n                E[u[i]].push_back(v[i]);\n            }\n        }\n    }\n\n    for (int i = q - 1; i >= 0; i--) {\n        ans[i] = n - cnt;\n        if (d[v[r[i]]] - d[u[r[i]]] == 1 && !ok[v[r[i]]]) {\n            E[u[r[i]]].push_back(v[r[i]]);\n            if (ok[u[r[i]]]) {\n                cnt++; ok[v[r[i]]] = true;\n                bfs(v[r[i]], cnt); // Re-calculate count after adding an edge\n            }\n        }\n    }\n\n    rep(i, q) printf("%d\\n", ans[i]);\n}')"
