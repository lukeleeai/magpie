LineLLMCrossover(('source.cpp', 26), '#include <cstdio>\n#include <algorithm>\n\nusing namespace std;\n\nconst int MAX = 200000;\nconst long long INF = 1LL << 61;\n\nlong long a[MAX + 1];\n\nint main() {\n    int n, k;\n    while (scanf("%d %d", &n, &k) == 2) {\n        if (n == 0) break;\n\n        for (int i = 1; i <= k; ++i) {\n            scanf("%lld", &a[i]);\n        }\n        long long res = -INF, current_sum = 0;\n        for (int i = 1; i <= k; ++i) {\n            current_sum += a[i];\n        }\n        res = current_sum; // Set the result to the first window sum\n        \n        // Slide the window\n        for (int i = k + 1; i <= n; ++i) {\n            scanf("%lld", &a[i]);\n            current_sum += a[i] - a[i - k]; // Update the current sum by adding new and removing old\n            res = max(res, current_sum);\n        }\n        printf("%lld\\n", res);\n    }\n    return 0;\n}')
