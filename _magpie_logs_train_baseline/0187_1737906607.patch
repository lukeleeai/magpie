LineLLMMutation(('source.cpp', 10), "#define _CRT_SECURE_NO_WARNINGS\n\n#include <iostream>\n#include <vector>\n#include <algorithm>\n\nusing namespace std;\n\ntypedef vector<int> vi;\n\nint main() {\n    string s;\n    while (cin >> s) {\n        int n = s.size();\n        vi l(n);\n        l[0] = 1;\n        for (int i = 1; i < n; i++) {\n            l[i] = (s[i] == s[i - 1]) ? l[i - 1] + 1 : 1;\n        }\n        int ans = 0;\n        for (int i = 1; i < n - 1; i++) {\n            if (s[i] == 'O' && s[i + 1] != 'O' && i + l[i] < n && i - l[i] >= 0 && \n                l[i + l[i]] >= l[i] && l[i - l[i]] >= l[i] && \n                s[i + l[i]] == 'I' && s[i - l[i]] == 'J') {\n                ans = max(ans, l[i]);\n            }\n        }\n        cout << ans << endl;\n    }\n}") + LineLLMMutation(('source.cpp', 13), "#define _CRT_SECURE_NO_WARNINGS\n\n#include <iostream>\n#include <string>\nusing namespace std;\n\nint main() {\n    string s;\n    while (cin >> s) {\n        int n = s.size();\n        int ans = 0, current_length = 1;\n        for (int i = 1; i < n; i++) {\n            if (s[i] == s[i - 1]) {\n                current_length++;\n            } else {\n                if (s[i - 1] == 'O' && i - 1 > 0 && s[i] != 'O') {\n                    int left_length = 0, right_length = 0;\n                    for (int j = i - 1; j >= 0 && s[j] == s[i - 1]; j--) left_length++;\n                    for (int j = i; j < n && s[j] == s[i]; j++) right_length++;\n                    if (right_length >= left_length && left_length > 0) {\n                        ans = max(ans, left_length);\n                    }\n                }\n                current_length = 1; // reset for new character\n            }\n        }\n        cout << ans << endl;\n    }\n}") + LineLLMMutation(('source.cpp', 25), "#define _CRT_SECURE_NO_WARNINGS\n\n#include <iostream>\n#include <string>\nusing namespace std;\n\nint main() {\n    string s;\n    while (cin >> s) {\n        int n = s.size();\n        int ans = 0, current_length = 1, left_length = 0, right_length = 0;\n        \n        for (int i = 1; i < n; i++) {\n            if (s[i] == s[i - 1]) {\n                current_length++;\n            } else {\n                if (s[i - 1] == 'O') {\n                    left_length = 1; // Reset left_length for 'O'\n                    for (int j = i - 2; j >= 0 && s[j] == 'O'; j--) left_length++;\n                }\n                right_length = (s[i] == s[i + 1]) ? 2 : 1; // Check next character\n                for (int j = i + 1; j < n && s[j] == s[i]; j++) right_length++;\n                \n                if (right_length >= left_length && left_length > 0) {\n                    ans = max(ans, left_length);\n                }\n                current_length = 1; // reset for new character\n            }\n        }\n        cout << ans << endl;\n    }\n}")
