2025-01-26 14:17:11,217	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include <cstdio>\n\nusing namespace std;\n\nint a[1001][1001], b[1001][1001], c[1001][1001];\n\nint main() {\n    int i, j;\n    int m, n;\n    scanf("%d%d", &m, &n);\n    int k;\n    scanf("%d", &k);\n\n    for(i = 0; i < m; ++i) {\n        a[i][0] = b[i][0] = c[i][0] = 0;\n\n        for(j = 0; j < n; ++j) {\n            char p;\n            scanf(" %c", &p); // Added space to skip whitespace\n\n            if(p == \'J\') {\n                a[i][j + 1] = a[i][j] + 1;\n                b[i][j + 1] = b[i][j];\n                c[i][j + 1] = c[i][j];\n            } else if(p == \'O\') {\n                a[i][j + 1] = a[i][j];\n                b[i][j + 1] = b[i][j] + 1;\n                c[i][j + 1] = c[i][j];\n            } else if(p == \'I\') {\n                a[i][j + 1] = a[i][j];\n                b[i][j + 1] = b[i][j];\n                c[i][j + 1] = c[i][j] + 1;\n            }\n        }\n    }\n\n    for(i = 0; i < k; ++i) {\n        int p, q, r, s;\n        scanf("%d%d%d%d", &p, &q, &r, &s);\n        --p; --q;\n        int d = 0, e = 0, f = 0;\n\n        for(j = p; j < r; ++j) {\n            d += a[j][s] - a[j][q];\n            e += b[j][s] - b[j][q];\n            f += c[j][s] - c[j][q];\n        }\n\n        printf("%d %d %d\\n", d, e, f);\n    }\n\n    return 0;\n}')"

