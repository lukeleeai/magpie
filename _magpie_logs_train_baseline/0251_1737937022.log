2025-01-27 00:18:58,218	[DEBUG]	patch(0-9)="LineLLMMutation(('source.cpp', 8), '#include<iostream>\n#include<cmath>\n#include<cstdio>\n#include<vector>\n#include<algorithm>\n\nusing namespace std;\n\ndouble EPS = 1e-10;\n\ndouble add(double a,double b){\n  return (fabs(a + b) < EPS * (fabs(a) + fabs(b))) ? 0 : a + b;\n}\n\nstruct point {\n  double x, y;\n  point() {}\n  point(double x, double y) : x(x), y(y) {}\n\n  point operator + (point p) {\n    return point(add(x, p.x), add(y, p.y));\n  }\n\n  point operator - (point p) {\n    return point(add(x, -p.x), add(y, -p.y));\n  }\n\n  point operator * (double d) {\n    return point(x * d, y * d);\n  }\n\n  point operator / (double d) {\n    return point(x / d, y / d);\n  }\n};\n\ndouble dist(point a, point b) {\n  return hypot(a.x - b.x, a.y - b.y);\n}\n\nint main(void) {\n  int n, x, y, v;\n  vector<point> P;\n  vector<int> V;\n\n  while (cin >> n, n) {\n    P.clear();\n    V.clear();\n\n    // Read input points and values\n    for (int i = 0; i < n; i++) {\n      cin >> x >> y >> v;\n      P.emplace_back(x, y);\n      V.emplace_back(v);\n    }\n\n    double r = 0.999;\n    point now(0, 0);\n\n    // Simulate movement towards points\n    for (double d = 10; d > EPS; d *= r) {\n      int mx = 0;\n      double mxd = 0;\n\n      for (int j = 0; j < P.size(); j++) {\n        double currentDist = dist(now, P[j]);\n        double distance = currentDist / V[j];\n        if (distance > mxd) {\n          mx = j;\n          mxd = distance;\n        }\n      }\n\n      double currentDistToMax = dist(P[mx], now);\n      now = now + ((P[mx] - now) / currentDistToMax * d);\n    }\n\n    double ans = 0;\n    for (int i = 0; i < P.size(); i++) {\n      ans = max(ans, dist(now, P[i]) / V[i]);\n    }\n\n    printf("%.8f\\n", ans);\n  }\n\n  return 0;\n}')"
