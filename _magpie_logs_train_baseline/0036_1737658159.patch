LineLLMCrossover(('source.cpp', 32), '#include <cstdio>\n#include <cstring>\n\nconst int MAX_V = 10000;\n\nunsigned char prime[MAX_V + 1];\n\nvoid sieve() {\n    memset(prime, 1, sizeof(prime)); // Initialize all as prime\n    prime[0] = prime[1] = 0; // 0 and 1 are not prime numbers\n    for (int i = 2; i * i <= MAX_V; i++) {\n        if (prime[i]) {\n            for (int k = i * i; k <= MAX_V; k += (i == 2 ? i : i * 2)) {\n                prime[k] = 0; \n            }\n        }\n    }\n}\n\nint main() {\n    sieve(); // Precompute primes\n    int n;\n    while (scanf("%d", &n) && n) {\n        int p1 = 0, q1 = 0;\n        for (int i = n; i >= 3; i--) {\n            if (prime[i] && prime[i - 2]) {\n                q1 = i;\n                p1 = i - 2;\n                break;\n            }\n        }\n        if (p1 && q1) {\n            printf("%d %d\\n", p1, q1);\n        }\n    }\n    return 0;\n}')
