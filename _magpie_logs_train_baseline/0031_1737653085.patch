LineLLMCrossover(('source.cpp', 9), '#include<iostream>\n#include<vector>\n#include<sstream>\n#include<cmath>\n#include<algorithm>\n\nusing namespace std;\n\nconst int MAX = 13;\nvector<float> Cake; \nfloat box; \nfloat dp[(1<<MAX)][MAX];\n\nvoid init(){\n    Cake.clear();\n    for(int i = 0; i < (1 << MAX); ++i) {\n        fill(dp[i], dp[i] + MAX, 100000000);\n    }\n    dp[0][0] = 0;\n}\n\nvoid make(){\n    string s;\n    getline(cin,s);\n    stringstream ss(s);\n    float num; \n    Cake.reserve(MAX);\n    while(ss >> num) Cake.push_back(num);\n}\n\nvoid solve(){\n    int n = (int)Cake.size();\n    for(int i = 0; i < (1 << n); i++)\n        for(int j = 0; j < n; j++){\n            if(i == 0) {\n                dp[(1<<j)][j] = Cake[j];\n                continue;\n            }\n            if (dp[i][j] == 100000000) continue; // Skip impossible states\n            for(int k = 0; k < n; k++)\n                if(!(i & (1 << k)) && j != k){\n                    float newValue = dp[i][j] + 2.0f * sqrt(Cake[j] * Cake[k]);\n                    dp[i | (1 << k)][k] = min(dp[i | (1 << k)][k], newValue);\n                }\n        }\n\n    for(int i = 0; i < n; i++){\n        if(dp[(1 << n) - 1][i] + Cake[i] <= box) {cout << "OK" << endl; return;}\n    }\n    cout << "NA" << endl;\n}\n\nint main(){\n    while(cin >> box){\n        init();\n        make();\n        solve();\n    }\n    return 0;\n}') + LineLLMMutation(('source.cpp', 25), '#include<iostream>\n#include<vector>\n#include<sstream>\n#include<cmath>\n#include<algorithm>\n#include<limits>\n\nusing namespace std;\n\nconst int MAX = 13;\nvector<float> Cake; \nfloat box; \nfloat dp[(1<<MAX)][MAX];\n\nvoid init(){\n    Cake.clear();\n    for(int i = 0; i < (1 << MAX); ++i) {\n        fill(dp[i], dp[i] + MAX, numeric_limits<float>::infinity());\n    }\n    dp[0][0] = 0;\n}\n\nvoid make(){\n    string s;\n    getline(cin,s);\n    stringstream ss(s);\n    float num; \n    Cake.reserve(MAX);\n    while(ss >> num) Cake.pus