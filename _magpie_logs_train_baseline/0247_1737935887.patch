LineLLMCrossover(('source.cpp', 5), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\n\n#define rep(i,n) for(int i=0;i<n;i++)\n\nint main() {\n    for(int c,d,w,x; scanf("%d %d %d %d", &c, &d, &w, &x), c|d|w|x;){\n        static int e[30][15], f[30][15];\n        rep(i,c) rep(j,d) scanf("%d", &e[j][i]);\n        rep(i,c) rep(j,d) scanf("%d", &f[j][i]);\n        \n        static int dp[31][6][1000];\n        memset(dp,-1,sizeof dp);\n        \n        dp[0][0][0]=0;\n        rep(i,d) rep(j,x+1) rep(k,1000){\n            if(dp[i][j][k] == -1) continue;\n            dp[i+1][j][k] = max(dp[i+1][j][k], dp[i][j][k]);\n            rep(l,c){\n                if(k + f[i][l] < 1000) {\n                    dp[i+1][j][k + f[i][l]] = max(dp[i+1][j][k + f[i][l]], dp[i][j][k] + e[i][l]);\n                }\n            }\n            if(j < x) {\n                rep(l,c){\n                    if(e[i][l] == 0) continue;\n                    int esum = e[i][l], fsum = f[i][l];\n                    for(int r = l+1; r < c; r++){\n                        if(e[i][r] == 0) break;\n                        esum += e[i][r];\n                        fsum += f[i][r];\n                        dp[i+1][j+1][k + fsum] = max(dp[i+1][j+1][k + fsum], dp[i][j][k] + esum);\n                    }\n                }\n            }\n        }\n\n        int res=0;\n        rep(i,x+1) rep(j,w+1)\n            res = max(res, dp[d][i][j]);\n        printf("%d\\n", res);\n    }\n    return 0;\n}') + LineLLMMutation(('source.cpp', 23), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\n\n#define rep(i,n) for(int i=0;i<n;i++)\n\nint main() {\n    for(int c,d,w,x; scanf("%d %d %d %d", &c, &d, &w, &x), c|d|w|x;){\n        static int e[30][15], f[30][15];\n        rep(i,c) rep(j,d) scanf("%d", &e[j][i]);\n        rep(i,c) rep(j,d) scanf("%d", &f[j][i]);\n        \n        static int dp[2][6][1000]; // Reduced to 2 layers for circular buffer\n        memset(dp, -1, sizeof dp);\n        \n        dp[0][0][0]=0;\n        int current = 0;\n        rep(i,d) {\n            current ^= 1; // Toggle between 0 and 1 for circular buffer\n            memset(dp[current], -1, sizeof dp[current]); // Reset only the current layer\n            \n            rep(j,x+1) rep(k,1000){\n                if(dp[current^1][j][k] == -1) continue; // Use previous layer\n                dp[current][j][k] = max(dp[current][j][k], dp[current^1][j][k]);\n                rep(l,c){\n                    if(k + f[i][l] < 1000) {\n                        dp[current][j][k + f[i][l]] = max(dp[current][j][k + f[i][l]], dp[current^1][j][k] + e[i][l]);\n                    }\n                }\n                if(j < x) {\n                    rep(l,c){\n                        if(e[i][l] == 0) continue;\n                        int esum = e[i][l], fsum = f[i][l];\n                        for(int r = l+1; r < c; r++){\n                            if(e[i][r] == 0) break;\n                            esum += e[i][r];\n                            fsum += f[i][r];\n                            dp[current][j+1][k + fsum] = max(dp[current][j+1][k + fsum], dp[current^1][j][k] + esum);\n                        }\n                    }\n                }\n            }\n        }\n\n        int res=0;\n        rep(i,x+1) rep(j,w+1)\n            res = max(res, dp[current][i][j]);\n        printf("%d\\n", res);\n    }\n    return 0;\n}')
