LineLLMCrossover(('source.cpp', 34), '#include <cstdio>\n\nusing namespace std;\n\nint a[20];\n\nbool check(int x) {\n    int pre = -1; // Start with -1 to ensure the first element is always valid\n    for (int i = 0; i < 10; i++) {\n        if (x & (1 << i)) {\n            if (a[i] <= pre) return false;\n            pre = a[i];\n        }\n    }\n    return true;\n}\n\nbool dfs(int i, int x, int pre) {\n    if (i == 10) {\n        return check(x);\n    }\n    bool temp = false;\n    if (a[i] > pre) temp = dfs(i + 1, x, a[i]); // Changed >= to > for optimization\n    return temp || dfs(i + 1, x | (1 << i), pre);\n}\n\nint main() {\n    int T;\n    scanf("%d", &T);\n    while (T--) {\n        for (int i = 0; i < 10; i++) scanf("%d", &a[i]);\n        printf("%s\\n", dfs(0, 0, -1) ? "YES" : "NO"); // Changed initial pre to -1\n    }\n    return 0;\n}')
