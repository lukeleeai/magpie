           esum+=e[i][r];\n                    fsum+=f[i][r];\n                    chmax(dp[i+1][j+1][k+fsum],dp[i][j][k]+esum);\n                }\n            }\n        }\n\n        int res=0;\n        rep(i,x+1) rep(j,w+1)\n            chmax(res,dp[d][i][j]);\n        cout<<res<<endl;\n    }\n    return 0;\n}')"
