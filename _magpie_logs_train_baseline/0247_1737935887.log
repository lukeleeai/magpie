uced to 2 layers for circular buffer\n        memset(dp, -1, sizeof dp);\n        \n        dp[0][0][0]=0;\n        int current = 0;\n        rep(i,d) {\n            current ^= 1; // Toggle between 0 and 1 for circular buffer\n            memset(dp[current], -1, sizeof dp[current]); // Reset only the current layer\n            \n            rep(j,x+1) rep(k,1000){\n                if(dp[current^1][j][k] == -1) continue; // Use previous layer\n                dp[current][j][k] = max(dp[current][j][k], dp[current^1][j][k]);\n                rep(l,c){\n                    if(k + f[i][l] < 1000) {\n                        dp[current][j][k + f[i][l]] = max(dp[current][j][k + f[i][l]], dp[current^1][j][k] + e[i][l]);\n                    }\n                }\n                if(j < x) {\n                    rep(l,c){\n                        if(e[i][l] == 0) continue;\n                        int esum = e[i][l], fsum = f[i][l];\n                        for(int r = l+1; r < c; r++){\n                            if(e[i][r] == 0) break;\n                            esum += e[i][r];\n                            fsum += f[i][r];\n                            dp[current][j+1][k + fsum] = max(dp[current][j+1][k + fsum], dp[current^1][j][k] + esum);\n                        }\n                    }\n                }\n            }\n        }\n\n        int res=0;\n        rep(i,x+1) rep(j,w+1)\n            res = max(res, dp[current][i][j]);\n        printf("%d\\n", res);\n    }\n    return 0;\n}')"

