LineLLMMutation(('source.cpp', 6), '#include<iostream>\n#include<cstdio>\n#include<vector>\nusing namespace std;\n\nint main() {\n    int K, ans = 0;\n\n    while (true) {\n        ans = 0;\n        cin >> K;\n        if (K == 0) break;\n\n        int totalNumbers = (K * (K - 1)) / 2;\n        vector<int> c(totalNumbers, 0);\n        for (int i = 0; i < totalNumbers; i++) {\n            cin >> c[i];\n            ans += c[i];\n        }\n\n        ans /= (K - 1);\n        cout << ans << endl;\n    }\n}') + LineLLMMutation(('source.cpp', 13), '#include<iostream>\n#include<cstdio>\nusing namespace std;\n\nint main() {\n    int K, ans = 0;\n\n    while (true) {\n        ans = 0;\n        cin >> K;\n        if (K == 0) break;\n\n        int totalNumbers = (K * (K - 1)) / 2;\n        for (int i = 0; i < totalNumbers; i++) {\n            int num;\n            cin >> num;\n            ans += num;\n        }\n\n        ans /= (K - 1);\n        cout << ans << endl;\n    }\n}') + LineLLMMutation(('source.cpp', 20), '#include <cstdio>\nusing namespace std;\n\nint main() {\n    int K;\n    while (scanf("%d", &K), K) {\n        long long ans = 0;  // Use long long to prevent overflow\n        int totalNumbers = (K * (K - 1)) / 2;\n        for (int i = 0; i < totalNumbers; i++) {\n            int num;\n            scanf("%d", &num);  // Use scanf for faster input\n            ans += num;\n        }\n        printf("%lld\\n", ans / (K - 1));  // Perform division at the end\n    }\n}')
