LineLLMCrossover(('source.cpp', 8), '#include <cstdio>\n#include <cstring>\n#include <algorithm>\n#include <array>\n\n#define N_F 1010\n#define N_CONST 1001\n\nusing namespace std;\n\nint v, d, f1, f2;\nstd::array<unsigned long long int, N_F> f;\nstd::array<std::array<int, N_CONST + 10>, N_CONST + 10> node;\n\nvoid rmNode(int i) {\n    node[i][i] = 0;\n    for (int j = 0; j < N_CONST; j++) {\n        if (node[j][j] == 0) continue;\n        if (node[i][j] == 1) {\n            rmNode(j);\n        }\n    }\n}\n\nint main() {\n    f[0] = 1; f[1] = 2;\n    for (int i = 2; i < N_F; i++) {\n        f[i] = (f[i - 1] + f[i - 2]) % N_CONST;\n    }\n\n    while (scanf("%d %d", &v, &d) == 2) {\n        std::fill(node.begin(), node.end(), std::array<int, N_CONST + 10>{0});\n        for (int i = 1; i <= v; i++) {\n            f1 = f[i] % N_CONST;\n            node[f1][f1] = 1;\n\n            for (int j = 1; j <= v; j++) {\n                f2 = f[j] % N_CONST;\n                if (abs(f1 - f2) < d) {\n                    node[f1][f2] = 1;\n                    node[f2][f1] = 1;\n                }\n            }\n        }\n\n        int n = 0;\n        for (int i = 0; i < N_CONST; i++) {\n            if (node[i][i] == 0) continue;\n            n++;\n            rmNode(i);\n        }\n        printf("%d\\n", n);\n    }\n\n    return 0;\n}')
