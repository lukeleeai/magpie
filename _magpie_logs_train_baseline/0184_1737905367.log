2025-01-26 15:32:22,086	[DEBUG]	patch(1-10)="LineLLMMutation(('source.cpp', 15), '#include <cstdio>\n#include <cstdlib>\n#include <ctime>\n#include <set>\n#include <algorithm>\n#include <vector>\n\nusing namespace std;\n\ntypedef long long ll;\n\nstruct house {\n    int x, y;\n    house() {}\n    house(int x, int y) : x(x), y(y) {}\n};\n\nstruct comp_x {\n    bool operator()(const house& a, const house& b) const {\n        return (a.x != b.x) ? a.x < b.x : a.y < b.y;\n    }\n};\n\nstruct comp_y {\n    bool operator()(const house& a, const house& b) const {\n        return (a.y != b.y) ? a.y < b.y : a.x < b.x;\n    }\n};\n\nint main() {\n    srand(static_cast<unsigned int>(time(NULL)));\n    int hh, w, n; \n    scanf("%d %d", &hh, &w); \n    scanf("%d", &n);\n\n    vector<house> h(n);\n    for (int i = 0; i < n; i++) {\n        scanf("%d %d", &h[i].x, &h[i].y);\n    }\n\n    set<int> se1, se2;\n    sort(h.begin(), h.end(), comp_x());\n    se1.insert(h[(n - 2) / 2].x);\n    se1.insert(h[n / 2].x);\n    sort(h.begin(), h.end(), comp_y());\n    se2.insert(h[(n - 2) / 2].y);\n    se2.insert(h[n / 2].y);\n\n    ll ret = 1e15; \n    int px = 2000000000, py = 2000000000;\n\n    for (int x : se1) {\n        for (int y : se2) {\n            ll totalDistance = 0;\n            ll maxDistance = 0;\n            for (const auto& house : h) {\n                ll distance = abs(house.x - x) + abs(house.y - y);\n                totalDistance += 2LL * distance;\n                maxDistance = max(maxDistance, distance);\n            }\n            ll val = totalDistance - maxDistance;\n            if (ret > val || (ret == val && (px > x || (px == x && py > y)))) {\n                ret = val;\n                px = x; \n                py = y;\n            }\n        }\n    }\n    printf("%lld\\n%d %d\\n", ret, px, py);\n}')"
