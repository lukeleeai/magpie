LineLLMMutation(('source.cpp', 5), '#include <cmath>\n#include <cstdio>\n#include <array>\n\n#define MAX 10001\n\nusing namespace std;\n\narray<bool, MAX> is_prime;\n\nvoid ComputePrimes() {\n    is_prime.fill(true);\n    is_prime[0] = is_prime[1] = false;\n    for (int i = 2; i * i < MAX; ++i) {\n        if (is_prime[i]) {\n            for (int j = i * i; j < MAX; j += i) {\n                is_prime[j] = false;\n            }\n        }\n    }\n}\n\nint main() {\n    ComputePrimes();\n    while (true) {\n        int N, P = 0;\n        scanf("%d", &N);\n        if (feof(stdin)) break;\n        for (int i = 1; i <= N; ++i) {\n            P += is_prime[N - i + 1] && is_prime[i];\n        }\n        printf("%d\\n", P);\n    }\n    return 0;\n}')
