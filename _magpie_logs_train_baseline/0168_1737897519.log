2025-01-26 13:21:18,687	[DEBUG]	patch(2-10)="LineLLMMutation(('source.cpp', 21), '#include <iostream>\n#include <vector>\n#include <cstring>\n#include <algorithm>\n#include <stack>\n\nusing namespace std;\n\nconst int MAXN = 100002;\nint memo[MAXN];\nint arr[MAXN];\n\nvoid iterative_dfs(int start, int l) {\n    stack<int> s;\n    s.push(start);\n    while (!s.empty()) {\n        int idx = s.top();\n        s.pop();\n\n        if (memo[idx] != -1) continue;\n\n        int lt = 0, rt = 0;\n        if (arr[idx] < arr[idx - 1]) {\n            s.push(idx - 1);\n            lt = memo[idx - 1] != -1 ? memo[idx - 1] : 0;\n        }\n        if (arr[idx] < arr[idx + 1]) {\n            s.push(idx + 1);\n            rt = memo[idx + 1] != -1 ? memo[idx + 1] : 0;\n        }\n        memo[idx] = max(lt, rt) + (l - arr[idx]);\n    }\n}\n\nint main(void) {\n    int n, l;\n    while (cin >> n >> l && n) {\n        memset(memo, -1, sizeof(memo));\n        memo[0] = 0;\n        memo[n + 1] = 0;\n        for (int i = 0; i < n; i++) {\n            cin >> arr[i + 1];\n        }\n\n        int ans = 0;\n        for (int i = 1; i <= n; i++) {\n            if (memo[i] == -1) {\n                iterative_dfs(i, l);\n            }\n            ans = max(ans, memo[i]);\n        }\n        cout << ans << endl;\n    }\n    return 0;\n}')"
