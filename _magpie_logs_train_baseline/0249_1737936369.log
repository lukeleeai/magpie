    dp[0] = 0;\n\n        for (int i = 0; i < d; i++) {\n            int current_f = f[i];\n            for (int x = 0; x < k[current_f]; x++) {\n                int v = p[current_f][x], c = w[current_f][x];\n                for (int j = m - v; j >= 0; j--) {\n                    if (dp[j] >= 0) dp[j + v] = max(dp[j + v], dp[j] + c);\n                }\n            }\n        }\n\n        int ans = max_element(dp.begin() + 1, dp.end()) - dp.begin();\n        cout << dp[ans] << " " << ans << endl;\n    }\n}')"
