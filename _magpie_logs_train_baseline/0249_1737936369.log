2025-01-27 00:09:30,995	[DEBUG]	patch(0-1)="LineLLMMutation(('source.cpp', 0), '#include <cstdio>\n#include <algorithm>\n\nusing namespace std;\n\nint dp[330];\nint s, d, m;\nint k[110], w[110][55], p[110][55], f[110];\n\nint main() {\n    while (scanf("%d %d %d", &s, &d, &m) == 3) {\n        for (int i = 0; i < s; i++) {\n            scanf("%d", &k[i]);\n            for (int j = 0; j < k[i]; j++) scanf("%d %d", &w[i][j], &p[i][j]);\n        }\n        for (int i = 0; i < d; i++) scanf("%d", &f[i]);\n\n        fill(dp, dp + m + 1, -1);\n        dp[0] = 0;\n\n        for (int i = 0; i < d; i++) {\n            for (int x = 0; x < k[f[i]]; x++) {\n                int v = p[f[i]][x], c = w[f[i]][x];\n                for (int j = m - v; j >= 0; j--) {\n                    if (dp[j] >= 0) dp[j + v] = max(dp[j + v], dp[j] + c);\n                }\n            }\n        }\n\n        int ans = max_element(dp + 1, dp + m + 1) - dp;\n        printf("%d %d\\n", dp[ans], ans);\n    }\n}')"

