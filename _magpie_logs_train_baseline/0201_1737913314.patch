LineLLMCrossover(('source.cpp', 14), '#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\ntypedef long long ll;\nconst int maxn = 200000;\n\nint main() {\n    int N;\n    scanf("%d", &N);\n    int InArray[2 * N]; // using static array for performance\n    ll sum = 0;\n\n    for (int i = 0; i < N; i++) {\n        scanf("%d", &InArray[i]);\n        sum += InArray[i]; // accumulate sum during input\n        InArray[i + N] = InArray[i]; // circular behavior\n    }\n\n    ll MaxMin = 0;\n    ll average = (sum + 2) / 3;\n\n    for (int a1 = 0; a1 < N; a1++) {\n        ll a1_sum = 0;\n        for (int a2 = a1 + 1; a2 < (a1 + N); a2++) {\n            a1_sum += InArray[a2];\n            if (a1_sum < average) continue;\n\n            ll average2 = (sum - a1_sum + 1) / 2;\n            ll a2_sum = 0;\n            for (int a3 = a2 + 1; a3 < (a1 + N); a3++) {\n                a2_sum += InArray[a3];\n                if (a2_sum < average2) continue;\n\n                MaxMin = max(MaxMin, sum - a1_sum - a2_sum);\n                break; // early break\n            }\n            break; // early break\n        }\n    }\n\n    printf("%lld\\n", MaxMin);\n    return 0;\n}')
