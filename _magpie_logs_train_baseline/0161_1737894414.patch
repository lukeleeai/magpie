LineLLMCrossover(('source.cpp', 12), '#include <iostream>\n#include <vector>\n#include <cstdlib>\n#define MAX 100500\n\nusing namespace std;\n\nint main(void) {\n    int n, m;\n    long long int N;\n\n    while (cin >> n >> m) {\n        vector<long long int> d(n + 1, 0); // Initialize d with size n + 1 for easier prefix sum calculation\n        long long int sum = 0, now = 0;\n\n        // Read all N values in one loop for better cache efficiency\n        for (int i = 1; i < n; i++) {\n            cin >> N;\n            d[i] = d[i - 1] + N; // Build prefix sum array\n        }\n\n        // Use a single vector to read M values\n        vector<long long int> M(m);\n        for (int i = 0; i < m; i++) {\n            cin >> M[i];\n        }\n\n        // Calculate the sum in a single pass\n        for (int i = 0; i < m; i++) {\n            sum += (M[i] >= 0) ? (d[now + M[i]] - d[now]) : abs(d[now] - d[now + M[i]]);\n            now += M[i];\n        }\n\n        cout << sum % 100000 << endl;\n    }\n\n    return 0;\n}')
