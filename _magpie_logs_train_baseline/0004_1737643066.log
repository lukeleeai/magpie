/ Array to store the cumulative count of primes\n\n// Initialize using Parent 2\'s method\nfill(primeNum + 2, primeNum + NUM + 1, true);\n\n// Sieve of Eratosthenes with prime count\nvoid sieve() {\n    for (long i = 2; i * i <= NUM; ++i) {\n        if (primeNum[i]) {\n            for (long j = i * i; j <= NUM; j += i) {\n                primeNum[j] = false;\n            }\n        }\n    }\n    \n    // Precompute the cumulative count of primes\n    for (long i = 2; i <= NUM; ++i) {\n        primeCount[i] = primeCount[i - 1] + primeNum[i];\n    }\n}\n\nint main() {\n    sieve(); // Run the sieve and populate primeCount\n\n    // Count primes during input\n    while (scanf("%ld", &n) != EOF) {\n        if (n >= 2) {\n            // Use precomputed prime counts to get the result in O(1)\n            printf("%ld\\n", primeCount[n]);\n        } else {\n            printf("0\\n"); // If n is less than 2, there are no primes\n        }\n    }\n\n    return 0;\n}')"
