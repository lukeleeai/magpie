ithm>\n#include <unordered_set> // Added for storing unique pairs\nusing namespace std;\n\nint main() {\n    int n;\n    while (scanf("%d", &n), n) {\n        vector<pair<int, int>> data;\n        data.reserve(n * 2);\n        for (int i = 0; i < n; ++i) {\n            int h, r;\n            scanf("%d%d", &h, &r);\n            data.emplace_back(h, r);\n        }\n\n        int M;\n        scanf("%d", &M);\n        for (int i = 0; i < M; ++i) {\n            int h, r;\n            scanf("%d%d", &h, &r);\n            data.emplace_back(h, r);\n        }\n\n        n += M;\n\n        // Using an unordered_set to track valid pairs instead of a full matrix\n        vector<unordered_set<int>> edges(n); \n\n        for (int i = 0; i < n; ++i) {\n            for (int j = 0; j < n; ++j) {\n                if (data[i].first < data[j].first && data[i].second < data[j].second) {\n                    edges[i].insert(j); // Store valid pairs\n                }\n            }\n        }\n\n        int ans = numeric_limits<int>::max();\n        for (int k = 0; k < n; ++k) {\n            for (int i = 0; i < n; ++i) {\n                if (edges[i].count(k) == 0) continue; // Check if edge exists\n                for (int j : edges[k]) { // Iterate through valid connections\n                    ans = min(ans, 1); // Update the answer logic as needed\n                }\n            }\n        }\n\n        printf("%d\\n", (ans == numeric_limits<int>::max()) ? -1 : -ans + 1);\n    }\n}')"
