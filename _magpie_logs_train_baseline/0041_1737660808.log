s\n        for (int i = 0; i < n; ++i) {\n            int h, r;\n            scanf("%d%d", &h, &r);\n            data.emplace_back(h, r);\n        }\n\n        int M;\n        scanf("%d", &M);\n        for (int i = 0; i < M; ++i) {\n            int h, r;\n            scanf("%d%d", &h, &r);\n            data.emplace_back(h, r);\n        }\n\n        n += M;\n        vector<int> m(n * n, -1); // Initialize with -1 to indicate no connection\n\n        for (int i = 0; i < n; ++i) {\n            m[i * n + i] = 0; // Initialize the diagonal to 0\n            for (int j = 0; j < n; ++j) {\n                if (data[i].first < data[j].first && data[i].second < data[j].second) {\n                    m[i * n + j] = 1; // Set edge for valid pairs\n                }\n            }\n        }\n\n        int ans = numeric_limits<int>::max();\n        for (int k = 0; k < n; ++k) {\n            for (int i = 0; i < n; ++i) {\n                if (m[i * n + k] == -1) continue; // Continue if no connection\n                for (int j = 0; j < n; ++j) {\n                    if (m[k * n + j] == -1) continue; // Continue if no connection\n                    if (m[i * n + j] == -1 || m[i * n + j] > m[i * n + k] + m[k * n + j]) {\n                        m[i * n + j] = m[i * n + k] + m[k * n + j];\n                    }\n                    ans = min(ans, m[i * n + j]);\n                }\n            }\n        }\n\n        printf("%d\\n", (ans == numeric_limits<int>::max()) ? -1 : ans);\n    }\n}')"
