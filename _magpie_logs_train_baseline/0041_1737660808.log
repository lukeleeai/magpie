2025-01-23 19:43:28,138	[DEBUG]	patch(7-9)="LineLLMCrossover(('source.cpp', 26), '#include <cstdio>\n#include <vector>\n#include <limits>\n#include <algorithm>\nusing namespace std;\n\nint main() {\n    int n;\n    while (scanf("%d", &n), n) {\n        vector<pair<int, int>> data; // Vector for height and reach\n        data.reserve(n + 100); // Preallocate space\n        for (int i = 0; i < n; ++i) {\n            int height, reach;\n            scanf("%d%d", &height, &reach);\n            data.emplace_back(height, reach);\n        }\n\n        int M;\n        scanf("%d", &M);\n        for (int i = 0; i < M; ++i) {\n            int height, reach;\n            scanf("%d%d", &height, &reach);\n            data.emplace_back(height, reach);\n        }\n\n        n += M;\n        vector<vector<int>> m(n, vector<int>(n, numeric_limits<int>::max())); // Adjacency matrix\n\n        for (int i = 0; i < n; ++i) {\n            m[i][i] = 0; // Distance to self is 0\n            for (int j = 0; j < n; ++j) {\n                if (data[i].first < data[j].first && data[i].second < data[j].second) {\n                    m[i][j] = -1; // Mark as reachable\n                }\n            }\n        }\n\n        int ans = numeric_limits<int>::max();\n        for (int k = 0; k < n; ++k) {\n            for (int i = 0; i < n; ++i) {\n                if (m[i][k] == numeric_limits<int>::max()) continue;\n                for (int j = 0; j < n; ++j) {\n                    if (m[k][j] == numeric_limits<int>::max()) continue;\n                    m[i][j] = min(m[i][j], m[i][k] + m[k][j]);\n                }\n            }\n        }\n\n        printf("%d\\n", (ans == numeric_limits<int>::max()) ? -1 : -ans + 1);\n    }\n}')"
