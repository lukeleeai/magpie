;  \n    memset(adj, 0, sizeof(adj));  \n    for (int i = 0, a, b; i < m; ++i) {  \n        ll c;  \n        scanf ("%d%d%lld", &a, &b, &c);  \n        if (c < 0) {  \n            ans += c;  \n        } else {  \n            adj[a][b] = adj[b][a] = adj[a][b] + c;  \n        }  \n    }  \n    printf("%lld\\n", ans + mincut());  \n}\n\nint main() {  \n    while (scanf("%d%d", &n, &m) == 2 && (n || m)) {  \n        gao();  \n    }  \n    return 0;  \n}')"

