LineLLMCrossover(('source.cpp', 11), '#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cstring>\n#include <cmath>\n#include <cstdio>\nusing namespace std;\n\n#define MAX_N 1000000\n#define INF 1145141145141919810LL\n\nlong long x[MAX_N], y[MAX_N], n, h, w, sx, sy, c, mx, my, sum, minx, dx, dy;\nlong long BX[MAX_N], BY[MAX_N];\nint bx_size = 0, by_size = 0;\n\nint main() {\n    scanf("%lld %lld %lld", &h, &w, &n);\n    for(int i = 0; i < n; i++) {\n        scanf("%lld %lld", &x[i], &y[i]);\n        sx += x[i];\n        sy += y[i];\n    }\n\n    sort(x, x + n);\n    sort(y, y + n);\n\n    mx = INF; my = INF; minx = INF;\n\n    for(int i = 0; i < n; i++) {\n        c = (i == 0) ? x[0] : x[i] - x[i - 1];\n        sx += (-n + i * 2) * c;\n        if(mx > sx) {\n            mx = sx;\n            bx_size = 0;\n            BX[bx_size++] = x[i];\n        } else if(mx == sx) {\n            BX[bx_size++] = x[i];\n        }\n    }\n\n    for(int i = 0; i < n; i++) {\n        c = (i == 0) ? y[0] : y[i] - y[i - 1];\n        sy += (-n + i * 2) * c;\n        if(my > sy) {\n            my = sy;\n            by_size = 0;\n            BY[by_size++] = y[i];\n        } else if(my == sy) {\n            BY[by_size++] = y[i];\n        }\n    }\n\n    long long d[MAX_N] = {0};\n    for(int i = 0; i < bx_size; i++) {\n        for(int j = 0; j < by_size; j++) {\n            sum = 0;\n            for(int k = 0; k < n; k++) {\n                d[k] = abs(BX[i] - x[k]) + abs(BY[j] - y[k]);\n                sum += d[k] * 2;\n            }\n            sort(d, d + n);\n            sum -= d[n - 1];\n            if(minx > sum) {\n                minx = sum;\n                dx = BX[i];\n                dy = BY[j];\n            }\n        }\n    }\n\n    printf("%lld\\n%lld %lld\\n", minx, dx, dy);\n    return 0;\n}') + LineLLMMutation(('source.cpp', 28), '#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cstring>\n#include <cmath>\n#include <cstdio>\nusing namespace std;\n\n#define MAX_N 1000000\n#define INF 1145141145141919810LL\n\nlong long x[MAX_N], y[MAX_N], n, h, w, sx, sy, c, mx, my, sum, minx, dx, dy;\nlong long BX[MAX_N], BY[MAX_N];\nint bx_size = 0, by_size = 0;\n\nint main() {\n    scanf("%lld %lld %lld", &h, &w, &n);\n    for(int i = 0; i < n; i++) {\n        scanf("%lld %lld", &x[i], &y[i]);\n        sx += x[i];\n        sy += y[i];\n    }\n\n    sort(x, x + n);\n    sort(y, y + n);\n\n    mx = INF; my = INF; minx = INF;\n\n    for(int i = 0; i < n; i++) {\n        c = (i == 0) ? x[0] : x[i] - x[i - 1];\n        sx += (-n + i * 2) * c;\n        if(mx > sx) {\n            mx = sx;\n            bx_size = 0;\n            BX[bx_size++] = x[i];\n        } else if(mx == sx) {\n            BX[bx_size++] = x[i];\n        }\n    }\n\n    for(int i = 0; i < n; i++) {\n        c = (i == 0) ? y[0] : y[i] - y[i - 1];\n        sy += (-n + i * 2) * c;\n        if(my > sy) {\n            my = sy;\n            by_size = 0;\n            BY[by_size++] = y[i];\n        } else if(my == sy) {\n            BY[by_size++] = y[i];\n        }\n    }\n\n    long long d[MAX_N];\n    for(int i = 0; i < bx_size; i++) {\n        for(int j = 0; j < by_size; j++) {\n            sum = 0;\n            for(int k = 0; k < n; k++) {\n                d[k] = abs(BX[i] - x[k]) + abs(BY[j] - y[k]);\n                sum += d[k];\n            }\n            sum *= 2; // Multiply the accumulated distance by 2 here\n            sort(d, d + n);\n            sum -= d[n - 1];\n            if(minx > sum) {\n                minx = sum;\n                dx = BX[i];\n                dy = BY[j];\n            }\n        }\n    }\n\n    printf("%lld\\n%lld %lld\\n", minx, dx, dy);\n    return 0;\n}')
